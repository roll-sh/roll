<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Roll.Secrets</RootNamespace>
    <PackageId>Roll.Secrets</PackageId>
    <Version>0.1.0</Version>
    <Description>A client for roll secrets: an environment's values, sealed resolves, digests with long polls, watches and a cache. The .NET base class library only.</Description>
    <PackageTags>roll;secrets</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Roll.Secrets.Tests" />
  </ItemGroup>

</Project>
