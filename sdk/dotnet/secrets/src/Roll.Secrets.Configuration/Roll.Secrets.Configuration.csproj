<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Roll.Secrets.Configuration</RootNamespace>
    <PackageId>Roll.Secrets.Configuration</PackageId>
    <Version>0.1.0</Version>
    <Description>roll secrets as an IConfiguration source (AddRollSecrets), reloaded when the environment changes.</Description>
    <PackageTags>roll;secrets;configuration</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Roll.Secrets/Roll.Secrets.csproj" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
  </ItemGroup>

</Project>
