          "kind": "command",
          "sample": {
            "channel": "1100000000000000002",
            "guild": "1100000000000000001",
            "prompt": "fix the build",
            "text": "fix the build",
            "user": "1100000000000000003",
            "user_name": "ada"
          },
          "title": "/roll <prompt>"
        }
      ],
      "source": "discord",
      "title": "Discord"
    },
    {
      "config": {
        "properties": {
          "anyone": {
            "description": "Issues from anyone, not just people who can push.",
            "type": "boolean"
          },
          "branches": {
            "description": "check.failed: on these branches.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "labels": {
            "description": "issue.labeled: one of these labels; issue.opened: having one.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "repos": {
            "description": "Repos (names); unset: every connected repo.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "description": "Issues, @roll comments, review requests and failing checks on the owner's GitHub-connected repos.",
      "events": [
        {
          "fields": [
            "repo",
            "number",
            "title",
            "body",
            "labels",
            "author",
            "trusted_author"
          ],
          "kind": "issue.opened",
          "sample": {
            "author": "ada",
            "author_association": "MEMBER",
            "body": "Steps: …",
            "github": "acme/app",
            "label": null,
            "labels": [
              "bug"
            ],
            "number": 12,
            "repo": "acme/app",
            "repo_name": "app",
            "title": "Login 500s on Safari",
            "trusted_author": true,
            "url": "https://github.com/acme/app/issues/12"
          },
          "title": "An issue is opened"
        },
        {
          "fields": [
            "repo",
            "number",
            "title",
            "label",
            "labels"
          ],
          "kind": "issue.labeled",
          "sample": {
            "author": "ada",
            "author_association": "MEMBER",
            "body": "Steps: …",
            "github": "acme/app",
            "label": "roll",
            "labels": [
              "bug",
              "roll"
            ],
            "number": 12,
            "repo": "acme/app",
            "repo_name": "app",
            "sender": "ada",
            "title": "Login 500s on Safari",
            "trusted_author": true,
            "url": "https://github.com/acme/app/issues/12"
          },
          "title": "An issue is labelled"
        },
        {
          "fields": [
            "repo",
            "number",
            "is_pr",
            "prompt",
            "body",
            "author",
            "change.number"
          ],
          "kind": "comment.mention",
          "sample": {
            "author": "ada",
            "author_association": "MEMBER",
            "body": "@roll fix this and open a PR",
            "change": null,
            "github": "acme/app",
            "is_pr": false,
            "issue_url": "https://github.com/acme/app/issues/12",
            "labels": [
              "bug"
            ],
            "number": 12,
            "prompt": "fix this and open a PR",
            "repo": "acme/app",
            "repo_name": "app",
            "title": "Login 500s on Safari",
            "url": "https://github.com/acme/app/issues/12#issuecomment-1"
          },
          "title": "@roll in a comment"
        },
        {
          "fields": [
            "repo",
            "number",
            "title",
            "reviewer",
            "head_ref"
          ],
          "kind": "review.requested",
          "sample": {
            "author": "ada",
            "base_ref": "main",
            "body": "",
            "github": "acme/app",
            "head_ref": "cache-sessions",
            "head_sha": "6dcb09b5b57875f334f61aebed695e2e4193db5e",
            "number": 7,
            "repo": "acme/app",
            "repo_name": "app",
            "reviewer": "roll-reviewers",
            "title": "Cache sessions",
            "url": "https://github.com/acme/app/pull/7"
          },
          "title": "A review is requested"
        },
        {
          "fields": [
            "repo",
            "check",
            "branch",
            "on_default",
            "sha",
            "pr",
            "url"
          ],
