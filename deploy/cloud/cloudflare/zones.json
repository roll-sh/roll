{
  "$comment": [
    "roll cloud's Cloudflare zones: records, zone settings and Worker routes (docs/cloud/README.md, 'Hostnames').",
    "Apply with: node deploy/cloud/cloudflare/apply.mjs [--dry-run] --stack roll-cloud (deploy/cloud/README.md).",
    "Records apply.mjs creates carry the comment below; it only ever changes or deletes those. Any other record in the way is a conflict: reported, never overwritten.",
    "type 'origin' is the NLB: a CNAME to its DNS name, or one A record per Elastic IP.",
    "*.roll.site also covers chg-<id>.roll.site (previews): the CDN Worker hands chg-* hosts to the origin untouched (ROLL_PASS_HOSTS in apps/cdn-worker/wrangler.toml).",
    "s3.roll.site and *.s3.roll.site are DNS only, so the Worker never runs there (a more specific record wins over the wildcard)."
  ],
  "comment": "managed by roll: deploy/cloud/cloudflare",
  "origin": "origin.roll.sh",
  "zones": {
    "roll.sh": {
      "settings": {
        "ssl": "strict",
        "always_use_https": "on",
        "min_tls_version": "1.2",
        "tls_1_3": "on",
        "tls_client_auth": "on",
        "security_header": {
          "strict_transport_security": {
            "enabled": true,
            "max_age": 31536000,
            "include_subdomains": false,
            "preload": false,
            "nosniff": true
          }
        }
      },
      "records": [
        { "name": "origin.roll.sh", "type": "origin" },
        { "name": "roll.sh", "type": "CNAME", "content": "origin.roll.sh", "proxied": true },
        { "name": "api.roll.sh", "type": "CNAME", "content": "origin.roll.sh", "proxied": true },
        { "name": "git.roll.sh", "type": "CNAME", "content": "origin.roll.sh", "proxied": false },
        { "name": "*.pg.roll.sh", "type": "CNAME", "content": "origin.roll.sh", "proxied": false },
        { "name": "*.redis.roll.sh", "type": "CNAME", "content": "origin.roll.sh", "proxied": false },
        { "name": "*.kafka.roll.sh", "type": "CNAME", "content": "origin.roll.sh", "proxied": false },
        { "name": "*.nosql.roll.sh", "type": "CNAME", "content": "origin.roll.sh", "proxied": false },
        { "name": "*.mq.roll.sh", "type": "CNAME", "content": "origin.roll.sh", "proxied": false },
        { "name": "tasks.roll.sh", "type": "CNAME", "content": "origin.roll.sh", "proxied": false }
      ]
    },
    "roll.site": {
      "settings": {
        "ssl": "strict",
        "always_use_https": "on",
        "min_tls_version": "1.2",
        "tls_1_3": "on",
        "tls_client_auth": "on"
      },
      "records": [
        { "name": "s3.roll.site", "type": "CNAME", "content": "origin.roll.sh", "proxied": false },
        { "name": "*.s3.roll.site", "type": "CNAME", "content": "origin.roll.sh", "proxied": false },
        { "name": "*.roll.site", "type": "CNAME", "content": "origin.roll.sh", "proxied": true }
      ],
      "workerRoutes": [{ "pattern": "*.roll.site/*", "script": "roll-cdn" }]
    }
  }
}
