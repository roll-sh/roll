ø ö é ä Ä z e cz ch abé abc ab a _ Z E B Abd 1
-- SELECT 1

> SET enable_seqscan = off
-- SET

> SELECT string_agg(t, ' ') FROM (SELECT t FROM locale_t ORDER BY t) s
string_agg:text
1 Abd B E Z _ a ab abc abé ch cz e z Ä ä é ö ø
-- SELECT 1

> SELECT string_agg(t, ' ') FROM (SELECT t FROM locale_t WHERE t > 'b' ORDER BY t) s
string_agg:text
ch cz e z Ä ä é ö ø
-- SELECT 1

> SELECT string_agg(t, ' ') FROM (SELECT t FROM locale_t WHERE t BETWEEN 'a' AND 'e' ORDER BY t) s
string_agg:text
a ab abc abé ch cz e
-- SELECT 1

> SELECT t FROM locale_t WHERE t LIKE 'ab%' ORDER BY t
t:text
ab
abc
abé
-- SELECT 3

> EXPLAIN (COSTS OFF) SELECT t FROM locale_t WHERE t LIKE 'ab%'
QUERY PLAN:text
Index Only Scan using locale_t_i on locale_t
  Index Cond: ((t >= 'ab'::text) AND (t < 'ac'::text))
  Filter: (t ~~ 'ab%'::text)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT t FROM locale_t WHERE t ~ '^ab'
QUERY PLAN:text
Index Only Scan using locale_t_i on locale_t
  Index Cond: ((t >= 'ab'::text) AND (t < 'ac'::text))
  Filter: (t ~ '^ab'::text)
-- EXPLAIN

> RESET enable_seqscan
-- RESET

