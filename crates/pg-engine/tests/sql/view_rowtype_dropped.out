id2 | 2 | email2 | 12 | t | 11 | 2
-- SELECT 2

> alter table vrd_users drop column moredrop
ERROR 2BP01: cannot drop column moredrop of table vrd_users because other objects depend on it
DETAIL: view vrd_usersview depends on column moredrop of table vrd_users
HINT: Use DROP ... CASCADE to drop the dependent objects too.

> begin
-- BEGIN

> delete from pg_depend where
>   objid = (select oid from pg_rewrite
>            where ev_class = 'vrd_usersview'::regclass and rulename = '_RETURN')
>   and refobjsubid = 5
> returning pg_describe_object(classid, objid, objsubid) as obj,
>           pg_describe_object(refclassid, refobjid, refobjsubid) as ref,
>           deptype
obj:text | ref:text | deptype:char
rule _RETURN on view vrd_usersview | column moredrop of table vrd_users | n
-- DELETE 1

