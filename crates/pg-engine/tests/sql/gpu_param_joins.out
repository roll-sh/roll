> CREATE TABLE gpu_t (unique1 int, unique2 int, two int, ten int, hundred int, thousand int, tenthous int)
-- CREATE TABLE

> INSERT INTO gpu_t SELECT i, (i * 7919) % 10000, i % 2, i % 10, i % 100, i % 1000, i FROM generate_series(0, 9999) i
-- INSERT 0 10000

> CREATE INDEX gpu_t_unique1 ON gpu_t (unique1)
-- CREATE INDEX

> CREATE INDEX gpu_t_unique2 ON gpu_t (unique2)
-- CREATE INDEX

> CREATE INDEX gpu_t_hundred ON gpu_t (hundred)
-- CREATE INDEX

> CREATE INDEX gpu_t_thous_tenthous ON gpu_t (thousand, tenthous)
-- CREATE INDEX

> ANALYZE gpu_t
-- ANALYZE

> CREATE TABLE gpu_i4 (f1 int)
-- CREATE TABLE

> INSERT INTO gpu_i4 VALUES (0), (123456), (-123456), (2147483647), (-2147483647)
-- INSERT 0 5

> ANALYZE gpu_i4
-- ANALYZE

> EXPLAIN (COSTS OFF)
> SELECT unique1 FROM gpu_t WHERE unique1 IN (SELECT 17)
QUERY PLAN:text
Index Only Scan using gpu_t_unique1 on gpu_t
  Index Cond: (unique1 = 17)
-- EXPLAIN

> SELECT unique1 FROM gpu_t WHERE unique1 IN (SELECT 17)
unique1:int4
17
-- SELECT 1

> EXPLAIN (COSTS OFF)
> SELECT unique1 FROM gpu_t WHERE (unique1, unique2) IN (SELECT 17, 4)
QUERY PLAN:text
Index Scan using gpu_t_unique2 on gpu_t
  Index Cond: (unique2 = 4)
  Filter: (unique1 = 17)
-- EXPLAIN

> SELECT unique1, unique2 FROM gpu_t WHERE (unique1, unique2) IN (SELECT 17, 3)
unique1:int4 | unique2:int4
-- SELECT 0

> CREATE FUNCTION gpu_imm(i int) RETURNS int AS $$ BEGIN RETURN i; END; $$ LANGUAGE plpgsql IMMUTABLE
-- CREATE FUNCTION

> EXPLAIN (COSTS OFF)
> SELECT unique1 FROM gpu_t, LATERAL gpu_imm(1) x WHERE x IN (SELECT 17)
QUERY PLAN:text
Result
  One-Time Filter: false
-- EXPLAIN

> EXPLAIN (COSTS OFF)
> SELECT unique1 IN (SELECT 17) FROM gpu_t WHERE unique1 < 3
QUERY PLAN:text
Index Only Scan using gpu_t_unique1 on gpu_t
  Index Cond: (unique1 < 3)
  SubPlan 1
    ->  Result
-- EXPLAIN

> SELECT unique1 IN (SELECT 17) FROM gpu_t WHERE unique1 < 3 ORDER BY 1
?column?:bool
f
f
f
-- SELECT 3

> EXPLAIN (COSTS OFF)
> SELECT * FROM gpu_t t1 LEFT JOIN
>   (gpu_t t2 JOIN gpu_t t3 ON t2.thousand = t3.unique2)
>   ON t1.hundred = t2.hundred AND t1.ten = t3.ten
> WHERE t1.unique1 = 1
QUERY PLAN:text
Nested Loop Left Join
  ->  Index Scan using gpu_t_unique1 on gpu_t t1
        Index Cond: (unique1 = 1)
  ->  Nested Loop
        Join Filter: (t1.ten = t3.ten)
        ->  Bitmap Heap Scan on gpu_t t2
              Recheck Cond: (t1.hundred = hundred)
              ->  Bitmap Index Scan on gpu_t_hundred
                    Index Cond: (hundred = t1.hundred)
        ->  Index Scan using gpu_t_unique2 on gpu_t t3
              Index Cond: (unique2 = t2.thousand)
-- EXPLAIN

> SELECT count(*), sum(t3.unique1) FROM gpu_t t1 LEFT JOIN
>   (gpu_t t2 JOIN gpu_t t3 ON t2.thousand = t3.unique2)
>   ON t1.hundred = t2.hundred AND t1.ten = t3.ten
> WHERE t1.unique1 = 1
count:int8 | sum:int8
1 | NULL
-- SELECT 1

> EXPLAIN (COSTS OFF)
> SELECT * FROM gpu_t t1 LEFT JOIN
>   (gpu_t t2 JOIN gpu_t t3 ON t2.thousand = t3.unique2)
>   ON t1.hundred = t2.hundred AND t1.ten + t2.ten = t3.ten
> WHERE t1.unique1 = 1
QUERY PLAN:text
Nested Loop Left Join
  ->  Index Scan using gpu_t_unique1 on gpu_t t1
        Index Cond: (unique1 = 1)
  ->  Nested Loop
        Join Filter: ((t1.ten + t2.ten) = t3.ten)
        ->  Bitmap Heap Scan on gpu_t t2
              Recheck Cond: (t1.hundred = hundred)
              ->  Bitmap Index Scan on gpu_t_hundred
                    Index Cond: (hundred = t1.hundred)
        ->  Index Scan using gpu_t_unique2 on gpu_t t3
              Index Cond: (unique2 = t2.thousand)
-- EXPLAIN

> SELECT count(*), sum(t3.unique1) FROM gpu_t t1 LEFT JOIN
>   (gpu_t t2 JOIN gpu_t t3 ON t2.thousand = t3.unique2)
>   ON t1.hundred = t2.hundred AND t1.ten + t2.ten = t3.ten
> WHERE t1.unique1 IN (1, 2, 3)
count:int8 | sum:int8
3 | NULL
-- SELECT 1

> EXPLAIN (COSTS OFF)
> SELECT * FROM gpu_t t,
>   (SELECT sum(f1) + 1 AS f1 FROM gpu_i4 i4a) a,
>   (SELECT sum(f1) AS f1 FROM gpu_i4 i4b) b
> WHERE b.f1 = t.thousand AND a.f1 = b.f1
QUERY PLAN:text
Nested Loop
  ->  Nested Loop
        Join Filter: (((sum(i4a.f1) + 1)) = (sum(i4b.f1)))
        ->  Aggregate
              ->  Seq Scan on gpu_i4 i4a
        ->  Aggregate
              ->  Seq Scan on gpu_i4 i4b
  ->  Bitmap Heap Scan on gpu_t t
        Recheck Cond: (thousand = (sum(i4b.f1)))
        ->  Bitmap Index Scan on gpu_t_thous_tenthous
              Index Cond: (thousand = (sum(i4b.f1)))
-- EXPLAIN

> SELECT count(*) FROM gpu_t t,
>   (SELECT sum(f1) + 1 AS f1 FROM gpu_i4 i4a) a,
>   (SELECT sum(f1) AS f1 FROM gpu_i4 i4b) b
> WHERE b.f1 = t.thousand AND a.f1 - 1 = b.f1
count:int8
10
-- SELECT 1

