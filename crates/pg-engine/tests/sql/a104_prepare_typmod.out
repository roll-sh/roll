> PREPARE a104_p3(varchar(2)[]) AS SELECT $1, pg_typeof($1)::text
-- PREPARE

> EXECUTE a104_p3('{abcd,e}')
?column?:varchar[] | pg_typeof:text
{abcd,e} | character varying[]
