> explain (costs off)
> select t1.*, t2.* from a26_al t1 join a26_be t2 on (t1.a = t2.a and t1.c = t2.c)
>   where ((t1.b >= 100 and t1.b < 110) or (t1.b >= 200 and t1.b < 210))
>     and ((t2.b >= 100 and t2.b < 110) or (t2.b >= 200 and t2.b < 210)) and t1.c in ('0004', '0009')
>   order by t1.a, t1.b, t2.b
QUERY PLAN:text
Sort
  Sort Key: t1.a, t1.b, t2.b
  ->  Append
        ->  Hash Join
              Hash Cond: ((t1_2.a = t2_2.a) AND (t1_2.c = t2_2.c))
              ->  Append
                    ->  Seq Scan on a26_al_neg_p1 t1_2
                          Filter: ((c = ANY ('{0004,0009}'::text[])) AND (((b >= 100) AND (b < 110)) OR ((b >= 200) AND (b < 210))))
                    ->  Seq Scan on a26_al_neg_p2 t1_3
                          Filter: ((c = ANY ('{0004,0009}'::text[])) AND (((b >= 100) AND (b < 110)) OR ((b >= 200) AND (b < 210))))
              ->  Hash
                    ->  Append
                          ->  Seq Scan on a26_be_neg_p1 t2_2
                                Filter: (((b >= 100) AND (b < 110)) OR ((b >= 200) AND (b < 210)))
                          ->  Seq Scan on a26_be_neg_p2 t2_3
                                Filter: (((b >= 100) AND (b < 110)) OR ((b >= 200) AND (b < 210)))
        ->  Nested Loop
              Join Filter: ((t1_4.a = t2_4.a) AND (t1_4.c = t2_4.c))
              ->  Seq Scan on a26_al_pos_p2 t1_4
                    Filter: ((c = ANY ('{0004,0009}'::text[])) AND (((b >= 100) AND (b < 110)) OR ((b >= 200) AND (b < 210))))
              ->  Seq Scan on a26_be_pos_p2 t2_4
                    Filter: (((b >= 100) AND (b < 110)) OR ((b >= 200) AND (b < 210)))
        ->  Nested Loop
              Join Filter: ((t1_5.a = t2_5.a) AND (t1_5.c = t2_5.c))
              ->  Seq Scan on a26_al_pos_p3 t1_5
                    Filter: ((c = ANY ('{0004,0009}'::text[])) AND (((b >= 100) AND (b < 110)) OR ((b >= 200) AND (b < 210))))
              ->  Seq Scan on a26_be_pos_p3 t2_5
                    Filter: (((b >= 100) AND (b < 110)) OR ((b >= 200) AND (b < 210)))
-- EXPLAIN

