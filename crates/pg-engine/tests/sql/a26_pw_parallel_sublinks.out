> explain select a, b from a26_p1_1 p1 full join a26_p2_1 p2(b, a, c) using (a, b)
>   where a between 490 and 510
QUERY PLAN:text
Merge Full Join  (cost=11.13..12.74 rows=14 width=8)
  Merge Cond: ((p1.a = p2.a) AND (p1.b = p2.b))
  Filter: ((COALESCE(p1.a, p2.a) >= 490) AND (COALESCE(p1.a, p2.a) <= 510))
  ->  Sort  (cost=6.60..6.92 rows=125 width=8)
        Sort Key: p1.a, p1.b
        ->  Seq Scan on a26_p1_1 p1  (cost=0.00..2.25 rows=125 width=8)
  ->  Sort  (cost=4.52..4.73 rows=84 width=8)
        Sort Key: p2.a, p2.b
        ->  Seq Scan on a26_p2_1 p2  (cost=0.00..1.84 rows=84 width=8)
-- EXPLAIN

> explain select a, b from a26_p1_1 p1 full join a26_p2_1 p2(b, a, c) using (a, b)
QUERY PLAN:text
Merge Full Join  (cost=11.13..12.73 rows=125 width=8)
  Merge Cond: ((p1.a = p2.a) AND (p1.b = p2.b))
  ->  Sort  (cost=6.60..6.92 rows=125 width=8)
        Sort Key: p1.a, p1.b
        ->  Seq Scan on a26_p1_1 p1  (cost=0.00..2.25 rows=125 width=8)
  ->  Sort  (cost=4.52..4.73 rows=84 width=8)
        Sort Key: p2.a, p2.b
        ->  Seq Scan on a26_p2_1 p2  (cost=0.00..1.84 rows=84 width=8)
-- EXPLAIN

> explain (costs off)
> select a, b from a26_p1 p1 full join a26_p2 p2(b, a, c) using (a, b)
>   where a between 490 and 510 group by 1, 2 order by 1, 2
QUERY PLAN:text
Group
  Group Key: (COALESCE(p1.a, p2.a)), (COALESCE(p1.b, p2.b))
  ->  Merge Append
        Sort Key: (COALESCE(p1.a, p2.a)), (COALESCE(p1.b, p2.b))
        ->  Group
              Group Key: (COALESCE(p1.a, p2.a)), (COALESCE(p1.b, p2.b))
              ->  Sort
                    Sort Key: (COALESCE(p1.a, p2.a)), (COALESCE(p1.b, p2.b))
                    ->  Merge Full Join
                          Merge Cond: ((p1.a = p2.a) AND (p1.b = p2.b))
                          Filter: ((COALESCE(p1.a, p2.a) >= 490) AND (COALESCE(p1.a, p2.a) <= 510))
                          ->  Sort
                                Sort Key: p1.a, p1.b
                                ->  Seq Scan on a26_p1_1 p1
                          ->  Sort
                                Sort Key: p2.a, p2.b
                                ->  Seq Scan on a26_p2_1 p2
        ->  Group
              Group Key: (COALESCE(p1_1.a, p2_1.a)), (COALESCE(p1_1.b, p2_1.b))
              ->  Sort
                    Sort Key: (COALESCE(p1_1.a, p2_1.a)), (COALESCE(p1_1.b, p2_1.b))
                    ->  Merge Full Join
                          Merge Cond: ((p1_1.a = p2_1.a) AND (p1_1.b = p2_1.b))
                          Filter: ((COALESCE(p1_1.a, p2_1.a) >= 490) AND (COALESCE(p1_1.a, p2_1.a) <= 510))
                          ->  Sort
                                Sort Key: p1_1.a, p1_1.b
                                ->  Seq Scan on a26_p1_2 p1_1
                          ->  Sort
                                Sort Key: p2_1.a, p2_1.b
                                ->  Seq Scan on a26_p2_2 p2_1
        ->  Group
              Group Key: (COALESCE(p1_2.a, p2_2.a)), (COALESCE(p1_2.b, p2_2.b))
              ->  Sort
                    Sort Key: (COALESCE(p1_2.a, p2_2.a)), (COALESCE(p1_2.b, p2_2.b))
                    ->  Merge Full Join
                          Merge Cond: ((p1_2.a = p2_2.a) AND (p1_2.b = p2_2.b))
                          Filter: ((COALESCE(p1_2.a, p2_2.a) >= 490) AND (COALESCE(p1_2.a, p2_2.a) <= 510))
                          ->  Sort
                                Sort Key: p1_2.a, p1_2.b
                                ->  Seq Scan on a26_p1_3 p1_2
                          ->  Sort
                                Sort Key: p2_2.a, p2_2.b
                                ->  Seq Scan on a26_p2_3 p2_2
-- EXPLAIN

