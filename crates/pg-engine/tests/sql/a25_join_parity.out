> explain (costs off)
> select t0.* from a25_tx t0
>   left join (select case t1.ten when 0 then 'doh!'::text else null::text end as case1,
>                     t1.stringu2
>                from a25_tk t1) ss
>   on t0.f1 = ss.case1
> where ss.stringu2 !~* ss.case1
QUERY PLAN:text
Hash Join
  Hash Cond: (CASE t1.ten WHEN 0 THEN 'doh!'::text ELSE NULL::text END = t0.f1)
  ->  Seq Scan on a25_tk t1
        Filter: (stringu2 !~* CASE ten WHEN 0 THEN 'doh!'::text ELSE NULL::text END)
  ->  Hash
        ->  Seq Scan on a25_tx t0
-- EXPLAIN

> explain (costs off)
> select t0.* from a25_tx t0
>   left join (select case t1.ten when 0 then 'doh!'::text else null::text end as case1,
>                     t1.stringu2
>                from a25_tk t1
>                join a25_i4 i4 on i4.f1 = t1.unique2
>                left join a25_u u1 on u1.f1 = t1.string4) ss
>   on t0.f1 = ss.case1
> where ss.stringu2 !~* ss.case1
QUERY PLAN:text
Nested Loop
  Join Filter: (t0.f1 = CASE t1.ten WHEN 0 THEN 'doh!'::text ELSE NULL::text END)
  ->  Nested Loop
        ->  Seq Scan on a25_i4 i4
        ->  Index Scan using a25_tk_unique2 on a25_tk t1
              Index Cond: (unique2 = i4.f1)
              Filter: (stringu2 !~* CASE ten WHEN 0 THEN 'doh!'::text ELSE NULL::text END)
  ->  Materialize
        ->  Seq Scan on a25_tx t0
-- EXPLAIN

