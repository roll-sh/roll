> explain (verbose, costs off)
> select * from
>   a25_tx t1
>   left join a25_i8 i8
>   on i8.q2 = 123,
>   lateral (select i8.q1, t2.f1 from a25_tx t2 limit 1) as ss1,
>   lateral (select ss1.* from a25_tx t3 limit 1) as ss2
> where t1.f1 = ss2.f1
QUERY PLAN:text
Nested Loop
  Output: t1.f1, i8.q1, i8.q2, (i8.q1), t2.f1, ((i8.q1)), (t2.f1)
  Join Filter: (t1.f1 = (t2.f1))
  ->  Nested Loop
        Output: t1.f1, i8.q1, i8.q2, (i8.q1), t2.f1
        ->  Nested Loop Left Join
              Output: t1.f1, i8.q1, i8.q2
              ->  Seq Scan on public.a25_tx t1
                    Output: t1.f1
              ->  Materialize
                    Output: i8.q1, i8.q2
                    ->  Seq Scan on public.a25_i8 i8
                          Output: i8.q1, i8.q2
                          Filter: (i8.q2 = 123)
        ->  Memoize
              Output: (i8.q1), t2.f1
              Cache Key: i8.q1
              Cache Mode: binary
              ->  Limit
                    Output: (i8.q1), t2.f1
                    ->  Seq Scan on public.a25_tx t2
                          Output: i8.q1, t2.f1
  ->  Memoize
        Output: ((i8.q1)), (t2.f1)
        Cache Key: (i8.q1), t2.f1
        Cache Mode: binary
        ->  Limit
              Output: ((i8.q1)), (t2.f1)
              ->  Seq Scan on public.a25_tx t3
                    Output: (i8.q1), t2.f1
-- EXPLAIN

