> explain (verbose, costs off)
> select t1.* from
>   a25_tx t1
>   left join (select *, '***'::text as d1 from a25_i8 i8b1) b1
>     left join a25_i8 i8
>       left join (select *, null::int as d2 from a25_i8 i8b2, a25_i4 i4b2) b2
>       on (i8.q1 = b2.q1)
>     on (b2.d2 = b1.q2)
>   on (t1.f1 = b1.d1)
>   left join a25_i4 i4
>   on (i8.q2 = i4.f1)
QUERY PLAN:text
Hash Left Join
  Output: t1.f1
  Hash Cond: (i8.q2 = i4.f1)
  ->  Nested Loop Left Join
        Output: t1.f1, i8.q2
        Join Filter: (t1.f1 = '***'::text)
        ->  Seq Scan on public.a25_tx t1
              Output: t1.f1
        ->  Materialize
              Output: i8.q2
              ->  Hash Right Join
                    Output: i8.q2
                    Hash Cond: ((NULL::integer) = i8b1.q2)
                    ->  Hash Right Join
                          Output: i8.q2, (NULL::integer)
                          Hash Cond: (i8b2.q1 = i8.q1)
                          ->  Nested Loop
                                Output: i8b2.q1, NULL::integer
                                ->  Seq Scan on public.a25_i8 i8b2
                                      Output: i8b2.q1, i8b2.q2
                                ->  Materialize
                                      ->  Seq Scan on public.a25_i4 i4b2
                          ->  Hash
                                Output: i8.q1, i8.q2
                                ->  Seq Scan on public.a25_i8 i8
                                      Output: i8.q1, i8.q2
                    ->  Hash
                          Output: i8b1.q2
                          ->  Seq Scan on public.a25_i8 i8b1
                                Output: i8b1.q2
  ->  Hash
        Output: i4.f1
        ->  Seq Scan on public.a25_i4 i4
              Output: i4.f1
-- EXPLAIN

> explain (verbose, costs off)
> select ss2.* from
>   a25_i4 i41
>   left join a25_i8 i8
>     join (select i42.f1 as c1, i43.f1 as c2, 42 as c3
>           from a25_i4 i42, a25_i4 i43) ss1
>     on i8.q1 = ss1.c2
>   on i41.f1 = ss1.c1,
>   lateral (select i41.*, i8.*, ss1.* from a25_tx limit 1) ss2
> where ss1.c2 = 0
QUERY PLAN:text
Nested Loop
  Output: (i41.f1), (i8.q1), (i8.q2), (i42.f1), (i43.f1), ((42))
  ->  Hash Join
        Output: i41.f1, i42.f1, i8.q1, i8.q2, i43.f1, 42
        Hash Cond: (i41.f1 = i42.f1)
        ->  Nested Loop
              Output: i8.q1, i8.q2, i43.f1, i41.f1
              ->  Nested Loop
                    Output: i8.q1, i8.q2, i43.f1
                    ->  Seq Scan on public.a25_i8 i8
                          Output: i8.q1, i8.q2
                          Filter: (i8.q1 = 0)
                    ->  Seq Scan on public.a25_i4 i43
                          Output: i43.f1
                          Filter: (i43.f1 = 0)
              ->  Seq Scan on public.a25_i4 i41
                    Output: i41.f1
        ->  Hash
              Output: i42.f1
              ->  Seq Scan on public.a25_i4 i42
                    Output: i42.f1
  ->  Limit
        Output: (i41.f1), (i8.q1), (i8.q2), (i42.f1), (i43.f1), ((42))
        ->  Seq Scan on public.a25_tx
              Output: i41.f1, i8.q1, i8.q2, i42.f1, i43.f1, (42)
-- EXPLAIN

