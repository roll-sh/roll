> SELECT ts_lexize('ispell_stop', 'the'), ts_lexize('ispell_stop', 'booking')
ts_lexize:text[] | ts_lexize:text[]
NULL | {booking,book}
-- SELECT 1

> CREATE TEXT SEARCH CONFIGURATION ispell_tst (COPY = english)
-- CREATE TEXT SEARCH CONFIGURATION

> ALTER TEXT SEARCH CONFIGURATION ispell_tst ALTER MAPPING FOR word, numword, asciiword, hword, numhword, asciihword, hword_part, hword_numpart, hword_asciipart WITH ispell, english_stem
-- ALTER TEXT SEARCH CONFIGURATION

> SELECT to_tsvector('ispell_tst', 'Booking the skies after rebookings for footballklubber from a foot')
to_tsvector:3614
'ball':7 'book':1,5 'booking':1,5 'foot':7,10 'football':7 'footballklubber':7 'klubber':7 'sky':3
-- SELECT 1

> SELECT to_tsquery('ispell_tst', 'footballklubber')
to_tsquery:3615
'footballklubber' | 'foot' & 'ball' & 'klubber' | 'football' & 'klubber'
-- SELECT 1

> SELECT to_tsquery('ispell_tst', 'footballyklubber:b & rebookings:A & sky')
to_tsquery:3615
'foot':B & 'ball':B & 'klubber':B & ( 'booking':A | 'book':A ) & 'sky'
-- SELECT 1

> SELECT to_tsquery('ispell_tst', 'footballyklubber:b <-> sky')
to_tsquery:3615
( 'foot':B & 'ball':B & 'klubber':B ) <-> 'sky'
-- SELECT 1

> SELECT phraseto_tsquery('ispell_tst', 'footballyklubber sky')
phraseto_tsquery:3615
( 'foot' & 'ball' & 'klubber' ) <-> 'sky'
-- SELECT 1

> SELECT ts_debug('ispell_tst', 'footballklubber skies')
ts_debug:record
(asciiword,"Word, all ASCII",footballklubber,"{ispell,english_stem}",ispell,"{footballklubber,foot,ball,klubber,football,klubber}")
(asciiword,"Word, all ASCII",skies,"{ispell,english_stem}",ispell,{sky})
(blank,"Space symbols"," ",{},,)
-- SELECT 3

> CREATE TEXT SEARCH CONFIGURATION hunspell_tst (COPY = ispell_tst)
-- CREATE TEXT SEARCH CONFIGURATION

> ALTER TEXT SEARCH CONFIGURATION hunspell_tst ALTER MAPPING REPLACE ispell WITH hunspell
-- ALTER TEXT SEARCH CONFIGURATION

> SELECT to_tsvector('hunspell_tst', 'Booking the skies after rebookings for footballklubber from a foot')
to_tsvector:3614
'ball':7 'book':1,5 'booking':1,5 'foot':7,10 'football':7 'footballklubber':7 'klubber':7 'sky':3
-- SELECT 1

> SELECT to_tsquery('hunspell_tst', 'footballyklubber:b & rebookings:A & sky')
to_tsquery:3615
'foot':B & 'ball':B & 'klubber':B & ( 'booking':A | 'book':A ) & 'sky'
-- SELECT 1

> ALTER TEXT SEARCH CONFIGURATION hunspell_tst ALTER MAPPING REPLACE hunspell WITH hunspell_long
-- ALTER TEXT SEARCH CONFIGURATION

> SELECT to_tsvector('hunspell_tst', 'Booking the skies after rebookings for footballklubber from a foot ex-machina')
to_tsvector:3614
'ball':7 'book':1,5 'booking':1,5 'ex':12 'ex-':11 'foot':7,10 'football':7 'footballklubber':7 'klubber':7 'machina':11,13 'sky':3
-- SELECT 1

> ALTER TEXT SEARCH CONFIGURATION hunspell_tst ALTER MAPPING REPLACE hunspell_long WITH hunspell_num
-- ALTER TEXT SEARCH CONFIGURATION

> SELECT to_tsvector('hunspell_tst', 'Booking the skies after rebookings for footballklubber from a foot booked')
to_tsvector:3614
'ball':7 'book':1,5,11 'booking':1,5 'foot':7,10 'football':7 'footballklubber':7 'klubber':7 'sky':3
-- SELECT 1

> SELECT ts_headline('hunspell_tst', 'Booking the skies after rebookings for footballklubber from a foot', to_tsquery('hunspell_tst', 'book & sky'))
ts_headline:text
<b>Booking</b> the <b>skies</b> after <b>rebookings</b> for footballklubber from a foot
-- SELECT 1

