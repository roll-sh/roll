-- EXPLAIN

> CREATE FUNCTION rec_arr(n int, VARIADIC xs int[]) RETURNS int LANGUAGE sql
>   AS 'SELECT CASE WHEN n = 0 THEN array_length(xs, 1) ELSE rec_arr(n - 1, VARIADIC xs || n) END'
-- CREATE FUNCTION

> SELECT rec_arr(3, 10, 20)
rec_arr:int4
5
-- SELECT 1

