> EXPLAIN (COSTS OFF)
> SELECT n_name, count(*) FROM a91_customer, a91_orders, a91_nation, a91_region
> WHERE c_custkey = o_custkey AND c_nationkey = n_nationkey AND n_regionkey = r_regionkey
>   AND r_name = 'r2' AND o_orderdate >= date '1994-01-01' AND o_orderdate < date '1995-01-01'
> GROUP BY n_name ORDER BY 2 DESC
QUERY PLAN:text
Sort
  Sort Key: (count(*)) DESC
  ->  HashAggregate
        Group Key: a91_nation.n_name
        ->  Hash Join
              Hash Cond: (a91_orders.o_custkey = a91_customer.c_custkey)
              ->  Bitmap Heap Scan on a91_orders
                    Recheck Cond: ((o_orderdate >= '1994-01-01'::date) AND (o_orderdate < '1995-01-01'::date))
                    ->  Bitmap Index Scan on a91_orders_date
                          Index Cond: ((o_orderdate >= '1994-01-01'::date) AND (o_orderdate < '1995-01-01'::date))
              ->  Hash
                    ->  Nested Loop
                          ->  Hash Join
                                Hash Cond: (a91_nation.n_regionkey = a91_region.r_regionkey)
                                ->  Seq Scan on a91_nation
                                ->  Hash
                                      ->  Seq Scan on a91_region
                                            Filter: (r_name = 'r2'::text)
                          ->  Bitmap Heap Scan on a91_customer
                                Recheck Cond: (c_nationkey = a91_nation.n_nationkey)
                                ->  Bitmap Index Scan on a91_customer_nation
                                      Index Cond: (c_nationkey = a91_nation.n_nationkey)
-- EXPLAIN

> RESET ALL
-- RESET

