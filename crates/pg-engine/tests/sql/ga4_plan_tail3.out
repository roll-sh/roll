> CREATE TABLE ga4_t2 (a int, b int)
-- CREATE TABLE

> INSERT INTO ga4_t2 VALUES (1, NULL), (3, 3)
-- INSERT 0 2

> EXPLAIN (COSTS OFF) SELECT * FROM ga4_i8 LEFT JOIN ga4_t2 ON ga4_i8.q2 = ga4_t2.a WHERE ga4_t2 IS NOT NULL
QUERY PLAN:text
Merge Left Join
  Merge Cond: (ga4_i8.q2 = ga4_t2.a)
  Filter: (ga4_t2.* IS NOT NULL)
  ->  Sort
        Sort Key: ga4_i8.q2
        ->  Seq Scan on ga4_i8
  ->  Sort
        Sort Key: ga4_t2.a
        ->  Seq Scan on ga4_t2
-- EXPLAIN

> SELECT * FROM ga4_i8 LEFT JOIN ga4_t2 ON ga4_i8.q2 = ga4_t2.a WHERE ga4_t2 IS NULL ORDER BY 1, 2
q1:int8 | q2:int8 | a:int4 | b:int4
1 | 2 | NULL | NULL
123 | 456 | NULL | NULL
4567890123456789 | 123 | NULL | NULL
NULL | 2 | NULL | NULL
-- SELECT 4

> EXPLAIN (VERBOSE, COSTS OFF)
> SELECT (r).column2 FROM (SELECT r FROM (VALUES (1, 2), (3, 4)) r LIMIT 1) ss
QUERY PLAN:text
Subquery Scan on ss
  Output: (ss.r).column2
  ->  Limit
        Output: (ROW("*VALUES*".column1, "*VALUES*".column2))
        ->  Values Scan on "*VALUES*"
              Output: ROW("*VALUES*".column1, "*VALUES*".column2)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM pg_class WHERE relname ~ '^pg_class$' COLLATE "POSIX"
QUERY PLAN:text
Index Scan using pg_class_relname_nsp_index on pg_class
  Index Cond: (relname = 'pg_class'::text)
  Filter: (relname ~ '^pg_class$'::text COLLATE "POSIX")
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM pg_class WHERE relname LIKE 'pg\_class' COLLATE "POSIX"
QUERY PLAN:text
Index Scan using pg_class_relname_nsp_index on pg_class
  Index Cond: (relname = 'pg_class'::text)
  Filter: (relname ~~ 'pg\_class'::text COLLATE "POSIX")
-- EXPLAIN

> SELECT relname FROM pg_class WHERE relname LIKE 'pg\_class' COLLATE "POSIX"
relname:name
pg_class
-- SELECT 1

> CREATE TABLE ga4_tk (unique1 int, thousand int, tenthous int)
-- CREATE TABLE

> INSERT INTO ga4_tk SELECT i, i % 1000, i FROM generate_series(0, 9999) i
-- INSERT 0 10000

> CREATE INDEX ga4_tk_thous_tenthous ON ga4_tk (thousand, tenthous)
-- CREATE INDEX

> VACUUM ANALYZE ga4_tk
-- VACUUM

> SET enable_hashagg = off
-- SET

> SET enable_seqscan = off
-- SET

> SET enable_sort = off
-- SET

> EXPLAIN (VERBOSE, COSTS OFF)
> SELECT sum(tenthous) AS s1, sum(tenthous) + random() * 0 AS s2
>   FROM ga4_tk GROUP BY thousand ORDER BY thousand LIMIT 3
QUERY PLAN:text
Limit
  Output: (sum(tenthous)), (((sum(tenthous))::double precision + (random() * '0'::double precision))), thousand
  ->  GroupAggregate
        Output: sum(tenthous), ((sum(tenthous))::double precision + (random() * '0'::double precision)), thousand
        Group Key: ga4_tk.thousand
        ->  Index Only Scan using ga4_tk_thous_tenthous on public.ga4_tk
              Output: thousand, tenthous
-- EXPLAIN

> SELECT sum(tenthous) AS s1 FROM ga4_tk GROUP BY thousand ORDER BY thousand LIMIT 3
s1:int8
45000
45010
45020
