> CREATE TABLE items (id int PRIMARY KEY, name text, qty int DEFAULT 1, price numeric(10,2))
-- CREATE TABLE

> INSERT INTO items VALUES (1, 'apple', 5, 1.20), (2, 'pear', 3, 0.80), (3, 'fig', DEFAULT, 3.00)
-- INSERT 0 3

> INSERT INTO items (id, name) VALUES (4, 'kiwi') RETURNING id, qty, price
id:int4 | qty:int4 | price:numeric
4 | 1 | NULL
-- INSERT 0 1

> INSERT INTO items SELECT id + 10, name || '2', qty, price FROM items WHERE id < 3
-- INSERT 0 2

> INSERT INTO items (id, name, id) VALUES (5, 'x', 5)
ERROR 42701: column "id" specified more than once (at 30)

> INSERT INTO items (id, nosuch) VALUES (5, 1)
ERROR 42703: column "nosuch" of relation "items" does not exist (at 24)

> INSERT INTO items (id) VALUES (1, 2)
ERROR 42601: INSERT has more expressions than target columns (at 35)

> INSERT INTO items (id, name) VALUES (6)
ERROR 42601: INSERT has more target columns than expressions (at 24)

> INSERT INTO items VALUES ('x')
ERROR 22P02: invalid input syntax for type integer: "x" (at 27)

> UPDATE items SET qty = qty + 1 WHERE id = 1 RETURNING *
id:int4 | name:text | qty:int4 | price:numeric
1 | apple | 6 | 1.20
-- UPDATE 1

> UPDATE items SET qty = qty * 2, price = price + 1 WHERE name LIKE '%2'
-- UPDATE 2

> UPDATE items SET nosuch = 1
ERROR 42703: column "nosuch" of relation "items" does not exist (at 18)

> UPDATE items SET id = 2 WHERE id = 1
ERROR 23505: duplicate key value violates unique constraint "items_pkey"
DETAIL: Key (id)=(2) already exists.
OBJECTS: schema=public table=items constraint=items_pkey

> UPDATE items SET (qty, price) = (10, 9.99) WHERE id = 3
-- UPDATE 1

> UPDATE items SET (qty, price) = (SELECT 7, 7.77) WHERE id = 4
-- UPDATE 1

> UPDATE items i SET qty = s.q FROM (VALUES (2, 100)) s(id, q) WHERE i.id = s.id
-- UPDATE 1

> SELECT * FROM items ORDER BY id
id:int4 | name:text | qty:int4 | price:numeric
1 | apple | 6 | 1.20
2 | pear | 100 | 0.80
3 | fig | 10 | 9.99
4 | kiwi | 7 | 7.77
11 | apple2 | 10 | 2.20
12 | pear2 | 6 | 1.80
-- SELECT 6

> DELETE FROM items WHERE id > 10 RETURNING id, name
id:int4 | name:text
11 | apple2
12 | pear2
-- DELETE 2

> DELETE FROM items i USING (VALUES (4)) d(id) WHERE i.id = d.id
-- DELETE 1

> SELECT id FROM items ORDER BY id
id:int4
1
2
3
-- SELECT 3

> INSERT INTO items VALUES (1, 'dup') ON CONFLICT DO NOTHING
-- INSERT 0 0

> INSERT INTO items VALUES (1, 'dup') ON CONFLICT (id) DO UPDATE SET name = excluded.name || '!' RETURNING id, name
id:int4 | name:text
1 | dup!
-- INSERT 0 1

> INSERT INTO items VALUES (1, 'again') ON CONFLICT (id) DO UPDATE SET name = 'x' WHERE items.qty > 100
-- INSERT 0 0

> INSERT INTO items VALUES (9, 'new') ON CONFLICT (id) DO UPDATE SET name = 'x' RETURNING *
id:int4 | name:text | qty:int4 | price:numeric
9 | new | 1 | NULL
-- INSERT 0 1

> INSERT INTO items VALUES (1, 'z') ON CONFLICT (name) DO NOTHING
ERROR 42P10: there is no unique or exclusion constraint matching the ON CONFLICT specification

> INSERT INTO items VALUES (1, 'z'), (1, 'z2') ON CONFLICT (id) DO UPDATE SET name = excluded.name
ERROR 21000: ON CONFLICT DO UPDATE command cannot affect row a second time
HINT: Ensure that no rows proposed for insertion within the same command have duplicate constrained values.

> SELECT * FROM items ORDER BY id
id:int4 | name:text | qty:int4 | price:numeric
1 | dup! | 6 | 1.20
2 | pear | 100 | 0.80
3 | fig | 10 | 9.99
9 | new | 1 | NULL
-- SELECT 4

> WITH moved AS (DELETE FROM items WHERE id = 9 RETURNING *) SELECT count(*) FROM moved
count:int8
1
-- SELECT 1

