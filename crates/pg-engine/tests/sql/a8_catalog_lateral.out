> CREATE TABLE a8_tk (unique1 int, two int, twenty int)
-- CREATE TABLE

> INSERT INTO a8_tk SELECT i, i % 2, i % 20 FROM generate_series(0, 9999) i
-- INSERT 0 10000

> CREATE INDEX a8_tk_u1 ON a8_tk (unique1)
-- CREATE INDEX

> ANALYZE a8_tk
-- ANALYZE

> EXPLAIN (COSTS OFF)
> SELECT COUNT(*), AVG(t1.twenty) FROM a8_tk t1 LEFT JOIN
> LATERAL (SELECT t1.twenty AS c1, t2.unique1 AS c2, t2.two FROM a8_tk t2) s
> ON t1.two = s.two
> WHERE s.c1 = s.c2 AND t1.unique1 < 1000
QUERY PLAN:text
Aggregate
  ->  Nested Loop
        ->  Index Scan using a8_tk_u1 on a8_tk t1
              Index Cond: (unique1 < 1000)
        ->  Memoize
              Cache Key: t1.two, t1.twenty
              Cache Mode: binary
              ->  Seq Scan on a8_tk t2
                    Filter: ((t1.twenty = unique1) AND (t1.two = two))
-- EXPLAIN

> SELECT COUNT(*), AVG(t1.twenty) FROM a8_tk t1 LEFT JOIN
> LATERAL (SELECT t1.twenty AS c1, t2.unique1 AS c2, t2.two FROM a8_tk t2) s
> ON t1.two = s.two
> WHERE s.c1 = s.c2 AND t1.unique1 < 1000
count:int8 | avg:numeric
1000 | 9.5000000000000000
