-- CREATE TABLE

> CREATE TABLE m2 PARTITION OF m FOR VALUES IN (2)
-- CREATE TABLE

> CREATE FUNCTION tt() RETURNS trigger LANGUAGE plpgsql AS $$ DECLARE r record; BEGIN
>   IF TG_OP IN ('INSERT', 'UPDATE') THEN FOR r IN SELECT * FROM n ORDER BY k, v LOOP RAISE NOTICE '% new %', TG_TABLE_NAME, r; END LOOP; END IF;
>   IF TG_OP IN ('DELETE', 'UPDATE') THEN FOR r IN SELECT * FROM o ORDER BY k, v LOOP RAISE NOTICE '% old %', TG_TABLE_NAME, r; END LOOP; END IF;
>   RETURN NULL; END $$
-- CREATE FUNCTION

> CREATE TRIGGER ti AFTER INSERT ON m REFERENCING NEW TABLE AS n FOR EACH STATEMENT EXECUTE FUNCTION tt()
-- CREATE TRIGGER

> CREATE TRIGGER tu AFTER UPDATE ON m REFERENCING NEW TABLE AS n OLD TABLE AS o FOR EACH STATEMENT EXECUTE FUNCTION tt()
-- CREATE TRIGGER

> CREATE TRIGGER td AFTER DELETE ON m REFERENCING OLD TABLE AS o FOR EACH STATEMENT EXECUTE FUNCTION tt()
-- CREATE TRIGGER

