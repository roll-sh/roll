Append
  InitPlan 1
    ->  Result
  ->  Append
        ->  Seq Scan on a12_ab_a1_b1 a12_ab_6
              Filter: ((a = 1) AND (b = (InitPlan 1).col1))
        ->  Seq Scan on a12_ab_a1_b2 a12_ab_7
              Filter: ((a = 1) AND (b = (InitPlan 1).col1))
  ->  Seq Scan on a12_ab_a1_b1 a12_ab_1
        Filter: (b = (InitPlan 1).col1)
  ->  Seq Scan on a12_ab_a1_b2 a12_ab_2
        Filter: (b = (InitPlan 1).col1)
  ->  Seq Scan on a12_ab_a2_b1 a12_ab_3
        Filter: (b = (InitPlan 1).col1)
  ->  Seq Scan on a12_ab_a2_b2 a12_ab_4
        Filter: (b = (InitPlan 1).col1)
