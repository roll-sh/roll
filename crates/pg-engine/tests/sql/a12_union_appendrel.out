> CREATE TABLE a12_z (z int)
-- CREATE TABLE

> INSERT INTO a12_z VALUES (1), (5)
-- INSERT 0 2

> ANALYZE a12_z
-- ANALYZE

> EXPLAIN (VERBOSE, COSTS OFF)
> SELECT * FROM a12_z, (SELECT * FROM a12_xy WHERE x = 5 UNION ALL SELECT * FROM a12_ab) a12_ab
>   WHERE a12_ab.x = a12_z.z
QUERY PLAN:text
Hash Join
  Output: a12_z.z, a12_xy.x, a12_xy.y
  Hash Cond: (a12_xy.x = a12_z.z)
  ->  Append
        ->  Seq Scan on public.a12_xy
              Output: a12_xy.x, a12_xy.y
              Filter: (a12_xy.x = 5)
        ->  Seq Scan on public.a12_ab_a1_b1 a12_ab_1
              Output: a12_ab_1.a, a12_ab_1.b
        ->  Seq Scan on public.a12_ab_a1_b2 a12_ab_2
              Output: a12_ab_2.a, a12_ab_2.b
        ->  Seq Scan on public.a12_ab_a2_b1 a12_ab_3
              Output: a12_ab_3.a, a12_ab_3.b
        ->  Seq Scan on public.a12_ab_a2_b2 a12_ab_4
              Output: a12_ab_4.a, a12_ab_4.b
  ->  Hash
        Output: a12_z.z
        ->  Seq Scan on public.a12_z
              Output: a12_z.z
-- EXPLAIN

