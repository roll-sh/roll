> CREATE TABLE r9s (id int PRIMARY KEY, g int, v int, t text, x numeric)
-- CREATE TABLE

> INSERT INTO r9s SELECT i, 1, NULL, (ARRAY['a', 'a b'])[i % 8 + 1] || 1 FROM generate_series(1, 2885) i
-- INSERT 0 2885

> ANALYZE r9s
-- ANALYZE

> PREPARE r9p (text) AS SELECT id, g FROM r9s WHERE id = ANY ($1::int[]) ORDER BY id
-- PREPARE

> EXECUTE r9p('{50,100,NULL}')
id:int4 | g:int4
100 | 1
50 | 1
-- SELECT 2

> EXECUTE r9p('{2999,1}')
id:int4 | g:int4
1 | 1
-- SELECT 1

> EXECUTE r9p('{}')
id:int4 | g:int4
-- SELECT 0

> EXECUTE r9p('{1,2,3}')
id:int4 | g:int4
1 | 1
2 | 1
3 | 1
-- SELECT 3

> EXPLAIN EXECUTE r9p('{1,2,3}')
QUERY PLAN:text
Index Scan using r9s_pkey on r9s  (cost=0.28..21.19 rows=3 width=8)
  Index Cond: (id = ANY (('{1,2,3}'::cstring)::integer[]))
-- EXPLAIN

> EXECUTE r9p('{50,100,NULL}')
id:int4 | g:int4
100 | 1
50 | 1
-- SELECT 2

> EXECUTE r9p('{50,100,NULL}')
id:int4 | g:int4
100 | 1
50 | 1
-- SELECT 2

> SELECT generic_plans, custom_plans FROM pg_prepared_statements WHERE name = 'r9p'
generic_plans:int8 | custom_plans:int8
2 | 5
-- SELECT 1

> EXPLAIN EXECUTE r9p('{1,2,3}')
QUERY PLAN:text
Index Scan using r9s_pkey on r9s  (cost=0.28..21.29 rows=10 width=8)
  Index Cond: (id = ANY (($1)::integer[]))
-- EXPLAIN

> DEALLOCATE r9p
-- DEALLOCATE

> CREATE TABLE r10c (id int PRIMARY KEY, k int, d timestamptz, n date)
-- CREATE TABLE

> INSERT INTO r10c SELECT i, i % 7, timestamptz '2026-01-01 00:00:00+00' + i * interval '1 hour', date '2026-01-01' + i FROM generate_series(1, 500) i
-- INSERT 0 500

> ANALYZE r10c
-- ANALYZE

> PREPARE q1 (text, int) AS SELECT id FROM r10c WHERE k = ANY ($1::int[]) AND id < $2
-- PREPARE

> EXECUTE q1('{1,x}', 0)
ERROR 22P02: invalid input syntax for type integer: "x"

> EXECUTE q1('{1,2}', 9)
id:int4
1
2
8
-- SELECT 3

> EXPLAIN (COSTS OFF) EXECUTE q1('{1,2}', 9)
QUERY PLAN:text
Index Scan using r10c_pkey on r10c
  Index Cond: (id < 9)
  Filter: (k = ANY (('{1,2}'::cstring)::integer[]))
-- EXPLAIN

> SELECT generic_plans, custom_plans FROM pg_prepared_statements WHERE name = 'q1'
generic_plans:int8 | custom_plans:int8
0 | 2
-- SELECT 1

> PREPARE q2 (text) AS SELECT count(*) FROM r10c WHERE d > $1::timestamptz
-- PREPARE

> EXECUTE q2('2026-02-30')
ERROR 22008: date/time field value out of range: "2026-02-30"

> EXECUTE q2('2026-01-15')
count:int8
164
-- SELECT 1

> EXPLAIN EXECUTE q2('2026-01-15')
QUERY PLAN:text
Aggregate  (cost=13.16..13.17 rows=1 width=8)
  ->  Seq Scan on r10c  (cost=0.00..12.75 rows=164 width=0)
        Filter: (d > ('2026-01-15'::cstring)::timestamp with time zone)
-- EXPLAIN

> SELECT generic_plans, custom_plans FROM pg_prepared_statements WHERE name = 'q2'
generic_plans:int8 | custom_plans:int8
0 | 2
-- SELECT 1

> PREPARE q3 (text) AS SELECT relname FROM pg_class WHERE oid = $1::regclass
-- PREPARE

> EXECUTE q3('r10nope')
ERROR 42P01: relation "r10nope" does not exist

> EXECUTE q3('r10c')
relname:name
r10c
-- SELECT 1

> PREPARE q4 (text, text) AS SELECT id FROM r10c WHERE n < $1::date AND d > $2::timestamptz ORDER BY id LIMIT 3
-- PREPARE

> EXECUTE q4('2026-01-05', 'x')
ERROR 22007: invalid input syntax for type timestamp with time zone: "x"

> EXECUTE q4('y', '2026-01-01')
ERROR 22007: invalid input syntax for type date: "y"

> EXECUTE q4('y', 'x')
ERROR 22007: invalid input syntax for type date: "y"

> EXECUTE q4('2026-01-05', '2026-01-01')
id:int4
1
2
3
-- SELECT 3

> EXPLAIN (COSTS OFF) EXECUTE q4('2026-01-05', '2026-01-01')
QUERY PLAN:text
Limit
  ->  Sort
        Sort Key: id
        ->  Seq Scan on r10c
              Filter: ((n < ('2026-01-05'::cstring)::date) AND (d > ('2026-01-01'::cstring)::timestamp with time zone))
-- EXPLAIN

> PREPARE q5 (text) AS SELECT $1::date AS d FROM r10c WHERE id = 1
-- PREPARE

> EXPLAIN (COSTS OFF, VERBOSE) EXECUTE q5('2026-01-03')
QUERY PLAN:text
Index Only Scan using r10c_pkey on public.r10c
  Output: ('2026-01-03'::cstring)::date
  Index Cond: (r10c.id = 1)
-- EXPLAIN

> EXECUTE q5('2026-01-03')
d:date
2026-01-03
-- SELECT 1

> EXECUTE q5('nope')
ERROR 22007: invalid input syntax for type date: "nope"

> DEALLOCATE ALL
-- DEALLOCATE ALL

> DROP TABLE r9s, r10c
-- DROP TABLE

