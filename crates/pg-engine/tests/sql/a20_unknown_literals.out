> EXPLAIN (VERBOSE, COSTS OFF) SELECT * FROM (SELECT 'x' b OFFSET 0) s
QUERY PLAN:text
Result
  Output: 'x'::text
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF) SELECT b || 'y' FROM (SELECT 'x' b OFFSET 0) s
QUERY PLAN:text
Subquery Scan on s
  Output: (s.b || 'y'::text)
  ->  Result
        Output: 'x'::text
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF) SELECT s.k, q.c FROM a20_s s, (SELECT 'c' c OFFSET 0) q
QUERY PLAN:text
Nested Loop
  Output: s.k, ('c'::text)
  ->  Result
        Output: 'c'::text
  ->  Seq Scan on public.a20_s s
        Output: s.k, s.v
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF)
> WITH c AS MATERIALIZED (SELECT 1 a, 'x' b) SELECT * FROM c
QUERY PLAN:text
CTE Scan on c
  Output: c.a, c.b
  CTE c
    ->  Result
          Output: 1, 'x'::text
-- EXPLAIN

> WITH c AS (SELECT 1 a, 'x' b) SELECT pg_typeof(b) FROM c
pg_typeof:regtype
text
-- SELECT 1

> EXPLAIN (VERBOSE, COSTS OFF) SELECT 'a' UNION SELECT 'b'
QUERY PLAN:text
Unique
  Output: ('a'::text)
  ->  Sort
        Output: ('a'::text)
        Sort Key: ('a'::text)
        ->  Append
              ->  Result
                    Output: 'a'::text
              ->  Result
                    Output: 'b'::text
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF) SELECT 'a', 1 UNION ALL SELECT 'b', 2
QUERY PLAN:text
Append
  ->  Result
        Output: 'a'::text, 1
  ->  Result
        Output: 'b'::text, 2
-- EXPLAIN

