> drop table if exists nk, tx
NOTICE 00000: table "nk" does not exist, skipping
NOTICE 00000: table "tx" does not exist, skipping
-- DROP TABLE

> create table nk(s name, v int)
-- CREATE TABLE

> create table tx(i text, w int)
-- CREATE TABLE

> insert into nk select 'A' || g, g from generate_series(1, 50) g
-- INSERT 0 50

> insert into tx select 'A' || g, g from generate_series(3, 60) g
-- INSERT 0 58

> analyze nk
-- ANALYZE

> analyze tx
-- ANALYZE

> set enable_hashjoin = off
-- SET

> set enable_nestloop = off
-- SET

> explain (costs off) select * from nk join tx on nk.s = tx.i
QUERY PLAN:text
Merge Join
  Merge Cond: (nk.s = (tx.i)::text)
  ->  Sort
        Sort Key: nk.s
        ->  Seq Scan on nk
  ->  Sort
        Sort Key: tx.i COLLATE "C"
        ->  Seq Scan on tx
-- EXPLAIN

> explain (costs off, verbose) select * from nk join tx on tx.i = nk.s
QUERY PLAN:text
Merge Join
  Output: nk.s, nk.v, tx.i, tx.w
  Merge Cond: (nk.s = (tx.i)::text)
  ->  Sort
        Output: nk.s, nk.v
        Sort Key: nk.s
        ->  Seq Scan on public.nk
              Output: nk.s, nk.v
  ->  Sort
        Output: tx.i, tx.w
        Sort Key: tx.i COLLATE "C"
        ->  Seq Scan on public.tx
              Output: tx.i, tx.w
-- EXPLAIN

> explain (costs off) select * from nk left join tx on nk.s = tx.i
QUERY PLAN:text
Merge Left Join
  Merge Cond: (nk.s = tx.i)
  ->  Sort
        Sort Key: nk.s
        ->  Seq Scan on nk
  ->  Sort
        Sort Key: tx.i COLLATE "C"
        ->  Seq Scan on tx
-- EXPLAIN

> explain (costs off) select * from tx left join nk on nk.s = tx.i
QUERY PLAN:text
Merge Left Join
  Merge Cond: (tx.i = nk.s)
  ->  Sort
        Sort Key: tx.i COLLATE "C"
        ->  Seq Scan on tx
  ->  Sort
        Sort Key: nk.s
        ->  Seq Scan on nk
-- EXPLAIN

> explain (costs off) select * from nk full join tx on nk.s = tx.i
QUERY PLAN:text
Merge Full Join
  Merge Cond: (nk.s = tx.i)
  ->  Sort
        Sort Key: nk.s
        ->  Seq Scan on nk
  ->  Sort
        Sort Key: tx.i COLLATE "C"
        ->  Seq Scan on tx
-- EXPLAIN

> explain (costs off) select * from nk where s in (select i from tx)
QUERY PLAN:text
Merge Semi Join
  Merge Cond: (nk.s = (tx.i)::text)
  ->  Sort
        Sort Key: nk.s
        ->  Seq Scan on nk
  ->  Sort
        Sort Key: tx.i COLLATE "C"
        ->  Seq Scan on tx
-- EXPLAIN

> explain (costs off) select * from nk join tx on nk.s = tx.i order by tx.i
QUERY PLAN:text
Sort
  Sort Key: tx.i
  ->  Merge Join
        Merge Cond: (nk.s = (tx.i)::text)
        ->  Sort
              Sort Key: nk.s
              ->  Seq Scan on nk
        ->  Sort
              Sort Key: tx.i COLLATE "C"
              ->  Seq Scan on tx
-- EXPLAIN

> explain (costs off) select * from nk join tx on nk.s = tx.i order by nk.s
QUERY PLAN:text
Merge Join
  Merge Cond: (nk.s = (tx.i)::text)
  ->  Sort
        Sort Key: nk.s
        ->  Seq Scan on nk
  ->  Sort
        Sort Key: tx.i COLLATE "C"
        ->  Seq Scan on tx
-- EXPLAIN

