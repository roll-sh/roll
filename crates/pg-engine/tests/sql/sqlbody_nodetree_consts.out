-- SELECT 85

> DO $$ DECLARE r record; BEGIN FOR r IN SELECT oid::regprocedure p FROM pg_proc WHERE proname LIKE 'sbk\_%' LOOP EXECUTE 'DROP FUNCTION ' || r.p; END LOOP; END $$
-- DO

> DROP TABLE sbk_t
-- DROP TABLE

> DROP TYPE sbk_ty
-- DROP TYPE

> DROP DOMAIN sbk_dom
-- DROP DOMAIN

