> set jit = off
-- SET

> create table pi_l (id int, t text, v varchar(20), n name, b char(8))
-- CREATE TABLE

> insert into pi_l select g, 'word' || (g % 500) || 'x', 'v' || (g % 300), 'nm' || g, 'b' || (g % 50) from generate_series(1, 20000) g
-- INSERT 0 20000

> create index pi_l_t on pi_l (t)
-- CREATE INDEX

> create index pi_l_v on pi_l (v)
-- CREATE INDEX

> create index pi_l_n on pi_l (n)
-- CREATE INDEX

> create index pi_l_b on pi_l (b)
-- CREATE INDEX

> analyze pi_l
-- ANALYZE

> explain select * from pi_l where t like 'word1%'
QUERY PLAN:text
Bitmap Heap Scan on pi_l  (cost=66.67..431.26 rows=4445 width=89)
  Filter: (t ~~ 'word1%'::text)
  ->  Bitmap Index Scan on pi_l_t  (cost=0.00..65.56 rows=4527 width=0)
        Index Cond: ((t >= 'word1'::text) AND (t < 'word2'::text))
-- EXPLAIN

