        Index Cond: (u1 <= 20)
  ->  Materialize  (cost=0.00..18.65 rows=30 width=4)
        ->  Seq Scan on a288t a288t_1  (cost=0.00..18.50 rows=30 width=4)
              Filter: (h < 3)
