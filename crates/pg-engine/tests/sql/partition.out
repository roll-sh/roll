> CREATE TABLE m (id int, region text, amount numeric) PARTITION BY LIST (region)
-- CREATE TABLE

> CREATE TABLE m_eu PARTITION OF m FOR VALUES IN ('eu', 'uk')
-- CREATE TABLE

> CREATE TABLE m_us PARTITION OF m FOR VALUES IN ('us')
-- CREATE TABLE

> CREATE TABLE m_def PARTITION OF m DEFAULT
-- CREATE TABLE

> INSERT INTO m VALUES (1, 'eu', 10), (2, 'us', 20), (3, 'uk', 30), (4, 'jp', 40), (5, NULL, 50)
-- INSERT 0 5

> SELECT tableoid::regclass, * FROM m ORDER BY id
tableoid:regclass | id:int4 | region:text | amount:numeric
m_eu | 1 | eu | 10
m_us | 2 | us | 20
m_eu | 3 | uk | 30
m_def | 4 | jp | 40
m_def | 5 | NULL | 50
-- SELECT 5

> SELECT * FROM m_eu ORDER BY id
id:int4 | region:text | amount:numeric
1 | eu | 10
3 | uk | 30
-- SELECT 2

> EXPLAIN (COSTS OFF) SELECT * FROM m WHERE region = 'us'
QUERY PLAN:text
Seq Scan on m_us m
  Filter: (region = 'us'::text)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM m WHERE region IN ('eu', 'jp')
QUERY PLAN:text
Append
  ->  Seq Scan on m_eu m_1
        Filter: (region = ANY ('{eu,jp}'::text[]))
  ->  Seq Scan on m_def m_2
        Filter: (region = ANY ('{eu,jp}'::text[]))
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM m
QUERY PLAN:text
Append
  ->  Seq Scan on m_eu m_1
  ->  Seq Scan on m_us m_2
  ->  Seq Scan on m_def m_3
-- EXPLAIN

> UPDATE m SET region = 'us' WHERE id = 1
-- UPDATE 1

> SELECT tableoid::regclass, * FROM m ORDER BY id
tableoid:regclass | id:int4 | region:text | amount:numeric
m_us | 1 | us | 10
m_us | 2 | us | 20
m_eu | 3 | uk | 30
m_def | 4 | jp | 40
m_def | 5 | NULL | 50
-- SELECT 5

> INSERT INTO m_us VALUES (9, 'eu', 0)
ERROR 23514: new row for relation "m_us" violates partition constraint
DETAIL: Failing row contains (9, eu, 0).
OBJECTS: schema=public table=m_us

> CREATE TABLE r (a int, b int) PARTITION BY RANGE (a)
-- CREATE TABLE

> CREATE TABLE r1 PARTITION OF r FOR VALUES FROM (MINVALUE) TO (10)
-- CREATE TABLE

> CREATE TABLE r2 PARTITION OF r FOR VALUES FROM (10) TO (20)
-- CREATE TABLE

> CREATE TABLE r3 PARTITION OF r FOR VALUES FROM (15) TO (30)
ERROR 42P17: partition "r3" would overlap partition "r2" (at 49)

> INSERT INTO r VALUES (5, 1), (10, 2), (19, 3)
-- INSERT 0 3

> INSERT INTO r VALUES (25, 4)
ERROR 23514: no partition of relation "r" found for row
DETAIL: Partition key of the failing row contains (a) = (25).
OBJECTS: schema=public table=r

> EXPLAIN (COSTS OFF) SELECT * FROM r WHERE a < 10
QUERY PLAN:text
Seq Scan on r1 r
  Filter: (a < 10)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM r WHERE a = 12
QUERY PLAN:text
Seq Scan on r2 r
  Filter: (a = 12)
-- EXPLAIN

> CREATE TABLE h (k int, v text) PARTITION BY HASH (k)
-- CREATE TABLE

> CREATE TABLE h0 PARTITION OF h FOR VALUES WITH (MODULUS 2, REMAINDER 0)
-- CREATE TABLE

> CREATE TABLE h1 PARTITION OF h FOR VALUES WITH (MODULUS 2, REMAINDER 1)
-- CREATE TABLE

> INSERT INTO h SELECT g, 'v' || g FROM generate_series(1, 10) g
-- INSERT 0 10

> SELECT tableoid::regclass, k FROM h ORDER BY k
tableoid:regclass | k:int4
h0 | 1
h0 | 2
h1 | 3
h1 | 4
h1 | 5
h1 | 6
h1 | 7
h1 | 8
h1 | 9
h1 | 10
-- SELECT 10

> EXPLAIN (COSTS OFF) SELECT * FROM h WHERE k = 3
QUERY PLAN:text
Seq Scan on h1 h
  Filter: (k = 3)
-- EXPLAIN

> SELECT relname, relkind, relispartition, pg_get_expr(relpartbound, oid) FROM pg_class WHERE relname IN ('m','m_eu','m_us','m_def','r','r1','r2','h','h0','h1') ORDER BY relname
relname:name | relkind:char | relispartition:bool | pg_get_expr:text
h | p | f | NULL
h0 | r | t | FOR VALUES WITH (modulus 2, remainder 0)
h1 | r | t | FOR VALUES WITH (modulus 2, remainder 1)
m | p | f | NULL
m_def | r | t | DEFAULT
m_eu | r | t | FOR VALUES IN ('eu', 'uk')
m_us | r | t | FOR VALUES IN ('us')
r | p | f | NULL
r1 | r | t | FOR VALUES FROM (MINVALUE) TO (10)
r2 | r | t | FOR VALUES FROM (10) TO (20)
