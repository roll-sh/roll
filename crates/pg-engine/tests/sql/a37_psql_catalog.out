-- CREATE TABLE

> CREATE RULE a37_r3 AS ON INSERT TO a37_t3
>   WHERE (EXISTS (SELECT 1 FROM a37_t3 WHERE a37_t3.id3a = new.id3a))
>   DO INSTEAD UPDATE a37_t3 SET data = new.data WHERE a37_t3.id3a = new.id3a
-- CREATE RULE

> SELECT rulename, pg_get_ruledef(oid) FROM pg_rewrite WHERE rulename LIKE 'a37_r%' ORDER BY 1
rulename:name | pg_get_ruledef:text
a37_r1 | CREATE RULE a37_r1 AS
    ON INSERT TO public.a37_ok DO INSTEAD  UPDATE a37_slv SET sl_avail = (a37_slv.sl_avail + new.ok_quant)
  WHERE (a37_slv.sl_name = new.ok_name);
a37_r3 | CREATE RULE a37_r3 AS
    ON INSERT TO public.a37_t3
   WHERE (EXISTS ( SELECT 1
           FROM a37_t3 a37_t3_1
          WHERE (a37_t3_1.id3a = new.id3a))) DO INSTEAD  UPDATE a37_t3 SET data = new.data
  WHERE (a37_t3.id3a = new.id3a);
-- SELECT 2

> SELECT rulename, pg_get_ruledef(oid, true) FROM pg_rewrite WHERE rulename LIKE 'a37_r%' ORDER BY 1
rulename:name | pg_get_ruledef:text
a37_r1 | CREATE RULE a37_r1 AS
    ON INSERT TO a37_ok DO INSTEAD  UPDATE a37_slv SET sl_avail = a37_slv.sl_avail + new.ok_quant
  WHERE a37_slv.sl_name = new.ok_name;
a37_r3 | CREATE RULE a37_r3 AS
    ON INSERT TO a37_t3
   WHERE (EXISTS ( SELECT 1
           FROM a37_t3 a37_t3_1
          WHERE a37_t3_1.id3a = new.id3a)) DO INSTEAD  UPDATE a37_t3 SET data = new.data
  WHERE a37_t3.id3a = new.id3a;
