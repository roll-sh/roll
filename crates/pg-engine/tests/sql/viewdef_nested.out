> CREATE TABLE vn_a (id int, name text, v numeric)
-- CREATE TABLE

> CREATE TABLE vn_b (id int, a_id int, w int)
-- CREATE TABLE

> CREATE VIEW vn_values_from AS SELECT x FROM (VALUES (1), (2)) s(x)
-- CREATE VIEW

> CREATE VIEW vn_union AS SELECT id FROM vn_a UNION SELECT a_id FROM vn_b
-- CREATE VIEW

> CREATE VIEW vn_union_all AS SELECT id, name FROM vn_a UNION ALL SELECT id, 'b' FROM vn_b ORDER BY 1 LIMIT 5
-- CREATE VIEW

> CREATE VIEW vn_with AS WITH c AS (SELECT id FROM vn_a WHERE v > 1) SELECT * FROM c
-- CREATE VIEW

> CREATE VIEW vn_window AS SELECT id, sum(w) OVER (PARTITION BY a_id ORDER BY id) FROM vn_b
-- CREATE VIEW

> CREATE VIEW vn_distinct_on AS SELECT DISTINCT ON (a_id) a_id, w FROM vn_b ORDER BY a_id, w DESC
-- CREATE VIEW

> CREATE VIEW vn_lateral AS SELECT a.id, s.cnt FROM vn_a a, LATERAL (SELECT count(*) AS cnt FROM vn_b b WHERE b.a_id = a.id) s
-- CREATE VIEW

> CREATE VIEW vn_from_sub AS SELECT * FROM (SELECT id, name FROM vn_a WHERE id > 3) sub WHERE name LIKE 'x%'
-- CREATE VIEW

> CREATE VIEW vn_setops AS SELECT id FROM vn_a INTERSECT SELECT a_id FROM vn_b EXCEPT SELECT 5
-- CREATE VIEW

> CREATE VIEW vn_values AS VALUES (1, 'a'), (2, 'b')
-- CREATE VIEW

> CREATE VIEW vn_values_named (n, label) AS VALUES (1, 'a'), (2, 'b')
-- CREATE VIEW

> CREATE VIEW vn_named_window AS SELECT id, row_number() OVER w, rank() OVER w FROM vn_a WINDOW w AS (ORDER BY v)
-- CREATE VIEW

> CREATE VIEW vn_joins AS SELECT a.id, b.w FROM vn_a a JOIN vn_b b ON b.a_id = a.id LEFT JOIN vn_b c ON c.id = a.id
-- CREATE VIEW

> CREATE VIEW vn_sublinks AS SELECT id FROM vn_a WHERE id IN (SELECT a_id FROM vn_b) AND EXISTS (SELECT 1 FROM vn_b WHERE w = vn_a.id)
-- CREATE VIEW

> CREATE VIEW vn_rollup AS SELECT a_id, count(*) FROM vn_b GROUP BY ROLLUP (a_id, w)
-- CREATE VIEW

> CREATE VIEW vn_recursive AS WITH RECURSIVE t(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM t WHERE n < 5) SELECT n FROM t
-- CREATE VIEW

> CREATE VIEW vn_lock AS SELECT * FROM vn_a FOR UPDATE
-- CREATE VIEW

> CREATE VIEW vn_lock_of AS SELECT a.id FROM vn_a a, vn_b b FOR SHARE OF b NOWAIT
-- CREATE VIEW

> CREATE VIEW vn_scalar AS SELECT id, (SELECT max(w) FROM vn_b b WHERE b.a_id = a.id) AS top, ARRAY(SELECT w FROM vn_b) AS ws FROM vn_a a
-- CREATE VIEW

> CREATE VIEW vn_any_all AS SELECT id FROM vn_a WHERE id > ANY (SELECT w FROM vn_b) OR id <= ALL (SELECT a_id FROM vn_b) OR (id, v) IN (SELECT id, w FROM vn_b)
-- CREATE VIEW

> CREATE VIEW vn_deep AS SELECT id FROM vn_a a WHERE EXISTS (SELECT 1 FROM vn_b b WHERE b.a_id = a.id AND EXISTS (SELECT 1 FROM vn_a c WHERE c.id = b.w AND c.v > a.v))
-- CREATE VIEW

> CREATE VIEW vn_same_name AS SELECT id FROM vn_a WHERE id IN (SELECT id FROM vn_a WHERE v > 0)
-- CREATE VIEW

> CREATE VIEW vn_using AS SELECT id, a.name, b.w FROM vn_a a JOIN vn_b b USING (id)
-- CREATE VIEW

> CREATE VIEW vn_anon AS SELECT * FROM (SELECT id FROM vn_a), (SELECT w FROM vn_b)
-- CREATE VIEW

> CREATE VIEW vn_materialized AS WITH m AS MATERIALIZED (SELECT * FROM vn_a), n AS NOT MATERIALIZED (SELECT id FROM m) SELECT * FROM n
-- CREATE VIEW

> CREATE VIEW vn_frames AS SELECT id, sum(v) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND CURRENT ROW), avg(v) OVER (ORDER BY id RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE TIES), count(*) OVER (w ORDER BY v) FROM vn_a WINDOW w AS (PARTITION BY name)
-- CREATE VIEW

> CREATE VIEW vn_sets AS SELECT a_id, w, count(*) FROM vn_b GROUP BY GROUPING SETS ((a_id), (a_id, w), ()), CUBE (w)
-- CREATE VIEW

> CREATE VIEW vn_ties AS SELECT id FROM vn_a ORDER BY id FETCH FIRST 3 ROWS WITH TIES
-- CREATE VIEW

> CREATE VIEW vn_limit_all AS SELECT id FROM vn_a ORDER BY id DESC NULLS LAST LIMIT ALL OFFSET 2
-- CREATE VIEW

> CREATE VIEW vn_union_nested AS SELECT id FROM vn_a UNION (SELECT a_id FROM vn_b INTERSECT SELECT w FROM vn_b) UNION ALL SELECT 7
-- CREATE VIEW

> CREATE VIEW vn_union_types AS SELECT name FROM vn_a UNION SELECT 'z'
-- CREATE VIEW

> CREATE VIEW vn_union_paren AS (SELECT id FROM vn_a ORDER BY id LIMIT 1) UNION SELECT w FROM vn_b
-- CREATE VIEW

> CREATE VIEW vn_values_order AS VALUES (3), (1) ORDER BY 1 LIMIT 1
-- CREATE VIEW

> CREATE VIEW vn_alias_same AS SELECT vn_a.id FROM vn_a vn_a
-- CREATE VIEW

> CREATE VIEW vn_cte_union AS WITH u AS (SELECT id FROM vn_a UNION SELECT w FROM vn_b) SELECT u.id, (SELECT count(*) FROM u u2 WHERE u2.id < u.id) AS below FROM u
-- CREATE VIEW

> CREATE VIEW vn_group_dup AS SELECT a_id FROM vn_b GROUP BY a_id, a_id HAVING sum(w) > 2
-- CREATE VIEW

> CREATE VIEW vn_order_alias AS SELECT id AS w, w AS id FROM vn_b ORDER BY id
-- CREATE VIEW

> SELECT c.relname, pg_get_viewdef(c.oid) FROM pg_class c WHERE c.relkind = 'v' AND c.relname LIKE 'vn\_%' ORDER BY 1
relname:name | pg_get_viewdef:text
vn_alias_same |  SELECT id
   FROM vn_a vn_a;
vn_anon |  SELECT unnamed_subquery.id,
    unnamed_subquery_1.w
   FROM ( SELECT vn_a.id
           FROM vn_a) unnamed_subquery,
    ( SELECT vn_b.w
           FROM vn_b) unnamed_subquery_1;
vn_any_all |  SELECT id
   FROM vn_a
  WHERE ((id > ANY ( SELECT vn_b.w
           FROM vn_b)) OR (id <= ALL ( SELECT vn_b.a_id
           FROM vn_b)) OR ((id, v) IN ( SELECT vn_b.id,
            vn_b.w
           FROM vn_b)));
vn_cte_union |  WITH u AS (
         SELECT vn_a.id
           FROM vn_a
        UNION
         SELECT vn_b.w
           FROM vn_b
        )
 SELECT id,
    ( SELECT count(*) AS count
           FROM u u2
          WHERE (u2.id < u.id)) AS below
   FROM u;
vn_deep |  SELECT id
   FROM vn_a a
  WHERE (EXISTS ( SELECT 1
           FROM vn_b b
          WHERE ((b.a_id = a.id) AND (EXISTS ( SELECT 1
                   FROM vn_a c
                  WHERE ((c.id = b.w) AND (c.v > a.v)))))));
vn_distinct_on |  SELECT DISTINCT ON (a_id) a_id,
    w
   FROM vn_b
  ORDER BY a_id, w DESC;
vn_frames |  SELECT id,
    sum(v) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS sum,
    avg(v) OVER (ORDER BY id RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE TIES) AS avg,
    count(*) OVER (w ORDER BY v) AS count
   FROM vn_a
  WINDOW w AS (PARTITION BY name);
vn_from_sub |  SELECT id,
    name
   FROM ( SELECT vn_a.id,
            vn_a.name
           FROM vn_a
          WHERE (vn_a.id > 3)) sub
  WHERE (name ~~ 'x%'::text);
vn_group_dup |  SELECT a_id
   FROM vn_b
  GROUP BY a_id
 HAVING (sum(w) > 2);
vn_joins |  SELECT a.id,
    b.w
   FROM ((vn_a a
     JOIN vn_b b ON ((b.a_id = a.id)))
     LEFT JOIN vn_b c ON ((c.id = a.id)));
vn_lateral |  SELECT a.id,
    s.cnt
   FROM vn_a a,
    LATERAL ( SELECT count(*) AS cnt
           FROM vn_b b
          WHERE (b.a_id = a.id)) s;
vn_limit_all |  SELECT id
   FROM vn_a
  ORDER BY id DESC NULLS LAST
 OFFSET 2
 LIMIT ALL;
vn_lock |  SELECT id,
    name,
    v
   FROM vn_a
 FOR UPDATE OF vn_a;
vn_lock_of |  SELECT a.id
   FROM vn_a a,
    vn_b b
 FOR SHARE OF b NOWAIT;
vn_materialized |  WITH m AS MATERIALIZED (
         SELECT vn_a.id,
            vn_a.name,
            vn_a.v
           FROM vn_a
        ), n AS NOT MATERIALIZED (
         SELECT m.id
           FROM m
        )
 SELECT id
   FROM n;
vn_named_window |  SELECT id,
    row_number() OVER w AS row_number,
    rank() OVER w AS rank
   FROM vn_a
  WINDOW w AS (ORDER BY v);
vn_order_alias |  SELECT id AS w,
    w AS id
   FROM vn_b
  ORDER BY vn_b.w;
vn_recursive |  WITH RECURSIVE t(n) AS (
         SELECT 1 AS "?column?"
        UNION ALL
         SELECT (t_1.n + 1)
           FROM t t_1
          WHERE (t_1.n < 5)
        )
 SELECT n
   FROM t;
vn_rollup |  SELECT a_id,
    count(*) AS count
   FROM vn_b
  GROUP BY ROLLUP(a_id, w);
vn_same_name |  SELECT id
   FROM vn_a
  WHERE (id IN ( SELECT vn_a_1.id
           FROM vn_a vn_a_1
          WHERE (vn_a_1.v > (0)::numeric)));
vn_scalar |  SELECT id,
    ( SELECT max(b.w) AS max
           FROM vn_b b
          WHERE (b.a_id = a.id)) AS top,
    ARRAY( SELECT vn_b.w
           FROM vn_b) AS ws
   FROM vn_a a;
vn_setops | (
         SELECT vn_a.id
           FROM vn_a
        INTERSECT
         SELECT vn_b.a_id AS id
           FROM vn_b
) EXCEPT
 SELECT 5 AS id;
vn_sets |  SELECT a_id,
    w,
    count(*) AS count
   FROM vn_b
  GROUP BY GROUPING SETS ((a_id), (a_id, w), ()), CUBE(w);
vn_sublinks |  SELECT id
   FROM vn_a
  WHERE ((id IN ( SELECT vn_b.a_id
           FROM vn_b)) AND (EXISTS ( SELECT 1
           FROM vn_b
          WHERE (vn_b.w = vn_a.id))));
vn_ties |  SELECT id
   FROM vn_a
  ORDER BY id
 FETCH FIRST (3) ROWS WITH TIES;
vn_union |  SELECT vn_a.id
   FROM vn_a
UNION
 SELECT vn_b.a_id AS id
   FROM vn_b;
vn_union_all |  SELECT vn_a.id,
    vn_a.name
   FROM vn_a
UNION ALL
 SELECT vn_b.id,
    'b'::text AS name
   FROM vn_b
  ORDER BY 1
 LIMIT 5;
vn_union_nested | (
         SELECT vn_a.id
           FROM vn_a
        UNION (
                 SELECT vn_b.a_id AS id
                   FROM vn_b
                INTERSECT
                 SELECT vn_b.w AS id
                   FROM vn_b
        )
) UNION ALL
 SELECT 7 AS id;
vn_union_paren | ( SELECT vn_a.id
   FROM vn_a
  ORDER BY vn_a.id
 LIMIT 1)
UNION
 SELECT vn_b.w AS id
   FROM vn_b;
vn_union_types |  SELECT vn_a.name
   FROM vn_a
UNION
 SELECT 'z'::text AS name;
vn_using |  SELECT a.id,
    a.name,
    b.w
   FROM (vn_a a
     JOIN vn_b b USING (id));
vn_values |  VALUES (1,'a'::text), (2,'b'::text);
vn_values_from |  SELECT x
   FROM ( VALUES (1), (2)) s(x);
vn_values_named |  SELECT column1 AS n,
    column2 AS label
   FROM (VALUES (1,'a'::text), (2,'b'::text)) "*VALUES*";
vn_values_order |  VALUES (3), (1)
  ORDER BY column1
 LIMIT 1;
vn_window |  SELECT id,
    sum(w) OVER (PARTITION BY a_id ORDER BY id) AS sum
   FROM vn_b;
vn_with |  WITH c AS (
         SELECT vn_a.id
           FROM vn_a
          WHERE (vn_a.v > (1)::numeric)
        )
 SELECT id
   FROM c;
-- SELECT 37

> SELECT c.relname, pg_get_viewdef(c.oid, true) FROM pg_class c WHERE c.relkind = 'v' AND c.relname IN ('vn_joins', 'vn_sublinks', 'vn_setops', 'vn_deep', 'vn_scalar') ORDER BY 1
relname:name | pg_get_viewdef:text
vn_deep |  SELECT id
   FROM vn_a a
  WHERE (EXISTS ( SELECT 1
           FROM vn_b b
          WHERE b.a_id = a.id AND (EXISTS ( SELECT 1
                   FROM vn_a c
                  WHERE c.id = b.w AND c.v > a.v))));
vn_joins |  SELECT a.id,
    b.w
   FROM vn_a a
     JOIN vn_b b ON b.a_id = a.id
     LEFT JOIN vn_b c ON c.id = a.id;
vn_scalar |  SELECT id,
    ( SELECT max(b.w) AS max
           FROM vn_b b
          WHERE b.a_id = a.id) AS top,
    ARRAY( SELECT vn_b.w
           FROM vn_b) AS ws
   FROM vn_a a;
vn_setops | (
         SELECT vn_a.id
           FROM vn_a
        INTERSECT
         SELECT vn_b.a_id AS id
           FROM vn_b
) EXCEPT
 SELECT 5 AS id;
vn_sublinks |  SELECT id
   FROM vn_a
  WHERE (id IN ( SELECT vn_b.a_id
           FROM vn_b)) AND (EXISTS ( SELECT 1
           FROM vn_b
          WHERE vn_b.w = vn_a.id));
-- SELECT 5

> SELECT pg_get_viewdef('vn_union_all'::regclass, 30), pg_get_viewdef('vn_lateral'::regclass, 80)
pg_get_viewdef:text | pg_get_viewdef:text
 SELECT vn_a.id, vn_a.name
   FROM vn_a
UNION ALL
 SELECT vn_b.id,
    'b'::text AS name
   FROM vn_b
  ORDER BY 1
 LIMIT 5; |  SELECT a.id, s.cnt
   FROM vn_a a,
    LATERAL ( SELECT count(*) AS cnt
           FROM vn_b b
          WHERE b.a_id = a.id) s;
-- SELECT 1

> DROP VIEW vn_values_from, vn_union, vn_union_all, vn_with, vn_window, vn_distinct_on, vn_lateral, vn_from_sub, vn_setops, vn_values, vn_values_named, vn_named_window, vn_joins, vn_sublinks, vn_rollup, vn_recursive, vn_lock, vn_lock_of, vn_scalar, vn_any_all, vn_deep, vn_same_name, vn_using, vn_anon, vn_materialized, vn_frames, vn_sets, vn_ties, vn_limit_all, vn_union_nested, vn_union_types, vn_union_paren, vn_values_order, vn_alias_same, vn_cte_union, vn_group_dup, vn_order_alias
