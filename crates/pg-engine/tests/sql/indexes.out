> CREATE TABLE nulls (a int, b int)
-- CREATE TABLE

> CREATE UNIQUE INDEX ON nulls (a)
-- CREATE INDEX

> INSERT INTO nulls VALUES (NULL, 1), (NULL, 2)
-- INSERT 0 2

> CREATE UNIQUE INDEX nn ON nulls (b) NULLS NOT DISTINCT
-- CREATE INDEX

> INSERT INTO nulls VALUES (1, NULL), (2, NULL)
ERROR 23505: duplicate key value violates unique constraint "nn"
DETAIL: Key (b)=(null) already exists.
OBJECTS: schema=public table=nulls constraint=nn

> SELECT count(*) FROM nulls
count:int8
2
-- SELECT 1

> CREATE TABLE desc_t (x int)
-- CREATE TABLE

> INSERT INTO desc_t VALUES (3), (1), (NULL), (2)
-- INSERT 0 4

> CREATE INDEX ON desc_t (x DESC NULLS LAST)
-- CREATE INDEX

> SELECT x FROM desc_t ORDER BY x DESC NULLS LAST
x:int4
3
2
1
NULL
-- SELECT 4

> SELECT x FROM desc_t ORDER BY x
x:int4
1
2
3
NULL
-- SELECT 4

> SELECT x FROM desc_t ORDER BY x NULLS FIRST
x:int4
NULL
1
2
3
