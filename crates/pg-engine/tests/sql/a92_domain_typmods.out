> select ('2021-02-03 04:05:06.789123'::ts3b)::text
text:text
2021-02-03 04:05:06.789
-- SELECT 1

> drop view ddv
-- DROP VIEW

> drop table dd
-- DROP TABLE

> drop type ddt
-- DROP TYPE

> drop domain posints, posint, ts3b, ts3, vc5c, vc5b, vc5, mynums2, mynums
-- DROP DOMAIN

