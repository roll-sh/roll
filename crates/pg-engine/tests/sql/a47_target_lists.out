> EXPLAIN (VERBOSE, COSTS OFF)
> SELECT t1.b, ss.phv FROM a47_ut t1 LEFT JOIN LATERAL
>   (SELECT t2.a AS t2a, t3.a t3a, least(t1.a, t2.a, t3.b) phv
>      FROM a47_pt t2 JOIN a47_ut t3 ON t2.a = t3.b) ss
>   ON t1.a = ss.t2a ORDER BY t1.a
QUERY PLAN:text
Sort
  Output: t1.b, (LEAST(t1.a, t2.a, t3.b)), t1.a
  Sort Key: t1.a
  ->  Nested Loop Left Join
        Output: t1.b, (LEAST(t1.a, t2.a, t3.b)), t1.a
        ->  Seq Scan on public.a47_ut t1
              Output: t1.a, t1.b, t1.c
        ->  Hash Join
              Output: t2.a, LEAST(t1.a, t2.a, t3.b)
              Hash Cond: (t2.a = t3.b)
              ->  Append
                    ->  Seq Scan on public.a47_pt_1_1 t2_1
                          Output: t2_1.a
                          Filter: (t1.a = t2_1.a)
                    ->  Seq Scan on public.a47_pt_2 t2_2
                          Output: t2_2.a
                          Filter: (t1.a = t2_2.a)
              ->  Hash
                    Output: t3.b
                    ->  Seq Scan on public.a47_ut t3
                          Output: t3.b
-- EXPLAIN

