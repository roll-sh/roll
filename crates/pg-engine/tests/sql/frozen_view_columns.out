    tt4.ay,
    tt4.q
   FROM tt2
     JOIN tt3 USING (b, c)
     JOIN tt4 USING (b);
-- SELECT 1

> select pg_get_viewdef('v3', true)
pg_get_viewdef:text
 SELECT b,
    tt3.c,
    tt2.a,
    tt3.ax,
    tt4.ay,
    tt4.q
   FROM tt2
     JOIN tt3 USING (b, c)
     FULL JOIN tt4 USING (b);
-- SELECT 1

> select pg_get_viewdef('v5', true)
pg_get_viewdef:text
 SELECT s.a,
    s.b,
    s.c,
    s4.ay,
    s4.q
   FROM ( SELECT tt2.a,
            tt2.b,
            tt2.c
           FROM tt2) s,
    ( SELECT tt4.ay,
            tt4.q
           FROM tt4) s4;
-- SELECT 1

