> reset search_path
-- RESET

> select * from fvc.v1
b:int4 | c:numeric | a:int4 | ax:int8
2 | 3 | 1 | 10
-- SELECT 1

> select pg_get_viewdef('fvc.v2', true)
pg_get_viewdef:text
 SELECT tt2.b,
    tt3.c,
    tt2.a,
    tt3.ax,
    tt4.ay,
    tt4.q
   FROM fvc.tt2
     JOIN fvc.tt3 tt3(ax, b, c, c_1, e) USING (b, c)
     JOIN fvc.tt4 USING (b);
-- SELECT 1

