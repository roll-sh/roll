> CREATE TABLE a2_ct (unique1 int, unique2 int)
-- CREATE TABLE

> INSERT INTO a2_ct SELECT g, g FROM generate_series(0, 9999) g
-- INSERT 0 10000

> CREATE INDEX ON a2_ct (unique1)
-- CREATE INDEX

> VACUUM ANALYZE a2_ct
-- VACUUM

> EXPLAIN (COSTS OFF)
> WITH x AS MATERIALIZED (SELECT unique1 FROM a2_ct b ORDER BY unique1)
> SELECT count(*) FROM a2_ct a WHERE unique1 IN (SELECT * FROM x)
QUERY PLAN:text
Aggregate
  CTE x
    ->  Index Only Scan using a2_ct_unique1_idx on a2_ct b
  ->  Hash Right Semi Join
        Hash Cond: (x.unique1 = a.unique1)
        ->  CTE Scan on x
        ->  Hash
              ->  Seq Scan on a2_ct a
-- EXPLAIN

> WITH x AS MATERIALIZED (SELECT unique1 FROM a2_ct b ORDER BY unique1)
> SELECT count(*) FROM a2_ct a WHERE unique1 IN (SELECT * FROM x)
count:int8
10000
-- SELECT 1

> EXPLAIN (COSTS OFF)
> WITH x AS MATERIALIZED (SELECT unique1, unique2 FROM a2_ct b WHERE unique1 < 100 ORDER BY unique2)
> SELECT * FROM x ORDER BY unique2 LIMIT 3
QUERY PLAN:text
Limit
  CTE x
    ->  Sort
          Sort Key: b.unique2
          ->  Index Scan using a2_ct_unique1_idx on a2_ct b
                Index Cond: (unique1 < 100)
  ->  CTE Scan on x
-- EXPLAIN

> DROP TABLE a2_ct
-- DROP TABLE

> CREATE TEMP TABLE a2_graph (f int, t int, label text)
-- CREATE TABLE

> INSERT INTO a2_graph VALUES
>   (1, 2, 'arc 1 -> 2'), (1, 3, 'arc 1 -> 3'), (2, 3, 'arc 2 -> 3'),
>   (1, 4, 'arc 1 -> 4'), (4, 5, 'arc 4 -> 5'), (5, 1, 'arc 5 -> 1')
-- INSERT 0 6

> EXPLAIN (COSTS OFF)
> WITH RECURSIVE search_graph(f, t, label, is_cycle, path) AS (
>   SELECT *, false, array[row(g.f, g.t)] FROM a2_graph g
>   UNION ALL
>   SELECT g.*, row(g.f, g.t) = any(path), path || row(g.f, g.t)
>   FROM a2_graph g, search_graph sg
>   WHERE g.f = sg.t AND NOT is_cycle
> )
> SELECT f, t, label, is_cycle FROM search_graph
QUERY PLAN:text
CTE Scan on search_graph
  CTE search_graph
    ->  Recursive Union
          ->  Seq Scan on a2_graph g
          ->  Merge Join
                Merge Cond: (g_1.f = sg.t)
                ->  Sort
                      Sort Key: g_1.f
                      ->  Seq Scan on a2_graph g_1
                ->  Sort
                      Sort Key: sg.t
                      ->  WorkTable Scan on search_graph sg
                            Filter: (NOT is_cycle)
-- EXPLAIN

> WITH RECURSIVE search_graph(f, t, label, is_cycle, path) AS (
