> EXPLAIN (COSTS OFF)
> WITH RECURSIVE
> graph(f, t, label) AS (
>   VALUES (1, 2, 'arc 1 -> 2'), (1, 3, 'arc 1 -> 3'), (2, 3, 'arc 2 -> 3'),
>          (1, 4, 'arc 1 -> 4'), (4, 5, 'arc 4 -> 5'), (5, 1, 'arc 5 -> 1')),
> search_graph(f, t, label) AS (
>   SELECT * FROM graph g
>   UNION ALL
>   SELECT g.* FROM graph g, search_graph sg WHERE g.f = sg.t
> ) CYCLE f, t SET is_cycle TO true DEFAULT false USING path
> SELECT f, t, label FROM search_graph
QUERY PLAN:text
CTE Scan on search_graph
  CTE graph
    ->  Values Scan on "*VALUES*"
  CTE search_graph
    ->  Recursive Union
          ->  CTE Scan on graph g
          ->  Hash Join
                Hash Cond: (sg.t = g_1.f)
                ->  WorkTable Scan on search_graph sg
                      Filter: (NOT is_cycle)
                ->  Hash
                      ->  CTE Scan on graph g_1
-- EXPLAIN

