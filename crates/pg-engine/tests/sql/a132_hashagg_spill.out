> create function a132_explain(q text) returns setof text language plpgsql as $$
> declare ln text;
> begin
>   for ln in execute 'explain (analyze, costs off, timing off, summary off, buffers off) ' || q loop
>     ln := regexp_replace(ln, '(Memory Usage|Disk Usage): \d+kB', '\1: NkB', 'g');
>     return next ln;
>   end loop;
> end $$
-- CREATE FUNCTION

> create table a132h (a int, b int, t text, n numeric)
-- CREATE TABLE

> insert into a132h select g, g % 5000, md5((g % 20000)::text), g % 1000 from generate_series(1, 40000) g
-- INSERT 0 40000

> analyze a132h
-- ANALYZE

> set max_parallel_workers_per_gather = 0
-- SET

> set enable_sort = off
-- SET

> select a132_explain('select b, count(*) from a132h group by b')
a132_explain:text
  ->  Seq Scan on a132h (actual rows=40000.00 loops=1)
  Batches: 1  Memory Usage: NkB
  Group Key: b
HashAggregate (actual rows=5000.00 loops=1)
-- SELECT 4

> set work_mem = '64kB'
-- SET

> select a132_explain('select b, count(*) from a132h group by b')
a132_explain:text
  ->  Seq Scan on a132h (actual rows=40000.00 loops=1)
  Batches: 5  Memory Usage: NkB  Disk Usage: NkB
  Group Key: b
HashAggregate (actual rows=5000.00 loops=1)
-- SELECT 4

