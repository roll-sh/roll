> explain (costs off)
> select * from a23_t a inner join a23_t b
>   on a.hundred in (select c.hundred from a23_t c where c.odd = b.odd)
>   where a.thousand < 750 and b.unique1 < 3
QUERY PLAN:text
Nested Loop
  ->  Hash Join
        Hash Cond: (c.odd = b.odd)
        ->  HashAggregate
              Group Key: c.odd, c.hundred
              ->  Seq Scan on a23_t c
        ->  Hash
              ->  Index Scan using a23_t_unique1 on a23_t b
                    Index Cond: (unique1 < 3)
  ->  Index Scan using a23_t_hundred on a23_t a
        Index Cond: (hundred = c.hundred)
        Filter: (thousand < 750)
-- EXPLAIN

> select count(*) from a23_t a inner join a23_t b
>   on a.hundred in (select c.hundred from a23_t c where c.odd = b.odd)
>   where a.thousand < 750 and b.unique1 < 3
count:int8
240
-- SELECT 1

> create table a23_s2 (id serial, a int)
-- CREATE TABLE

> create table a23_s3 (id serial, a int)
-- CREATE TABLE

> create table a23_s4 (id serial, a int)
-- CREATE TABLE

> create unique index on a23_s3 (a, id)
-- CREATE INDEX

> create unique index on a23_s2 (id)
-- CREATE INDEX

> explain (costs off)
> select a23_s2.id from a23_s2
> where exists (select true from a23_s3, a23_s4 where a23_s3.a = 1 and a23_s3.id = a23_s2.id)
QUERY PLAN:text
Nested Loop
  ->  HashAggregate
        Group Key: a23_s3.id
        ->  Nested Loop
              ->  Seq Scan on a23_s4
              ->  Materialize
                    ->  Bitmap Heap Scan on a23_s3
                          Recheck Cond: (a = 1)
                          ->  Bitmap Index Scan on a23_s3_a_id_idx
                                Index Cond: (a = 1)
  ->  Index Only Scan using a23_s2_id_idx on a23_s2
        Index Cond: (id = a23_s3.id)
-- EXPLAIN

> insert into a23_s2 (a) select i from generate_series(1, 5) i
-- INSERT 0 5

> insert into a23_s3 (a) select 1 from generate_series(1, 3) i
-- INSERT 0 3

> insert into a23_s4 (a) values (1), (2)
-- INSERT 0 2

> select a23_s2.id from a23_s2
> where exists (select true from a23_s3, a23_s4 where a23_s3.a = 1 and a23_s3.id = a23_s2.id)
> order by 1
id:int4
1
2
3
-- SELECT 3

> explain (verbose, costs off)
> select t.hundred, q.q2 from a23_t t, a23_f f, a23_q q where t.hundred = f.f1 and t.thousand = q.q1
QUERY PLAN:text
Hash Join
  Output: t.hundred, q.q2
  Hash Cond: (f.f1 = t.hundred)
  ->  Seq Scan on public.a23_f f
        Output: f.f1
  ->  Hash
        Output: t.hundred, q.q2
        ->  Hash Join
              Output: t.hundred, q.q2
              Hash Cond: (q.q1 = t.thousand)
              ->  Seq Scan on public.a23_q q
                    Output: q.q1, q.q2
              ->  Hash
                    Output: t.hundred, t.thousand
                    ->  Seq Scan on public.a23_t t
                          Output: t.hundred, t.thousand
-- EXPLAIN

> drop table a23_t, a23_o, a23_q, a23_f, a23_inner, a23_fk, a23_s2, a23_s3, a23_s4
-- DROP TABLE

