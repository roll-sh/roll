> create table lk (a int primary key, b text, c int check (c > 0), d int)
-- CREATE TABLE

> create index lk_b on lk (b)
-- CREATE INDEX

> create index lk_e on lk (lower(b)) where d > 0
-- CREATE INDEX

> create unique index lk_cd on lk (c, d) include (b)
-- CREATE INDEX

> create index lk_h on lk using hash (d)
-- CREATE INDEX

> alter table lk add constraint lk_x exclude using btree (d with =)
-- ALTER TABLE

> comment on column lk.b is 'bee'
-- COMMENT

> comment on constraint lk_c_check on lk is 'positive'
-- COMMENT

> comment on index lk_b is 'b index'
-- COMMENT

> comment on table lk is 'the table'
-- COMMENT

> create table lk2 (like lk including all)
-- CREATE TABLE

> select indexname, indexdef from pg_indexes where tablename = 'lk2' order by 1
indexname:name | indexdef:text
lk2_b_idx | CREATE INDEX lk2_b_idx ON public.lk2 USING btree (b)
lk2_c_d_b_idx | CREATE UNIQUE INDEX lk2_c_d_b_idx ON public.lk2 USING btree (c, d) INCLUDE (b)
lk2_d_excl | CREATE INDEX lk2_d_excl ON public.lk2 USING btree (d)
lk2_d_idx | CREATE INDEX lk2_d_idx ON public.lk2 USING hash (d)
lk2_lower_idx | CREATE INDEX lk2_lower_idx ON public.lk2 USING btree (lower(b)) WHERE (d > 0)
lk2_pkey | CREATE UNIQUE INDEX lk2_pkey ON public.lk2 USING btree (a)
-- SELECT 6

> select conname, contype from pg_constraint where conrelid = 'lk2'::regclass order by 1
conname:name | contype:char
lk2_d_excl | x
lk2_pkey | p
lk_a_not_null | n
lk_c_check | c
-- SELECT 4

> select col_description('lk2'::regclass, 2), obj_description('lk2'::regclass, 'pg_class')
col_description:text | obj_description:text
bee | NULL
-- SELECT 1

> select c.relname, obj_description(c.oid, 'pg_class') from pg_index i join pg_class c on c.oid = i.indexrelid where i.indrelid = 'lk2'::regclass order by 1
relname:name | obj_description:text
lk2_b_idx | b index
lk2_c_d_b_idx | NULL
lk2_d_excl | NULL
lk2_d_idx | NULL
lk2_lower_idx | NULL
lk2_pkey | NULL
-- SELECT 6

> select conname, obj_description(oid, 'pg_constraint') from pg_constraint where conrelid = 'lk2'::regclass order by 1
conname:name | obj_description:text
lk2_d_excl | NULL
lk2_pkey | NULL
lk_a_not_null | NULL
lk_c_check | positive
-- SELECT 4

