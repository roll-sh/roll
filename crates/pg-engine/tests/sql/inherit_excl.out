  ->  Seq Scan on c2 p_2
        Filter: ((a IS NOT NULL) AND (a = 15) AND (b = 'q'::text))
  ->  Seq Scan on c4 p_3
        Filter: ((a IS NOT NULL) AND (a = 15) AND (b = 'q'::text))
-- EXPLAIN

