> CREATE TABLE p (a int, b text, CHECK (a > 0))
-- CREATE TABLE

> CREATE TABLE c1 (CHECK (a < 10)) INHERITS (p)
-- CREATE TABLE

> CREATE TABLE c2 (CHECK (a >= 10 AND a < 20)) INHERITS (p)
-- CREATE TABLE

> CREATE TABLE c3 (CHECK (b IN ('x', 'y'))) INHERITS (p)
-- CREATE TABLE

> CREATE TABLE c4 (CHECK (a IS NOT NULL), CHECK (b <> 'z')) INHERITS (p)
-- CREATE TABLE

> EXPLAIN (COSTS OFF) SELECT * FROM p WHERE a = 15
QUERY PLAN:text
Append
  ->  Seq Scan on p p_1
        Filter: (a = 15)
  ->  Seq Scan on c2 p_2
        Filter: (a = 15)
  ->  Seq Scan on c3 p_3
        Filter: (a = 15)
  ->  Seq Scan on c4 p_4
        Filter: (a = 15)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM p WHERE a < 0
QUERY PLAN:text
Result
  One-Time Filter: false
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM p WHERE a BETWEEN 12 AND 13
QUERY PLAN:text
Append
  ->  Seq Scan on p p_1
        Filter: ((a >= 12) AND (a <= 13))
  ->  Seq Scan on c2 p_2
        Filter: ((a >= 12) AND (a <= 13))
  ->  Seq Scan on c3 p_3
        Filter: ((a >= 12) AND (a <= 13))
  ->  Seq Scan on c4 p_4
        Filter: ((a >= 12) AND (a <= 13))
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM p WHERE b = 'q'
QUERY PLAN:text
Append
  ->  Seq Scan on p p_1
        Filter: (b = 'q'::text)
  ->  Seq Scan on c1 p_2
        Filter: (b = 'q'::text)
  ->  Seq Scan on c2 p_3
        Filter: (b = 'q'::text)
  ->  Seq Scan on c4 p_4
        Filter: (b = 'q'::text)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM p WHERE b = 'z'
QUERY PLAN:text
Append
  ->  Seq Scan on p p_1
        Filter: (b = 'z'::text)
  ->  Seq Scan on c1 p_2
        Filter: (b = 'z'::text)
  ->  Seq Scan on c2 p_3
        Filter: (b = 'z'::text)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM p WHERE a IS NULL
QUERY PLAN:text
Append
  ->  Seq Scan on p p_1
        Filter: (a IS NULL)
  ->  Seq Scan on c1 p_2
        Filter: (a IS NULL)
  ->  Seq Scan on c2 p_3
        Filter: (a IS NULL)
  ->  Seq Scan on c3 p_4
        Filter: (a IS NULL)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM p WHERE a IN (15, 16)
QUERY PLAN:text
Append
  ->  Seq Scan on p p_1
        Filter: (a = ANY ('{15,16}'::integer[]))
  ->  Seq Scan on c2 p_2
        Filter: (a = ANY ('{15,16}'::integer[]))
  ->  Seq Scan on c3 p_3
        Filter: (a = ANY ('{15,16}'::integer[]))
  ->  Seq Scan on c4 p_4
        Filter: (a = ANY ('{15,16}'::integer[]))
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM p WHERE a = 15 OR a = 3
QUERY PLAN:text
Append
  ->  Seq Scan on p p_1
        Filter: ((a = 15) OR (a = 3))
  ->  Seq Scan on c1 p_2
        Filter: ((a = 15) OR (a = 3))
  ->  Seq Scan on c2 p_3
        Filter: ((a = 15) OR (a = 3))
  ->  Seq Scan on c3 p_4
        Filter: ((a = 15) OR (a = 3))
  ->  Seq Scan on c4 p_5
        Filter: ((a = 15) OR (a = 3))
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM p WHERE false
QUERY PLAN:text
Result
  One-Time Filter: false
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM p WHERE a = 15 AND b = 'q'
QUERY PLAN:text
Append
  ->  Seq Scan on p p_1
        Filter: ((a = 15) AND (b = 'q'::text))
  ->  Seq Scan on c2 p_2
        Filter: ((a = 15) AND (b = 'q'::text))
  ->  Seq Scan on c4 p_3
        Filter: ((a = 15) AND (b = 'q'::text))
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM c1 WHERE a = 15
QUERY PLAN:text
Seq Scan on c1
  Filter: (a = 15)
-- EXPLAIN

> EXPLAIN (COSTS OFF) UPDATE p SET b = 'w' WHERE a = 15
QUERY PLAN:text
Update on p
  Update on p p_1
  Update on c2 p_2
  Update on c3 p_3
  Update on c4 p_4
  ->  Result
        ->  Append
              ->  Seq Scan on p p_1
                    Filter: (a = 15)
              ->  Seq Scan on c2 p_2
                    Filter: (a = 15)
              ->  Seq Scan on c3 p_3
                    Filter: (a = 15)
              ->  Seq Scan on c4 p_4
                    Filter: (a = 15)
-- EXPLAIN

> EXPLAIN (COSTS OFF) DELETE FROM p WHERE a = 15 AND b = 'q'
QUERY PLAN:text
Delete on p
  Delete on p p_1
  Delete on c2 p_2
  Delete on c4 p_3
  ->  Append
        ->  Seq Scan on p p_1
              Filter: ((a = 15) AND (b = 'q'::text))
        ->  Seq Scan on c2 p_2
              Filter: ((a = 15) AND (b = 'q'::text))
        ->  Seq Scan on c4 p_3
              Filter: ((a = 15) AND (b = 'q'::text))
-- EXPLAIN

