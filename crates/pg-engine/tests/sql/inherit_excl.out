> SET constraint_exclusion = off
-- SET

> EXPLAIN (COSTS OFF) SELECT * FROM p WHERE a = 15
QUERY PLAN:text
Append
  ->  Seq Scan on p p_1
        Filter: (a = 15)
  ->  Seq Scan on c1 p_2
        Filter: (a = 15)
  ->  Seq Scan on c2 p_3
        Filter: (a = 15)
  ->  Seq Scan on c3 p_4
        Filter: (a = 15)
  ->  Seq Scan on c4 p_5
        Filter: (a = 15)
-- EXPLAIN

> SET constraint_exclusion = on
-- SET

> EXPLAIN (COSTS OFF) SELECT * FROM c1 WHERE a = 15
QUERY PLAN:text
Result
  One-Time Filter: false
-- EXPLAIN

> SHOW constraint_exclusion
constraint_exclusion:text
on
-- SHOW

> SET constraint_exclusion = bogus
ERROR 22023: invalid value for parameter "constraint_exclusion": "bogus"
HINT: Available values: partition, on, off.

> RESET constraint_exclusion
-- RESET

> SHOW constraint_exclusion
constraint_exclusion:text
partition
-- SHOW

> SELECT setting, vartype, enumvals FROM pg_settings WHERE name = 'constraint_exclusion'
setting:text | vartype:text | enumvals:text[]
partition | enum | {partition,on,off}
-- SELECT 1

