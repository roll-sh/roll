> create table a285f (id int) with (autovacuum_enabled = off)
-- CREATE TABLE

> create table a285b (id1 int, id2 int) with (autovacuum_enabled = off)
-- CREATE TABLE

> insert into a285f values (1), (2)
-- INSERT 0 2

> insert into a285b values (1, 1), (2, 2), (3, 1)
-- INSERT 0 3

> explain select * from a285f where id in (select id2 from (select id2 from a285b group by id2) s)
QUERY PLAN:text
Hash Join  (cost=42.75..85.09 rows=2550 width=4)
  Hash Cond: (a285f.id = a285b.id2)
  ->  Seq Scan on a285f  (cost=0.00..35.50 rows=2550 width=4)
  ->  Hash  (cost=40.25..40.25 rows=200 width=4)
        ->  HashAggregate  (cost=38.25..40.25 rows=200 width=4)
              Group Key: a285b.id2
              ->  Seq Scan on a285b  (cost=0.00..32.60 rows=2260 width=4)
-- EXPLAIN

> select * from a285f where id in (select id2 from (select distinct on (id2) id1, id2 from a285b) s) order by 1
id:int4
1
2
-- SELECT 2

> explain select * from a285f where id in (select id2 from (select distinct id1, id2 from a285b) s)
QUERY PLAN:text
Hash Join  (cost=53.48..109.86 rows=1275 width=4)
  Hash Cond: (a285f.id = s.id2)
  ->  Seq Scan on a285f  (cost=0.00..35.50 rows=2550 width=4)
  ->  Hash  (cost=50.98..50.98 rows=200 width=4)
        ->  HashAggregate  (cost=48.98..50.98 rows=200 width=4)
              Group Key: s.id2
              ->  Subquery Scan on s  (cost=43.90..48.42 rows=226 width=4)
                    ->  HashAggregate  (cost=43.90..46.16 rows=226 width=8)
                          Group Key: a285b.id1, a285b.id2
                          ->  Seq Scan on a285b  (cost=0.00..32.60 rows=2260 width=8)
-- EXPLAIN

> explain select * from a285f where id in (select id2 from (select id1, id2 from a285b union select id1, id2 from a285b) s)
QUERY PLAN:text
Hash Join  (cost=216.60..272.98 rows=1275 width=4)
  Hash Cond: (a285f.id = s.id2)
  ->  Seq Scan on a285f  (cost=0.00..35.50 rows=2550 width=4)
  ->  Hash  (cost=214.10..214.10 rows=200 width=4)
        ->  HashAggregate  (cost=212.10..214.10 rows=200 width=4)
              Group Key: s.id2
              ->  Subquery Scan on s  (cost=110.40..200.80 rows=4520 width=4)
                    ->  HashAggregate  (cost=110.40..155.60 rows=4520 width=8)
                          Group Key: a285b.id1, a285b.id2
                          ->  Append  (cost=0.00..87.80 rows=4520 width=8)
                                ->  Seq Scan on a285b  (cost=0.00..32.60 rows=2260 width=8)
                                ->  Seq Scan on a285b a285b_1  (cost=0.00..32.60 rows=2260 width=8)
-- EXPLAIN

> explain select * from a285f where id in (select id2 from (select id2 from a285b union select id2 from a285b) s)
QUERY PLAN:text
Hash Join  (cost=200.80..243.14 rows=57630 width=4)
  Hash Cond: (a285f.id = a285b.id2)
  ->  Seq Scan on a285f  (cost=0.00..35.50 rows=2550 width=4)
  ->  Hash  (cost=144.30..144.30 rows=4520 width=4)
        ->  HashAggregate  (cost=99.10..144.30 rows=4520 width=4)
              Group Key: a285b.id2
              ->  Append  (cost=0.00..87.80 rows=4520 width=4)
                    ->  Seq Scan on a285b  (cost=0.00..32.60 rows=2260 width=4)
                    ->  Seq Scan on a285b a285b_1  (cost=0.00..32.60 rows=2260 width=4)
