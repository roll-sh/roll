> create table a285co (t text, u text collate "C", i int) with (autovacuum_enabled = off)
-- CREATE TABLE

> insert into a285co select g::text, g::text, g from generate_series(1, 2000) g
-- INSERT 0 2000

> create index a285co_t on a285co (t collate "C")
-- CREATE INDEX

> create index a285co_u on a285co (u)
-- CREATE INDEX

> analyze a285co
-- ANALYZE

> explain select * from a285co order by t limit 5
QUERY PLAN:text
Limit  (cost=64.22..64.23 rows=5 width=12)
  ->  Sort  (cost=64.22..69.22 rows=2000 width=12)
        Sort Key: t
        ->  Seq Scan on a285co  (cost=0.00..31.00 rows=2000 width=12)
-- EXPLAIN

> explain select * from a285co order by t collate "C" limit 5
QUERY PLAN:text
Limit  (cost=0.28..0.53 rows=5 width=44)
  ->  Index Scan using a285co_t on a285co  (cost=0.28..101.72 rows=2000 width=44)
-- EXPLAIN

> explain select * from a285co order by u collate "default" limit 5
QUERY PLAN:text
Limit  (cost=64.22..64.23 rows=5 width=44)
  ->  Sort  (cost=64.22..69.22 rows=2000 width=44)
        Sort Key: u
        ->  Seq Scan on a285co  (cost=0.00..31.00 rows=2000 width=44)
-- EXPLAIN

> explain select * from a285co order by t collate "C", i limit 5
QUERY PLAN:text
Limit  (cost=0.34..0.82 rows=5 width=44)
  ->  Incremental Sort  (cost=0.34..191.72 rows=2000 width=44)
        Sort Key: t COLLATE "C", i
        Presorted Key: t
        ->  Index Scan using a285co_t on a285co  (cost=0.28..101.72 rows=2000 width=44)
-- EXPLAIN

> explain select * from a285co order by u, t limit 5
QUERY PLAN:text
Limit  (cost=0.34..0.82 rows=5 width=12)
  ->  Incremental Sort  (cost=0.34..191.72 rows=2000 width=12)
        Sort Key: u COLLATE "C", t
        Presorted Key: u
        ->  Index Scan using a285co_u on a285co  (cost=0.28..101.72 rows=2000 width=12)
