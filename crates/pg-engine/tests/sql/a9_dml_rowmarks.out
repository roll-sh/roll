ERROR 0A000: FOR UPDATE is not allowed with aggregate functions

> SELECT * FROM (SELECT * FROM (SELECT count(*) c FROM a9j) a) b, a9j j WHERE j.other = 11 FOR UPDATE OF j
c:int8 | f2j:text | other:int4
3 | one | 11
-- SELECT 1

> UPDATE a9p SET f3 = f3 + j.other FROM a9j j, (SELECT f2j FROM a9j OFFSET 0) s
>   WHERE a9p.f2 = j.f2j AND j.f2j = s.f2j RETURNING a9p.f1, j.other
f1:int4 | other:int4
1 | 11
7 | 33
-- UPDATE 2

> CREATE TABLE a9src (a int, b int, c int, d int)
-- CREATE TABLE

> CREATE TABLE a9tgt (a int, b int, c int, d int)
-- CREATE TABLE

> CREATE TABLE a9ref (ab int, cd int)
-- CREATE TABLE

> EXPLAIN (VERBOSE, COSTS OFF)
> MERGE INTO a9tgt t
> USING (SELECT *, (SELECT count(*) FROM a9ref r
>                    WHERE r.ab = s.a + s.b AND r.cd = s.c - s.d) cnt
>          FROM a9src s) s
> ON t.a = s.a AND t.b < s.cnt
> WHEN MATCHED AND t.c > s.cnt THEN
>   UPDATE SET (b, c) = (SELECT s.b, s.cnt)
QUERY PLAN:text
Merge on public.a9tgt t
  ->  Hash Join
        Output: t.ctid, s.a, s.b, s.c, s.d, s.ctid
        Hash Cond: (t.a = s.a)
        Join Filter: (t.b < (SubPlan 1))
        ->  Seq Scan on public.a9tgt t
              Output: t.ctid, t.a, t.b
        ->  Hash
              Output: s.a, s.b, s.c, s.d, s.ctid
              ->  Seq Scan on public.a9src s
                    Output: s.a, s.b, s.c, s.d, s.ctid
        SubPlan 1
          ->  Aggregate
                Output: count(*)
                ->  Seq Scan on public.a9ref r
                      Output: r.ab, r.cd
                      Filter: ((r.ab = (s.a + s.b)) AND (r.cd = (s.c - s.d)))
  SubPlan 4
    ->  Aggregate
          Output: count(*)
          ->  Seq Scan on public.a9ref r_2
                Output: r_2.ab, r_2.cd
                Filter: ((r_2.ab = (s.a + s.b)) AND (r_2.cd = (s.c - s.d)))
  SubPlan 3
    ->  Result
          Output: s.b, (InitPlan 2).col1
          InitPlan 2
            ->  Aggregate
                  Output: count(*)
                  ->  Seq Scan on public.a9ref r_1
                        Output: r_1.ab, r_1.cd
                        Filter: ((r_1.ab = (s.a + s.b)) AND (r_1.cd = (s.c - s.d)))
-- EXPLAIN

