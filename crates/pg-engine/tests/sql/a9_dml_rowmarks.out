> CREATE TABLE a9j (f2j text, other int)
-- CREATE TABLE

> INSERT INTO a9j VALUES ('one', 11), ('kid', 22), ('seven', 33)
-- INSERT 0 3

> CREATE RULE a9p_del AS ON DELETE TO a9p DO INSTEAD
>   UPDATE a9p SET f2 = f2 || ' (deleted)', f3 = -1, f4 = -1 WHERE f1 = OLD.f1
>   RETURNING *
-- CREATE RULE

> DELETE FROM a9p WHERE f1 = 4 RETURNING old.*, new.*, *
f1:int4 | f2:text | f3:int4 | f4:int8 | f1:int4 | f2:text | f3:int4 | f4:int8 | f1:int4 | f2:text | f3:int4 | f4:int8
4 | four | 40 | 400 | 4 | four (deleted) | -1 | -1 | 4 | four (deleted) | -1 | -1
4 | kid | 41 | 401 | 4 | kid (deleted) | -1 | -1 | 4 | kid (deleted) | -1 | -1
-- DELETE 0

> SELECT tableoid::regclass, * FROM a9p ORDER BY f1, f2
tableoid:regclass | f1:int4 | f2:text | f3:int4 | f4:int8
a9p | 1 | one | 10 | 100
a9p | 4 | four (deleted) | -1 | -1
a9c | 4 | kid (deleted) | -1 | -1
a9c | 7 | seven | 70 | 700
-- SELECT 4

> DROP RULE a9p_del ON a9p
-- DROP RULE

> EXPLAIN (VERBOSE, COSTS OFF)
> SELECT p.f1, s.c FROM a9p p, (SELECT f2j, count(*) c FROM a9j GROUP BY f2j) s
>   WHERE p.f2 = s.f2j FOR UPDATE OF p
QUERY PLAN:text
LockRows
  Output: p.f1, s.c, p.ctid, s.*, p.tableoid
  ->  Hash Join
        Output: p.f1, s.c, p.ctid, s.*, p.tableoid
        Inner Unique: true
        Hash Cond: (p.f2 = s.f2j)
        ->  Append
              ->  Seq Scan on public.a9p p_1
                    Output: p_1.f1, p_1.ctid, p_1.f2, p_1.tableoid
              ->  Seq Scan on public.a9c p_2
                    Output: p_2.f1, p_2.ctid, p_2.f2, p_2.tableoid
        ->  Hash
              Output: s.c, s.*, s.f2j
              ->  Subquery Scan on s
                    Output: s.c, s.*, s.f2j
                    ->  HashAggregate
                          Output: a9j.f2j, count(*)
                          Group Key: a9j.f2j
                          ->  Seq Scan on public.a9j
                                Output: a9j.f2j, a9j.other
-- EXPLAIN

> SELECT p.f1, s.c FROM a9p p, (SELECT f2j, count(*) c FROM a9j GROUP BY f2j) s
>   WHERE p.f2 = s.f2j ORDER BY 1 FOR UPDATE OF p
f1:int4 | c:int8
1 | 1
7 | 1
-- SELECT 2

