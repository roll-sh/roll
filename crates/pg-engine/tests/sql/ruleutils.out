ru_func | CREATE INDEX ru_func ON public.ru USING btree (lower(t), COALESCE(vc, 'q'::character varying))
ru_partial | CREATE INDEX ru_partial ON public.ru USING btree (i8) WHERE (b AND (n > (1)::numeric))
ru_pkey | CREATE UNIQUE INDEX ru_pkey ON public.ru USING btree (id)
