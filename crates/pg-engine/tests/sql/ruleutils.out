> SELECT pg_get_constraintdef(oid, true) AS pretty, pg_get_constraintdef(oid) AS plain
> FROM pg_constraint WHERE conrelid = 'ru'::regclass AND contype = 'c' ORDER BY pg_get_constraintdef(oid, true)
pretty:text | plain:text
CHECK (
CASE
    WHEN b THEN i2 > 0
    ELSE NULL::boolean
END) | CHECK (
CASE
    WHEN b THEN (i2 > 0)
    ELSE NULL::boolean
END)
CHECK (
CASE i2
    WHEN 1 THEN true
    ELSE false
END) | CHECK (
CASE i2
    WHEN 1 THEN true
    ELSE false
END)
CHECK ((- i2) < 5 AND ((i2 + 1) * 2) > 0 AND (i2 - (1 - 2)) > 0) | CHECK ((((- i2) < 5) AND (((i2 + 1) * 2) > 0) AND ((i2 - (1 - 2)) > 0)))
CHECK ((i2 = ANY (ARRAY[1, 2])) AND t IS NOT NULL) | CHECK (((i2 = ANY (ARRAY[1, 2])) AND (t IS NOT NULL)))
CHECK ((t || 'x'::text) <> 'y'::text AND length(t) > 1 AND i2::text::integer > 0) | CHECK ((((t || 'x'::text) <> 'y'::text) AND (length(t) > 1) AND (((i2)::text)::integer > 0)))
CHECK (COALESCE(t, ''::text) <> 'q'::text) | CHECK ((COALESCE(t, ''::text) <> 'q'::text))
CHECK (GREATEST(i2::integer, 2) > NULLIF(i2, 3)) | CHECK ((GREATEST((i2)::integer, 2) > NULLIF(i2, 3)))
CHECK (NOT b OR i8 = 5) | CHECK (((NOT b) OR (i8 = 5)))
CHECK (ar[1] > 0 AND NOT i2 IS DISTINCT FROM 1) | CHECK (((ar[1] > 0) AND (NOT (i2 IS DISTINCT FROM 1))))
CHECK (b IS NOT TRUE OR (i2 * 2 + 1) > (i2 - 1 - 1)) | CHECK (((b IS NOT TRUE) OR (((i2 * 2) + 1) > ((i2 - 1) - 1))))
CHECK (f::integer > 0) | CHECK (((f)::integer > 0))
CHECK (i2 <> 3) | CHECK ((i2 <> 3))
CHECK (i8 >= 1 AND i8 <= 10) | CHECK (((i8 >= 1) AND (i8 <= 10)))
CHECK (j ? 'k'::text OR j = '{}'::jsonb) | CHECK (((j ? 'k'::text) OR (j = '{}'::jsonb)))
CHECK (n > 0::numeric) | CHECK ((n > (0)::numeric))
CHECK (t ~~ '%x%'::text AND t IS NOT NULL) | CHECK (((t ~~ '%x%'::text) AND (t IS NOT NULL)))
CHECK (vc::text <> ''::text) | CHECK (((vc)::text <> ''::text))
