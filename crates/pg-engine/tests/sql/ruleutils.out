> CREATE INDEX ru_partial ON ru (i8) WHERE b AND n > 1
-- CREATE INDEX

> CREATE INDEX ru_expr ON ru ((i8 + 1), t DESC NULLS LAST)
-- CREATE INDEX

> CREATE INDEX ru_func ON ru (lower(t), coalesce(vc, 'q'))
-- CREATE INDEX

> SELECT pg_get_indexdef(i.indexrelid, 0, true), pg_get_indexdef(i.indexrelid)
> FROM pg_index i JOIN pg_class c ON c.oid = i.indexrelid WHERE i.indrelid = 'ru'::regclass ORDER BY c.relname
pg_get_indexdef:text | pg_get_indexdef:text
CREATE INDEX ru_expr ON ru USING btree ((i8 + 1), t DESC NULLS LAST) | CREATE INDEX ru_expr ON public.ru USING btree (((i8 + 1)), t DESC NULLS LAST)
CREATE INDEX ru_func ON ru USING btree (lower(t), COALESCE(vc, 'q'::character varying)) | CREATE INDEX ru_func ON public.ru USING btree (lower(t), COALESCE(vc, 'q'::character varying))
CREATE INDEX ru_partial ON ru USING btree (i8) WHERE b AND n > 1::numeric | CREATE INDEX ru_partial ON public.ru USING btree (i8) WHERE (b AND (n > (1)::numeric))
CREATE UNIQUE INDEX ru_pkey ON ru USING btree (id) | CREATE UNIQUE INDEX ru_pkey ON public.ru USING btree (id)
