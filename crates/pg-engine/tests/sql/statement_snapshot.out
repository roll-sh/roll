> INSERT INTO t VALUES (1, 0), (2, 0), (3, 0)
-- INSERT 0 3

> CREATE FUNCTION trg() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF new.id = 1 THEN UPDATE t SET v = v + 50 WHERE id = 2; END IF; RETURN new; END $$
-- CREATE FUNCTION

> CREATE TRIGGER trg BEFORE UPDATE ON t FOR EACH ROW EXECUTE FUNCTION trg()
-- CREATE TRIGGER

> UPDATE t SET v = v + 1
ERROR 27000: tuple to be updated was already modified by an operation triggered by the current command
HINT: Consider using an AFTER trigger instead of a BEFORE trigger to propagate changes to other rows.

