2 | 50
3 | 0
-- SELECT 3

> DROP TRIGGER trg ON t
-- DROP TRIGGER

> CREATE FUNCTION trgself() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN UPDATE t SET v = 999 WHERE id = old.id; RETURN old; END $$
-- CREATE FUNCTION

> CREATE TRIGGER trgself BEFORE DELETE ON t FOR EACH ROW EXECUTE FUNCTION trgself()
-- CREATE TRIGGER

> DELETE FROM t WHERE id = 3
ERROR 27000: tuple to be deleted was already modified by an operation triggered by the current command
HINT: Consider using an AFTER trigger instead of a BEFORE trigger to propagate changes to other rows.

> DROP TRIGGER trgself ON t
-- DROP TRIGGER

