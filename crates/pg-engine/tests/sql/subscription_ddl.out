> create subscription subd_s connection 'dbname=subd_nowhere' publication p1 with (connect = false, copy_data = true)
ERROR 42601: connect = false and copy_data = true are mutually exclusive options

> create subscription subd_s connection 'dbname=subd_nowhere' publication p1 with (connect = false, enabled = true)
ERROR 42601: connect = false and enabled = true are mutually exclusive options

> create subscription subd_s connection 'dbname=subd_nowhere' publication p1 with (slot_name = none)
ERROR 42601: subscription with slot_name = NONE must also set enabled = false

> create subscription subd_s connection 'dbname=subd_nowhere' publication p1 with (slot_name = none, enabled = false)
ERROR 42601: subscription with slot_name = NONE must also set create_slot = false

> create subscription subd_s connection 'dbname=subd_nowhere' publication p1 with (slot_name = '')
ERROR 42602: replication slot name "" is too short

> create subscription subd_s connection 'dbname=subd_nowhere' publication p1 with (slot_name = 'Bad-Name', connect = false)
ERROR 42602: replication slot name "Bad-Name" contains invalid character
HINT: Replication slot names may only contain lower case letters, numbers, and the underscore character.

> create subscription subd_s connection 'dbname=subd_nowhere' publication p1 with (connect = false, origin = 'x')
ERROR 22023: unrecognized origin value: "x"

> create subscription subd_s connection 'dbname=subd_nowhere' publication p1 with (connect = false, streaming = 'x')
ERROR 42601: streaming requires a Boolean value or "parallel"

> create subscription subd_s connection 'dbname=subd_nowhere' publication p1 with (connect = false, binary = 'x')
ERROR 42601: binary requires a Boolean value

> create subscription subd_s connection 'dbname=subd_nowhere' publication p1 with (connect = false, synchronous_commit = 'x')
ERROR 22023: invalid value for parameter "synchronous_commit": "x"
HINT: Available values: local, remote_write, remote_apply, on, off.

> create subscription subd_s connection 'dbname=subd_nowhere' publication p1 with (connect = false, nope = 1)
ERROR 42601: unrecognized subscription parameter: "nope"

> create subscription subd_s connection 'dbname=subd_nowhere' publication p1 with (connect = false, connect = false)
ERROR 42601: conflicting or redundant options (at 99)

> create subscription subd_s connection 'nope' publication p1 with (connect = false)
ERROR 42601: invalid connection string syntax: missing "=" after "nope" in connection info string


> create subscription subd_s connection 'host=a bogus=1' publication p1 with (connect = false)
ERROR 42601: invalid connection string syntax: invalid connection option "bogus"


> create subscription subd_s connection 'dbname=subd_nowhere' publication p1, p2, p1 with (connect = false)
ERROR 42710: publication name "p1" used more than once

> create subscription subd_s connection 'port=-1' publication p1
ERROR 08006: subscription "subd_s" could not connect to the publisher: invalid port number: "-1"

> create subscription subd_s connection 'dbname=subd_nowhere' publication p1, p2 with (connect = false)
WARNING 01000: subscription was created, but is not connected
HINT: To initiate replication, you must manually create the replication slot, enable the subscription, and refresh the subscription.
-- CREATE SUBSCRIPTION

> create subscription subd_s connection 'dbname=subd_nowhere' publication p1 with (connect = false)
ERROR 42710: subscription "subd_s" already exists

> create subscription subd_t connection 'dbname=subd_nowhere' publication p1 with (connect = false, slot_name = none, binary = true, streaming = off, two_phase = true, disable_on_error = true, origin = none, synchronous_commit = local, failover = true, run_as_owner = true)
WARNING 01000: subscription was created, but is not connected
HINT: To initiate replication, you must manually create the replication slot, enable the subscription, and refresh the subscription.
-- CREATE SUBSCRIPTION

> select subname, subenabled, subbinary, substream, subtwophasestate, subdisableonerr, subpasswordrequired, subrunasowner, subfailover, subconninfo, subslotname, subsynccommit, subpublications, suborigin, subskiplsn
>   from pg_subscription where subname like 'subd%' order by 1
subname:name | subenabled:bool | subbinary:bool | substream:char | subtwophasestate:char | subdisableonerr:bool | subpasswordrequired:bool | subrunasowner:bool | subfailover:bool | subconninfo:text | subslotname:name | subsynccommit:text | subpublications:text[] | suborigin:text | subskiplsn:pg_lsn
subd_s | f | f | p | d | f | t | f | f | dbname=subd_nowhere | subd_s | off | {p1,p2} | any | 0/0
subd_t | f | t | f | p | t | t | t | t | dbname=subd_nowhere | NULL | local | {p1} | none | 0/0
