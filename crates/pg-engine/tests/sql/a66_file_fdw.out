> GRANT CREATE ON SCHEMA public TO a66_fdw_user
-- GRANT

> SET ROLE a66_fdw_user
-- SET

> CREATE FOREIGN TABLE a66_u () SERVER a66_srv OPTIONS (filename 'a')
