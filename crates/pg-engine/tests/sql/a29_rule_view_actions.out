>   RETURNING old.*, new.*, *, new.f3 - old.f3 AS delta_f3
QUERY PLAN:text
Update on public.a29_foo
  Output: old.f1, old.f2, old.f3, old.f4, a29_joinme.other, new.f1, new.f2, new.f3, new.f4, a29_joinme.other, a29_foo.f1, a29_foo.f2, a29_foo.f3, a29_foo.f4, a29_joinme.other, (new.f3 - old.f3)
  ->  Nested Loop
        Output: a29_foo_1.f1, (a29_foo_1.f3 + 1), a29_foo.ctid, a29_joinme.ctid, a29_foo_1.ctid, a29_joinme_1.ctid, a29_joinme.other
        Join Filter: (a29_foo.f2 = a29_joinme_1.f2j)
        ->  Nested Loop
              Output: a29_foo.ctid, a29_foo.f2, a29_joinme.ctid, a29_joinme.other, a29_joinme.f2j, a29_foo_1.f1, a29_foo_1.f3, a29_foo_1.ctid, a29_foo_1.f2
              Join Filter: (a29_foo.f2 = a29_joinme.f2j)
              ->  Nested Loop
                    Output: a29_foo.ctid, a29_foo.f2, a29_foo_1.f1, a29_foo_1.f3, a29_foo_1.ctid, a29_foo_1.f2
                    Join Filter: (a29_foo.f2 = a29_foo_1.f2)
                    ->  Seq Scan on public.a29_foo a29_foo_1
                          Output: a29_foo_1.f1, a29_foo_1.f3, a29_foo_1.ctid, a29_foo_1.f2
                          Filter: (a29_foo_1.f3 = 57)
                    ->  Seq Scan on public.a29_foo
                          Output: a29_foo.ctid, a29_foo.f2
              ->  Seq Scan on public.a29_joinme
                    Output: a29_joinme.ctid, a29_joinme.other, a29_joinme.f2j
        ->  Seq Scan on public.a29_joinme a29_joinme_1
              Output: a29_joinme_1.ctid, a29_joinme_1.f2j
-- EXPLAIN

