> CREATE RULE a29_joinview_u AS ON UPDATE TO a29_joinview DO INSTEAD
>   UPDATE a29_foo SET f1 = new.f1, f3 = new.f3
>     FROM a29_joinme WHERE f2 = f2j AND f2 = old.f2
>     RETURNING a29_foo.*, other
-- CREATE RULE

> EXPLAIN (verbose, costs off)
