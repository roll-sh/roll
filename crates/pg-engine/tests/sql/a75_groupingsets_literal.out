-- CREATE TABLE

> SELECT count(*) FROM a75gk GROUP BY GROUPING SETS ((), ('2025-06-19'::date)) HAVING 1 > (10.00 - ('2025-06-19' - '1999-11-11'::date))
count:int8
-- SELECT 0

> SELECT count(*), ('2025-06-19' - '1999-11-11'::date) AS x FROM a75gk GROUP BY GROUPING SETS ((), ('2025-06-19'::date))
count:int8 | x:int4
0 | NULL
