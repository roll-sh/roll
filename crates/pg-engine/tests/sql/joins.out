> CREATE TABLE a (id int PRIMARY KEY, v text)
-- CREATE TABLE

> CREATE TABLE b (id int, a_id int, w text)
-- CREATE TABLE

> INSERT INTO a VALUES (1, 'one'), (2, 'two'), (3, 'three')
-- INSERT 0 3

> INSERT INTO b VALUES (10, 1, 'x'), (11, 1, 'y'), (12, 2, 'z'), (13, NULL, 'n'), (14, 9, 'orphan')
-- INSERT 0 5

> SELECT a.v, b.w FROM a JOIN b ON a.id = b.a_id ORDER BY 1, 2
v:text | w:text
one | x
one | y
two | z
-- SELECT 3

> SELECT a.v, b.w FROM a LEFT JOIN b ON a.id = b.a_id ORDER BY 1, 2
v:text | w:text
one | x
one | y
three | NULL
two | z
-- SELECT 4

> SELECT a.v, b.w FROM a RIGHT JOIN b ON a.id = b.a_id ORDER BY 2
v:text | w:text
NULL | n
NULL | orphan
one | x
one | y
two | z
-- SELECT 5

> SELECT a.v, b.w FROM a FULL JOIN b ON a.id = b.a_id ORDER BY 1, 2
v:text | w:text
one | x
one | y
three | NULL
two | z
NULL | n
NULL | orphan
-- SELECT 6

> SELECT count(*) FROM a CROSS JOIN b
count:int8
15
-- SELECT 1

> SELECT * FROM a JOIN b USING (id)
id:int4 | v:text | a_id:int4 | w:text
-- SELECT 0

> SELECT * FROM a NATURAL JOIN (SELECT 1 AS id, 'q' AS extra) s
id:int4 | v:text | extra:text
1 | one | q
-- SELECT 1

> SELECT id, v FROM a JOIN (SELECT a_id AS id, count(*) AS n FROM b GROUP BY a_id) c USING (id) ORDER BY id
id:int4 | v:text
1 | one
2 | two
-- SELECT 2

> SELECT a.id, x.w FROM a, LATERAL (SELECT w FROM b WHERE b.a_id = a.id ORDER BY w LIMIT 1) x ORDER BY a.id
id:int4 | w:text
1 | x
2 | z
-- SELECT 2

> SELECT a.id, x.w FROM a LEFT JOIN LATERAL (SELECT w FROM b WHERE b.a_id = a.id ORDER BY w DESC LIMIT 1) x ON true ORDER BY a.id
id:int4 | w:text
1 | y
2 | z
3 | NULL
-- SELECT 3

> SELECT * FROM a WHERE EXISTS (SELECT 1 FROM b WHERE b.a_id = a.id) ORDER BY id
id:int4 | v:text
1 | one
2 | two
-- SELECT 2

> SELECT * FROM a WHERE NOT EXISTS (SELECT 1 FROM b WHERE b.a_id = a.id) ORDER BY id
id:int4 | v:text
3 | three
-- SELECT 1

> SELECT * FROM a WHERE id IN (SELECT a_id FROM b) ORDER BY id
id:int4 | v:text
1 | one
2 | two
-- SELECT 2

> SELECT * FROM a WHERE id NOT IN (SELECT a_id FROM b)
id:int4 | v:text
-- SELECT 0

> SELECT * FROM a WHERE id NOT IN (SELECT a_id FROM b WHERE a_id IS NOT NULL) ORDER BY id
id:int4 | v:text
3 | three
-- SELECT 1

> SELECT v, (SELECT count(*) FROM b WHERE b.a_id = a.id) AS n FROM a ORDER BY v
v:text | n:int8
one | 2
three | 0
two | 1
-- SELECT 3

> SELECT v, (SELECT w FROM b WHERE b.a_id = a.id) FROM a
ERROR 21000: more than one row returned by a subquery used as an expression

> SELECT * FROM a WHERE id = ANY (SELECT a_id FROM b) ORDER BY id
id:int4 | v:text
1 | one
2 | two
-- SELECT 2

> SELECT * FROM a WHERE id > ALL (SELECT a_id FROM b WHERE a_id < 3) ORDER BY id
id:int4 | v:text
3 | three
-- SELECT 1

> SELECT * FROM a x JOIN a y ON x.id < y.id ORDER BY x.id, y.id
id:int4 | v:text | id:int4 | v:text
1 | one | 2 | two
1 | one | 3 | three
2 | two | 3 | three
-- SELECT 3

> SELECT id FROM a JOIN b ON true
ERROR 42702: column reference "id" is ambiguous (at 8)

> SELECT a.id FROM a JOIN b ON a.nosuch = b.id
ERROR 42703: column a.nosuch does not exist (at 30)

> SELECT * FROM a, a
ERROR 42712: table name "a" specified more than once

> SELECT * FROM a AS t1 JOIN b AS t1 ON true
ERROR 42712: table name "t1" specified more than once

> SELECT b.w FROM a JOIN b ON a.id = b.a_id AND b.w > 'x' ORDER BY 1
w:text
y
z
-- SELECT 2

> SELECT a.v, b.w FROM a LEFT JOIN b ON a.id = b.a_id WHERE b.id IS NULL ORDER BY 1
v:text | w:text
three | NULL
-- SELECT 1

> SELECT a.v, count(b.id) FROM a LEFT JOIN b ON a.id = b.a_id GROUP BY a.v ORDER BY a.v
v:text | count:int8
one | 2
three | 0
two | 1
-- SELECT 3

> WITH x AS (SELECT * FROM a WHERE id < 3) SELECT x.v, b.w FROM x JOIN b ON x.id = b.a_id ORDER BY 1, 2
v:text | w:text
one | x
one | y
two | z
-- SELECT 3

> SELECT * FROM (a JOIN b ON a.id = b.a_id) j(i, vv, bid) ORDER BY bid
i:int4 | vv:text | bid:int4 | a_id:int4 | w:text
1 | one | 10 | 1 | x
1 | one | 11 | 1 | y
2 | two | 12 | 2 | z
-- SELECT 3

