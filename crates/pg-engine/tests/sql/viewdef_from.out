> CREATE TABLE vf_a (id int, x int)
-- CREATE TABLE

> CREATE TABLE vf_b (id int, y int)
-- CREATE TABLE

> CREATE FUNCTION vf_f(n int) RETURNS TABLE (k int, v text) LANGUAGE sql AS $$ SELECT n, 'a' $$
-- CREATE FUNCTION

> CREATE FUNCTION vf_g(n int) RETURNS int LANGUAGE sql AS $$ SELECT n $$
-- CREATE FUNCTION

> CREATE FUNCTION vf_r() RETURNS SETOF record LANGUAGE sql AS $$ SELECT 1, 'x'::text $$
-- CREATE FUNCTION

> CREATE VIEW vf_v1 AS SELECT j.id, j.x FROM (vf_a JOIN vf_b USING (id)) j
-- CREATE VIEW

> CREATE VIEW vf_v2 AS SELECT * FROM (vf_a a JOIN vf_b b ON a.id = b.id) AS j(i1, x1, i2, y2)
-- CREATE VIEW

> CREATE VIEW vf_v3 AS SELECT f.k, f.v FROM vf_f(3) f
-- CREATE VIEW

> CREATE VIEW vf_v4 AS SELECT * FROM vf_a, vf_f(vf_a.x) WITH ORDINALITY AS t(kk, vv, o)
-- CREATE VIEW

> CREATE VIEW vf_v5 AS SELECT vf_g(a.x) AS g, s FROM vf_a a, vf_g(a.id) s
-- CREATE VIEW

> CREATE VIEW vf_v6 AS SELECT * FROM (vf_a a LEFT JOIN vf_b b USING (id)) j WHERE j.id > 1
-- CREATE VIEW

> CREATE VIEW vf_v7 AS SELECT * FROM vf_r() AS r(a int, b text)
-- CREATE VIEW

> CREATE VIEW vf_v8 AS SELECT a.id, l.m FROM vf_a a, LATERAL (SELECT max(y) AS m FROM vf_b WHERE vf_b.id = a.id) l
-- CREATE VIEW

> CREATE VIEW vf_v9 AS SELECT * FROM vf_a TABLESAMPLE system (10) REPEATABLE (1)
-- CREATE VIEW

> CREATE VIEW vf_v10 AS SELECT j.id, j.x, c.x AS cx FROM (vf_a a JOIN vf_b b USING (id)) j JOIN vf_a c ON c.id = j.id
-- CREATE VIEW

> CREATE VIEW vf_v11 AS SELECT * FROM vf_f(1)
-- CREATE VIEW

> CREATE VIEW vf_v12 AS SELECT vf_f FROM vf_f(1)
ERROR 42P16: column "vf_f" has pseudo-type record

> CREATE VIEW vf_v13 AS SELECT * FROM vf_g(1) WITH ORDINALITY
-- CREATE VIEW

> CREATE FUNCTION vf_s() RETURNS int LANGUAGE sql AS $$ SELECT 1 WHERE false $$
-- CREATE FUNCTION

> CREATE FUNCTION vf_t(OUT a int, OUT b text) LANGUAGE sql AS $$ SELECT 1, 'q' WHERE false $$
-- CREATE FUNCTION

> CREATE FUNCTION vf_u() RETURNS SETOF int LANGUAGE sql AS $$ VALUES (1), (2) $$
-- CREATE FUNCTION

> CREATE VIEW vf_v14 AS SELECT * FROM ROWS FROM (vf_u(), vf_r() AS (a int, b text), generate_series(1, 3)) WITH ORDINALITY
-- CREATE VIEW

> CREATE VIEW vf_v15 AS SELECT * FROM public.vf_u() WITH ORDINALITY AS z(p, q)
-- CREATE VIEW

