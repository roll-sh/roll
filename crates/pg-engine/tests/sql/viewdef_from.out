> SELECT * FROM vf_a, vf_f(vf_a.x) WITH ORDINALITY AS t(kk, vv, o)
id:int4 | x:int4 | kk:int4 | vv:text | o:int8
-- SELECT 0

> SELECT c.relname, pg_get_viewdef(c.oid) FROM pg_class c WHERE c.relkind = 'v' AND c.relname LIKE 'vf\_v%' ORDER BY length(c.relname), 1
relname:name | pg_get_viewdef:text
vf_v1 |  SELECT j.id,
    j.x
   FROM (vf_a
     JOIN vf_b USING (id)) j;
vf_v2 |  SELECT j.i1,
    j.x1,
    j.i2,
    j.y2
   FROM (vf_a a
     JOIN vf_b b ON ((a.id = b.id))) j(i1, x1, i2, y2);
vf_v3 |  SELECT k,
    v
   FROM vf_f(3) f(k, v);
vf_v4 |  SELECT vf_a.id,
    vf_a.x,
    t.kk,
    t.vv,
    t.o
   FROM vf_a,
    LATERAL vf_f(vf_a.x) WITH ORDINALITY t(kk, vv, o);
vf_v5 |  SELECT vf_g(a.x) AS g,
    s.s
   FROM vf_a a,
    LATERAL vf_g(a.id) s(s);
vf_v6 |  SELECT j.id,
    j.x,
    j.y
   FROM (vf_a a
     LEFT JOIN vf_b b USING (id)) j
  WHERE (j.id > 1);
vf_v7 |  SELECT a,
    b
   FROM vf_r() r(a integer, b text);
vf_v8 |  SELECT a.id,
    l.m
   FROM vf_a a,
    LATERAL ( SELECT max(vf_b.y) AS m
           FROM vf_b
          WHERE (vf_b.id = a.id)) l;
vf_v9 |  SELECT id,
    x
   FROM vf_a TABLESAMPLE system (10) REPEATABLE (1);
vf_v10 |  SELECT j.id,
    j.x,
    c.x AS cx
   FROM ((vf_a a
     JOIN vf_b b USING (id)) j
     JOIN vf_a c ON ((c.id = j.id)));
vf_v11 |  SELECT k,
    v
   FROM vf_f(1) vf_f(k, v);
vf_v13 |  SELECT vf_g,
    ordinality
   FROM vf_g(1) WITH ORDINALITY vf_g(vf_g, ordinality);
vf_v14 |  SELECT vf_u,
    a,
    b,
    generate_series,
    ordinality
   FROM ROWS FROM(vf_u(), vf_r() AS (a integer, b text), generate_series(1, 3)) WITH ORDINALITY vf_u(vf_u, a, b, generate_series, ordinality);
vf_v15 |  SELECT p,
    q
   FROM vf_u() WITH ORDINALITY z(p, q);
-- SELECT 14

> SELECT pg_get_viewdef('vf_v10'::regclass, true)
pg_get_viewdef:text
 SELECT j.id,
    j.x,
    c.x AS cx
   FROM (vf_a a
     JOIN vf_b b USING (id)) j
     JOIN vf_a c ON c.id = j.id;
-- SELECT 1

