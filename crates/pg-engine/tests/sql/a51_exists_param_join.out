> EXPLAIN (COSTS OFF)
> SELECT v0.id FROM a51_author v0 WHERE EXISTS
>   (SELECT 1 FROM a51_report u0 JOIN a51_author u1 ON u0.creator_id = u1.num WHERE u1.id = v0.id)
QUERY PLAN:text
Hash Right Semi Join
  Hash Cond: (u1.id = v0.id)
  ->  Hash Join
        Hash Cond: (u0.creator_id = u1.num)
        ->  Seq Scan on a51_report u0
        ->  Hash
              ->  Seq Scan on a51_author u1
  ->  Hash
        ->  Seq Scan on a51_author v0
-- EXPLAIN

