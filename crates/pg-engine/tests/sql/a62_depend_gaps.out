> CREATE TRIGGER trg3 INSTEAD OF INSERT ON vtp FOR EACH ROW EXECUTE FUNCTION trf()
-- CREATE TRIGGER

> CREATE TRIGGER trg4 AFTER INSERT ON tp REFERENCING NEW TABLE AS nt FOR EACH STATEMENT EXECUTE FUNCTION trf()
