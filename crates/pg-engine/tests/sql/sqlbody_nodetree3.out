> create table sbx_t (x int primary key, y text, z numeric, arr int[], d date)
-- CREATE TABLE

> create table sbx_u (x int, w text)
-- CREATE TABLE

> create table sbx_g (x int generated always as identity, y text)
-- CREATE TABLE

> create function sbx_01() returns setof int begin atomic select x from sbx_t for update; end
-- CREATE FUNCTION

> create function sbx_02() returns setof int begin atomic select x from sbx_t for share nowait; end
-- CREATE FUNCTION

> create function sbx_03() returns setof int begin atomic select t.x from sbx_t t, sbx_u u for no key update of t skip locked; end
-- CREATE FUNCTION

> create function sbx_04() returns setof int begin atomic select x from sbx_t for key share; end
-- CREATE FUNCTION

> create function sbx_10() returns void begin atomic insert into sbx_g overriding system value values (1, 'a'); end
-- CREATE FUNCTION

> create function sbx_11() returns void begin atomic insert into sbx_g overriding user value values (1, 'a'); end
-- CREATE FUNCTION

> create function sbx_12() returns void begin atomic merge into sbx_g g using sbx_u u on g.x = u.x when not matched then insert overriding system value values (u.x, u.w); end
-- CREATE FUNCTION

> create function sbx_20() returns setof int begin atomic merge into sbx_t t using sbx_u u on t.x = u.x when matched then update set y = u.w returning t.x; end
-- CREATE FUNCTION

> create function sbx_21() returns setof text begin atomic merge into sbx_t t using sbx_u u on t.x = u.x when matched then delete returning merge_action(); end
-- CREATE FUNCTION

> create function sbx_30() returns void begin atomic update sbx_t set (y, z) = ('a', 1); end
-- CREATE FUNCTION

> create function sbx_31() returns void begin atomic update sbx_t set (y, z) = (select w, 1 from sbx_u limit 1); end
-- CREATE FUNCTION

> create function sbx_32() returns void begin atomic update sbx_t set arr[1] = 5; end
-- CREATE FUNCTION

> create function sbx_33() returns void begin atomic insert into sbx_t (x, arr[1]) values (1, 2); end
-- CREATE FUNCTION

> create function sbx_40() returns setof bigint begin atomic select count(*) from sbx_t group by rollup (y); end
-- CREATE FUNCTION

> create function sbx_41() returns setof bigint begin atomic select count(*) from sbx_t group by cube (y, z); end
-- CREATE FUNCTION

> create function sbx_42() returns setof bigint begin atomic select count(*) from sbx_t group by grouping sets ((y), (z), ()); end
-- CREATE FUNCTION

> create function sbx_43() returns setof int begin atomic select grouping(y) from sbx_t group by rollup (y); end
-- CREATE FUNCTION

> create function sbx_44() returns setof bigint begin atomic select count(*) from sbx_t group by x, rollup (y); end
-- CREATE FUNCTION

> create function sbx_50() returns setof numeric begin atomic select sum(z) over (order by x range between 1 preceding and 2 following) from sbx_t; end
-- CREATE FUNCTION

> create function sbx_51() returns setof numeric begin atomic select sum(z) over (order by d desc range between '1 day' preceding and current row) from sbx_t; end
-- CREATE FUNCTION

> create function sbx_52() returns setof numeric begin atomic select sum(z) over (order by z range 1.5 preceding) from sbx_t; end
-- CREATE FUNCTION

> create function sbx_60() returns setof bigint begin atomic select (select count(t.x) from sbx_u) from sbx_t t; end
-- CREATE FUNCTION

> create function sbx_61() returns setof bigint begin atomic select x from sbx_t t group by x having exists (select 1 from sbx_u where sum(t.z) > 0); end
-- CREATE FUNCTION

> create function sbx_70() returns setof int begin atomic with recursive r(n) as (select 1 union all select n + 1 from r where n < 3) search depth first by n set ord select n from r; end
-- CREATE FUNCTION

> create function sbx_71() returns setof int begin atomic with recursive r(n) as (select 1 union all select n + 1 from r where n < 3) cycle n set is_cycle using path select n from r; end
-- CREATE FUNCTION

> create function sbx_80() returns setof int begin atomic select a from rows from (generate_series(1,2), generate_series(1,3)) as f(a, b); end
-- CREATE FUNCTION

> create function sbx_81() returns setof text begin atomic select b from json_to_record('{"a":1}') as r(a int, b text); end
-- CREATE FUNCTION

> create function sbx_82() returns setof bigint begin atomic select o from rows from (generate_series(1,2)) with ordinality as f(a, o); end
-- CREATE FUNCTION

> create table sby_t (x int primary key, y text, z numeric, arr int[], d date, ts timestamptz, f float8)
-- CREATE TABLE

> create table sby_u (x int, w text)
-- CREATE TABLE

> create table sby_g (x int generated always as identity, y text)
-- CREATE TABLE

> create table sby_h (x int generated by default as identity, y text)
-- CREATE TABLE

> create function sby_01() returns setof int begin atomic select t.x from sby_t t join sby_u u on t.x = u.x for update of t, u; end
-- CREATE FUNCTION

> create function sby_02() returns setof int begin atomic select t.x from sby_t t, sby_u u for share of u for update of t nowait; end
-- CREATE FUNCTION

> create function sby_03() returns setof int begin atomic select x from sby_t where x > 1 order by x limit 2 for update skip locked; end
-- CREATE FUNCTION

> create function sby_10() returns void begin atomic insert into sby_h overriding user value select x, w from sby_u; end
-- CREATE FUNCTION

> create function sby_11() returns void begin atomic insert into sby_g (x, y) overriding system value values (1, 'a') returning x; end
-- CREATE FUNCTION

> create function sby_20() returns setof text begin atomic merge into sby_t t using sby_u u on t.x = u.x when matched then update set y = u.w when not matched then insert (x, y) values (u.x, u.w) returning merge_action(); end
-- CREATE FUNCTION

> create function sby_30() returns void begin atomic update sby_t set (y, z) = (select w, 1 from sby_u limit 1), d = current_date, (arr, x) = (select array[1], 2); end
-- CREATE FUNCTION

> create function sby_31() returns void begin atomic update sby_t set arr[1:2] = array[5, 6], z = 1; end
-- CREATE FUNCTION

> create function sby_32() returns void begin atomic update sby_t set (y) = row('q'); end
-- CREATE FUNCTION

> create function sby_40() returns setof bigint begin atomic select count(*) from sby_t group by cube (x, y, z); end
-- CREATE FUNCTION

> create function sby_41() returns setof bigint begin atomic select count(*) from sby_t group by rollup ((x, y), z); end
-- CREATE FUNCTION

> create function sby_42() returns setof text begin atomic select y from sby_t group by grouping sets (y, (y, z)) having grouping(y, z) = 0 order by y; end
-- CREATE FUNCTION

> create function sby_43() returns setof int begin atomic select grouping(x) + grouping(x, y) from sby_t group by grouping sets ((x), (x, y), ()); end
-- CREATE FUNCTION

> create function sby_44() returns setof bigint begin atomic select sum(x) from sby_t group by y, grouping sets ((z), ()); end
-- CREATE FUNCTION

> create function sby_50() returns setof float8 begin atomic select sum(f) over (order by f range between 1.5 preceding and unbounded following) from sby_t; end
-- CREATE FUNCTION

> create function sby_51() returns setof numeric begin atomic select sum(z) over (order by ts range between interval '1 hour' preceding and current row) from sby_t; end
-- CREATE FUNCTION

> create function sby_52() returns setof numeric begin atomic select sum(z) over (order by x desc nulls last range between current row and 3 following) from sby_t; end
-- CREATE FUNCTION

> create function sby_53() returns setof numeric begin atomic select sum(z) over (order by x range between 2::bigint preceding and current row) from sby_t; end
-- CREATE FUNCTION

> create function sby_60() returns setof bigint begin atomic select (select (select count(t.x) from sby_u u2) from sby_u u1 limit 1) from sby_t t; end
-- CREATE FUNCTION

> create function sby_61() returns setof bigint begin atomic select (select sum(t.x + u.x) from sby_u u) from sby_t t; end
-- CREATE FUNCTION

> create function sby_70() returns setof int begin atomic with recursive r(n) as (select 1 union all select n + 1 from r where n < 3) search breadth first by n set ord select n from r order by ord; end
-- CREATE FUNCTION

> create function sby_71() returns setof int begin atomic with recursive r(n, m) as (select 1, 2 union all select n + 1, m from r where n < 3) cycle n, m set c to 'Y' default 'N' using p select n from r; end
-- CREATE FUNCTION

> create function sby_72() returns setof int begin atomic with recursive r(n) as (select 1 union all select n + 1 from r where n < 3) search depth first by n set ord cycle n set c using p select n from r; end
-- CREATE FUNCTION

> create function sby_80() returns setof bigint begin atomic select o from rows from (generate_series(1,2), generate_series(1,3), unnest(array['a','b'])) with ordinality as f(a, b, c, o); end
-- CREATE FUNCTION

> create function sby_81() returns setof int begin atomic select a from rows from (json_to_record('{"a":1}') as (a int, b text), generate_series(1,2)) as f; end
-- CREATE FUNCTION

> create function sby_82() returns setof varchar begin atomic select b from json_to_recordset('[{"a":1}]') as r(a int, b varchar(10)); end
-- CREATE FUNCTION

