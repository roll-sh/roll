24:00:00 | 1
30 days | 1
NULL | 1
-- SELECT 4

> SELECT DISTINCT 1 AS c1, a FROM a68d ORDER BY 1, 2
c1:int4 | a:interval
1 | 02:00:00
1 | 24:00:00
1 | 30 days
1 | NULL
-- SELECT 4

> SELECT DISTINCT 'x' AS c0, a FROM a68d ORDER BY 1, 2
c0:text | a:interval
x | 02:00:00
x | 24:00:00
x | 30 days
x | NULL
-- SELECT 4

> SELECT DISTINCT '{1,2}'::int4[] AS c0, 1 AS c1, a FROM a68d ORDER BY 1, 3
c0:int4[] | c1:int4 | a:interval
