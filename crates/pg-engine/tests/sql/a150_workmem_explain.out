> create table a150t (unique1 int, unique2 int, twenty int, thousand int, s text, pad text)
-- CREATE TABLE

> insert into a150t select g, 9999 - g, g % 20, g % 1000, md5(g::text), repeat('p', 30) from generate_series(0, 9999) g
-- INSERT 0 10000

