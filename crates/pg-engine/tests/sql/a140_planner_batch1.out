> EXPLAIN (COSTS OFF) SELECT c_custkey, c_name, sum(l_extendedprice) AS revenue, c_acctbal
> FROM a140_cust, a140_ord, a140_line
> WHERE c_custkey = o_custkey AND l_orderkey = o_orderkey
>   AND o_orderdate >= date '1993-10-01' AND o_orderdate < date '1994-01-01'
> GROUP BY c_custkey, c_name, c_acctbal
> ORDER BY revenue DESC LIMIT 20
QUERY PLAN:text
Limit
  ->  Sort
        Sort Key: (sum(a140_line.l_extendedprice)) DESC
        ->  GroupAggregate
              Group Key: a140_cust.c_custkey
              ->  Merge Join
                    Merge Cond: (a140_cust.c_custkey = a140_ord.o_custkey)
                    ->  Index Scan using a140_cust_pkey on a140_cust
                    ->  Materialize
                          ->  Sort
                                Sort Key: a140_ord.o_custkey
                                ->  Hash Join
                                      Hash Cond: (a140_line.l_orderkey = a140_ord.o_orderkey)
                                      ->  Seq Scan on a140_line
                                      ->  Hash
                                            ->  Seq Scan on a140_ord
                                                  Filter: ((o_orderdate >= '1993-10-01'::date) AND (o_orderdate < '1994-01-01'::date))
-- EXPLAIN

