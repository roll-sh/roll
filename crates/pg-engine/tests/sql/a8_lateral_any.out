-- SELECT 1

> explain (costs off)
> select b.unique1, b.hundred from la_b b
> where b.unique1 < 300
>   and b.hundred in (select sum(c.unique1) / 100 from la_b c where c.odd = b.odd and c.unique1 < 300 group by c.unique1 % 3)
QUERY PLAN:text
Nested Loop Semi Join
  ->  Seq Scan on la_b b
        Filter: (unique1 < 300)
  ->  Subquery Scan on "ANY_subquery"
        Filter: (b.hundred = "ANY_subquery"."?column?")
        ->  GroupAggregate
              Group Key: ((c.unique1 % 3))
              ->  Sort
                    Sort Key: ((c.unique1 % 3))
                    ->  Seq Scan on la_b c
                          Filter: ((unique1 < 300) AND (odd = b.odd))
-- EXPLAIN

