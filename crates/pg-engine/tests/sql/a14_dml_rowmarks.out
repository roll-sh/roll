> EXPLAIN (VERBOSE, COSTS OFF)
> WITH wcte AS (INSERT INTO a14_i VALUES (42, 47) RETURNING q2)
> DELETE FROM a14_p USING wcte WHERE aa = q2
QUERY PLAN:text
Delete on public.a14_p
  Delete on public.a14_p a14_p_1
  Delete on public.a14_c a14_p_2
  CTE wcte
    ->  Insert on public.a14_i
          Output: a14_i.q2
          ->  Result
                Output: '42'::bigint, '47'::bigint
  ->  Hash Join
        Output: wcte.*, a14_p.tableoid, a14_p.ctid
        Hash Cond: (a14_p.aa = wcte.q2)
        ->  Append
              ->  Seq Scan on public.a14_p a14_p_1
                    Output: a14_p_1.aa, a14_p_1.tableoid, a14_p_1.ctid
              ->  Seq Scan on public.a14_c a14_p_2
                    Output: a14_p_2.aa, a14_p_2.tableoid, a14_p_2.ctid
        ->  Hash
              Output: wcte.*, wcte.q2
              ->  CTE Scan on wcte
                    Output: wcte.*, wcte.q2
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF)
