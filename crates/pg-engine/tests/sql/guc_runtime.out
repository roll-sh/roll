> CREATE OR REPLACE FUNCTION gx_guc_f(int) RETURNS text AS $$
> begin
>   set work_mem = '2MB';
>   perform 1/$1;
>   return current_setting('work_mem');
> end $$ LANGUAGE plpgsql SET work_mem = '1MB'
