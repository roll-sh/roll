> EXPLAIN (VERBOSE, COSTS OFF)
> SELECT t1.*, i8.q2 FROM
>   a19_t t1
>   LEFT JOIN (SELECT *, '***'::text AS d1 FROM a19_i8 i8b1) b1
>     LEFT JOIN a19_i8 i8
>       LEFT JOIN (SELECT *, null::int AS d2 FROM a19_i8 i8b2, a19_i4 i4b2
>                  WHERE q1 = f1) b2
>       ON (i8.q1 = b2.q1)
>     ON (b2.d2 = b1.q2)
>   ON (t1.f1 = b1.d1)
QUERY PLAN:text
Nested Loop Left Join
  Output: t1.f1, i8.q2
  Join Filter: (t1.f1 = '***'::text)
  ->  Seq Scan on public.a19_t t1
        Output: t1.f1
  ->  Materialize
        Output: i8.q2
        ->  Hash Right Join
              Output: i8.q2
              Hash Cond: ((NULL::integer) = i8b1.q2)
              ->  Hash Right Join
                    Output: i8.q2, (NULL::integer)
                    Hash Cond: (i8b2.q1 = i8.q1)
                    ->  Hash Join
                          Output: i8b2.q1, NULL::integer
                          Hash Cond: (i8b2.q1 = i4b2.f1)
                          ->  Seq Scan on public.a19_i8 i8b2
                                Output: i8b2.q1, i8b2.q2
                          ->  Hash
                                Output: i4b2.f1
                                ->  Seq Scan on public.a19_i4 i4b2
                                      Output: i4b2.f1
                    ->  Hash
                          Output: i8.q2, i8.q1
                          ->  Seq Scan on public.a19_i8 i8
                                Output: i8.q2, i8.q1
              ->  Hash
                    Output: i8b1.q2
                    ->  Seq Scan on public.a19_i8 i8b1
                          Output: i8b1.q2
-- EXPLAIN

