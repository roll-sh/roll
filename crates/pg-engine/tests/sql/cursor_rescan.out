> create procedure gx_cr_p() language plpgsql as $$
> declare r record;
> begin
>   for r in select a, gx_cr_n(a) as v from gx_cr_t order by a loop
>     raise notice 'row % %', r.a, r.v;
>     commit;
>   end loop;
> end $$
