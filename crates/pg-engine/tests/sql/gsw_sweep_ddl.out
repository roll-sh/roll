> SELECT conname, pg_get_constraintdef(oid, true) FROM pg_constraint WHERE conname LIKE 'gsw_jc%' ORDER BY 1
conname:name | pg_get_constraintdef:text
gsw_jc1 | CHECK (js IS JSON)
gsw_jc2 | CHECK (i > 0 AND i < 100)
gsw_jc3 | CHECK (JSON_VALUE(js::jsonb, '$."a"' RETURNING integer DEFAULT 12 ON EMPTY ERROR ON ERROR) > i)
gsw_jc4 | CHECK (js > ('a'::text COLLATE "C"))
