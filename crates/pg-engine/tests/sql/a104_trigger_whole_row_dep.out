HINT: Use DROP ... CASCADE to drop the dependent objects too.

> SELECT tgname, pg_get_triggerdef(oid) FROM pg_trigger WHERE tgrelid = 'a104_tw'::regclass ORDER BY 1
tgname:name | pg_get_triggerdef:text
a104_tw1 | CREATE TRIGGER a104_tw1 AFTER UPDATE ON public.a104_tw FOR EACH ROW WHEN ((old.* IS DISTINCT FROM new.*)) EXECUTE FUNCTION a104_twf()
a104_tw2 | CREATE TRIGGER a104_tw2 AFTER UPDATE ON public.a104_tw FOR EACH ROW WHEN ((old.a IS DISTINCT FROM new.a)) EXECUTE FUNCTION a104_twf()
a104_tw3 | CREATE TRIGGER a104_tw3 AFTER UPDATE OF b ON public.a104_tw FOR EACH ROW EXECUTE FUNCTION a104_twf()
a104_tw4 | CREATE TRIGGER a104_tw4 BEFORE UPDATE ON public.a104_tw FOR EACH ROW WHEN (((NOT (new.* IS DISTINCT FROM old.*)) AND (old.c IS NOT NULL))) EXECUTE FUNCTION a104_twf()
