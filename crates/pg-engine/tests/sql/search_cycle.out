> WITH RECURSIVE g AS (SELECT 1 AS n UNION ALL SELECT n + 1 FROM g WHERE n < 3) SEARCH BREADTH FIRST BY n SET ord SELECT *, pg_typeof(ord) FROM g ORDER BY ord
n:int4 | ord:record | pg_typeof:regtype
1 | (0,1) | record
2 | (1,2) | record
3 | (2,3) | record
