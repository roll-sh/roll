2 | 3 | {"(1,2)","(2,3)"} | n | {(1),(2)}
3 | 1 | {"(1,2)","(2,3)","(3,1)"} | n | {(1),(2),(3)}
1 | 2 | {"(1,2)","(2,3)","(3,1)","(1,2)"} | y | {(1),(2),(3),(1)}
3 | 4 | {"(1,2)","(2,3)","(3,4)"} | n | {(1),(2),(3)}
4 | 5 | {"(1,2)","(2,3)","(3,4)","(4,5)"} | n | {(1),(2),(3),(4)}
-- SELECT 6

> WITH RECURSIVE w(a, b) AS (SELECT a, b FROM edge WHERE a = 1 UNION ALL SELECT e.a, e.b FROM edge e, w WHERE e.a = w.b) SEARCH BREADTH FIRST BY b SET s CYCLE b SET c USING p SELECT a, b, s, c FROM w ORDER BY s
a:int4 | b:int4 | s:record | c:bool
