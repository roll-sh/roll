> WITH RECURSIVE w(a, b) AS (SELECT a, b FROM edge WHERE a = 1 UNION SELECT e.a, e.b FROM edge e JOIN w x ON e.a = x.b) CYCLE a, b SET c TO 1 DEFAULT 0 USING p SELECT count(*), sum(c) FROM w
count:int8 | sum:int8
6 | 1
-- SELECT 1

> WITH RECURSIVE w AS (SELECT a, b FROM edge WHERE a = 1 UNION ALL SELECT e.* FROM edge e JOIN w ON e.a = w.b) CYCLE a SET c USING p SELECT max(array_length(p, 1)) FROM w
max:int4
4
