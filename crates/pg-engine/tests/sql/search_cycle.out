> WITH RECURSIVE w(a, b) AS (SELECT a, b FROM edge WHERE a = 1 UNION ALL SELECT e.a, e.b FROM edge e JOIN w ON e.a = w.b) SEARCH DEPTH FIRST BY a, b SET s CYCLE a SET c TO 'y' DEFAULT 'n' USING p SELECT * FROM w ORDER BY s
a:int4 | b:int4 | s:2287 | c:text | p:2287
