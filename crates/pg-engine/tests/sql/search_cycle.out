> WITH RECURSIVE w(a, b) AS (SELECT a, b FROM edge WHERE a = 1 UNION ALL SELECT e.a, e.b FROM edge e JOIN w ON e.a = w.b) CYCLE a SET is_cycle USING path SELECT *, pg_typeof(path) FROM w ORDER BY path
a:int4 | b:int4 | is_cycle:bool | path:2287 | pg_typeof:regtype
