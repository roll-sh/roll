2 | 3 | f | {(1),(2)} | record[]
3 | 1 | f | {(1),(2),(3)} | record[]
3 | 4 | f | {(1),(2),(3)} | record[]
1 | 2 | t | {(1),(2),(3),(1)} | record[]
4 | 5 | f | {(1),(2),(3),(4)} | record[]
