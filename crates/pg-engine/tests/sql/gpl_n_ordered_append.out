> CREATE TABLE gpl_oa (a int, b int, c int) PARTITION BY RANGE (a, b)
-- CREATE TABLE

> CREATE TABLE gpl_oa1 PARTITION OF gpl_oa FOR VALUES FROM (0, 0) TO (10, 10)
-- CREATE TABLE

> CREATE TABLE gpl_oa2 PARTITION OF gpl_oa FOR VALUES FROM (10, 10) TO (20, 20)
-- CREATE TABLE

> CREATE TABLE gpl_oa3 PARTITION OF gpl_oa FOR VALUES FROM (20, 20) TO (30, 30) PARTITION BY LIST (a)
-- CREATE TABLE

> CREATE TABLE gpl_oa3a PARTITION OF gpl_oa3 FOR VALUES IN (20, 22)
-- CREATE TABLE

> CREATE TABLE gpl_oa3b PARTITION OF gpl_oa3 FOR VALUES IN (21)
-- CREATE TABLE

> CREATE INDEX ON gpl_oa (a, b, c)
-- CREATE INDEX

> INSERT INTO gpl_oa SELECT i % 23, i % 23, i FROM generate_series(1, 690) i
-- INSERT 0 690

> VACUUM ANALYZE gpl_oa
-- VACUUM

> SET enable_seqscan = off
-- SET

> SET enable_bitmapscan = off
-- SET

> EXPLAIN (COSTS OFF) SELECT * FROM gpl_oa WHERE a < 20 ORDER BY a, b, c
QUERY PLAN:text
Append
  ->  Index Only Scan using gpl_oa1_a_b_c_idx on gpl_oa1 gpl_oa_1
        Index Cond: (a < 20)
  ->  Index Only Scan using gpl_oa2_a_b_c_idx on gpl_oa2 gpl_oa_2
        Index Cond: (a < 20)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM gpl_oa WHERE a < 20 ORDER BY a DESC, b DESC, c DESC
QUERY PLAN:text
Append
  ->  Index Only Scan Backward using gpl_oa2_a_b_c_idx on gpl_oa2 gpl_oa_2
        Index Cond: (a < 20)
  ->  Index Only Scan Backward using gpl_oa1_a_b_c_idx on gpl_oa1 gpl_oa_1
        Index Cond: (a < 20)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM gpl_oa ORDER BY a, b
QUERY PLAN:text
Append
  ->  Index Only Scan using gpl_oa1_a_b_c_idx on gpl_oa1 gpl_oa_1
  ->  Index Only Scan using gpl_oa2_a_b_c_idx on gpl_oa2 gpl_oa_2
  ->  Merge Append
        Sort Key: gpl_oa_4.a, gpl_oa_4.b
        ->  Index Only Scan using gpl_oa3a_a_b_c_idx on gpl_oa3a gpl_oa_4
        ->  Index Only Scan using gpl_oa3b_a_b_c_idx on gpl_oa3b gpl_oa_5
-- EXPLAIN

> SELECT a, b, c FROM gpl_oa ORDER BY a, b, c LIMIT 3
a:int4 | b:int4 | c:int4
0 | 0 | 23
0 | 0 | 46
0 | 0 | 69
-- SELECT 3

> SELECT a, b, c FROM gpl_oa ORDER BY a DESC, b DESC, c DESC LIMIT 3
a:int4 | b:int4 | c:int4
22 | 22 | 689
22 | 22 | 666
22 | 22 | 643
-- SELECT 3

> SELECT a, count(*) FROM (SELECT a FROM gpl_oa WHERE a BETWEEN 18 AND 23 ORDER BY a, b) s GROUP BY a ORDER BY a
a:int4 | count:int8
18 | 30
19 | 30
20 | 30
21 | 30
22 | 30
-- SELECT 5

> EXPLAIN (COSTS OFF) SELECT * FROM gpl_oa WHERE a IN (21, 22) ORDER BY a
QUERY PLAN:text
Merge Append
  Sort Key: gpl_oa_1.a
  ->  Index Only Scan using gpl_oa3a_a_b_c_idx on gpl_oa3a gpl_oa_1
        Index Cond: (a = ANY ('{21,22}'::integer[]))
  ->  Index Only Scan using gpl_oa3b_a_b_c_idx on gpl_oa3b gpl_oa_2
        Index Cond: (a = ANY ('{21,22}'::integer[]))
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM gpl_oa WHERE a = 5 ORDER BY a, b, c
QUERY PLAN:text
Index Only Scan using gpl_oa1_a_b_c_idx on gpl_oa1 gpl_oa
  Index Cond: (a = 5)
-- EXPLAIN

> RESET enable_seqscan
-- RESET

> RESET enable_bitmapscan
-- RESET

> DROP TABLE gpl_oa
-- DROP TABLE

