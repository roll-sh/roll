-- ANALYZE

> explain (costs off)
> select a.id, ss.* from a33_a a left join lateral
>   (select b.id as bid, c.x, least(a.v, b.w, c.x) as l from a33_b b join a33_c c on b.id = c.id) ss
>   on a.id = ss.bid order by 1, 2, 3, 4
QUERY PLAN:text
Sort
  Sort Key: a.id, b.id, c.x, (LEAST(a.v, b.w, c.x))
  ->  Nested Loop Left Join
        ->  Seq Scan on a33_a a
        ->  Nested Loop
              Join Filter: (b.id = c.id)
              ->  Seq Scan on a33_b b
                    Filter: (a.id = id)
              ->  Seq Scan on a33_c c
-- EXPLAIN

> select a.id, ss.* from a33_a a left join lateral
>   (select b.id as bid, c.x, least(a.v, b.w, c.x) as l from a33_b b join a33_c c on b.id = c.id) ss
>   on a.id = ss.bid order by 1, 2, 3, 4
