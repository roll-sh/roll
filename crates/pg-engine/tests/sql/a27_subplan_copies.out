> explain (costs off)
> select ss.x, ss.y from (select (select max(a) from spc_b x where x.b = spc_a.b) x, spc_b.a y from spc_a join spc_b on spc_a.a = spc_b.a) ss, spc_a
> where spc_a.b = ss.x % 5 and ss.y < 5
QUERY PLAN:text
Hash Join
  Hash Cond: (((SubPlan 4) % 5) = spc_a.b)
  ->  Hash Join
        Hash Cond: (spc_a_1.a = spc_b.a)
        ->  Seq Scan on spc_a spc_a_1
        ->  Hash
              ->  Seq Scan on spc_b
                    Filter: (a < 5)
  ->  Hash
        ->  Seq Scan on spc_a
  SubPlan 2
    ->  Result
          InitPlan 1
            ->  Limit
                  ->  Index Scan Backward using spc_b_a_idx on spc_b x
                        Index Cond: (a IS NOT NULL)
                        Filter: (b = spc_a_1.b)
  SubPlan 4
    ->  Result
          InitPlan 3
            ->  Limit
                  ->  Index Scan Backward using spc_b_a_idx on spc_b x_1
                        Index Cond: (a IS NOT NULL)
                        Filter: (b = spc_a_1.b)
-- EXPLAIN

