> explain (verbose, costs off)
> select ss.x, ss.a from (select (select max(a) from spc_b where spc_b.b = spc_a.b) x, a from spc_a) ss where ss.x > 5
QUERY PLAN:text
Seq Scan on public.spc_a
  Output: (SubPlan 2), spc_a.a
  Filter: ((SubPlan 4) > 5)
  SubPlan 2
    ->  Result
          Output: (InitPlan 1).col1
          InitPlan 1
            ->  Limit
                  Output: spc_b.a
                  ->  Index Scan Backward using spc_b_a_idx on public.spc_b
                        Output: spc_b.a
                        Index Cond: (spc_b.a IS NOT NULL)
                        Filter: (spc_b.b = spc_a.b)
  SubPlan 4
    ->  Result
          Output: (InitPlan 3).col1
          InitPlan 3
            ->  Limit
                  Output: spc_b_1.a
                  ->  Index Scan Backward using spc_b_a_idx on public.spc_b spc_b_1
                        Output: spc_b_1.a
                        Index Cond: (spc_b_1.a IS NOT NULL)
                        Filter: (spc_b_1.b = spc_a.b)
-- EXPLAIN

