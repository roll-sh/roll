> explain (costs off) select * from puo_h where a = 5 and b = 2
QUERY PLAN:text
Seq Scan on puo_h0 puo_h
  Filter: ((a = 5) AND (b = 2))
-- EXPLAIN

> explain (costs off) select * from puo_h where a is null and b is null
QUERY PLAN:text
Seq Scan on puo_h0 puo_h
  Filter: ((a IS NULL) AND (b IS NULL))
-- EXPLAIN

> explain (costs off) select * from puo_h where a = 1 and b is null
QUERY PLAN:text
Seq Scan on puo_h1 puo_h
  Filter: ((b IS NULL) AND (a = 1))
-- EXPLAIN

> explain (costs off) select * from puo_h where a = 5
QUERY PLAN:text
Append
  ->  Seq Scan on puo_h0 puo_h_1
        Filter: (a = 5)
  ->  Seq Scan on puo_h1 puo_h_2
        Filter: (a = 5)
  ->  Seq Scan on puo_h2 puo_h_3
        Filter: (a = 5)
  ->  Seq Scan on puo_h3 puo_h_4
        Filter: (a = 5)
-- EXPLAIN

