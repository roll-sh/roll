> create function a12_stable_one() returns int as $$ begin return 1; end; $$ language plpgsql stable
-- CREATE FUNCTION

> create table a12_pa (a int, b text, c bool) partition by list (a)
-- CREATE TABLE

> create table a12_pa_1 (b text, a int, c bool)
-- CREATE TABLE

> create table a12_pa_2 (a int, c bool, b text)
-- CREATE TABLE

> alter table a12_pa attach partition a12_pa_1 for values in (1)
-- ALTER TABLE

> alter table a12_pa attach partition a12_pa_2 for values in (2)
-- ALTER TABLE

> insert into a12_pa values (1, 'b', true)
-- INSERT 0 1

> insert into a12_pa values (2, 'c', true)
-- INSERT 0 1

> create index on a12_pa (a)
-- CREATE INDEX

> alter table a12_pa add d int
-- ALTER TABLE

> create table a12_pa_3 partition of a12_pa for values in (3, 4) partition by range (d)
-- CREATE TABLE

> create table a12_pa_3_1 partition of a12_pa_3 for values from (minvalue) to (1)
-- CREATE TABLE

> create table a12_pa_3_2 partition of a12_pa_3 for values from (1) to (100)
-- CREATE TABLE

> create table a12_pa_3_3 partition of a12_pa_3 for values from (100) to (maxvalue)
-- CREATE TABLE

> explain (costs off)
> select min(a) over (partition by a order by a) from a12_pa where a >= 2
QUERY PLAN:text
WindowAgg
  Window: w1 AS (PARTITION BY a12_pa.a ORDER BY a12_pa.a)
  ->  Sort
        Sort Key: a12_pa.a
        ->  Append
              ->  Seq Scan on a12_pa_2 a12_pa_1
                    Filter: (a >= 2)
              ->  Bitmap Heap Scan on a12_pa_3_1 a12_pa_2
                    Recheck Cond: (a >= 2)
                    ->  Bitmap Index Scan on a12_pa_3_1_a_idx
                          Index Cond: (a >= 2)
              ->  Bitmap Heap Scan on a12_pa_3_2 a12_pa_3
                    Recheck Cond: (a >= 2)
                    ->  Bitmap Index Scan on a12_pa_3_2_a_idx
                          Index Cond: (a >= 2)
              ->  Bitmap Heap Scan on a12_pa_3_3 a12_pa_4
                    Recheck Cond: (a >= 2)
                    ->  Bitmap Index Scan on a12_pa_3_3_a_idx
                          Index Cond: (a >= 2)
-- EXPLAIN

> explain (costs off)
> select a from a12_pa where a >= a12_stable_one() + 1 order by a
QUERY PLAN:text
Append
  Subplans Removed: 1
  ->  Index Only Scan using a12_pa_2_a_idx on a12_pa_2 a12_pa_1
        Index Cond: (a >= (a12_stable_one() + 1))
  ->  Merge Append
        Sort Key: a12_pa_3.a
        ->  Index Only Scan using a12_pa_3_1_a_idx on a12_pa_3_1 a12_pa_3
              Index Cond: (a >= (a12_stable_one() + 1))
        ->  Index Only Scan using a12_pa_3_2_a_idx on a12_pa_3_2 a12_pa_4
              Index Cond: (a >= (a12_stable_one() + 1))
        ->  Index Only Scan using a12_pa_3_3_a_idx on a12_pa_3_3 a12_pa_5
              Index Cond: (a >= (a12_stable_one() + 1))
-- EXPLAIN

