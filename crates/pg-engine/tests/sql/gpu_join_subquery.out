> SELECT t1.a, t1.c, t2.b, t2.c FROM gpu_p1 t1 RIGHT JOIN gpu_p2 t2 ON t1.a = t2.b WHERE t2.a = 0 ORDER BY t1.a, t2.b
QUERY PLAN:text
Sort
  Sort Key: t1.a, t2.b
  ->  Append
        ->  Hash Right Join
              Hash Cond: (t1_1.a = t2_1.b)
              ->  Seq Scan on gpu_p1_p1 t1_1
              ->  Hash
                    ->  Seq Scan on gpu_p2_p1 t2_1
                          Filter: (a = 0)
        ->  Hash Right Join
              Hash Cond: (t1_2.a = t2_2.b)
              ->  Seq Scan on gpu_p1_p2 t1_2
              ->  Hash
                    ->  Seq Scan on gpu_p2_p2 t2_2
                          Filter: (a = 0)
        ->  Nested Loop Left Join
              ->  Seq Scan on gpu_p2_p3 t2_3
                    Filter: (a = 0)
              ->  Index Scan using gpu_p1_p3_a on gpu_p1_p3 t1_3
                    Index Cond: (a = t2_3.b)
