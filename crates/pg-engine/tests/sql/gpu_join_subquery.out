> EXPLAIN (COSTS OFF)
> SELECT a.f1 FROM gpu_t4 a
>   LEFT JOIN (SELECT b.f1 FROM gpu_t3 b LEFT JOIN gpu_t3 c ON (b.f1 = c.f1)
>              WHERE COALESCE(c.f1, 0) = 0) AS d ON (a.f1 = d.f1)
> WHERE COALESCE(d.f1, 0) = 0 ORDER BY 1
QUERY PLAN:text
Sort
  Sort Key: a.f1
  ->  Hash Right Join
        Hash Cond: (b.f1 = a.f1)
        Filter: (COALESCE(b.f1, 0) = 0)
        ->  Hash Left Join
              Hash Cond: (b.f1 = c.f1)
              Filter: (COALESCE(c.f1, 0) = 0)
              ->  Seq Scan on gpu_t3 b
              ->  Hash
                    ->  Seq Scan on gpu_t3 c
        ->  Hash
              ->  Seq Scan on gpu_t4 a
-- EXPLAIN

