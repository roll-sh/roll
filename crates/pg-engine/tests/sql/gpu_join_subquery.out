-- INSERT 0 3

> ANALYZE gpu_i4
-- ANALYZE

> EXPLAIN (VERBOSE, COSTS OFF)
> SELECT i8.*, ss.v FROM gpu_i8 i8
>   LEFT JOIN gpu_i4 i4 ON i4.f1 = 1
>   LEFT JOIN LATERAL (SELECT i4.f1 + 1 AS v) AS ss ON true
>   LEFT JOIN gpu_n1 t ON t.id = ss.v
> WHERE q2 = 456
QUERY PLAN:text
Nested Loop Left Join
  Output: i8.q1, i8.q2, (i4.f1 + 1)
  ->  Seq Scan on public.gpu_i8 i8
        Output: i8.q1, i8.q2
        Filter: (i8.q2 = 456)
  ->  Materialize
        Output: i4.f1
        ->  Seq Scan on public.gpu_i4 i4
              Output: i4.f1
              Filter: (i4.f1 = 1)
-- EXPLAIN

