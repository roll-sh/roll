> EXPLAIN (COSTS OFF)
> SELECT n3.id FROM gpu_n3 n3 JOIN gpu_n2 n2 ON n2.id = n3.n2_id JOIN gpu_n1 n1 ON n1.id = n2.n1_id
> WHERE n3.id = 1 AND (n2.b1 OR n1.a1)
QUERY PLAN:text
Nested Loop
  ->  Nested Loop
        ->  Index Scan using gpu_n3_pkey on gpu_n3 n3
              Index Cond: (id = 1)
        ->  Index Scan using gpu_n2_pkey on gpu_n2 n2
              Index Cond: (id = n3.n2_id)
  ->  Index Scan using gpu_n1_pkey on gpu_n1 n1
        Index Cond: (id = n2.n1_id)
        Filter: (n2.b1 OR a1)
-- EXPLAIN

> EXPLAIN (COSTS OFF)
> SELECT n3.id FROM gpu_n3 n3 JOIN gpu_n2 n2 ON n2.id = n3.n2_id JOIN gpu_n1 n1 ON n1.id = n2.n1_id
> WHERE n3.id = 1 AND CASE WHEN n2.b1 THEN n1.id IS NOT NULL ELSE false END
QUERY PLAN:text
Nested Loop
  ->  Nested Loop
        ->  Index Scan using gpu_n3_pkey on gpu_n3 n3
              Index Cond: (id = 1)
        ->  Index Scan using gpu_n2_pkey on gpu_n2 n2
              Index Cond: (id = n3.n2_id)
  ->  Index Only Scan using gpu_n1_pkey on gpu_n1 n1
        Index Cond: (id = n2.n1_id)
        Filter: CASE WHEN n2.b1 THEN (id IS NOT NULL) ELSE false END
-- EXPLAIN

> SELECT n3.id FROM gpu_n3 n3 JOIN gpu_n2 n2 ON n2.id = n3.n2_id JOIN gpu_n1 n1 ON n1.id = n2.n1_id
> WHERE n3.id = 1 AND (n2.b1 OR n1.a1)
