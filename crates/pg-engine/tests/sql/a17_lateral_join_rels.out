> EXPLAIN (VERBOSE, COSTS OFF)
> SELECT * FROM a17_i8 a,
>   a17_i8 x LEFT JOIN LATERAL (SELECT a.q1 FROM a17_i4 y) ss(z) ON x.q2 = ss.z
>   ORDER BY a.q1, a.q2, x.q1, x.q2, ss.z
QUERY PLAN:text
Sort
  Output: a.q1, a.q2, x.q1, x.q2, (a.q1)
  Sort Key: a.q1, a.q2, x.q1, x.q2, (a.q1)
  ->  Nested Loop
        Output: a.q1, a.q2, x.q1, x.q2, (a.q1)
        ->  Seq Scan on public.a17_i8 a
              Output: a.q1, a.q2
        ->  Hash Left Join
              Output: x.q1, x.q2, (a.q1)
              Hash Cond: (x.q2 = (a.q1))
              ->  Seq Scan on public.a17_i8 x
                    Output: x.q1, x.q2
              ->  Hash
                    Output: (a.q1)
                    ->  Seq Scan on public.a17_i4 y
                          Output: a.q1
-- EXPLAIN

