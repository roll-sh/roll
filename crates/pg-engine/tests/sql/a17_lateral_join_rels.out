> EXPLAIN (VERBOSE, COSTS OFF)
> SELECT * FROM generate_series(1, 3) x, generate_series(1, 3) y,
>   JSON_TABLE(jsonb '[[1,2,3],[2,3,4,5],[3,4,5,6]]', 'strict $[*] ? (@[*] <= $x)'
>     PASSING x AS x, y AS y
>     COLUMNS (y text FORMAT JSON PATH '$',
>       NESTED PATH 'strict $[*] ? (@ == $y)' COLUMNS (z int PATH '$'))) jt
QUERY PLAN:text
Nested Loop
  Output: x.x, y.y, jt.y, jt.z
  ->  Function Scan on pg_catalog.generate_series y
        Output: y.y
        Function Call: generate_series(1, 3)
  ->  Nested Loop
        Output: x.x, jt.y, jt.z
        ->  Function Scan on pg_catalog.generate_series x
              Output: x.x
              Function Call: generate_series(1, 3)
        ->  Table Function Scan on "json_table" jt
              Output: jt.y, jt.z
              Table Function Call: JSON_TABLE('[[1, 2, 3], [2, 3, 4, 5], [3, 4, 5, 6]]'::jsonb, 'strict $[*]?(@[*] <= $"x")' AS json_table_path_0 PASSING x.x AS x, y.y AS y COLUMNS (y text FORMAT JSON PATH '$' WITHOUT WRAPPER KEEP QUOTES, NESTED PATH 'strict $[*]?(@ == $"y")' AS json_table_path_1 COLUMNS (z integer PATH '$')))
-- EXPLAIN

