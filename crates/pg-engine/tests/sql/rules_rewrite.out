> SELECT tablename, rulename, definition FROM pg_rules WHERE tablename LIKE 'rr_%' ORDER BY 1, 2
tablename:name | rulename:name | definition:text
rr_a | rr_a_1 | CREATE RULE rr_a_1 AS
    ON INSERT TO public.rr_a
   WHERE (new.a >= 20) DO  INSERT INTO rr_c (a, b)
  VALUES (new.a, new.b);
rr_a | rr_a_2 | CREATE RULE rr_a_2 AS
    ON INSERT TO public.rr_a
   WHERE ((new.a >= 10) AND (new.a < 20)) DO INSTEAD  INSERT INTO rr_b (a, b)
  VALUES (new.a, new.b);
rr_a | rr_a_3 | CREATE RULE rr_a_3 AS
    ON INSERT TO public.rr_a
   WHERE (new.a < 5) DO INSTEAD NOTHING;
rr_emp | rr_emp_del | CREATE RULE rr_emp_del AS
    ON DELETE TO public.rr_emp DO  INSERT INTO rr_log (ename, action, newsal, oldsal)
  VALUES (old.ename, 'fired'::text, 0, old.salary);
rr_emp | rr_emp_ins | CREATE RULE rr_emp_ins AS
    ON INSERT TO public.rr_emp DO  INSERT INTO rr_log (ename, action, newsal, oldsal)
  VALUES (new.ename, 'hired'::text, new.salary, 0);
rr_emp | rr_emp_upd | CREATE RULE rr_emp_upd AS
    ON UPDATE TO public.rr_emp
   WHERE (new.salary <> old.salary) DO  INSERT INTO rr_log (ename, action, newsal, oldsal)
  VALUES (new.ename, 'honored'::text, new.salary, old.salary);
rr_retv | rr_retv_ins | CREATE RULE rr_retv_ins AS
    ON INSERT TO public.rr_retv DO INSTEAD  INSERT INTO rr_ret (f1, f2, tag)
  VALUES (new.f1, new.f2, 'via rule'::text)
  RETURNING rr_ret.f1,
    rr_ret.f2;
rr_retv | rr_retv_upd | CREATE RULE rr_retv_upd AS
    ON UPDATE TO public.rr_retv
   WHERE (new.f1 > 0) DO INSTEAD NOTHING;
rr_src | r1 | CREATE RULE r1 AS
    ON UPDATE TO public.rr_src DO  INSERT INTO rr_slog (f1, f2, tag, id) VALUES (old.f1,old.f2,'old'::text,DEFAULT), (new.f1,new.f2,'new'::text,DEFAULT);
rr_src | r2 | CREATE RULE r2 AS
    ON UPDATE TO public.rr_src DO  VALUES (old.f1,old.f2,'old'::text), (new.f1,new.f2,'new'::text);
rr_src | r3 | CREATE RULE r3 AS
    ON DELETE TO public.rr_src DO INSTEAD ( INSERT INTO rr_slog (f1, f2, tag)
  VALUES (old.f1, 0, 'deleted'::text);
 INSERT INTO rr_slog (f1, f2, tag)
  VALUES (old.f2, 0, 'deleted'::text);
);
rr_v1 | rr_v1_del | CREATE RULE rr_v1_del AS
    ON DELETE TO public.rr_v1 DO INSTEAD  DELETE FROM rr_t1
  WHERE (rr_t1.a = old.a);
rr_v1 | rr_v1_ins | CREATE RULE rr_v1_ins AS
    ON INSERT TO public.rr_v1 DO INSTEAD  INSERT INTO rr_t1 (a, b)
  VALUES (new.a, new.b);
rr_v1 | rr_v1_upd | CREATE RULE rr_v1_upd AS
    ON UPDATE TO public.rr_v1 DO INSTEAD  UPDATE rr_t1 SET a = new.a, b = new.b
  WHERE (rr_t1.a = old.a);
