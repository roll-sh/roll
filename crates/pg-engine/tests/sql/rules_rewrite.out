-- CREATE RULE

> CREATE RULE rr_v1_upd AS ON UPDATE TO rr_v1 DO INSTEAD UPDATE rr_t1 SET a = new.a, b = new.b WHERE a = old.a
-- CREATE RULE

> CREATE RULE rr_v1_del AS ON DELETE TO rr_v1 DO INSTEAD DELETE FROM rr_t1 WHERE a = old.a
-- CREATE RULE

