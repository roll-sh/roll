              ->  Hash Full Join
                    Hash Cond: ((COALESCE(gpu_f1_1.a, p2_1.a) = p3_1.a) AND (COALESCE(gpu_f1_1.b, p2_1.b) = p3_1.b))
                    ->  Hash Full Join
                          Hash Cond: ((gpu_f1_1.a = p2_1.a) AND (gpu_f1_1.b = p2_1.b))
                          ->  Seq Scan on gpu_f1_p1 gpu_f1_1
                          ->  Hash
                                ->  Seq Scan on gpu_f2_p1 p2_1
                    ->  Hash
                          ->  Seq Scan on gpu_f2_p1 p3_1
              ->  Hash
                    ->  Seq Scan on gpu_f1_p1 p4_1
        ->  Hash Full Join
              Hash Cond: ((COALESCE(COALESCE(gpu_f1_2.a, p2_2.a), p3_2.a) = p4_2.a) AND (COALESCE(COALESCE(gpu_f1_2.b, p2_2.b), p3_2.b) = p4_2.b))
              Filter: ((COALESCE(COALESCE(COALESCE(gpu_f1_2.a, p2_2.a), p3_2.a), p4_2.a) >= 490) AND (COALESCE(COALESCE(COALESCE(gpu_f1_2.a, p2_2.a), p3_2.a), p4_2.a) <= 510))
              ->  Hash Full Join
                    Hash Cond: ((COALESCE(gpu_f1_2.a, p2_2.a) = p3_2.a) AND (COALESCE(gpu_f1_2.b, p2_2.b) = p3_2.b))
                    ->  Hash Full Join
                          Hash Cond: ((gpu_f1_2.a = p2_2.a) AND (gpu_f1_2.b = p2_2.b))
                          ->  Seq Scan on gpu_f1_p2 gpu_f1_2
                          ->  Hash
                                ->  Seq Scan on gpu_f2_p2 p2_2
                    ->  Hash
                          ->  Seq Scan on gpu_f2_p2 p3_2
              ->  Hash
                    ->  Seq Scan on gpu_f1_p2 p4_2
        ->  Hash Full Join
              Hash Cond: ((COALESCE(COALESCE(gpu_f1_3.a, p2_3.a), p3_3.a) = p4_3.a) AND (COALESCE(COALESCE(gpu_f1_3.b, p2_3.b), p3_3.b) = p4_3.b))
              Filter: ((COALESCE(COALESCE(COALESCE(gpu_f1_3.a, p2_3.a), p3_3.a), p4_3.a) >= 490) AND (COALESCE(COALESCE(COALESCE(gpu_f1_3.a, p2_3.a), p3_3.a), p4_3.a) <= 510))
