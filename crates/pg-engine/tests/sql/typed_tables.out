> CREATE TYPE tt_person AS (name text, age int)
-- CREATE TYPE

> CREATE TABLE tt_people OF tt_person
-- CREATE TABLE

> INSERT INTO tt_people VALUES ('ann', 30)
-- INSERT 0 1

> SELECT * FROM tt_people
name:text | age:int4
ann | 30
-- SELECT 1

> CREATE TABLE tt_people2 OF tt_person (PRIMARY KEY (name), age WITH OPTIONS DEFAULT 18 NOT NULL CHECK (age >= 0))
-- CREATE TABLE

> INSERT INTO tt_people2 (name) VALUES ('bob')
-- INSERT 0 1

> INSERT INTO tt_people2 VALUES ('carl', -1)
ERROR 23514: new row for relation "tt_people2" violates check constraint "tt_people2_age_check"
DETAIL: Failing row contains (carl, -1).
OBJECTS: schema=public table=tt_people2 constraint=tt_people2_age_check

> SELECT * FROM tt_people2
name:text | age:int4
bob | 18
-- SELECT 1

> SELECT relname, reloftype::regtype FROM pg_class WHERE relname LIKE 'tt_people%' ORDER BY 1
relname:name | reloftype:regtype
tt_people | tt_person
tt_people2 | tt_person
tt_people2_pkey | -
-- SELECT 3

> SELECT attname, attislocal, attnotnull FROM pg_attribute WHERE attrelid = 'tt_people2'::regclass AND attnum > 0 ORDER BY attnum
attname:name | attislocal:bool | attnotnull:bool
name | t | t
age | t | t
-- SELECT 2

