> CREATE TABLE gpl_m1 (id integer PRIMARY KEY) INHERITS (gpl_m0)
NOTICE 00000: merging column "id" with inherited definition
-- CREATE TABLE

> CREATE TABLE gpl_m2 (id integer PRIMARY KEY) INHERITS (gpl_m0)
NOTICE 00000: merging column "id" with inherited definition
-- CREATE TABLE

> CREATE INDEX gpl_m0i ON gpl_m0 ((1 - id))
-- CREATE INDEX

> CREATE INDEX gpl_m1i ON gpl_m1 ((1 - id))
-- CREATE INDEX

> INSERT INTO gpl_m1 (name) VALUES ('a'), ('b')
-- INSERT 0 2

> INSERT INTO gpl_m2 (name) VALUES ('c'), ('d')
-- INSERT 0 2

> SET enable_seqscan = off
-- SET

> SET enable_parallel_append = off
-- SET

> EXPLAIN (VERBOSE, COSTS OFF) SELECT * FROM gpl_m0 ORDER BY 1 - id
QUERY PLAN:text
Merge Append
  Sort Key: ((1 - gpl_m0.id))
  ->  Index Scan using gpl_m0i on public.gpl_m0 gpl_m0_1
        Output: gpl_m0_1.id, gpl_m0_1.name, (1 - gpl_m0_1.id)
  ->  Index Scan using gpl_m1i on public.gpl_m1 gpl_m0_2
        Output: gpl_m0_2.id, gpl_m0_2.name, (1 - gpl_m0_2.id)
  ->  Sort
        Output: gpl_m0_3.id, gpl_m0_3.name, ((1 - gpl_m0_3.id))
        Sort Key: ((1 - gpl_m0_3.id))
        ->  Seq Scan on public.gpl_m2 gpl_m0_3
              Disabled: true
              Output: gpl_m0_3.id, gpl_m0_3.name, (1 - gpl_m0_3.id)
-- EXPLAIN

> SELECT * FROM gpl_m0 ORDER BY 1 - id
id:int4 | name:text
4 | d
3 | c
2 | b
1 | a
-- SELECT 4

> EXPLAIN (VERBOSE, COSTS OFF) SELECT min(1 - id) FROM gpl_m0
QUERY PLAN:text
Result
  Output: (InitPlan 1).col1
  InitPlan 1
    ->  Limit
          Output: ((1 - gpl_m0.id))
          ->  Result
                Output: ((1 - gpl_m0.id))
                ->  Merge Append
                      Sort Key: ((1 - gpl_m0.id))
                      ->  Index Scan using gpl_m0i on public.gpl_m0 gpl_m0_1
                            Output: gpl_m0_1.id, (1 - gpl_m0_1.id)
                            Index Cond: ((1 - gpl_m0_1.id) IS NOT NULL)
                      ->  Index Scan using gpl_m1i on public.gpl_m1 gpl_m0_2
                            Output: gpl_m0_2.id, (1 - gpl_m0_2.id)
                            Index Cond: ((1 - gpl_m0_2.id) IS NOT NULL)
                      ->  Sort
                            Output: gpl_m0_3.id, ((1 - gpl_m0_3.id))
                            Sort Key: ((1 - gpl_m0_3.id))
                            ->  Bitmap Heap Scan on public.gpl_m2 gpl_m0_3
                                  Output: gpl_m0_3.id, (1 - gpl_m0_3.id)
                                  Filter: ((1 - gpl_m0_3.id) IS NOT NULL)
                                  ->  Bitmap Index Scan on gpl_m2_pkey
-- EXPLAIN

> SELECT min(1 - id) FROM gpl_m0
min:int4
-3
-- SELECT 1

