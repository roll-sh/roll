ERROR 42804: column "f1" is of type di_dpa[] but expression is of type di_posint[] (at 26)
HINT: You will need to rewrite or cast the expression.

> insert into di_a values (array[array[1]::di_dpa], array[2], array[3])
-- INSERT 0 1

> select pg_typeof(f1), pg_typeof(f1[1]), pg_typeof(f1[1][1]), pg_typeof((f1[1])[1]), pg_typeof(f2), pg_typeof(f2[1]), pg_typeof(f3), pg_typeof(f3[1]) from di_a
pg_typeof:regtype | pg_typeof:regtype | pg_typeof:regtype | pg_typeof:regtype | pg_typeof:regtype | pg_typeof:regtype | pg_typeof:regtype | pg_typeof:regtype
di_dpa[] | di_dpa | di_dpa | di_posint | di_dpa | di_posint | di_posint[] | di_posint
-- SELECT 1

