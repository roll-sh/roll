pg_typeof:regtype | pg_typeof:regtype
di_dpa2 | di_posint
-- SELECT 1

> select typname, typbasetype::regtype, typelem::regtype, typarray::regtype from pg_type where typname in ('di_dpa', 'di_dpa2', '_di_dpa2') order by 1
typname:name | typbasetype:regtype | typelem:regtype | typarray:regtype
_di_dpa2 | - | di_dpa2 | -
di_dpa | di_posint[] | - | di_dpa[]
di_dpa2 | di_dpa | - | di_dpa2[]
-- SELECT 3

> create table di_a (f1 di_dpa[], f2 di_dpa, f3 di_posint[])
-- CREATE TABLE

