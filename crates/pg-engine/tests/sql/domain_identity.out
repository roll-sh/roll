f1:user | f2:user | f3:user | f1:user | f2:int4 | f3:int4 | f1:int4
{"{1}"} | {2} | {3} | {1} | 2 | 3 | 1
-- SELECT 1

> select pg_typeof(f2[1:1]), pg_typeof(f3[1:1]), pg_typeof(f1[1:1]) from di_a
pg_typeof:regtype | pg_typeof:regtype | pg_typeof:regtype
di_posint[] | di_posint[] | di_dpa[]
