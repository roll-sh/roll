> select proname, prosrc, pg_get_functiondef(oid) from pg_proc where proname in ('sbp_e9','sbp_e10') order by 1
proname:name | prosrc:text | pg_get_functiondef:text
sbp_e10 |  | CREATE OR REPLACE FUNCTION public.sbp_e10(x text)
 RETURNS text
 LANGUAGE sql
RETURN x

sbp_e9 |  | CREATE OR REPLACE FUNCTION public.sbp_e9(x integer)
 RETURNS integer
 LANGUAGE sql
BEGIN ATOMIC
 SELECT x AS x;
 SELECT x AS x;
END

