-- CREATE INDEX

> ANALYZE a6_pp
-- ANALYZE

> CREATE FUNCTION a6_psv(a int) RETURNS int AS $$ BEGIN RETURN a; END; $$
>   PARALLEL SAFE VOLATILE LANGUAGE plpgsql
