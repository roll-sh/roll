>   filler text)
-- CREATE TABLE

> INSERT INTO a6_pp SELECT i, i % 2, i % 4, i % 10, i % 100, i % 1000, repeat('x', 100)
>   FROM generate_series(0, 9999) i
-- INSERT 0 10000

> CREATE INDEX a6_pp_hundred ON a6_pp (hundred)
