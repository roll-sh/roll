> EXPLAIN (COSTS OFF, VERBOSE) SELECT * FROM JSON_TABLE('{}', '$' COLUMNS (q text PATH '$' WITH CONDITIONAL WRAPPER OMIT QUOTES EMPTY ARRAY ON EMPTY))
ERROR 42601: SQL/JSON QUOTES behavior must not be specified when WITH WRAPPER is used (at 74)

> CREATE VIEW jtv AS SELECT * FROM JSON_TABLE('[1]', '$[*]' COLUMNS (a int PATH '$', o FOR ORDINALITY, NESTED PATH '$' COLUMNS (b text PATH '$.b'))) t
-- CREATE VIEW

> SELECT pg_get_viewdef('jtv'::regclass, true)
pg_get_viewdef:text
 SELECT a,
    o,
    b
   FROM JSON_TABLE(
            '[1]'::text, '$[*]' AS json_table_path_0
            COLUMNS (
                a integer PATH '$',
                o FOR ORDINALITY,
                NESTED PATH '$' AS json_table_path_1
                COLUMNS (
                    b text PATH '$."b"'
                )
            )
        ) t;
-- SELECT 1

> SELECT pg_get_viewdef('jtv'::regclass)
pg_get_viewdef:text
 SELECT a,
    o,
    b
   FROM JSON_TABLE(
            '[1]'::text, '$[*]' AS json_table_path_0
            COLUMNS (
                a integer PATH '$',
                o FOR ORDINALITY,
                NESTED PATH '$' AS json_table_path_1
                COLUMNS (
                    b text PATH '$."b"'
                )
            )
        ) t;
-- SELECT 1

> SELECT * FROM jtv
a:int4 | o:int4 | b:text
1 | 1 | NULL
-- SELECT 1

> DROP VIEW jtv
-- DROP VIEW

> CREATE TABLE jtt2 (doc jsonb)
-- CREATE TABLE

> CREATE VIEW jtv2 AS SELECT t.* FROM jtt2, JSON_TABLE(doc, '$.items[*]' AS items PASSING 2 AS lim COLUMNS (n text PATH '$.n' DEFAULT 'none' ON EMPTY, q int PATH '$.q ? (@ > $lim)' NULL ON ERROR, w jsonb PATH '$' WITH WRAPPER, ex bool EXISTS PATH '$.q' ERROR ON ERROR) ERROR ON ERROR) t
-- CREATE VIEW

> SELECT pg_get_viewdef('jtv2'::regclass, true)
pg_get_viewdef:text
 SELECT t.n,
    t.q,
    t.w,
    t.ex
   FROM jtt2,
    LATERAL JSON_TABLE(
            jtt2.doc, '$."items"[*]' AS items
            PASSING
                2 AS lim
            COLUMNS (
                n text PATH '$."n"' DEFAULT 'none'::text ON EMPTY,
                q integer PATH '$."q"?(@ > $"lim")',
                w jsonb PATH '$' WITH UNCONDITIONAL WRAPPER KEEP QUOTES,
                ex boolean EXISTS PATH '$."q"' ERROR ON ERROR
            ) ERROR ON ERROR
        ) t;
-- SELECT 1

> DROP VIEW jtv2
-- DROP VIEW

> DROP TABLE jtt2
-- DROP TABLE

