Table Function Scan on "json_table"
  Output: a, o, j, t, e, d, b, c, cc
  Table Function Call: JSON_TABLE('[1]'::jsonb, '$[*]' AS p PASSING 1 AS x, 'a'::text AS y COLUMNS (a integer PATH '$', o FOR ORDINALITY, j jsonb PATH '$' WITHOUT WRAPPER KEEP QUOTES, t text FORMAT JSON PATH '$' WITHOUT WRAPPER KEEP QUOTES, e integer EXISTS PATH '$' TRUE ON ERROR, d integer PATH '$."d"' DEFAULT 3 ON EMPTY ERROR ON ERROR, NESTED PATH '$' AS json_table_path_0 COLUMNS (b text PATH '$."b"'), NESTED PATH '$' AS n2 COLUMNS (c text PATH '$."c"', NESTED PATH '$' AS json_table_path_1 COLUMNS (cc integer PATH '$."cc"'))) ERROR ON ERROR)
