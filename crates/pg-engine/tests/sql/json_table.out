> EXPLAIN (COSTS OFF, VERBOSE) SELECT * FROM JSON_TABLE('[1]'::jsonb, '$[*]' AS p PASSING 1 AS x, 'a' AS y COLUMNS (a int PATH '$', o FOR ORDINALITY, j jsonb PATH '$', t text FORMAT JSON PATH '$', e int EXISTS PATH '$' TRUE ON ERROR, d int PATH '$.d' DEFAULT 3 ON EMPTY ERROR ON ERROR, NESTED PATH '$' COLUMNS (b text PATH '$.b'), NESTED PATH '$' AS n2 COLUMNS (c text PATH '$.c', NESTED PATH '$' COLUMNS (cc int PATH '$.cc'))) ERROR ON ERROR)
