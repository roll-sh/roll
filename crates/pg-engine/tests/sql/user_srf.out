> CREATE TABLE us_t (v int)
-- CREATE TABLE

> INSERT INTO us_t VALUES (generate_series(1, 3))
-- INSERT 0 3

> INSERT INTO us_t VALUES (us_nums(2))
-- INSERT 0 2

> INSERT INTO us_t SELECT us_nums(2)
-- INSERT 0 2

> INSERT INTO us_t VALUES (1), (generate_series(1, 2))
ERROR 0A000: set-returning functions are not allowed in VALUES (at 31)

