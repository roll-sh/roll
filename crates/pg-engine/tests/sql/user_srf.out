> CREATE FUNCTION us_nums(n int) RETURNS SETOF int LANGUAGE sql AS $$ SELECT generate_series(1, n) $$
-- CREATE FUNCTION

> CREATE FUNCTION us_pairs(n int, OUT a int, OUT b text) RETURNS SETOF record LANGUAGE sql AS $$ SELECT i, 'v' || i FROM generate_series(1, n) i $$
-- CREATE FUNCTION

> CREATE FUNCTION us_tab(n int) RETURNS TABLE (x int, y int) LANGUAGE sql AS $$ SELECT i, i * i FROM generate_series(1, n) i $$
-- CREATE FUNCTION

> CREATE FUNCTION us_plpg(n int) RETURNS SETOF text LANGUAGE plpgsql AS $$
> BEGIN
>   FOR i IN 1..n LOOP RETURN NEXT 'p' || i; END LOOP;
> END $$
-- CREATE FUNCTION

> CREATE FUNCTION us_strict(n int) RETURNS SETOF int LANGUAGE sql STRICT AS $$ SELECT 42 $$
-- CREATE FUNCTION

> SELECT us_nums(3)
us_nums:int4
1
2
3
-- SELECT 3

> SELECT us_nums(2), us_nums(3)
us_nums:int4 | us_nums:int4
1 | 1
2 | 2
NULL | 3
-- SELECT 3

> SELECT us_nums(2), generate_series(10, 12)
us_nums:int4 | generate_series:int4
1 | 10
2 | 11
NULL | 12
-- SELECT 3

> SELECT us_pairs(2)
us_pairs:record
(1,v1)
(2,v2)
-- SELECT 2

> SELECT (us_pairs(2)).*
a:int4 | b:text
1 | v1
2 | v2
-- SELECT 2

> SELECT (us_pairs(2)).b
b:text
v1
v2
-- SELECT 2

> SELECT us_tab(3)
us_tab:record
(1,1)
(2,4)
(3,9)
-- SELECT 3

> SELECT (us_tab(2)).y
y:int4
1
4
-- SELECT 2

> SELECT us_plpg(3)
us_plpg:text
p1
p2
p3
-- SELECT 3

> SELECT us_strict(NULL), us_strict(1)
us_strict:int4 | us_strict:int4
NULL | 42
-- SELECT 1

> SELECT n, us_nums(n) FROM (VALUES (1), (2), (0)) v(n) ORDER BY 1, 2
n:int4 | us_nums:int4
1 | 1
2 | 1
2 | 2
-- SELECT 3

> SELECT us_nums(3) + 100 AS plus
plus:int4
101
102
103
-- SELECT 3

> SELECT * FROM us_nums(2) WHERE us_nums = 2
us_nums:int4
2
-- SELECT 1

