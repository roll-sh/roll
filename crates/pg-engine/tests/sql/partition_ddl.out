> CREATE TABLE q2 PARTITION OF q FOR VALUES FROM (6) TO (7)
ERROR 42P16: FROM must specify exactly one value per partitioning column

> CREATE TABLE q2 PARTITION OF q FOR VALUES FROM (2, 0) TO (10, 0)
