> 									WHERE nspname = tc.constraint_schema
> 								)
> 							)
> 					WHERE
> 						tc.table_name = 'users'
> 						AND tc.constraint_schema = 'public'
> 						AND tc.constraint_type = 'CHECK'
> 						AND con.contype = 'c'
