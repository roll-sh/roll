> create table rm1 (a int, b text)
-- CREATE TABLE

> create table rm2 (x int, y text)
-- CREATE TABLE

> create table rm3 (p int, q int)
-- CREATE TABLE

> insert into rm1 select g, 'b' || g from generate_series(1, 10) g
-- INSERT 0 10

> insert into rm2 select g, 'y' || g from generate_series(1, 10) g
-- INSERT 0 10

> insert into rm3 select g, g from generate_series(1, 10) g
-- INSERT 0 10

> analyze rm1, rm2, rm3
-- ANALYZE

> explain (verbose, costs off)
> select * from (select a, b from rm1 offset 0) s, rm2 where s.a = rm2.x for update of s
QUERY PLAN:text
LockRows
  Output: s.a, s.b, rm2.x, rm2.y, s.*, rm2.ctid
  ->  Hash Join
        Output: s.a, s.b, rm2.x, rm2.y, s.*, rm2.ctid
        Hash Cond: (s.a = rm2.x)
        ->  Subquery Scan on s
              Output: s.a, s.b, s.*
              ->  LockRows
                    Output: rm1.a, rm1.b, rm1.ctid
                    ->  Seq Scan on public.rm1
                          Output: rm1.a, rm1.b, rm1.ctid
        ->  Hash
              Output: rm2.x, rm2.y, rm2.ctid
              ->  Seq Scan on public.rm2
                    Output: rm2.x, rm2.y, rm2.ctid
-- EXPLAIN

> explain (verbose, costs off)
> select * from rm2, (select a, b from rm1 offset 0) s where s.a = rm2.x for update of s
QUERY PLAN:text
LockRows
  Output: rm2.x, rm2.y, s.a, s.b, rm2.ctid, s.*
  ->  Hash Join
        Output: rm2.x, rm2.y, s.a, s.b, rm2.ctid, s.*
        Hash Cond: (s.a = rm2.x)
        ->  Subquery Scan on s
              Output: s.a, s.b, s.*
              ->  LockRows
                    Output: rm1.a, rm1.b, rm1.ctid
                    ->  Seq Scan on public.rm1
                          Output: rm1.a, rm1.b, rm1.ctid
        ->  Hash
              Output: rm2.x, rm2.y, rm2.ctid
              ->  Seq Scan on public.rm2
                    Output: rm2.x, rm2.y, rm2.ctid
-- EXPLAIN

> explain (verbose, costs off)
> select * from (select a, b from rm1 offset 0) s, rm2, rm3 where s.a = rm2.x and rm3.p = rm2.x for update of rm3
QUERY PLAN:text
LockRows
  Output: s.a, s.b, rm2.x, rm2.y, rm3.p, rm3.q, rm3.ctid, s.*, rm2.ctid
  ->  Hash Join
        Output: s.a, s.b, rm2.x, rm2.y, rm3.p, rm3.q, rm3.ctid, s.*, rm2.ctid
        Hash Cond: (s.a = rm3.p)
        ->  Hash Join
              Output: s.a, s.b, s.*, rm2.x, rm2.y, rm2.ctid
              Hash Cond: (s.a = rm2.x)
              ->  Subquery Scan on s
                    Output: s.a, s.b, s.*
                    ->  Seq Scan on public.rm1
                          Output: rm1.a, rm1.b
              ->  Hash
                    Output: rm2.x, rm2.y, rm2.ctid
                    ->  Seq Scan on public.rm2
                          Output: rm2.x, rm2.y, rm2.ctid
        ->  Hash
              Output: rm3.p, rm3.q, rm3.ctid
              ->  Seq Scan on public.rm3
                    Output: rm3.p, rm3.q, rm3.ctid
-- EXPLAIN

> explain (verbose, costs off)
> select * from rm2, (values (1), (2)) v(c), generate_series(1, 3) g where v.c = rm2.x and g < rm2.x for update of rm2
QUERY PLAN:text
LockRows
  Output: rm2.x, rm2.y, "*VALUES*".column1, g.g, rm2.ctid, g.*, "*VALUES*".*
  ->  Nested Loop
        Output: rm2.x, rm2.y, "*VALUES*".column1, g.g, rm2.ctid, g.*, "*VALUES*".*
        Join Filter: (g.g < rm2.x)
        ->  Function Scan on pg_catalog.generate_series g
              Output: g.g, g.*
              Function Call: generate_series(1, 3)
        ->  Materialize
              Output: rm2.x, rm2.y, rm2.ctid, "*VALUES*".column1, "*VALUES*".*
              ->  Hash Join
                    Output: rm2.x, rm2.y, rm2.ctid, "*VALUES*".column1, "*VALUES*".*
                    Hash Cond: (rm2.x = "*VALUES*".column1)
                    ->  Seq Scan on public.rm2
                          Output: rm2.x, rm2.y, rm2.ctid
                    ->  Hash
                          Output: "*VALUES*".column1, "*VALUES*".*
                          ->  Values Scan on "*VALUES*"
                                Output: "*VALUES*".column1, "*VALUES*".*
-- EXPLAIN

> explain (verbose, costs off)
> with c as materialized (select * from rm3) select * from rm2, c, rm1 where c.p = rm2.x and rm1.b = rm2.y for update of rm1
QUERY PLAN:text
LockRows
  Output: rm2.x, rm2.y, c.p, c.q, rm1.a, rm1.b, rm1.ctid, rm2.ctid, c.*
  CTE c
    ->  Seq Scan on public.rm3
          Output: rm3.p, rm3.q
  ->  Hash Join
        Output: rm2.x, rm2.y, c.p, c.q, rm1.a, rm1.b, rm1.ctid, rm2.ctid, c.*
        Hash Cond: (rm2.y = rm1.b)
        ->  Hash Join
              Output: rm2.x, rm2.y, rm2.ctid, c.p, c.q, c.*
              Hash Cond: (rm2.x = c.p)
              ->  Seq Scan on public.rm2
                    Output: rm2.x, rm2.y, rm2.ctid
              ->  Hash
                    Output: c.p, c.q, c.*
                    ->  CTE Scan on c
                          Output: c.p, c.q, c.*
        ->  Hash
              Output: rm1.a, rm1.b, rm1.ctid
              ->  Seq Scan on public.rm1
                    Output: rm1.a, rm1.b, rm1.ctid
-- EXPLAIN

> explain (verbose, costs off)
> select * from rm3, rm2, rm1 where rm3.p = rm2.x and rm1.a = rm2.x for update of rm1, rm3
QUERY PLAN:text
LockRows
  Output: rm3.p, rm3.q, rm2.x, rm2.y, rm1.a, rm1.b, rm1.ctid, rm3.ctid, rm2.ctid
  ->  Hash Join
        Output: rm3.p, rm3.q, rm2.x, rm2.y, rm1.a, rm1.b, rm1.ctid, rm3.ctid, rm2.ctid
        Hash Cond: (rm3.p = rm1.a)
        ->  Hash Join
              Output: rm3.p, rm3.q, rm3.ctid, rm2.x, rm2.y, rm2.ctid
              Hash Cond: (rm3.p = rm2.x)
              ->  Seq Scan on public.rm3
                    Output: rm3.p, rm3.q, rm3.ctid
              ->  Hash
                    Output: rm2.x, rm2.y, rm2.ctid
                    ->  Seq Scan on public.rm2
                          Output: rm2.x, rm2.y, rm2.ctid
        ->  Hash
              Output: rm1.a, rm1.b, rm1.ctid
              ->  Seq Scan on public.rm1
                    Output: rm1.a, rm1.b, rm1.ctid
-- EXPLAIN

> explain (verbose, costs off)
> select * from rm3, rm2, rm1 where rm3.p = rm2.x and rm1.a = rm2.x for update of rm1 for share of rm3
QUERY PLAN:text
LockRows
  Output: rm3.p, rm3.q, rm2.x, rm2.y, rm1.a, rm1.b, rm1.ctid, rm3.ctid, rm2.ctid
  ->  Hash Join
        Output: rm3.p, rm3.q, rm2.x, rm2.y, rm1.a, rm1.b, rm1.ctid, rm3.ctid, rm2.ctid
        Hash Cond: (rm3.p = rm1.a)
        ->  Hash Join
              Output: rm3.p, rm3.q, rm3.ctid, rm2.x, rm2.y, rm2.ctid
              Hash Cond: (rm3.p = rm2.x)
              ->  Seq Scan on public.rm3
                    Output: rm3.p, rm3.q, rm3.ctid
              ->  Hash
                    Output: rm2.x, rm2.y, rm2.ctid
                    ->  Seq Scan on public.rm2
                          Output: rm2.x, rm2.y, rm2.ctid
        ->  Hash
              Output: rm1.a, rm1.b, rm1.ctid
              ->  Seq Scan on public.rm1
                    Output: rm1.a, rm1.b, rm1.ctid
-- EXPLAIN

> select * from rm3, rm2, rm1 where rm3.p = rm2.x and rm1.a = rm2.x and rm1.a < 3 order by 1 for update of rm1 for share of rm3
p:int4 | q:int4 | x:int4 | y:text | a:int4 | b:text
1 | 1 | 1 | y1 | 1 | b1
2 | 2 | 2 | y2 | 2 | b2
-- SELECT 2

> select * from rm3, rm1 where rm3.p = rm1.a and rm1.a < 3 order by 1 for share of rm1 for update of rm1, rm3 skip locked
p:int4 | q:int4 | a:int4 | b:text
1 | 1 | 1 | b1
2 | 2 | 2 | b2
-- SELECT 2

> explain (verbose, costs off)
> update rm1 set b = 'z' from rm3, (select x from rm2 offset 0) s where s.x = rm1.a and rm3.p = rm1.a and rm3.q < 3
QUERY PLAN:text
Update on public.rm1
  ->  Hash Join
        Output: 'z'::text, rm1.ctid, rm3.ctid, s.*
        Hash Cond: (s.x = rm1.a)
        ->  Subquery Scan on s
              Output: s.*, s.x
              ->  Seq Scan on public.rm2
                    Output: rm2.x
        ->  Hash
              Output: rm1.ctid, rm1.a, rm3.ctid, rm3.p
              ->  Hash Join
                    Output: rm1.ctid, rm1.a, rm3.ctid, rm3.p
                    Hash Cond: (rm1.a = rm3.p)
                    ->  Seq Scan on public.rm1
                          Output: rm1.ctid, rm1.a
                    ->  Hash
                          Output: rm3.ctid, rm3.p
                          ->  Seq Scan on public.rm3
                                Output: rm3.ctid, rm3.p
                                Filter: (rm3.q < 3)
-- EXPLAIN

> explain (verbose, costs off)
> update rm1 set b = 'z' from (values (1), (2)) v(c), rm3 where v.c = rm1.a and rm3.p < rm1.a
QUERY PLAN:text
Update on public.rm1
  ->  Nested Loop
        Output: 'z'::text, rm1.ctid, rm3.ctid, "*VALUES*".*
        Join Filter: (rm3.p < rm1.a)
        ->  Seq Scan on public.rm3
              Output: rm3.ctid, rm3.p
        ->  Materialize
              Output: rm1.ctid, rm1.a, "*VALUES*".*
              ->  Hash Join
                    Output: rm1.ctid, rm1.a, "*VALUES*".*
                    Hash Cond: (rm1.a = "*VALUES*".column1)
                    ->  Seq Scan on public.rm1
                          Output: rm1.ctid, rm1.a
                    ->  Hash
                          Output: "*VALUES*".*, "*VALUES*".column1
                          ->  Values Scan on "*VALUES*"
                                Output: "*VALUES*".*, "*VALUES*".column1
-- EXPLAIN

