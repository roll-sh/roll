Sort
  Sort Key: a88_jobs.id
  ->  Nested Loop
        ->  HashAggregate
              Group Key: "ANY_subquery".id
              ->  Subquery Scan on "ANY_subquery"
                    ->  Limit
                          ->  LockRows
                                ->  Sort
                                      Sort Key: a88_jobs_1.priority, a88_jobs_1.id
                                      ->  Seq Scan on a88_jobs a88_jobs_1
                                            Filter: (queue = 'q2'::text)
        ->  Index Scan using a88_jobs_pkey on a88_jobs
              Index Cond: (id = "ANY_subquery".id)
-- EXPLAIN

