-- CREATE INDEX

> analyze sp_p
-- ANALYZE

> explain select * from sp_p where b = 5 and c = 1
QUERY PLAN:text
Bitmap Heap Scan on sp_p  (cost=4.50..78.23 rows=29 width=25)
  Recheck Cond: ((b = 5) AND (c = 1))
  ->  Bitmap Index Scan on sp_p_part  (cost=0.00..4.50 rows=29 width=0)
        Index Cond: (b = 5)
-- EXPLAIN

> explain select * from sp_p where b = 5
QUERY PLAN:text
Bitmap Heap Scan on sp_p  (cost=27.59..184.82 rows=200 width=25)
  Recheck Cond: (b = 5)
  ->  Bitmap Index Scan on sp_p_cb  (cost=0.00..27.54 rows=200 width=0)
        Index Cond: (b = 5)
-- EXPLAIN

> explain select * from sp_p where a % 50 = 3
QUERY PLAN:text
Bitmap Heap Scan on sp_p  (cost=7.39..160.39 rows=400 width=25)
  Recheck Cond: ((a % 50) = 3)
  ->  Bitmap Index Scan on sp_p_expr  (cost=0.00..7.29 rows=400 width=0)
        Index Cond: ((a % 50) = 3)
-- EXPLAIN

> explain select * from sp_p where b = 7
QUERY PLAN:text
Bitmap Heap Scan on sp_p  (cost=27.59..184.82 rows=200 width=25)
  Recheck Cond: (b = 7)
  ->  Bitmap Index Scan on sp_p_cb  (cost=0.00..27.54 rows=200 width=0)
        Index Cond: (b = 7)
-- EXPLAIN

> explain select * from sp_p where c = 2 and b = 7
QUERY PLAN:text
Bitmap Heap Scan on sp_p  (cost=4.58..78.31 rows=29 width=25)
  Recheck Cond: ((c = 2) AND (b = 7))
  ->  Bitmap Index Scan on sp_p_cb  (cost=0.00..4.58 rows=29 width=0)
        Index Cond: ((c = 2) AND (b = 7))
-- EXPLAIN

> explain select * from sp_p where f
QUERY PLAN:text
Bitmap Heap Scan on sp_p  (cost=79.95..293.61 rows=6666 width=25)
  Recheck Cond: f
  ->  Bitmap Index Scan on sp_p_f  (cost=0.00..78.28 rows=6666 width=0)
        Index Cond: (f = true)
-- EXPLAIN

> explain select * from sp_p where not f
QUERY PLAN:text
Seq Scan on sp_p  (cost=0.00..347.00 rows=13334 width=25)
  Filter: (NOT f)
-- EXPLAIN

> explain select * from sp_p where a = 77
QUERY PLAN:text
Index Scan using sp_p_h on sp_p  (cost=0.00..8.02 rows=1 width=25)
  Index Cond: (a = 77)
-- EXPLAIN

> explain select * from sp_p where n = 5.5
QUERY PLAN:text
Index Scan using sp_p_n on sp_p  (cost=0.29..8.30 rows=1 width=25)
  Index Cond: (n = 5.5)
-- EXPLAIN

> explain select * from sp_p where n < 10
QUERY PLAN:text
Index Scan using sp_p_n on sp_p  (cost=0.29..10.02 rows=99 width=25)
  Index Cond: (n < '10'::numeric)
-- EXPLAIN

> explain select * from sp_p where c is not null and b = 3
QUERY PLAN:text
Bitmap Heap Scan on sp_p  (cost=28.09..185.33 rows=200 width=25)
  Recheck Cond: ((c IS NOT NULL) AND (b = 3))
  ->  Bitmap Index Scan on sp_p_cb  (cost=0.00..28.04 rows=200 width=0)
        Index Cond: ((c IS NOT NULL) AND (b = 3))
-- EXPLAIN

> explain select * from sp_p where a = 5 or a = 9
QUERY PLAN:text
Bitmap Heap Scan on sp_p  (cost=8.02..15.35 rows=2 width=25)
  Recheck Cond: ((a = 5) OR (a = 9))
  ->  BitmapOr  (cost=8.02..8.02 rows=2 width=0)
        ->  Bitmap Index Scan on sp_p_h  (cost=0.00..4.01 rows=1 width=0)
              Index Cond: (a = 5)
        ->  Bitmap Index Scan on sp_p_h  (cost=0.00..4.01 rows=1 width=0)
              Index Cond: (a = 9)
-- EXPLAIN

> explain select * from sp_p where (c = 1 and b = 2) or (c = 2 and b = 3)
QUERY PLAN:text
Bitmap Heap Scan on sp_p  (cost=9.10..119.96 rows=57 width=25)
  Recheck Cond: (((b = 2) AND (c = 1)) OR ((c = 2) AND (b = 3)))
  ->  BitmapOr  (cost=9.10..9.10 rows=57 width=0)
        ->  Bitmap Index Scan on sp_p_part  (cost=0.00..4.50 rows=29 width=0)
              Index Cond: (b = 2)
        ->  Bitmap Index Scan on sp_p_cb  (cost=0.00..4.58 rows=29 width=0)
              Index Cond: ((c = 2) AND (b = 3))
-- EXPLAIN

> explain select * from sp_p where c in (1, 2) and b = 50
QUERY PLAN:text
Bitmap Heap Scan on sp_p  (cost=9.17..119.74 rows=57 width=25)
  Recheck Cond: ((c = ANY ('{1,2}'::integer[])) AND (b = 50))
  ->  Bitmap Index Scan on sp_p_cb  (cost=0.00..9.15 rows=57 width=0)
        Index Cond: ((c = ANY ('{1,2}'::integer[])) AND (b = 50))
-- EXPLAIN

