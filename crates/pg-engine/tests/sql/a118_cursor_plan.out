> CREATE TABLE cq (k int, v text, PRIMARY KEY (k, v)) PARTITION BY RANGE (k)
-- CREATE TABLE

> CREATE TABLE cq1 PARTITION OF cq FOR VALUES FROM (MINVALUE) TO (10)
-- CREATE TABLE

> CREATE TABLE cq2 PARTITION OF cq FOR VALUES FROM (10) TO (20)
-- CREATE TABLE

> CREATE TABLE cq3 PARTITION OF cq FOR VALUES FROM (20) TO (30)
-- CREATE TABLE

> EXPLAIN SELECT * FROM cq ORDER BY k, v LIMIT 1
QUERY PLAN:text
Limit  (cost=0.46..0.51 rows=1 width=36)
  ->  Append  (cost=0.46..208.66 rows=3810 width=36)
        ->  Index Only Scan using cq1_pkey on cq1 cq_1  (cost=0.15..63.20 rows=1270 width=36)
        ->  Index Only Scan using cq2_pkey on cq2 cq_2  (cost=0.15..63.20 rows=1270 width=36)
        ->  Index Only Scan using cq3_pkey on cq3 cq_3  (cost=0.15..63.20 rows=1270 width=36)
-- EXPLAIN

> EXPLAIN SELECT * FROM cq WHERE k > 3 ORDER BY k DESC LIMIT 2
QUERY PLAN:text
Limit  (cost=0.46..0.71 rows=2 width=36)
  ->  Append  (cost=0.46..161.01 rows=1269 width=36)
        ->  Index Only Scan Backward using cq3_pkey on cq3 cq_3  (cost=0.15..51.56 rows=423 width=36)
              Index Cond: (k > 3)
        ->  Index Only Scan Backward using cq2_pkey on cq2 cq_2  (cost=0.15..51.56 rows=423 width=36)
              Index Cond: (k > 3)
        ->  Index Only Scan Backward using cq1_pkey on cq1 cq_1  (cost=0.15..51.56 rows=423 width=36)
              Index Cond: (k > 3)
-- EXPLAIN

