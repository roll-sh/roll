-- DROP EXTENSION

> CREATE EXTENSION seg
-- CREATE EXTENSION

> SELECT seg_center('1 .. 4'), seg_size('1 .. 4'), seg_lower('<1 .. >4'), seg_upper('~2 .. ')
seg_center:float4 | seg_size:float4 | seg_lower:float4 | seg_upper:float4
2.5 | 3 | 1 | Infinity
-- SELECT 1

> SELECT seg_union('1 .. 2', '1.50 .. 3.0'), seg_inter('1 .. 2', '1.50 .. 3.0')
seg_union:user | seg_inter:user
1 .. 3.0 | 1.50 .. 2
-- SELECT 1

> SELECT s FROM unnest(ARRAY['1 .. 2', '1.0 .. 2', '<1 .. 2', '~1 .. 2', '.. 2', '1 ..']::seg[]) s ORDER BY s
s:user
.. 2
<1 .. 2
~1 .. 2
1 .. 2
1 ..
1.0 .. 2
-- SELECT 6

> SELECT '1e40'::seg
ERROR 22003: "1e40" is out of range for type real (at 8)

> SELECT '1 2'::seg
