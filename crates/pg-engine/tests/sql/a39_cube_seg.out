> CREATE EXTENSION cube
-- CREATE EXTENSION

> SELECT cube_send('(1,2),(3,4)'::cube), cube_send('(5)'::cube)
cube_send:bytea | cube_send:bytea
\x000000023ff0000000000000400000000000000040080000000000004010000000000000 | \x800000014014000000000000
-- SELECT 1

> SELECT cube_coord_llur('(1,2),(3,4)'::cube, 3), cube_coord_llur('(1,2),(3,4)'::cube, -4), cube_ll_coord('(5,1),(1,5)', 1)
cube_coord_llur:float8 | cube_coord_llur:float8 | cube_ll_coord:float8
2 | -4 | 1
-- SELECT 1

> SELECT cube_coord('(1,2),(3,4)'::cube, 5)
ERROR 2202E: cube index 5 is out of bounds

> SELECT cube_enlarge('(1,2),(3,4)'::cube, -1.5, 2), cube_enlarge('(0)'::cube, 2, 3)
cube_enlarge:user | cube_enlarge:user
(2, 3) | (-2, -2, -2),(2, 2, 2)
-- SELECT 1

> CREATE TABLE a39_cb (c cube PRIMARY KEY)
-- CREATE TABLE

> INSERT INTO a39_cb VALUES ('(1,2)'), ('(0,5)'), ('(1,2),(3,4)'), ('(2,1)')
-- INSERT 0 4

> INSERT INTO a39_cb VALUES ('(2,1)')
ERROR 23505: duplicate key value violates unique constraint "a39_cb_pkey"
DETAIL: Key (c)=((2, 1)) already exists.
OBJECTS: schema=public table=a39_cb constraint=a39_cb_pkey

> SELECT c FROM a39_cb ORDER BY c
c:user
(0, 5)
(1, 2)
(1, 2),(3, 4)
(2, 1)
-- SELECT 4

> SELECT c, count(*) FROM (SELECT c FROM a39_cb UNION ALL SELECT '(1,2)') s GROUP BY c ORDER BY c
c:user | count:int8
(0, 5) | 1
(1, 2) | 2
(1, 2),(3, 4) | 1
(2, 1) | 1
-- SELECT 4

> SELECT c FROM a39_cb WHERE c = '(1,2)'
c:user
(1, 2)
-- SELECT 1

> SELECT min(c), max(c) FROM a39_cb
ERROR 42883: function min(cube) does not exist (at 8)
HINT: No function matches the given name and argument types. You might need to add explicit type casts.

