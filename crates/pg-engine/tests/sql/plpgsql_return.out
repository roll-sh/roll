> create function gx_f1() returns int begin atomic select 1; end
-- CREATE FUNCTION

> create function gx_f2(a int) returns int language sql return a + 1
-- CREATE FUNCTION

> create function gx_f3() returns int language sql as 'select 3'
-- CREATE FUNCTION

> select proname, prosrc, prosqlbody is not null, pg_get_functiondef(oid) from pg_proc where proname like 'gx_f_' order by 1
proname:name | prosrc:text | ?column?:bool | pg_get_functiondef:text
gx_f1 |  | t | CREATE OR REPLACE FUNCTION public.gx_f1()
 RETURNS integer
 LANGUAGE sql
BEGIN ATOMIC
 SELECT 1;
END

gx_f2 |  | t | CREATE OR REPLACE FUNCTION public.gx_f2(a integer)
 RETURNS integer
 LANGUAGE sql
RETURN (a + 1)

gx_f3 | select 3 | f | CREATE OR REPLACE FUNCTION public.gx_f3()
 RETURNS integer
 LANGUAGE sql
AS $function$select 3$function$

-- SELECT 3

