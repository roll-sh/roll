> create table jeq1 (a int, t text)
-- CREATE TABLE

> create table jeq2 (b int, u text)
-- CREATE TABLE

> create table jeq3 (c int)
-- CREATE TABLE

> create table jeq4 (d int primary key, e int)
-- CREATE TABLE

> insert into jeq1 select case when g % 3 = 0 then 1 else g end, 't' || (g % 50) from generate_series(1, 2000) g
-- INSERT 0 2000

> insert into jeq2 select case when g % 2 = 0 then 1 else g % 100 end, 'T' || (g % 30) from generate_series(1, 3000) g
-- INSERT 0 3000

> insert into jeq3 select g % 5 from generate_series(1, 50) g
-- INSERT 0 50

> insert into jeq4 select g, g % 10 from generate_series(1, 5000) g
-- INSERT 0 5000

> analyze jeq1
-- ANALYZE

> analyze jeq2
-- ANALYZE

> analyze jeq3
-- ANALYZE

> analyze jeq4
-- ANALYZE

> explain select count(*) from jeq1 join jeq2 on a = b join jeq3 on c = b
QUERY PLAN:text
Aggregate  (cost=51515.39..51515.40 rows=1 width=8)
  ->  Hash Join  (cost=212.10..42943.53 rows=3428743 width=0)
        Hash Cond: (jeq2.b = jeq1.a)
        ->  Seq Scan on jeq2  (cost=0.00..44.00 rows=3000 width=4)
        ->  Hash  (cost=128.22..128.22 rows=6710 width=8)
              ->  Hash Join  (cost=2.12..128.22 rows=6710 width=8)
                    Hash Cond: (jeq1.a = jeq3.c)
                    ->  Seq Scan on jeq1  (cost=0.00..29.00 rows=2000 width=4)
                    ->  Hash  (cost=1.50..1.50 rows=50 width=4)
                          ->  Seq Scan on jeq3  (cost=0.00..1.50 rows=50 width=4)
-- EXPLAIN

