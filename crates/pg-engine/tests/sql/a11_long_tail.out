-- ANALYZE

> CREATE VIEW a11_iv WITH (security_barrier = true) AS
> SELECT *, (SELECT d FROM a11_i11 WHERE a11_i11.a = a11_i1.a LIMIT 1) AS d
> FROM a11_i1 WHERE a > 5 AND EXISTS (SELECT 1 FROM a11_i12 WHERE a11_i12.a = a11_i1.a)
-- CREATE VIEW

> UPDATE a11_i1 SET a = a + 1 WHERE a = 8
-- UPDATE 4

> EXPLAIN (COSTS OFF) SELECT * FROM a11_iv WHERE b = 8
QUERY PLAN:text
Hash Semi Join
  Hash Cond: (a11_i1.a = a11_i12.a)
  ->  Append
        ->  Seq Scan on a11_i1 a11_i1_1
              Filter: ((a > 5) AND (b = '8'::double precision))
        ->  Seq Scan on a11_i11 a11_i1_2
              Filter: ((a > 5) AND (b = '8'::double precision))
        ->  Seq Scan on a11_i12 a11_i1_3
              Filter: ((a > 5) AND (b = '8'::double precision))
        ->  Seq Scan on a11_i111 a11_i1_4
              Filter: ((a > 5) AND (b = '8'::double precision))
  ->  Hash
        ->  Append
              ->  Seq Scan on a11_i12 a11_i12_1
              ->  Seq Scan on a11_i111 a11_i12_2
  SubPlan 1
    ->  Limit
          ->  Append
                ->  Seq Scan on a11_i11 a11_i11_1
                      Filter: (a = a11_i1.a)
                ->  Seq Scan on a11_i111 a11_i11_2
                      Filter: (a = a11_i1.a)
-- EXPLAIN

> SELECT * FROM a11_iv WHERE b = 8
a:int4 | b:float8 | c:text | d:text
9 | 8 | i1 | i11d
9 | 8 | i11 | i11d
9 | 8 | i111 | i11d
9 | 8 | i12 | i11d
-- SELECT 4

> EXPLAIN (COSTS OFF) SELECT * FROM a11_iv WHERE a = 7
QUERY PLAN:text
Nested Loop Semi Join
  ->  Append
        ->  Seq Scan on a11_i1 a11_i1_1
              Filter: ((a > 5) AND (a = 7))
        ->  Seq Scan on a11_i11 a11_i1_2
              Filter: ((a > 5) AND (a = 7))
        ->  Seq Scan on a11_i12 a11_i1_3
              Filter: ((a > 5) AND (a = 7))
        ->  Seq Scan on a11_i111 a11_i1_4
              Filter: ((a > 5) AND (a = 7))
  ->  Materialize
        ->  Append
              ->  Seq Scan on a11_i12 a11_i12_1
                    Filter: (a = 7)
              ->  Seq Scan on a11_i111 a11_i12_2
                    Filter: (a = 7)
  SubPlan 1
    ->  Limit
          ->  Append
                ->  Seq Scan on a11_i11 a11_i11_1
                      Filter: (a = a11_i1.a)
                ->  Seq Scan on a11_i111 a11_i11_2
                      Filter: (a = a11_i1.a)
-- EXPLAIN

> SELECT * FROM a11_iv WHERE a = 7
a:int4 | b:float8 | c:text | d:text
7 | 7 | i1 | i11d
7 | 7 | i11 | i11d
7 | 7 | i111 | i11d
7 | 7 | i12 | i11d
-- SELECT 4

> EXPLAIN (COSTS OFF) SELECT * FROM ONLY a11_i1 WHERE a > 5 AND EXISTS (SELECT 1 FROM ONLY a11_i12 WHERE a11_i12.a = a11_i1.a) AND a = 7
QUERY PLAN:text
Nested Loop Semi Join
  ->  Seq Scan on a11_i1
        Filter: ((a > 5) AND (a = 7))
  ->  Seq Scan on a11_i12
        Filter: (a = 7)
-- EXPLAIN

