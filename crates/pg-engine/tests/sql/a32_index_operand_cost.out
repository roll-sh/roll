-- RESET

> explain (costs off)
> select * from ioc_o, ioc_p where ioc_p.id > ioc_o.f1
QUERY PLAN:text
Nested Loop
  ->  Seq Scan on ioc_o
  ->  Append
        ->  Bitmap Heap Scan on ioc_p0 ioc_p_1
              Recheck Cond: (id > ioc_o.f1)
              ->  Bitmap Index Scan on ioc_p0_pkey
                    Index Cond: (id > ioc_o.f1)
        ->  Bitmap Heap Scan on ioc_p1 ioc_p_2
              Recheck Cond: (id > ioc_o.f1)
              ->  Bitmap Index Scan on ioc_p1_pkey
                    Index Cond: (id > ioc_o.f1)
-- EXPLAIN

> explain (costs off)
> select * from ioc_o, ioc_p where ioc_p.id > ioc_o.f1 + 1
QUERY PLAN:text
Nested Loop
  ->  Seq Scan on ioc_o
  ->  Append
        ->  Index Only Scan using ioc_p0_pkey on ioc_p0 ioc_p_1
              Index Cond: (id > (ioc_o.f1 + 1))
        ->  Index Only Scan using ioc_p1_pkey on ioc_p1 ioc_p_2
              Index Cond: (id > (ioc_o.f1 + 1))
-- EXPLAIN

