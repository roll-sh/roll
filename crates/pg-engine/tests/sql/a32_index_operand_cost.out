> set enable_bitmapscan = off
-- SET

> explain
> select * from ioc_o, ioc_t where ioc_t.id > abs(abs(abs(abs(ioc_o.f1)))) + 1 + 1 + 1 + 1 + 1 + 1
QUERY PLAN:text
Nested Loop  (cost=0.18..166.83 rows=4250 width=8)
