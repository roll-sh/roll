> CREATE TABLE a189_t (id int, v int, s text, d date)
-- CREATE TABLE

> INSERT INTO a189_t SELECT i, i % 100, md5(i::text), date '2000-01-01' + i % 3000 FROM generate_series(1, 200000) i
-- INSERT 0 200000

> CREATE TABLE a189_e (id int, v int, s text)
-- CREATE TABLE

> CREATE TABLE a189_dim (k int PRIMARY KEY, name text, w int)
-- CREATE TABLE

> INSERT INTO a189_dim SELECT k, 'name ' || (k % 7), k % 5 FROM generate_series(0, 99) k
-- INSERT 0 100

> ANALYZE a189_t
-- ANALYZE

> ANALYZE a189_dim
-- ANALYZE

> SELECT count(*), sum(id) FROM a189_t WHERE v > (SELECT avg(v) FROM a189_t WHERE id < 1000) AND substring(s FROM 1 FOR 1) IN ('a', 'b')
count:int8 | sum:int8
12420 | 1247796355
-- SELECT 1

> SELECT substring(s FROM 1 FOR 2) AS code, count(*), sum(v) FROM a189_t
>   WHERE v > (SELECT avg(v) FROM a189_t WHERE id < 50) AND substring(s FROM 1 FOR 2) IN ('13', 'a1', 'ff', '0b')
>   GROUP BY 1 ORDER BY 1
code:text | count:int8 | sum:int8
0b | 618 | 38760
13 | 623 | 38483
a1 | 534 | 34127
ff | 548 | 34524
-- SELECT 4

> SELECT count(*) FROM a189_t WHERE v > (SELECT 1 / (min(v) - min(v)) FROM a189_t) AND s LIKE 'a%'
ERROR 22012: division by zero

> SELECT count(*) FROM a189_e WHERE v > (SELECT 1 / (count(*) - count(*))::int FROM a189_e) AND s LIKE 'a%'
count:int8
0
-- SELECT 1

> SELECT count(*) FROM a189_t WHERE (CASE WHEN id % 2 = 0 THEN NULL ELSE v END) NOT IN (SELECT id FROM (VALUES (1), (NULL::int)) x(id))
count:int8
0
-- SELECT 1

> SELECT id FROM a189_t WHERE v NOT IN (SELECT id FROM a189_e) AND id < 5
id:int4
1
2
3
4
-- SELECT 4

> SELECT id FROM a189_t WHERE v IN (SELECT id FROM (VALUES (1), (NULL::int)) x(id)) AND id < 5
id:int4
1
-- SELECT 1

> SELECT id FROM a189_t WHERE v > (SELECT NULL::int)
id:int4
-- SELECT 0

> CREATE SEQUENCE a189_seq
-- CREATE SEQUENCE

> SELECT id FROM a189_t WHERE nextval('a189_seq') < (SELECT nextval('a189_seq'))
id:int4
1
-- SELECT 1

> ALTER SEQUENCE a189_seq RESTART
-- ALTER SEQUENCE

> PREPARE a189_p(int) AS SELECT count(*) FROM a189_t WHERE v < (SELECT nextval('a189_seq') + $1)
-- PREPARE

> EXECUTE a189_p(0)
count:int8
2000
-- SELECT 1

> EXECUTE a189_p(10)
count:int8
24000
-- SELECT 1

> SELECT last_value FROM a189_seq
last_value:int8
2
-- SELECT 1

> DEALLOCATE a189_p
-- DEALLOCATE

> DROP SEQUENCE a189_seq
-- DROP SEQUENCE

