> SELECT count(substring(CASE WHEN id % 3 = 0 THEN NULL ELSE s END FROM 2 FOR 0)), count(*) FROM a189_t WHERE substring(s FROM 2 FOR 1) = '7'
count:int8 | count:int8
8456 | 12639
-- SELECT 1

