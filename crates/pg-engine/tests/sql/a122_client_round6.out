> EXCEPTION WHEN not_null_violation THEN
>   GET STACKED DIAGNOSTICS c = COLUMN_NAME, t = TABLE_NAME, k = SCHEMA_NAME;
>   RAISE NOTICE '%: % (%.%.%)', SQLSTATE, SQLERRM, k, t, c;
> END $$
NOTICE 00000: 23502: null value in column "oid" of relation "pg_class" violates not-null constraint (pg_catalog.pg_class.oid)
