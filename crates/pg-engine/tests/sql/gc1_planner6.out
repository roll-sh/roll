Sort
  Sort Key: ss.x
  ->  Subquery Scan on ss
        Filter: (ss.x < 4)
        ->  HashAggregate
              Group Key: (1), (generate_series(1, 10))
              ->  Append
                    ->  ProjectSet
                          ->  Result
                    ->  Result
-- EXPLAIN

