> SELECT n, (SELECT min(id) FROM g6_ev WHERE id > n) FROM g6_n
QUERY PLAN:text
Seq Scan on g6_n
  SubPlan 2
    ->  Result
          InitPlan 1
            ->  Limit
                  ->  Merge Append
                        Sort Key: g6_ev.id
                        ->  Index Only Scan using g6_ev_pkey on g6_ev g6_ev_1
                              Index Cond: (id > g6_n.n)
                        ->  Sort
                              Sort Key: g6_ev_2.id
                              ->  Seq Scan on g6_ev_child g6_ev_2
                                    Filter: (id > g6_n.n)
-- EXPLAIN

