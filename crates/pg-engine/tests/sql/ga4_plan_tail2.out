> CREATE FUNCTION ga4_explain_memoize(query text) RETURNS SETOF text
> LANGUAGE plpgsql AS
> $$
> DECLARE
>     ln text;
> BEGIN
>     FOR ln IN
>         EXECUTE format('explain (analyze, costs off, summary off, timing off, buffers off) %s', query)
>     LOOP
>         ln := regexp_replace(ln, 'Evictions: 0', 'Evictions: Zero');
>         ln := regexp_replace(ln, 'Evictions: \d+', 'Evictions: N');
>         ln := regexp_replace(ln, 'Memory Usage: \d+', 'Memory Usage: N');
>         ln := regexp_replace(ln, 'Heap Fetches: \d+', 'Heap Fetches: N');
>         ln := regexp_replace(ln, 'loops=\d+', 'loops=N');
>         ln := regexp_replace(ln, 'Index Searches: \d+', 'Index Searches: N');
>         RETURN NEXT ln;
>     END LOOP;
> END;
> $$
-- CREATE FUNCTION

> CREATE TABLE ga4_flt (f float)
-- CREATE TABLE

> CREATE INDEX ga4_flt_f_idx ON ga4_flt (f)
-- CREATE INDEX

> INSERT INTO ga4_flt VALUES ('-0.0'::float), ('+0.0'::float)
-- INSERT 0 2

> ANALYZE ga4_flt
-- ANALYZE

> SET enable_seqscan TO off
-- SET

> SET enable_hashjoin TO off
-- SET

> SET enable_mergejoin TO off
-- SET

> SET enable_bitmapscan TO off
-- SET

> SELECT ga4_explain_memoize('SELECT * FROM ga4_flt f1 INNER JOIN ga4_flt f2 ON f1.f >= f2.f;')
ga4_explain_memoize:text
              Heap Fetches: N
              Index Cond: (f <= f1.f)
              Index Searches: N
        ->  Index Only Scan using ga4_flt_f_idx on ga4_flt f2 (actual rows=2.00 loops=N)
        Cache Key: f1.f
        Cache Mode: binary
        Heap Fetches: N
        Hits: 0  Misses: 2  Evictions: Zero  Overflows: 0  Memory Usage: NkB
        Index Searches: N
  ->  Index Only Scan using ga4_flt_f_idx on ga4_flt f1 (actual rows=2.00 loops=N)
  ->  Memoize (actual rows=2.00 loops=N)
Nested Loop (actual rows=4.00 loops=N)
-- SELECT 12

> SELECT ga4_explain_memoize('SELECT * FROM ga4_flt f1 INNER JOIN ga4_flt f2 ON f1.f = f2.f;')
ga4_explain_memoize:text
              Heap Fetches: N
              Index Cond: (f = f1.f)
              Index Searches: N
        ->  Index Only Scan using ga4_flt_f_idx on ga4_flt f2 (actual rows=2.00 loops=N)
        Cache Key: f1.f
        Cache Mode: logical
        Heap Fetches: N
        Hits: 1  Misses: 1  Evictions: Zero  Overflows: 0  Memory Usage: NkB
        Index Searches: N
  ->  Index Only Scan using ga4_flt_f_idx on ga4_flt f1 (actual rows=2.00 loops=N)
  ->  Memoize (actual rows=2.00 loops=N)
Nested Loop (actual rows=4.00 loops=N)
-- SELECT 12

> RESET enable_seqscan
-- RESET

