> EXPLAIN (COSTS OFF) SELECT * FROM (SELECT a, b, row_number() OVER (ORDER BY a, b) rn FROM gc3_p1) s WHERE rn <= 3
QUERY PLAN:text
WindowAgg
  Window: w1 AS (ORDER BY gc3_p1.a, gc3_p1.b ROWS UNBOUNDED PRECEDING)
  Run Condition: (row_number() OVER w1 <= 3)
  ->  Sort
        Sort Key: gc3_p1.a, gc3_p1.b
        ->  Seq Scan on gc3_p1
-- EXPLAIN

> SELECT * FROM (SELECT a, b, row_number() OVER (ORDER BY a, b) rn FROM gc3_p1) s WHERE rn <= 3
a:int4 | b:int4 | rn:int8
0 | 0 | 1
0 | 0 | 2
0 | 0 | 3
-- SELECT 3

> EXPLAIN (COSTS OFF) SELECT * FROM (SELECT a, b, count(*) OVER (PARTITION BY a ORDER BY b) c FROM gc3_p1) s WHERE c <= 2
QUERY PLAN:text
WindowAgg
  Window: w1 AS (PARTITION BY gc3_p1.a ORDER BY gc3_p1.b)
  Run Condition: (count(*) OVER w1 <= 2)
  ->  Sort
        Sort Key: gc3_p1.a, gc3_p1.b
        ->  Seq Scan on gc3_p1
-- EXPLAIN

> SELECT * FROM (SELECT a, b, count(*) OVER (PARTITION BY a ORDER BY b) c FROM gc3_p1) s WHERE c <= 2
a:int4 | b:int4 | c:int8
-- SELECT 0

> EXPLAIN (VERBOSE, COSTS OFF) SELECT a, sum(b) OVER (ORDER BY a ROWS BETWEEN 1 PRECEDING AND CURRENT ROW), rank() OVER (ORDER BY a) FROM gc3_p2 LIMIT 3
QUERY PLAN:text
Limit
  Output: a, (sum(b) OVER w1), (rank() OVER w2)
  ->  WindowAgg
        Output: a, (sum(b) OVER w1), rank() OVER w2
        Window: w2 AS (ORDER BY gc3_p2.a ROWS UNBOUNDED PRECEDING)
        ->  WindowAgg
              Output: a, b, sum(b) OVER w1
              Window: w1 AS (ORDER BY gc3_p2.a ROWS BETWEEN '1'::bigint PRECEDING AND CURRENT ROW)
              ->  Sort
                    Output: a, b
                    Sort Key: gc3_p2.a
                    ->  Seq Scan on public.gc3_p2
                          Output: a, b
-- EXPLAIN

