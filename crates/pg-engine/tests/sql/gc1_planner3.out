-- CREATE TABLE

> CREATE TABLE gc3_p2 PARTITION OF gc3_p FOR VALUES IN (3, 4, 5)
-- CREATE TABLE

> CREATE TABLE gc3_p3 PARTITION OF gc3_p FOR VALUES IN (6, 7, 8, 9)
-- CREATE TABLE

> INSERT INTO gc3_p SELECT i % 10, i % 7, to_char(i % 4, 'FM0000') FROM generate_series(1, 3000) i
-- INSERT 0 3000

> ANALYZE gc3_p
-- ANALYZE

> SET enable_partitionwise_aggregate = on
-- SET

> EXPLAIN (COSTS OFF) SELECT a, sum(b), count(*) FROM gc3_p GROUP BY a HAVING avg(b) < 3.2 ORDER BY 1
QUERY PLAN:text
Sort
  Sort Key: gc3_p.a
  ->  Append
        ->  HashAggregate
              Group Key: gc3_p.a
              Filter: (avg(gc3_p.b) < 3.2)
              ->  Seq Scan on gc3_p1 gc3_p
        ->  HashAggregate
              Group Key: gc3_p_1.a
              Filter: (avg(gc3_p_1.b) < 3.2)
              ->  Seq Scan on gc3_p2 gc3_p_1
        ->  HashAggregate
              Group Key: gc3_p_2.a
              Filter: (avg(gc3_p_2.b) < 3.2)
              ->  Seq Scan on gc3_p3 gc3_p_2
-- EXPLAIN

