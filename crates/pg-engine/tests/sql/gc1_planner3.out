QUERY PLAN:text
Finalize GroupAggregate
  Group Key: gc3_p.b
  ->  Sort
        Sort Key: gc3_p.b
        ->  Append
              ->  Partial HashAggregate
                    Group Key: gc3_p.b
                    ->  Seq Scan on gc3_p1 gc3_p
              ->  Partial HashAggregate
                    Group Key: gc3_p_1.b
                    ->  Seq Scan on gc3_p2 gc3_p_1
              ->  Partial HashAggregate
                    Group Key: gc3_p_2.b
                    ->  Seq Scan on gc3_p3 gc3_p_2
-- EXPLAIN

