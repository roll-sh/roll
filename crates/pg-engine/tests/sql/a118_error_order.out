> CREATE TABLE eo (id int PRIMARY KEY, b text)
-- CREATE TABLE

> CREATE FUNCTION eo_tr() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE NOTICE 'row %', NEW.id; RETURN NEW; END $$
-- CREATE FUNCTION

> CREATE TRIGGER eo_b BEFORE INSERT ON eo FOR EACH ROW EXECUTE FUNCTION eo_tr()
-- CREATE TRIGGER

> INSERT INTO eo VALUES (2, 'x')
NOTICE 00000: row 2
CONTEXT: PL/pgSQL function eo_tr() line 1 at RAISE
-- INSERT 0 1

> COPY eo FROM STDIN (FORMAT csv)
>> 1,a
>> 3,"b
NOTICE 00000: row 1
CONTEXT: PL/pgSQL function eo_tr() line 1 at RAISE
CONTEXT: COPY eo, line 1: "1,a"
ERROR 22P04: unterminated CSV quoted field
CONTEXT: COPY eo, line 3: "3,"b
CONTEXT: "

> COPY eo FROM STDIN (FORMAT csv)
>> 1,a
>> 2,b
>> 3,"c
NOTICE 00000: row 1
CONTEXT: PL/pgSQL function eo_tr() line 1 at RAISE
CONTEXT: COPY eo, line 1: "1,a"
NOTICE 00000: row 2
CONTEXT: PL/pgSQL function eo_tr() line 1 at RAISE
CONTEXT: COPY eo, line 2: "2,b"
ERROR 23505: duplicate key value violates unique constraint "eo_pkey"
DETAIL: Key (id)=(2) already exists.
CONTEXT: COPY eo, line 2: "2,b"
OBJECTS: schema=public table=eo constraint=eo_pkey

> SELECT * FROM eo ORDER BY id
id:int4 | b:text
2 | x
-- SELECT 1

> DROP TRIGGER eo_b ON eo
