> select t1.* from a10_mm0 t1, a10_mm0 t2
> where t1.b = t2.b and t2.c = t2.d
> order by t1.b limit 10
QUERY PLAN:text
Limit
  ->  Merge Join
        Merge Cond: (t1.b = t2.b)
        ->  Merge Append
              Sort Key: t1.b
              ->  Index Scan using a10_mm0i on a10_mm0 t1_1
              ->  Index Scan using a10_mm1i on a10_mm1 t1_2
        ->  Materialize
              ->  Merge Append
                    Sort Key: t2.b
                    ->  Index Scan using a10_mm0i on a10_mm0 t2_1
                          Filter: (c = d)
                    ->  Index Scan using a10_mm1i on a10_mm1 t2_2
                          Filter: (c = d)
-- EXPLAIN

