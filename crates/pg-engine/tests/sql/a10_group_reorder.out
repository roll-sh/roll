QUERY PLAN:text
Limit
  Output: ((1 - t1.id))
  ->  Result
        Output: ((1 - t1.id))
        ->  Merge Append
              Sort Key: ((1 - t1.id))
              ->  Index Scan using a10_mt3i on public.a10_mt3 t1
                    Output: t1.id, (1 - t1.id)
              ->  Sort
                    Output: ((t2.id * 2)), ((1 - (t2.id * 2)))
                    Sort Key: ((1 - (t2.id * 2)))
                    ->  Seq Scan on public.a10_mt3 t2
                          Output: (t2.id * 2), (1 - (t2.id * 2))
              ->  Sort
                    Output: ((t3.id + 1)), ((1 - (t3.id + 1)))
                    Sort Key: ((1 - (t3.id + 1)))
                    ->  Seq Scan on public.a10_mt3 t3
                          Output: (t3.id + 1), (1 - (t3.id + 1))
-- EXPLAIN

