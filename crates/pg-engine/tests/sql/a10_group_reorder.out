Result
  ->  Merge Append
        Sort Key: ((1 - t1.id))
        ->  Index Scan using a10_mt3i on a10_mt3 t1
        ->  Sort
              Sort Key: ((1 - (t2.id * 2)))
              ->  Seq Scan on a10_mt3 t2
-- EXPLAIN

