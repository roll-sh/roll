> CREATE FUNCTION gc1_f(int) RETURNS int AS $$ BEGIN RETURN $1; END $$ LANGUAGE plpgsql STABLE
-- CREATE FUNCTION

> CREATE FUNCTION gc1_g(int) RETURNS int AS $$ SELECT $1 + 1 $$ LANGUAGE sql
-- CREATE FUNCTION

> CREATE FUNCTION gc1_h(int) RETURNS int AS $$ SELECT a FROM (VALUES ($1)) v(a) WHERE a > 0 $$ LANGUAGE sql
-- CREATE FUNCTION

> CREATE TABLE gc1_t (f1 int)
-- CREATE TABLE

