> EXPLAIN (COSTS OFF) SELECT * FROM gc1_t a WHERE NOT EXISTS (SELECT 1 FROM gc1_t b LEFT JOIN gc1_t c ON b.f1 = c.f1 WHERE a.f1 = b.f1)
QUERY PLAN:text
Hash Anti Join
  Hash Cond: (a.f1 = b.f1)
  ->  Seq Scan on gc1_t a
  ->  Hash
        ->  Merge Left Join
              Merge Cond: (b.f1 = c.f1)
              ->  Sort
                    Sort Key: b.f1
                    ->  Seq Scan on gc1_t b
              ->  Sort
                    Sort Key: c.f1
                    ->  Seq Scan on gc1_t c
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM gc1_t a WHERE EXISTS (SELECT 1 FROM gc1_t b WHERE a.f1 = b.f1 GROUP BY b.f1)
QUERY PLAN:text
Hash Join
  Hash Cond: (a.f1 = b.f1)
  ->  Seq Scan on gc1_t a
  ->  Hash
        ->  HashAggregate
              Group Key: b.f1
              ->  Seq Scan on gc1_t b
-- EXPLAIN

