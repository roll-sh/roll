> EXPLAIN (COSTS OFF) SELECT * FROM pg_constraint WHERE oid > 4000000000
QUERY PLAN:text
Index Scan using pg_constraint_oid_index on pg_constraint
  Index Cond: (oid > '4000000000'::oid)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT c.oid FROM pg_constraint c JOIN pg_class r ON r.oid = c.confrelid WHERE c.contype = 'f'
QUERY PLAN:text
Nested Loop
  ->  Seq Scan on pg_constraint c
        Filter: (contype = 'f'::"char")
  ->  Index Only Scan using pg_class_oid_index on pg_class r
        Index Cond: (oid = c.confrelid)
-- EXPLAIN

