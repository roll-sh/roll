    v.b,
    v.c,
    v.x,
    v.e,
    v.f
   FROM ( VALUES (1,2,3,4,5,6)) v(a, b, c, x, e, f)
UNION ALL
 SELECT x AS a,
    sdm_tt7.y AS b,
    sdm_tt8.z AS c,
    x_1 AS x,
    tt8x.z AS e,
    tt7x.y AS f
   FROM sdm_tt7
     FULL JOIN sdm_tt8 USING (x),
    sdm_tt8 tt8x(x_1, z)
     FULL JOIN sdm_tt7 tt7x(x_1, y) USING (x_1);
