> CREATE TEMP TABLE h(x int, y text)
-- CREATE TABLE

> INSERT INTO h VALUES (1,'a'),(2,'b'),(2,'b'),(3,NULL),(NULL,'c'),(5,'e')
-- INSERT 0 6

> SELECT rank(2) WITHIN GROUP (ORDER BY x), dense_rank(2) WITHIN GROUP (ORDER BY x), percent_rank(2) WITHIN GROUP (ORDER BY x), cume_dist(2) WITHIN GROUP (ORDER BY x) FROM h
rank:int8 | dense_rank:int8 | percent_rank:float8 | cume_dist:float8
2 | 2 | 0.16666666666666666 | 0.5714285714285714
-- SELECT 1

> SELECT rank(2) WITHIN GROUP (ORDER BY x DESC), dense_rank(2) WITHIN GROUP (ORDER BY x DESC NULLS LAST), percent_rank(2) WITHIN GROUP (ORDER BY x DESC), cume_dist(2) WITHIN GROUP (ORDER BY x DESC) FROM h
rank:int8 | dense_rank:int8 | percent_rank:float8 | cume_dist:float8
4 | 3 | 0.5 | 0.8571428571428571
-- SELECT 1

> SELECT rank(NULL) WITHIN GROUP (ORDER BY x), cume_dist(NULL) WITHIN GROUP (ORDER BY x), rank(NULL::int) WITHIN GROUP (ORDER BY x NULLS FIRST) FROM h
rank:int8 | cume_dist:float8 | rank:int8
6 | 1 | 1
-- SELECT 1

> SELECT rank(2,'b') WITHIN GROUP (ORDER BY x, y), cume_dist(2,'b') WITHIN GROUP (ORDER BY x, y), dense_rank(6, 'z') WITHIN GROUP (ORDER BY x,y) FROM h
rank:int8 | cume_dist:float8 | dense_rank:int8
2 | 0.5714285714285714 | 5
-- SELECT 1

> SELECT rank(2.5) WITHIN GROUP (ORDER BY x), pg_typeof(rank(2.5) WITHIN GROUP (ORDER BY x)), pg_typeof(percent_rank(1) WITHIN GROUP (ORDER BY x)) FROM h
rank:int8 | pg_typeof:regtype | pg_typeof:regtype
4 | bigint | double precision
-- SELECT 1

> SELECT rank(1) WITHIN GROUP (ORDER BY x), percent_rank(1) WITHIN GROUP (ORDER BY x), cume_dist(1) WITHIN GROUP (ORDER BY x), dense_rank(1) WITHIN GROUP (ORDER BY x) FROM h WHERE false
rank:int8 | percent_rank:float8 | cume_dist:float8 | dense_rank:int8
1 | 0 | 1 | 1
-- SELECT 1

