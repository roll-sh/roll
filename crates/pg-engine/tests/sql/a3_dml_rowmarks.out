> EXPLAIN (VERBOSE, COSTS OFF)
> MERGE INTO a3_rm_p t USING a3_rm_s s ON t.tid = s.a WHEN NOT MATCHED THEN INSERT VALUES (s.a)
QUERY PLAN:text
Merge on public.a3_rm_p t
  Merge on public.a3_rm_pp t_1
  ->  Hash Left Join
        Output: s.a, s.ctid, t_1.tableoid, t_1.ctid
        Inner Unique: true
        Hash Cond: (s.a = t_1.tid)
        ->  Seq Scan on public.a3_rm_s s
              Output: s.a, s.ctid
        ->  Hash
              Output: t_1.tid, t_1.tableoid, t_1.ctid
              ->  Seq Scan on public.a3_rm_pp t_1
                    Output: t_1.tid, t_1.tableoid, t_1.ctid
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF)
> MERGE INTO a3_rm_p t USING a3_rm_s s ON t.tid = s.a WHEN MATCHED THEN DELETE
QUERY PLAN:text
Merge on public.a3_rm_p t
  Merge on public.a3_rm_pp t_1
  ->  Hash Join
        Output: s.ctid, t_1.tableoid, t_1.ctid
        Inner Unique: true
        Hash Cond: (s.a = t_1.tid)
        ->  Seq Scan on public.a3_rm_s s
              Output: s.ctid, s.a
        ->  Hash
              Output: t_1.tid, t_1.tableoid, t_1.ctid
              ->  Seq Scan on public.a3_rm_pp t_1
                    Output: t_1.tid, t_1.tableoid, t_1.ctid
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF) SELECT * FROM a3_rm_s s LEFT JOIN a3_rm_p t ON t.tid = s.a
QUERY PLAN:text
Hash Left Join
  Output: s.a, s.b, t.tid
  Inner Unique: true
  Hash Cond: (s.a = t.tid)
  ->  Seq Scan on public.a3_rm_s s
        Output: s.a, s.b
  ->  Hash
        Output: t.tid
        ->  Seq Scan on public.a3_rm_pp t
              Output: t.tid
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF) SELECT * FROM a3_rm_s s LEFT JOIN a3_rm_p2 t ON t.tid = s.a
QUERY PLAN:text
Hash Left Join
  Output: s.a, s.b, t.tid
  Inner Unique: true
  Hash Cond: (s.a = t.tid)
  ->  Seq Scan on public.a3_rm_s s
        Output: s.a, s.b
  ->  Hash
        Output: t.tid
        ->  Append
              ->  Seq Scan on public.a3_rm_p2a t_1
                    Output: t_1.tid
              ->  Seq Scan on public.a3_rm_p2b t_2
                    Output: t_2.tid
-- EXPLAIN

