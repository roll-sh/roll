> CREATE TABLE a3_rm_t (a int, b int, c int)
-- CREATE TABLE

> CREATE TABLE a3_rm_s (a int, b int)
-- CREATE TABLE

> INSERT INTO a3_rm_t SELECT g, g, g FROM generate_series(1, 5) g
-- INSERT 0 5

> INSERT INTO a3_rm_s SELECT g, g * 10 FROM generate_series(3, 7) g
-- INSERT 0 5

> EXPLAIN (VERBOSE, COSTS OFF) UPDATE a3_rm_t SET b = a3_rm_s.b FROM a3_rm_s WHERE a3_rm_t.a = a3_rm_s.a
QUERY PLAN:text
Update on public.a3_rm_t
  ->  Merge Join
        Output: a3_rm_s.b, a3_rm_t.ctid, a3_rm_s.ctid
        Merge Cond: (a3_rm_t.a = a3_rm_s.a)
        ->  Sort
              Output: a3_rm_t.ctid, a3_rm_t.a
              Sort Key: a3_rm_t.a
              ->  Seq Scan on public.a3_rm_t
                    Output: a3_rm_t.ctid, a3_rm_t.a
        ->  Sort
              Output: a3_rm_s.b, a3_rm_s.ctid, a3_rm_s.a
              Sort Key: a3_rm_s.a
              ->  Seq Scan on public.a3_rm_s
                    Output: a3_rm_s.b, a3_rm_s.ctid, a3_rm_s.a
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF) UPDATE a3_rm_t SET c = a3_rm_s.b + 1, b = 0 FROM a3_rm_s WHERE a3_rm_t.a = a3_rm_s.a
QUERY PLAN:text
Update on public.a3_rm_t
  ->  Merge Join
        Output: 0, (a3_rm_s.b + 1), a3_rm_t.ctid, a3_rm_s.ctid
        Merge Cond: (a3_rm_t.a = a3_rm_s.a)
        ->  Sort
              Output: a3_rm_t.ctid, a3_rm_t.a
              Sort Key: a3_rm_t.a
              ->  Seq Scan on public.a3_rm_t
                    Output: a3_rm_t.ctid, a3_rm_t.a
        ->  Sort
              Output: a3_rm_s.b, a3_rm_s.ctid, a3_rm_s.a
              Sort Key: a3_rm_s.a
              ->  Seq Scan on public.a3_rm_s
                    Output: a3_rm_s.b, a3_rm_s.ctid, a3_rm_s.a
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF) DELETE FROM a3_rm_t USING a3_rm_s WHERE a3_rm_t.a = a3_rm_s.a
QUERY PLAN:text
Delete on public.a3_rm_t
  ->  Merge Join
        Output: a3_rm_t.ctid, a3_rm_s.ctid
        Merge Cond: (a3_rm_t.a = a3_rm_s.a)
        ->  Sort
              Output: a3_rm_t.ctid, a3_rm_t.a
              Sort Key: a3_rm_t.a
              ->  Seq Scan on public.a3_rm_t
                    Output: a3_rm_t.ctid, a3_rm_t.a
        ->  Sort
              Output: a3_rm_s.ctid, a3_rm_s.a
              Sort Key: a3_rm_s.a
              ->  Seq Scan on public.a3_rm_s
                    Output: a3_rm_s.ctid, a3_rm_s.a
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF)
> MERGE INTO a3_rm_t t USING a3_rm_s s ON t.a = s.a WHEN MATCHED THEN UPDATE SET b = s.b
QUERY PLAN:text
Merge on public.a3_rm_t t
  ->  Merge Join
        Output: t.ctid, s.b, s.ctid
        Merge Cond: (t.a = s.a)
        ->  Sort
              Output: t.ctid, t.a
              Sort Key: t.a
              ->  Seq Scan on public.a3_rm_t t
                    Output: t.ctid, t.a
        ->  Sort
              Output: s.b, s.ctid, s.a
              Sort Key: s.a
              ->  Seq Scan on public.a3_rm_s s
                    Output: s.b, s.ctid, s.a
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF)
> MERGE INTO a3_rm_t t USING a3_rm_s s ON t.a = s.a WHEN NOT MATCHED THEN INSERT VALUES (s.a)
QUERY PLAN:text
Merge on public.a3_rm_t t
  ->  Merge Right Join
        Output: t.ctid, s.a, s.ctid
        Merge Cond: (t.a = s.a)
        ->  Sort
              Output: t.ctid, t.a
              Sort Key: t.a
              ->  Seq Scan on public.a3_rm_t t
                    Output: t.ctid, t.a
        ->  Sort
              Output: s.a, s.ctid
              Sort Key: s.a
              ->  Seq Scan on public.a3_rm_s s
                    Output: s.a, s.ctid
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF)
> MERGE INTO a3_rm_t t USING (SELECT * FROM a3_rm_s) s ON t.a = s.a WHEN MATCHED THEN DELETE
QUERY PLAN:text
Merge on public.a3_rm_t t
  ->  Merge Join
        Output: t.ctid, a3_rm_s.ctid
        Merge Cond: (t.a = a3_rm_s.a)
        ->  Sort
              Output: t.ctid, t.a
              Sort Key: t.a
              ->  Seq Scan on public.a3_rm_t t
                    Output: t.ctid, t.a
        ->  Sort
              Output: a3_rm_s.ctid, a3_rm_s.a
              Sort Key: a3_rm_s.a
              ->  Seq Scan on public.a3_rm_s
                    Output: a3_rm_s.ctid, a3_rm_s.a
-- EXPLAIN

