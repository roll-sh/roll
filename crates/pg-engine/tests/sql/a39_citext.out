> SET enable_seqscan = off
-- SET

> EXPLAIN (COSTS OFF) SELECT * FROM a39_ct WHERE c > 'B' ORDER BY c
QUERY PLAN:text
Sort
  Sort Key: c
  ->  Bitmap Heap Scan on a39_ct
        Recheck Cond: (c > 'B'::citext)
        ->  Bitmap Index Scan on a39_ct_pkey
              Index Cond: (c > 'B'::citext)
-- EXPLAIN

> SELECT * FROM a39_ct WHERE c > 'B' ORDER BY c
c:user
Def
-- SELECT 1

> DROP TABLE a39_ct
-- DROP TABLE

> DROP EXTENSION citext
-- DROP EXTENSION

