> CREATE VIEW a104_isv AS SELECT id FROM a104_is WHERE d IN (1) AND t NOT IN ('x')
-- CREATE VIEW

> SELECT pg_get_viewdef('a104_isv'::regclass)
pg_get_viewdef:text
 SELECT id
   FROM a104_is
  WHERE (((d)::integer = 1) AND (t <> 'x'::text));
-- SELECT 1

