> begin
-- BEGIN

> create temp table sp_b (id int primary key, c_id int)
-- CREATE TABLE

> create temp table sp_d (a int, b int)
-- CREATE TABLE

> insert into sp_b values (0, 0), (1, null)
-- INSERT 0 2

> insert into sp_d values (1, 3), (2, 2), (3, 1)
-- INSERT 0 3

> explain (costs off)
> select sp_d.* from sp_d left join (select * from sp_b group by sp_b.id, sp_b.c_id) s
>   on sp_d.a = s.id
QUERY PLAN:text
Merge Right Join
  Merge Cond: (sp_b.id = sp_d.a)
  ->  Group
        Group Key: sp_b.id
        ->  Index Scan using sp_b_pkey on sp_b
  ->  Sort
        Sort Key: sp_d.a
        ->  Seq Scan on sp_d
-- EXPLAIN

> select sp_d.*, s.* from sp_d left join (select * from sp_b group by sp_b.id, sp_b.c_id) s
>   on sp_d.a = s.id
a:int4 | b:int4 | id:int4 | c_id:int4
1 | 3 | 1 | NULL
2 | 2 | NULL | NULL
3 | 1 | NULL | NULL
-- SELECT 3

> explain (costs off)
> select sp_d.* from sp_d left join (select distinct * from sp_b) s
>   on sp_d.a = s.id
QUERY PLAN:text
Merge Right Join
  Merge Cond: (sp_b.id = sp_d.a)
  ->  Unique
        ->  Sort
              Sort Key: sp_b.id, sp_b.c_id
              ->  Seq Scan on sp_b
  ->  Sort
        Sort Key: sp_d.a
        ->  Seq Scan on sp_d
-- EXPLAIN

> select sp_d.*, s.* from sp_d left join (select distinct * from sp_b) s
>   on sp_d.a = s.id
a:int4 | b:int4 | id:int4 | c_id:int4
1 | 3 | 1 | NULL
2 | 2 | NULL | NULL
3 | 1 | NULL | NULL
-- SELECT 3

> explain (costs off)
> select s.id, sp_d.b from (select * from sp_b group by sp_b.id, sp_b.c_id) s
>   join sp_d on sp_d.a = s.id order by s.id
QUERY PLAN:text
Merge Join
  Merge Cond: (sp_b.id = sp_d.a)
  ->  Group
        Group Key: sp_b.id
        ->  Index Scan using sp_b_pkey on sp_b
  ->  Sort
        Sort Key: sp_d.a
        ->  Seq Scan on sp_d
-- EXPLAIN

> select s.id, sp_d.b from (select * from sp_b group by sp_b.id, sp_b.c_id) s
>   join sp_d on sp_d.a = s.id order by s.id
id:int4 | b:int4
1 | 3
-- SELECT 1

> rollback
-- ROLLBACK

> create table sp_t (g int, h int, v int)
-- CREATE TABLE

> insert into sp_t select i % 50, i % 7, i from generate_series(1, 5000) i
-- INSERT 0 5000

> create index on sp_t (g)
-- CREATE INDEX

> create table sp_u (g int, w int)
-- CREATE TABLE

> insert into sp_u select i % 60, i from generate_series(1, 3000) i
-- INSERT 0 3000

> analyze sp_t, sp_u
-- ANALYZE

> explain (costs off)
> select * from (select distinct g, h from sp_t) s join sp_u u on u.g = s.g
>   where u.w < 40 order by s.g, s.h, u.w
QUERY PLAN:text
Sort
  Sort Key: sp_t.g, sp_t.h, u.w
  ->  Hash Join
        Hash Cond: (u.g = sp_t.g)
        ->  Seq Scan on sp_u u
              Filter: (w < 40)
        ->  Hash
              ->  HashAggregate
                    Group Key: sp_t.g, sp_t.h
                    ->  Seq Scan on sp_t
-- EXPLAIN

