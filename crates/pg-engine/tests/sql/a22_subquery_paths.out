> set enable_hashjoin = off
-- SET

> explain (costs off)
> select s.g, s.n, u.w from (select g, count(*) n from sp_t group by g) s
>   left join sp_u u on u.g = s.g and u.w < 70
QUERY PLAN:text
Merge Right Join
  Merge Cond: (u.g = sp_t.g)
  ->  Sort
        Sort Key: u.g
        ->  Seq Scan on sp_u u
              Filter: (w < 70)
  ->  Sort
        Sort Key: sp_t.g
        ->  HashAggregate
              Group Key: sp_t.g
              ->  Seq Scan on sp_t
-- EXPLAIN

