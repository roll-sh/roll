> CREATE TABLE mb (a int, b text)
-- CREATE TABLE

> INSERT INTO mb VALUES (1, 'one'), (2, 'two'), (3, 'three')
-- INSERT 0 3

> CREATE MATERIALIZED VIEW mvp AS SELECT a, b FROM mb WITH NO DATA
-- CREATE MATERIALIZED VIEW

> SELECT relispopulated FROM pg_class WHERE relname = 'mvp'
relispopulated:bool
f
-- SELECT 1

> SELECT ispopulated, hasindexes FROM pg_matviews WHERE matviewname = 'mvp'
ispopulated:bool | hasindexes:bool
f | f
-- SELECT 1

> SELECT * FROM mvp
ERROR 55000: materialized view "mvp" has not been populated
HINT: Use the REFRESH MATERIALIZED VIEW command.

> SELECT count(*) FROM (SELECT * FROM mvp) s
ERROR 55000: materialized view "mvp" has not been populated
HINT: Use the REFRESH MATERIALIZED VIEW command.

> REFRESH MATERIALIZED VIEW CONCURRENTLY mvp
ERROR 0A000: CONCURRENTLY cannot be used when the materialized view is not populated

> REFRESH MATERIALIZED VIEW mvp
-- REFRESH MATERIALIZED VIEW

> SELECT * FROM mvp ORDER BY a
a:int4 | b:text
1 | one
2 | two
3 | three
-- SELECT 3

> SELECT relispopulated FROM pg_class WHERE relname = 'mvp'
relispopulated:bool
t
-- SELECT 1

> REFRESH MATERIALIZED VIEW mvp WITH NO DATA
-- REFRESH MATERIALIZED VIEW

> SELECT relispopulated FROM pg_class WHERE relname = 'mvp'
relispopulated:bool
f
-- SELECT 1

> SELECT * FROM mvp
ERROR 55000: materialized view "mvp" has not been populated
HINT: Use the REFRESH MATERIALIZED VIEW command.

> REFRESH MATERIALIZED VIEW CONCURRENTLY mvp WITH NO DATA
ERROR 0A000: CONCURRENTLY cannot be used when the materialized view is not populated

> REFRESH MATERIALIZED VIEW mvp
-- REFRESH MATERIALIZED VIEW

> CREATE UNIQUE INDEX mvp_a ON mvp (a)
-- CREATE INDEX

> CREATE INDEX mvp_b ON mvp (b) WHERE a > 1
-- CREATE INDEX

> CREATE INDEX mvp_lower ON mvp (lower(b))
-- CREATE INDEX

> SELECT indexname, indexdef FROM pg_indexes WHERE tablename = 'mvp' ORDER BY 1
indexname:name | indexdef:text
mvp_a | CREATE UNIQUE INDEX mvp_a ON public.mvp USING btree (a)
mvp_b | CREATE INDEX mvp_b ON public.mvp USING btree (b) WHERE (a > 1)
mvp_lower | CREATE INDEX mvp_lower ON public.mvp USING btree (lower(b))
-- SELECT 3

> SELECT c.relname, i.indisunique, i.indisvalid FROM pg_index i JOIN pg_class c ON c.oid = i.indexrelid WHERE i.indrelid = 'mvp'::regclass ORDER BY 1
relname:name | indisunique:bool | indisvalid:bool
mvp_a | t | t
mvp_b | f | t
mvp_lower | f | t
-- SELECT 3

> SELECT ispopulated, hasindexes FROM pg_matviews WHERE matviewname = 'mvp'
ispopulated:bool | hasindexes:bool
t | t
-- SELECT 1

> SELECT relhasindex FROM pg_class WHERE relname = 'mvp'
relhasindex:bool
t
-- SELECT 1

> SELECT pg_get_indexdef('mvp_b'::regclass)
pg_get_indexdef:text
CREATE INDEX mvp_b ON public.mvp USING btree (b) WHERE (a > 1)
-- SELECT 1

> INSERT INTO mb VALUES (4, 'four')
-- INSERT 0 1

> REFRESH MATERIALIZED VIEW CONCURRENTLY mvp
-- REFRESH MATERIALIZED VIEW

> SELECT * FROM mvp ORDER BY a
a:int4 | b:text
1 | one
2 | two
3 | three
4 | four
-- SELECT 4

> UPDATE mb SET b = 'TWO' WHERE a = 2
-- UPDATE 1

> DELETE FROM mb WHERE a = 3
-- DELETE 1

> REFRESH MATERIALIZED VIEW CONCURRENTLY mvp
-- REFRESH MATERIALIZED VIEW

> SELECT * FROM mvp ORDER BY a
a:int4 | b:text
1 | one
2 | TWO
4 | four
-- SELECT 3

