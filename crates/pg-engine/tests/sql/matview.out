> CREATE MATERIALIZED VIEW mvd AS SELECT x FROM (VALUES (1), (2)) v(x)
-- SELECT 2

> CREATE UNIQUE INDEX mvd_x ON mvd (x)
-- CREATE INDEX

> CREATE OR REPLACE VIEW mvdsrc AS SELECT 1
-- CREATE VIEW

> DROP MATERIALIZED VIEW mvd
-- DROP MATERIALIZED VIEW

> CREATE TABLE md (x int, y int)
-- CREATE TABLE

> INSERT INTO md VALUES (1, 1), (NULL, 2), (NULL, 2)
-- INSERT 0 3

> CREATE MATERIALIZED VIEW mvd AS SELECT * FROM md
-- SELECT 3

> CREATE UNIQUE INDEX mvd_x ON mvd (x)
-- CREATE INDEX

