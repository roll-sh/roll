> CREATE VIEW jv AS SELECT JSON_OBJECT('id' : id, 'n' : JSON_VALUE(doc, '$.name')) AS o, JSON_ARRAY(id, 2) AS a, doc IS JSON OBJECT AS isj FROM jt
