> SELECT pg_get_viewdef('jv')
pg_get_viewdef:text
 SELECT JSON_OBJECT('id' : id, 'n' : JSON_VALUE(doc, '$."name"' RETURNING text) RETURNING json) AS o,
    JSON_ARRAY(id, 2 RETURNING json) AS a,
    (doc IS JSON OBJECT) AS isj
   FROM jt;
-- SELECT 1

> DROP VIEW jv
-- DROP VIEW

> DROP TABLE jt
-- DROP TABLE

> CREATE VIEW zv AS SELECT JSON_OBJECT('a' : 'x', 'b' : '[1]' FORMAT JSON, 'c': 1 ABSENT ON NULL WITH UNIQUE KEYS RETURNING jsonb) o, JSON_ARRAY('x', 1 NULL ON NULL RETURNING text) a, JSON('{}' WITH UNIQUE KEYS) j, JSON_SCALAR(1) s, JSON_SERIALIZE('{}' RETURNING bytea) z, '1' IS NOT JSON ARRAY WITH UNIQUE KEYS i, JSON_EXISTS('{}', '$.a' PASSING 1 AS x TRUE ON ERROR) e, JSON_QUERY('{}', '$.a' WITH CONDITIONAL WRAPPER EMPTY ARRAY ON EMPTY DEFAULT '[1]' ON ERROR) q, JSON_QUERY('{}', '$.a' OMIT QUOTES) q2, JSON_VALUE('{}', '$.a' RETURNING int DEFAULT 1 ON EMPTY ERROR ON ERROR) v
-- CREATE VIEW

> SELECT pg_get_viewdef('zv')
pg_get_viewdef:text
 SELECT JSON_OBJECT('a' : 'x'::text, 'b' : '[1]'::text FORMAT JSON, 'c' : 1 ABSENT ON NULL WITH UNIQUE KEYS RETURNING jsonb) AS o,
    JSON_ARRAY('x'::text, 1 NULL ON NULL RETURNING text) AS a,
    JSON('{}'::text WITH UNIQUE KEYS) AS j,
    JSON_SCALAR(1) AS s,
    JSON_SERIALIZE('{}'::text RETURNING bytea) AS z,
    (NOT ('1'::text IS JSON ARRAY WITH UNIQUE KEYS)) AS i,
    JSON_EXISTS('{}'::text, '$."a"' PASSING 1 AS x TRUE ON ERROR) AS e,
    JSON_QUERY('{}'::text, '$."a"' RETURNING jsonb WITH CONDITIONAL WRAPPER KEEP QUOTES EMPTY ARRAY ON EMPTY DEFAULT '[1]'::jsonb ON ERROR) AS q,
    JSON_QUERY('{}'::text, '$."a"' RETURNING jsonb WITHOUT WRAPPER OMIT QUOTES) AS q2,
    JSON_VALUE('{}'::text, '$."a"' RETURNING integer DEFAULT 1 ON EMPTY ERROR ON ERROR) AS v;
-- SELECT 1

> SELECT * FROM zv
o:jsonb | a:text | j:json | s:json | z:bytea | i:bool | e:bool | q:jsonb | q2:jsonb | v:int4
{"a": "x", "b": [1], "c": 1} | ["x", 1] | {} | 1 | \x7b7d | t | f | [] | NULL | 1
-- SELECT 1

