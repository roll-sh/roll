CREATE CONSTRAINT TRIGGER "RI_ConstraintTrigger_c_N" AFTER UPDATE ON public.fkt_c FROM fkt_p DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION "RI_FKey_check_upd"()
CREATE CONSTRAINT TRIGGER "RI_ConstraintTrigger_a_N" AFTER DELETE ON public.fkt_p FROM fkt_c NOT DEFERRABLE INITIALLY IMMEDIATE FOR EACH ROW EXECUTE FUNCTION "RI_FKey_setnull_del"()
CREATE CONSTRAINT TRIGGER "RI_ConstraintTrigger_a_N" AFTER UPDATE ON public.fkt_p FROM fkt_c DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION "RI_FKey_noaction_upd"()
