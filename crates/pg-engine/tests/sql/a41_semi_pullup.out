> explain (costs off)
> select * from a41_t1
> join (select a41_t2.id as id from a41_t2
>       where exists (select true from a41_t3, a41_t4 where a41_t3.a = 1 and a41_t3.id = a41_t2.id)) s1
>   on a41_t1.id = s1.id
> join (select a41_t2.id as id from a41_t2
>       where exists (select true from a41_t3, a41_t4 where a41_t3.a = 1 and a41_t3.id = a41_t2.id)) s2
>   on a41_t1.id = s2.id
QUERY PLAN:text
Nested Loop
  Join Filter: (a41_t3.id = a41_t1.id)
  ->  Nested Loop
        Join Filter: (a41_t2.id = a41_t3.id)
        ->  Nested Loop Semi Join
              ->  Nested Loop
                    ->  HashAggregate
                          Group Key: a41_t3.id
                          ->  Nested Loop
                                ->  Seq Scan on a41_t4
                                ->  Materialize
                                      ->  Bitmap Heap Scan on a41_t3
                                            Recheck Cond: (a = 1)
                                            ->  Bitmap Index Scan on a41_t3_a_id_idx
                                                  Index Cond: (a = 1)
                    ->  Index Only Scan using a41_t2_id_idx on a41_t2 a41_t2_1
                          Index Cond: (id = a41_t3.id)
              ->  Nested Loop
                    ->  Index Only Scan using a41_t3_a_id_idx on a41_t3 a41_t3_1
                          Index Cond: ((a = 1) AND (id = a41_t3.id))
                    ->  Seq Scan on a41_t4 a41_t4_1
        ->  Index Only Scan using a41_t2_id_idx on a41_t2
              Index Cond: (id = a41_t2_1.id)
  ->  Seq Scan on a41_t1
-- EXPLAIN

