> CREATE TYPE ac_mood AS ENUM ('a')
-- CREATE TYPE

> ALTER TYPE ac_mood ADD ATTRIBUTE b int
ERROR 42P01: relation "ac_mood" does not exist

> CREATE TABLE ac_t (id int, p ac_pt)
-- CREATE TABLE

> INSERT INTO ac_t VALUES (1, ROW(1, 2.5)), (2, NULL)
-- INSERT 0 2

> INSERT INTO ac_t VALUES (3, ROW(7, 8.25)::ac_pt)
-- INSERT 0 1

> ALTER TYPE ac_pt ADD ATTRIBUTE c int, ADD ATTRIBUTE b text
-- ALTER TYPE

> SELECT * FROM ac_t ORDER BY id
id:int4 | p:user
1 | (1,2.50,,)
2 | NULL
3 | (7,8.25,,)
-- SELECT 3

> UPDATE ac_t SET p.b = 'bee' WHERE id = 1
-- UPDATE 1

> ALTER TYPE ac_pt DROP ATTRIBUTE c
-- ALTER TYPE

> ALTER TYPE ac_pt ALTER ATTRIBUTE zz TYPE int
ERROR 0A000: cannot alter type "ac_pt" because column "ac_t.p" uses it

> ALTER TYPE ac_pt RENAME ATTRIBUTE b TO bee
-- ALTER TYPE

> SELECT (p).bee, (p).x, p FROM ac_t ORDER BY id
bee:text | x:int4 | p:user
bee | 1 | (1,2.50,bee)
NULL | NULL | NULL
NULL | 7 | (7,8.25,)
-- SELECT 3

> ALTER TYPE ac_pt DROP ATTRIBUTE x
-- ALTER TYPE

> SELECT * FROM ac_t ORDER BY id
id:int4 | p:user
1 | (2.50,bee)
2 | NULL
3 | (8.25,)
-- SELECT 3

> CREATE TABLE ac_arr (ps ac_pt[])
-- CREATE TABLE

> INSERT INTO ac_arr VALUES (ARRAY[ROW(1, 'a')::ac_pt, ROW(2, 'b')::ac_pt])
-- INSERT 0 1

> ALTER TYPE ac_pt ADD ATTRIBUTE w int
-- ALTER TYPE

> SELECT ps, ps[2].bee FROM ac_arr
ps:user | bee:text
{"(1.00,a,)","(2.00,b,)"} | b
-- SELECT 1

> DROP TABLE ac_arr
-- DROP TABLE

> CREATE TYPE ac_inner AS (a int)
-- CREATE TYPE

> CREATE TYPE ac_outer AS (i ac_inner, n int)
-- CREATE TYPE

> CREATE FUNCTION ac_make(v int) RETURNS ac_inner LANGUAGE sql AS 'SELECT ROW(v)::ac_inner'
-- CREATE FUNCTION

> ALTER TYPE ac_inner ADD ATTRIBUTE b text
-- ALTER TYPE

> SELECT ROW(ROW(1, 'x'), 2)::ac_outer
row:user
("(1,x)",2)
