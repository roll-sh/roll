> CREATE TYPE ac_pt AS (x int, y int)
-- CREATE TYPE

> ALTER TYPE ac_pt ADD ATTRIBUTE z int
-- ALTER TYPE

> SELECT ROW(1, 2, 3)::ac_pt
row:user
(1,2,3)
-- SELECT 1

> SELECT attname, atttypid::regtype, attnum FROM pg_attribute WHERE attrelid = 'ac_pt'::regclass AND attnum > 0 ORDER BY attnum
attname:name | atttypid:regtype | attnum:int2
x | integer | 1
y | integer | 2
z | integer | 3
-- SELECT 3

> ALTER TYPE ac_pt DROP ATTRIBUTE y
-- ALTER TYPE

> SELECT attname, atttypid::regtype FROM pg_attribute WHERE attrelid = 'ac_pt'::regclass AND attnum > 0 AND NOT attisdropped ORDER BY attnum
attname:name | atttypid:regtype
x | integer
z | integer
-- SELECT 2

> SELECT ROW(1, 3)::ac_pt
row:user
(1,3)
-- SELECT 1

> ALTER TYPE ac_pt ALTER ATTRIBUTE z TYPE bigint
-- ALTER TYPE

> ALTER TYPE ac_pt ALTER ATTRIBUTE z SET DATA TYPE numeric(10, 2)
-- ALTER TYPE

> SELECT ROW(1, 3.456)::ac_pt
row:user
(1,3.46)
-- SELECT 1

> ALTER TYPE ac_pt RENAME ATTRIBUTE z TO zz
-- ALTER TYPE

> SELECT (ROW(1, 2)::ac_pt).zz
zz:numeric
2.00
-- SELECT 1

> ALTER TYPE ac_pt ADD ATTRIBUTE x text
