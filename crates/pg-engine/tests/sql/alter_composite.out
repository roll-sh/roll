NOTICE 00000: column "nope" of relation "ac_pt" does not exist, skipping
-- ALTER TYPE

> ALTER TYPE ac_pt ALTER ATTRIBUTE nope TYPE int
ERROR 42703: column "nope" of relation "ac_pt" does not exist

> ALTER TYPE ac_pt RENAME ATTRIBUTE nope TO n2
ERROR 42703: column "nope" does not exist

> ALTER TYPE ac_pt RENAME ATTRIBUTE x TO zz
ERROR 42701: column "zz" of relation "ac_pt" already exists

> ALTER TYPE ac_pt ADD ATTRIBUTE a int, ADD ATTRIBUTE b text, DROP ATTRIBUTE a
ERROR 42703: column "a" of relation "ac_pt" does not exist

> ALTER TYPE ac_pt ALTER ATTRIBUTE x SET DEFAULT 1
ERROR 42601: syntax error at or near "DEFAULT" (at 40)

> SELECT format_type(atttypid, atttypmod), attname FROM pg_attribute WHERE attrelid = 'ac_pt'::regclass AND attnum > 0 AND NOT attisdropped ORDER BY attnum
format_type:text | attname:name
integer | x
numeric(10,2) | zz
-- SELECT 2

> ALTER TYPE ac_nope ADD ATTRIBUTE a int
