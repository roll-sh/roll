> CREATE TABLE a19_l (a int, b int, c varchar)
-- CREATE TABLE

> CREATE TABLE a19_m (a int, b int, c varchar)
-- CREATE TABLE

> INSERT INTO a19_l SELECT i, i % 25, to_char(i % 4, 'FM0000') FROM generate_series(0, 599, 2) i
-- INSERT 0 300

> INSERT INTO a19_m SELECT i % 25, i, to_char(i % 4, 'FM0000') FROM generate_series(0, 599, 3) i
-- INSERT 0 200

> CREATE INDEX a19_m_b ON a19_m (b)
-- CREATE INDEX

> ANALYZE a19_l
-- ANALYZE

> ANALYZE a19_m
-- ANALYZE

> EXPLAIN (COSTS OFF)
> SELECT count(*) FROM a19_l t1 LEFT JOIN LATERAL
>   (SELECT t1.b AS t1b, t2.* FROM a19_m t2) s
>   ON t1.a = s.b AND t1.b = s.a AND t1.c = s.c
>   WHERE s.t1b = s.a
QUERY PLAN:text
Aggregate
  ->  Nested Loop
        ->  Seq Scan on a19_l t1
        ->  Index Scan using a19_m_b on a19_m t2
              Index Cond: (b = t1.a)
              Filter: ((a = t1.b) AND (t1.b = a) AND ((t1.c)::text = (c)::text))
-- EXPLAIN

> SELECT count(*) FROM a19_l t1 LEFT JOIN LATERAL
>   (SELECT t1.b AS t1b, t2.* FROM a19_m t2) s
>   ON t1.a = s.b AND t1.b = s.a AND t1.c = s.c
>   WHERE s.t1b = s.a
count:int8
100
-- SELECT 1

> EXPLAIN (COSTS OFF)
> SELECT count(*) FROM a19_l t1 LEFT JOIN LATERAL
>   (SELECT t1.b AS t1b, t2.* FROM a19_m t2) s
>   ON t1.a = s.b WHERE s.t1b = s.b
QUERY PLAN:text
Aggregate
  ->  Nested Loop
        ->  Seq Scan on a19_l t1
        ->  Index Only Scan using a19_m_b on a19_m t2
              Index Cond: (b = t1.a)
              Filter: (b = t1.b)
-- EXPLAIN

> SELECT count(*) FROM a19_l t1 LEFT JOIN LATERAL
>   (SELECT t1.b AS t1b, t2.* FROM a19_m t2) s
>   ON t1.a = s.b WHERE s.t1b = s.b
count:int8
5
-- SELECT 1

> EXPLAIN (COSTS OFF)
> SELECT count(*) FROM a19_l t1 LEFT JOIN LATERAL
>   (SELECT t1.b AS t1b, t2.* FROM a19_m t2) s
>   ON t1.a = s.a WHERE s.t1b = s.b
QUERY PLAN:text
Aggregate
  ->  Nested Loop
        ->  Seq Scan on a19_l t1
        ->  Seq Scan on a19_m t2
              Filter: ((t1.b = b) AND (t1.a = a))
-- EXPLAIN

> EXPLAIN (COSTS OFF)
> SELECT count(*) FROM a19_l t1 LEFT JOIN LATERAL
>   (SELECT t1.b AS t1b, t2.* FROM a19_m t2) s
>   ON t1.a = s.a WHERE s.b = s.t1b
QUERY PLAN:text
Aggregate
  ->  Nested Loop
        ->  Seq Scan on a19_l t1
        ->  Seq Scan on a19_m t2
              Filter: ((b = t1.b) AND (t1.a = a))
-- EXPLAIN

> SELECT count(*) FROM a19_l t1 LEFT JOIN LATERAL
>   (SELECT t1.b AS t1b, t2.* FROM a19_m t2) s
>   ON t1.a = s.a WHERE s.b = s.t1b
count:int8
5
-- SELECT 1

> SET enable_partitionwise_join TO true
-- SET

> CREATE TABLE a19_p1 (a int, b int, c varchar) PARTITION BY RANGE (a)
-- CREATE TABLE

> CREATE TABLE a19_p1_1 PARTITION OF a19_p1 FOR VALUES FROM (0) TO (250)
-- CREATE TABLE

> CREATE TABLE a19_p1_2 PARTITION OF a19_p1 FOR VALUES FROM (250) TO (600)
-- CREATE TABLE

> INSERT INTO a19_p1 SELECT i, i % 25, to_char(i % 4, 'FM0000') FROM generate_series(0, 599, 2) i
-- INSERT 0 300

> CREATE TABLE a19_p2 (a int, b int, c varchar) PARTITION BY RANGE (b)
-- CREATE TABLE

> CREATE TABLE a19_p2_1 PARTITION OF a19_p2 FOR VALUES FROM (0) TO (250)
-- CREATE TABLE

> CREATE TABLE a19_p2_2 PARTITION OF a19_p2 FOR VALUES FROM (250) TO (600)
-- CREATE TABLE

> INSERT INTO a19_p2 SELECT i % 25, i, to_char(i % 4, 'FM0000') FROM generate_series(0, 599, 3) i
-- INSERT 0 200

> CREATE INDEX a19_p2_b ON a19_p2 (b)
-- CREATE INDEX

> ANALYZE a19_p1
-- ANALYZE

> ANALYZE a19_p2
-- ANALYZE

> EXPLAIN (COSTS OFF)
> SELECT count(*) FROM a19_p1 t1 LEFT JOIN LATERAL
>   (SELECT t1.b AS t1b, t2.* FROM a19_p2 t2) s
>   ON t1.a = s.b WHERE s.t1b = s.b
QUERY PLAN:text
Aggregate
  ->  Append
        ->  Nested Loop
              ->  Seq Scan on a19_p1_1 t1_1
              ->  Index Only Scan using a19_p2_1_b_idx on a19_p2_1 t2_1
                    Index Cond: (b = t1_1.a)
                    Filter: (b = t1_1.b)
        ->  Nested Loop
              ->  Seq Scan on a19_p1_2 t1_2
              ->  Index Only Scan using a19_p2_2_b_idx on a19_p2_2 t2_2
                    Index Cond: (b = t1_2.a)
                    Filter: (b = t1_2.b)
-- EXPLAIN

> SELECT count(*) FROM a19_p1 t1 LEFT JOIN LATERAL
>   (SELECT t1.b AS t1b, t2.* FROM a19_p2 t2) s
>   ON t1.a = s.b WHERE s.t1b = s.b
count:int8
5
-- SELECT 1

> RESET enable_partitionwise_join
-- RESET

