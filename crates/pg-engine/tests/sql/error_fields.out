> SELECT ef_try('INSERT INTO ef_p VALUES (2, NULL, 1)')
ef_try:text
23502|public|ef_p|n||
-- SELECT 1

> SELECT ef_try('INSERT INTO ef_c VALUES (9)')
ef_try:text
23503|public|ef_c|||ef_c_id_fkey
-- SELECT 1

> SELECT ef_try('SELECT 0::ef_d')
ef_try:text
23514|public|||ef_d|ef_d_pos
-- SELECT 1

> SELECT ef_try('SELECT 1/0')
ef_try:text
22012|||||
-- SELECT 1

