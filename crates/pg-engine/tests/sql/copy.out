> CREATE TABLE cpt (a int, b text)
-- CREATE TABLE

> CREATE FUNCTION cpt_trig() RETURNS trigger LANGUAGE plpgsql AS $$
> BEGIN
>   NEW.b := upper(NEW.b);
>   RAISE NOTICE 'row %', NEW.a;
>   RETURN NEW;
> END $$
-- CREATE FUNCTION

> CREATE TRIGGER cpt_t BEFORE INSERT ON cpt FOR EACH ROW EXECUTE FUNCTION cpt_trig()
-- CREATE TRIGGER

> COPY cpt FROM STDIN
