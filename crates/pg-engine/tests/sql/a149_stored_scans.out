> CREATE EXTENSION bloom
-- CREATE EXTENSION

> CREATE INDEX scans_bl ON scans USING bloom (a)
-- CREATE INDEX

> SET enable_seqscan = off
-- SET

> BEGIN
-- BEGIN

> REINDEX INDEX scans_bl
-- REINDEX

> SELECT count(*) FROM scans WHERE a = 901
count:int8
1
-- SELECT 1

> COMMIT
-- COMMIT

> SELECT count(*) FROM scans WHERE a = 901
count:int8
1
-- SELECT 1

> BEGIN
-- BEGIN

> TRUNCATE scans
-- TRUNCATE TABLE

> INSERT INTO scans (a, e) VALUES (7, 'new')
-- INSERT 0 1

> REINDEX INDEX scans_bl
-- REINDEX

> SELECT a, e FROM scans WHERE a = 7
a:int4 | e:text
7 | new
-- SELECT 1

> COMMIT
-- COMMIT

> SELECT a, e FROM scans WHERE a = 7
a:int4 | e:text
7 | new
-- SELECT 1

> BEGIN
-- BEGIN

> DROP INDEX scans_bl
-- DROP INDEX

> ROLLBACK
-- ROLLBACK

> SELECT a, e FROM scans WHERE a = 7
a:int4 | e:text
7 | new
-- SELECT 1

> DROP INDEX scans_bl
-- DROP INDEX

> SELECT a, e FROM scans
a:int4 | e:text
7 | new
-- SELECT 1

