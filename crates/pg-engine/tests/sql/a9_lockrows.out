> EXPLAIN (COSTS OFF) SELECT * FROM a9a WHERE id < 3 ORDER BY x LIMIT 1 FOR UPDATE SKIP LOCKED
QUERY PLAN:text
Limit
  ->  LockRows
        ->  Sort
              Sort Key: x
              ->  Seq Scan on a9a
                    Filter: (id < 3)
-- EXPLAIN

> EXPLAIN (COSTS OFF, VERBOSE) SELECT x + 1 FROM a9a ORDER BY x FOR SHARE
QUERY PLAN:text
LockRows
  Output: ((x + 1)), x, ctid
  ->  Sort
        Output: ((x + 1)), x, ctid
        Sort Key: a9a.x
        ->  Seq Scan on public.a9a
              Output: (x + 1), x, ctid
-- EXPLAIN

> EXPLAIN (COSTS OFF, VERBOSE) SELECT * FROM a9a WHERE x = 3 FOR UPDATE
QUERY PLAN:text
LockRows
  Output: id, x, note, ctid
  ->  Seq Scan on public.a9a
        Output: id, x, note, ctid
        Filter: (a9a.x = 3)
-- EXPLAIN

> EXPLAIN (COSTS OFF, VERBOSE) SELECT 1 FROM a9a a, a9a b WHERE a.id = b.id FOR UPDATE OF b
QUERY PLAN:text
LockRows
  Output: 1, b.ctid, a.ctid
  ->  Hash Join
        Output: 1, b.ctid, a.ctid
        Inner Unique: true
        Hash Cond: (a.id = b.id)
        ->  Seq Scan on public.a9a a
              Output: a.ctid, a.id
        ->  Hash
              Output: b.ctid, b.id
              ->  Seq Scan on public.a9a b
                    Output: b.ctid, b.id
-- EXPLAIN

