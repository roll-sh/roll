> CREATE TABLE a9a (id int PRIMARY KEY, x int, note text)
-- CREATE TABLE

> CREATE TABLE a9b (id int PRIMARY KEY, y int)
-- CREATE TABLE

> INSERT INTO a9a SELECT g, g, 'n' || g FROM generate_series(1, 10) g
-- INSERT 0 10

> INSERT INTO a9b SELECT g, g FROM generate_series(1, 5) g
-- INSERT 0 5

> ANALYZE a9a
-- ANALYZE

> ANALYZE a9b
-- ANALYZE

> EXPLAIN (COSTS OFF) SELECT * FROM a9a JOIN a9b ON a9a.x = a9b.y FOR UPDATE
QUERY PLAN:text
LockRows
  ->  Hash Join
        Hash Cond: (a9a.x = a9b.y)
        ->  Seq Scan on a9a
        ->  Hash
              ->  Seq Scan on a9b
-- EXPLAIN

> EXPLAIN (COSTS OFF, VERBOSE) SELECT * FROM a9a JOIN a9b ON a9a.x = a9b.y FOR UPDATE
QUERY PLAN:text
LockRows
  Output: a9a.id, a9a.x, a9a.note, a9b.id, a9b.y, a9a.ctid, a9b.ctid
  ->  Hash Join
        Output: a9a.id, a9a.x, a9a.note, a9b.id, a9b.y, a9a.ctid, a9b.ctid
        Hash Cond: (a9a.x = a9b.y)
        ->  Seq Scan on public.a9a
              Output: a9a.id, a9a.x, a9a.note, a9a.ctid
        ->  Hash
              Output: a9b.id, a9b.y, a9b.ctid
              ->  Seq Scan on public.a9b
                    Output: a9b.id, a9b.y, a9b.ctid
-- EXPLAIN

> EXPLAIN (COSTS OFF, VERBOSE) SELECT a9a.x FROM a9a JOIN a9b ON a9a.x = a9b.y FOR UPDATE OF a9a
QUERY PLAN:text
LockRows
  Output: a9a.x, a9a.ctid, a9b.ctid
  ->  Hash Join
        Output: a9a.x, a9a.ctid, a9b.ctid
        Hash Cond: (a9a.x = a9b.y)
        ->  Seq Scan on public.a9a
              Output: a9a.x, a9a.ctid
        ->  Hash
              Output: a9b.ctid, a9b.y
              ->  Seq Scan on public.a9b
                    Output: a9b.ctid, a9b.y
-- EXPLAIN

> EXPLAIN (COSTS OFF, VERBOSE) SELECT a9a.x FROM a9a, a9b WHERE a9a.x = a9b.y AND a9b.y < 3 FOR SHARE OF a9b NOWAIT
QUERY PLAN:text
LockRows
  Output: a9a.x, a9b.ctid, a9a.ctid
  ->  Hash Join
        Output: a9a.x, a9b.ctid, a9a.ctid
        Hash Cond: (a9a.x = a9b.y)
        ->  Seq Scan on public.a9a
              Output: a9a.x, a9a.ctid
        ->  Hash
              Output: a9b.ctid, a9b.y
              ->  Seq Scan on public.a9b
                    Output: a9b.ctid, a9b.y
                    Filter: (a9b.y < 3)
-- EXPLAIN

