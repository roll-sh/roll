> CREATE TABLE grg_foo (f1 int, f2 text, f3 int, f4 int)
-- CREATE TABLE

> CREATE FUNCTION grg_foo_update() RETURNS void LANGUAGE sql
> BEGIN ATOMIC
>   WITH u1 AS (UPDATE grg_foo SET f1 = f1 + 1 RETURNING old.*, new.*)
>   UPDATE grg_foo SET f1 = f1 + 1
>     RETURNING WITH (OLD AS o, NEW AS n) o.*, n.*, o.f1 = n.f1,
>               (SELECT o.f2 = n.f2),
>               (SELECT count(*) FROM grg_foo WHERE grg_foo.f1 = o.f4),
>               (SELECT count(*) FROM grg_foo WHERE grg_foo = n);
> END
-- CREATE FUNCTION

> SELECT pg_get_functiondef('grg_foo_update'::regproc)
pg_get_functiondef:text
CREATE OR REPLACE FUNCTION public.grg_foo_update()
 RETURNS void
 LANGUAGE sql
BEGIN ATOMIC
 WITH u1 AS (
          UPDATE grg_foo grg_foo_1 SET f1 = (grg_foo_1.f1 + 1)
           RETURNING old.f1,
             old.f2,
             old.f3,
             old.f4,
             new.f1,
             new.f2,
             new.f3,
             new.f4
         )
  UPDATE grg_foo SET f1 = (grg_foo.f1 + 1)
   RETURNING WITH (OLD AS o, NEW AS n) o.f1,
     o.f2,
     o.f3,
     o.f4,
     n.f1,
     n.f2,
     n.f3,
     n.f4,
     (o.f1 = n.f1),
     ( SELECT (o.f2 = n.f2)),
     ( SELECT count(*) AS count
            FROM grg_foo grg_foo_1
           WHERE (grg_foo_1.f1 = o.f4)) AS count,
     ( SELECT count(*) AS count
            FROM grg_foo grg_foo_1
           WHERE (grg_foo_1.* = n.*)) AS count;
END

-- SELECT 1

