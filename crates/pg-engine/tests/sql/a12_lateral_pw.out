-- SELECT 1

> EXPLAIN (COSTS OFF)
> SELECT count(*) FROM a12_p1 t1 JOIN LATERAL
>   (SELECT * FROM a12_p2 t2 TABLESAMPLE SYSTEM (100) REPEATABLE (t1.b) WHERE t2.b < 400) s ON t1.a = s.b
>   WHERE t1.a >= 200
QUERY PLAN:text
Aggregate
  ->  Append
        ->  Nested Loop
              ->  Seq Scan on a12_p1_1 t1_1
                    Filter: (a >= 200)
              ->  Sample Scan on a12_p2_1 t2_1
                    Sampling: system ('100'::real) REPEATABLE (t1_1.b)
                    Filter: ((b < 400) AND (t1_1.a = b))
        ->  Nested Loop
              ->  Seq Scan on a12_p1_2 t1_2
                    Filter: (a >= 200)
              ->  Sample Scan on a12_p2_2 t2_2
                    Sampling: system ('100'::real) REPEATABLE (t1_2.b)
                    Filter: ((b < 400) AND (t1_2.a = b))
-- EXPLAIN

> SELECT count(*) FROM a12_p1 t1 JOIN LATERAL
>   (SELECT * FROM a12_p2 t2 TABLESAMPLE SYSTEM (100) REPEATABLE (t1.b) WHERE t2.b < 400) s ON t1.a = s.b
>   WHERE t1.a >= 200
count:int8
33
-- SELECT 1

> SELECT count(*), count(s.b) FROM a12_p1 t1 LEFT JOIN LATERAL
>   (SELECT * FROM a12_p2 t2 TABLESAMPLE SYSTEM (100) REPEATABLE (t1.b) WHERE t2.b < 400) s ON t1.a = s.b
count:int8 | count:int8
300 | 67
-- SELECT 1

> CREATE INDEX a12_p2_1_b ON a12_p2_1 (b)
-- CREATE INDEX

> CREATE INDEX a12_p2_2_b ON a12_p2_2 (b)
-- CREATE INDEX

> CREATE INDEX a12_p2_3_b ON a12_p2_3 (b)
-- CREATE INDEX

> EXPLAIN (COSTS OFF)
> SELECT count(*) FROM a12_p1 t1 LEFT JOIN LATERAL
>   (SELECT t1.b AS t1b, t2.* FROM a12_p2 t2) s ON t1.a = s.b WHERE s.t1b = s.a
QUERY PLAN:text
Aggregate
  ->  Append
        ->  Nested Loop
              ->  Seq Scan on a12_p1_1 t1_1
              ->  Index Scan using a12_p2_1_b on a12_p2_1 t2_1
                    Index Cond: (b = t1_1.a)
                    Filter: (t1_1.b = a)
        ->  Nested Loop
              ->  Seq Scan on a12_p1_2 t1_2
              ->  Index Scan using a12_p2_2_b on a12_p2_2 t2_2
                    Index Cond: (b = t1_2.a)
                    Filter: (t1_2.b = a)
        ->  Nested Loop
              ->  Seq Scan on a12_p1_3 t1_3
              ->  Index Scan using a12_p2_3_b on a12_p2_3 t2_3
                    Index Cond: (b = t1_3.a)
                    Filter: (t1_3.b = a)
-- EXPLAIN

> SELECT count(*) FROM a12_p1 t1 LEFT JOIN LATERAL
>   (SELECT t1.b AS t1b, t2.* FROM a12_p2 t2) s ON t1.a = s.b WHERE s.t1b = s.a
count:int8
100
-- SELECT 1

