-- INSERT 0 1

> insert into f values (4, 'z')
-- INSERT 0 1

> vacuum f
-- VACUUM

> select * from ages
k:text | age:int4
heap | 4
toast | 0
-- SELECT 2

> vacuum freeze f
-- VACUUM

> select * from ages
k:text | age:int4
heap | 0
toast | 0
-- SELECT 2

> insert into f values (5, 'z')
-- INSERT 0 1

> vacuum full f
-- VACUUM

> select * from ages
k:text | age:int4
heap | 1
toast | 1
-- SELECT 2

