> create table g (a int)
-- CREATE TABLE

> insert into g values (1)
-- INSERT 0 1

> insert into g values (2)
-- INSERT 0 1

> alter table g add column b text
-- ALTER TABLE

> select age(relfrozenxid) from pg_class where oid = (select reltoastrelid from pg_class where relname = 'g')
age:int4
1
-- SELECT 1

> insert into g values (3)
-- INSERT 0 1

> alter table g add column c text default random()::text
-- ALTER TABLE

> select age(c.relfrozenxid), age(t.relfrozenxid) from pg_class c join pg_class t on t.oid = c.reltoastrelid where c.relname = 'g'
age:int4 | age:int4
1 | 1
-- SELECT 1

> drop view ages
-- DROP VIEW

> drop table f, g
-- DROP TABLE

