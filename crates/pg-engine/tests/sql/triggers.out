> CREATE FUNCTION tr_note() RETURNS trigger LANGUAGE plpgsql AS $$
> BEGIN
>   RAISE NOTICE '% fired: old=% new=%', TG_NAME, OLD.v, NEW.v;
>   RETURN NEW;
> END $$
-- CREATE FUNCTION

