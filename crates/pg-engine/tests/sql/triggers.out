> CREATE FUNCTION tr_mod() RETURNS trigger LANGUAGE plpgsql AS $$
> BEGIN
>   IF NEW.v = 'skip' THEN RETURN NULL; END IF;
>   NEW.v := upper(NEW.v);
>   NEW.n := NEW.n + 1;
>   RETURN NEW;
> END $$
-- CREATE FUNCTION

