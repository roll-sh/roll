> CREATE PROCEDURE tc() LANGUAGE plpgsql AS $$
> BEGIN
>   FOR i IN 1..4 LOOP
>     INSERT INTO proc_t VALUES (10 + i, 'tc');
>     IF i % 2 = 0 THEN COMMIT; ELSE ROLLBACK; END IF;
>   END LOOP;
> END $$
-- CREATE PROCEDURE

> CALL tc()
-- CALL

> SELECT * FROM proc_t WHERE note = 'tc' ORDER BY id
id:int4 | note:text
12 | tc
14 | tc
-- SELECT 2

> BEGIN
-- BEGIN

> CALL tc()
