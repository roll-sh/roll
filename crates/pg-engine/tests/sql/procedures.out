> ROLLBACK
-- ROLLBACK

> DO $$
> BEGIN
>   INSERT INTO proc_t VALUES (20, 'do');
>   COMMIT;
>   INSERT INTO proc_t VALUES (21, 'do');
>   ROLLBACK;
> END $$
