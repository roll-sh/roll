> SELECT * FROM proc_t WHERE note = 'do' ORDER BY id
id:int4 | note:text
20 | do
-- SELECT 1

> DO $$
> BEGIN
>   BEGIN
>     COMMIT;
>   EXCEPTION WHEN others THEN
>     RAISE NOTICE 'caught: %', SQLERRM;
>   END;
> END $$
