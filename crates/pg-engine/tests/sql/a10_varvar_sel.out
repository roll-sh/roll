> EXPLAIN (COSTS OFF)
> SELECT t1.c, count(t2.c) FROM a10_vtab5 t1 JOIN a10_vtab6 t2 ON t1.c = t2.c AND t1.c = t2.b GROUP BY 1 ORDER BY t1.c COLLATE "C"
QUERY PLAN:text
Sort
  Sort Key: t1.c COLLATE "C"
  ->  Append
        ->  HashAggregate
              Group Key: t1.c
              ->  Nested Loop
                    Join Filter: (t1.c = t2.c)
                    ->  Seq Scan on a10_vtab6_p1 t2
                          Filter: (c = b)
                    ->  Seq Scan on a10_vtab5_p1 t1
        ->  HashAggregate
              Group Key: t1_1.c
              ->  Nested Loop
                    Join Filter: (t1_1.c = t2_1.c)
                    ->  Seq Scan on a10_vtab6_p2 t2_1
                          Filter: (c = b)
                    ->  Seq Scan on a10_vtab5_p2 t1_1
-- EXPLAIN

> SELECT t1.c, count(t2.c) FROM a10_vtab5 t1 JOIN a10_vtab6 t2 ON t1.c = t2.c AND t1.c = t2.b GROUP BY 1 ORDER BY t1.c COLLATE "C"
c:text | count:int8
