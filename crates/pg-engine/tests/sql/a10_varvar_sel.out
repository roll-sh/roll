QUERY PLAN:text
Seq Scan on a10_vs1  (cost=0.00..11.50 rows=3 width=17)
  Filter: (c = d)
-- EXPLAIN

> EXPLAIN SELECT * FROM a10_vs1 WHERE e = f
QUERY PLAN:text
Seq Scan on a10_vs1  (cost=0.00..11.50 rows=3 width=17)
  Filter: (e = f)
-- EXPLAIN

> EXPLAIN SELECT * FROM a10_vs1 x JOIN a10_vs1 y ON x.a = y.b
QUERY PLAN:text
Hash Join  (cost=17.50..1379.00 rows=120000 width=34)
  Hash Cond: (y.b = x.a)
  ->  Seq Scan on a10_vs1 y  (cost=0.00..10.00 rows=600 width=17)
  ->  Hash  (cost=10.00..10.00 rows=600 width=17)
        ->  Seq Scan on a10_vs1 x  (cost=0.00..10.00 rows=600 width=17)
-- EXPLAIN

> SET max_parallel_workers_per_gather TO 0
-- SET

> SET enable_incremental_sort TO off
-- SET

> SET enable_partitionwise_aggregate TO true
-- SET

> SET enable_partitionwise_join TO true
-- SET

