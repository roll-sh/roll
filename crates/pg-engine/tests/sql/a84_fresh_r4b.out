> CREATE TABLE a84j (id int, j jsonb)
-- CREATE TABLE

> INSERT INTO a84j VALUES (1, '{"n": 1e3}'), (2, '{"n": "10"}'), (3, '{"n": 2.5}'), (4, '{"n": -0.0}'),
>   (5, '{"n": 123456789012345678901234567890}'), (6, '{"a": [1, 2, 3]}'), (7, '{"a": ["1", "a", null, true]}'),
>   (8, '{"a": 5, "s": "abc"}'), (9, '{"b": {"c": "x"}, "a": [1]}'), (10, '{"b": {"c": "x"}}'), (11, '[1, "x", 3]')
