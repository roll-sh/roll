> SELECT t.id, r.v FROM a84j t, LATERAL jsonb_path_query(t.j, '$.a.boolean()', '{}', true) WITH ORDINALITY r(v, o) ORDER BY t.id, r.o
id:int4 | v:jsonb
6 | true
6 | true
6 | true
7 | true
8 | true
9 | true
