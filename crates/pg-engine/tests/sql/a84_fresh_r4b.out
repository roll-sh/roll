> SELECT id, sum(x) OVER (ORDER BY id ROWS BETWEEN CURRENT ROW AND CURRENT ROW) FROM (VALUES (1, '-0'::float8), (2, '1')) v(id, x) ORDER BY id
id:int4 | sum:float8
1 | -0
2 | 1
