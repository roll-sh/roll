3 | 1 | 2020-01-02
-- SELECT 1

> create table gx_f(a int, b text)
-- CREATE TABLE

> create view gx_fv as select text(a) t, int4(b) i, bpchar(a) c from gx_f
-- CREATE VIEW

> select pg_get_viewdef('gx_fv')
pg_get_viewdef:text
 SELECT (a)::text AS t,
    (b)::integer AS i,
    (a)::bpchar AS c
   FROM gx_f;
-- SELECT 1

