> CREATE TABLE l (a text, b int) PARTITION BY LIST (a)
-- CREATE TABLE

> CREATE TABLE l1 PARTITION OF l FOR VALUES IN ('x')
-- CREATE TABLE

> CREATE TABLE l2 PARTITION OF l FOR VALUES IN (NULL)
-- CREATE TABLE

> CREATE TABLE l3 PARTITION OF l FOR VALUES IN ('y', NULL, 'z')
ERROR 42P17: partition "l3" would overlap partition "l2" (at 52)

> CREATE TABLE l3 PARTITION OF l FOR VALUES IN ('y', 'z')
-- CREATE TABLE

> CREATE TABLE ld PARTITION OF l DEFAULT
-- CREATE TABLE

> SELECT c.relname, pg_get_partition_constraintdef(c.oid) FROM pg_class c WHERE relname IN ('l1','l2','l3','ld') ORDER BY 1
relname:name | pg_get_partition_constraintdef:text
l1 | ((a IS NOT NULL) AND (a = 'x'::text))
l2 | (a IS NULL)
l3 | ((a IS NOT NULL) AND (a = ANY (ARRAY['y'::text, 'z'::text])))
ld | (NOT ((a IS NULL) OR (a = ANY (ARRAY['x'::text, 'y'::text, 'z'::text]))))
-- SELECT 4

> CREATE TABLE r (a int, b date) PARTITION BY RANGE (a, b)
-- CREATE TABLE

> CREATE TABLE r1 PARTITION OF r FOR VALUES FROM (MINVALUE, MINVALUE) TO (10, '2024-01-01')
-- CREATE TABLE

> CREATE TABLE r2 PARTITION OF r FOR VALUES FROM (10, '2024-01-01') TO (MAXVALUE, MAXVALUE)
-- CREATE TABLE

> CREATE TABLE r3 (a int, b date) PARTITION BY RANGE (a)
-- CREATE TABLE

> CREATE TABLE r31 PARTITION OF r3 FOR VALUES FROM (1) TO (MAXVALUE)
-- CREATE TABLE

> CREATE TABLE r3d PARTITION OF r3 DEFAULT
-- CREATE TABLE

> CREATE TABLE sub (a int, b int) PARTITION BY LIST (a)
-- CREATE TABLE

> CREATE TABLE sub1 PARTITION OF sub FOR VALUES IN (1, 2) PARTITION BY RANGE (b)
-- CREATE TABLE

> CREATE TABLE sub11 PARTITION OF sub1 FOR VALUES FROM (0) TO (10)
-- CREATE TABLE

> CREATE TABLE sub1d PARTITION OF sub1 DEFAULT
-- CREATE TABLE

> CREATE TABLE onlyd (a int) PARTITION BY LIST (a)
-- CREATE TABLE

> CREATE TABLE onlyd_d PARTITION OF onlyd DEFAULT
-- CREATE TABLE

> SELECT c.relname, pg_get_partition_constraintdef(c.oid) FROM pg_class c WHERE relname IN ('r1','r2','r31','r3d','sub1','sub11','sub1d','onlyd_d', 'r', 'sub') ORDER BY 1
relname:name | pg_get_partition_constraintdef:text
onlyd_d | NULL
r | NULL
r1 | ((a IS NOT NULL) AND (b IS NOT NULL) AND ((a < 10) OR ((a = 10) AND (b < '2024-01-01'::date))))
r2 | ((a IS NOT NULL) AND (b IS NOT NULL) AND ((a > 10) OR ((a = 10) AND (b >= '2024-01-01'::date))))
r31 | ((a IS NOT NULL) AND (a >= 1))
r3d | (NOT ((a IS NOT NULL) AND (a >= 1)))
sub | NULL
sub1 | ((a IS NOT NULL) AND (a = ANY (ARRAY[1, 2])))
sub11 | ((a IS NOT NULL) AND (a = ANY (ARRAY[1, 2])) AND (b IS NOT NULL) AND (b >= 0) AND (b < 10))
sub1d | ((a IS NOT NULL) AND (a = ANY (ARRAY[1, 2])) AND (NOT ((b IS NOT NULL) AND ((b >= 0) AND (b < 10)))))
-- SELECT 10

> CREATE TABLE e (a int, t text) PARTITION BY RANGE ((a + 1), lower(t))
-- CREATE TABLE

> CREATE TABLE e1 PARTITION OF e FOR VALUES FROM (0, 'a') TO (10, 'm')
-- CREATE TABLE

> SELECT pg_get_partkeydef('e'::regclass), pg_get_partition_constraintdef('e1'::regclass)
pg_get_partkeydef:text | pg_get_partition_constraintdef:text
RANGE (((a + 1)), lower(t)) | (((a + 1) IS NOT NULL) AND (lower(t) IS NOT NULL) AND (((a + 1) > 0) OR (((a + 1) = 0) AND (lower(t) >= 'a'::text))) AND (((a + 1) < 10) OR (((a + 1) = 10) AND (lower(t) < 'm'::text))))
-- SELECT 1

> SELECT partattrs, partexprs IS NOT NULL FROM pg_partitioned_table WHERE partrelid = 'e'::regclass
partattrs:22 | ?column?:bool
0 0 | t
-- SELECT 1

> INSERT INTO e VALUES (3, 'b')
-- INSERT 0 1

> INSERT INTO e VALUES (30, 'b')
ERROR 23514: no partition of relation "e" found for row
DETAIL: Partition key of the failing row contains ((a + 1), lower(t)) = (31, b).
OBJECTS: schema=public table=e

> EXPLAIN (COSTS OFF) SELECT * FROM e WHERE a + 1 = 4
QUERY PLAN:text
Seq Scan on e1 e
  Filter: ((a + 1) = 4)
-- EXPLAIN

> SELECT * FROM pg_partition_tree('sub') ORDER BY level, relid::text
relid:regclass | parentrelid:regclass | isleaf:bool | level:int4
sub | NULL | f | 0
sub1 | sub | f | 1
sub11 | sub1 | t | 2
sub1d | sub1 | t | 2
-- SELECT 4

> SELECT pg_partition_root('sub11'), pg_partition_root('sub'), pg_partition_root('e'), pg_partition_root('pg_class')
pg_partition_root:regclass | pg_partition_root:regclass | pg_partition_root:regclass | pg_partition_root:regclass
sub | sub | e | NULL
-- SELECT 1

> SELECT * FROM pg_partition_ancestors('sub11')
relid:regclass
sub
sub1
sub11
