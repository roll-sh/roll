> EXPLAIN (COSTS OFF) SELECT * FROM sub WHERE a = 1 AND b = 5
QUERY PLAN:text
Seq Scan on sub11 sub
  Filter: ((a = 1) AND (b = 5))
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM sub WHERE b = 50
QUERY PLAN:text
Seq Scan on sub1d sub
  Filter: (b = 50)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM sub
QUERY PLAN:text
Append
  ->  Seq Scan on sub11 sub_1
  ->  Seq Scan on sub1d sub_2
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM l WHERE a IS NULL
QUERY PLAN:text
Seq Scan on l2 l
  Filter: (a IS NULL)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM l WHERE a IS NOT NULL
QUERY PLAN:text
Append
  ->  Seq Scan on l1 l_1
        Filter: (a IS NOT NULL)
  ->  Seq Scan on l3 l_2
        Filter: (a IS NOT NULL)
  ->  Seq Scan on ld l_3
        Filter: (a IS NOT NULL)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM l WHERE a > 'x'
QUERY PLAN:text
Append
  ->  Seq Scan on l3 l_1
        Filter: (a > 'x'::text)
  ->  Seq Scan on ld l_2
        Filter: (a > 'x'::text)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM l WHERE a <> 'x'
QUERY PLAN:text
Append
  ->  Seq Scan on l3 l_1
        Filter: (a <> 'x'::text)
  ->  Seq Scan on ld l_2
        Filter: (a <> 'x'::text)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM l WHERE a = 'q' OR a = 'y'
QUERY PLAN:text
Append
  ->  Seq Scan on l3 l_1
        Filter: ((a = 'q'::text) OR (a = 'y'::text))
  ->  Seq Scan on ld l_2
        Filter: ((a = 'q'::text) OR (a = 'y'::text))
-- EXPLAIN

