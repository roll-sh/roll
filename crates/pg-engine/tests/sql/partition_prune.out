> EXPLAIN (COSTS OFF) UPDATE sub SET b = b + 1 WHERE a = 1
QUERY PLAN:text
Update on sub
  Update on sub11 sub_1
  Update on sub1d sub_2
  ->  Append
        ->  Seq Scan on sub11 sub_1
              Filter: (a = 1)
        ->  Seq Scan on sub1d sub_2
              Filter: (a = 1)
-- EXPLAIN

