> EXPLAIN (COSTS OFF)
> SELECT t1.x, t2.y FROM (SELECT * FROM a6_r1 WHERE x = 1 AND x = 2) t1
>   RIGHT JOIN a6_r2 t2 ON t1.x = t2.y AND t1.y = t2.x
QUERY PLAN:text
Hash Left Join
  Hash Cond: ((t2.y = x) AND (t2.x = y))
  ->  Append
        ->  Seq Scan on a6_r2_p1 t2_1
        ->  Seq Scan on a6_r2_p2 t2_2
  ->  Hash
        ->  Result
              One-Time Filter: false
-- EXPLAIN

> EXPLAIN (COSTS OFF)
> SELECT t1.x, sum(t1.y), count(t1) FROM a6_r1 t1, a6_r2 t2 WHERE t1.x = t2.y GROUP BY t1.x ORDER BY 1, 2, 3
QUERY PLAN:text
Sort
  Sort Key: t1.x, (sum(t1.y)), (count(((t1.*)::a6_r1)))
  ->  HashAggregate
        Group Key: t1.x
        ->  Hash Join
              Hash Cond: (t1.x = t2.y)
              ->  Append
                    ->  Seq Scan on a6_r1_p1 t1_1
                    ->  Seq Scan on a6_r1_p2 t1_2
              ->  Hash
                    ->  Append
                          ->  Seq Scan on a6_r2_p1 t2_1
                          ->  Seq Scan on a6_r2_p2 t2_2
-- EXPLAIN

