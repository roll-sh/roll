> CREATE FUNCTION a6_simple(v int) RETURNS int AS $$ BEGIN RETURN v + 10; END; $$
>   LANGUAGE plpgsql PARALLEL SAFE
-- CREATE FUNCTION

> EXPLAIN (COSTS OFF, VERBOSE)
> SELECT ten, a6_simple(ten) FROM a6_big WHERE ten < 100 ORDER BY ten
QUERY PLAN:text
Gather Merge
  Output: ten, (a6_simple(ten))
  Workers Planned: 4
  ->  Result
        Output: ten, a6_simple(ten)
        ->  Sort
              Output: ten
              Sort Key: a6_big.ten
              ->  Parallel Seq Scan on public.a6_big
                    Output: ten
                    Filter: (a6_big.ten < 100)
-- EXPLAIN

