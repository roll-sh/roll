  ->  Seq Scan on a46_t1 t1
  ->  Hash
        ->  Hash Join
              Hash Cond: (t2.x = t3.p)
              ->  Seq Scan on a46_t2 t2
              ->  Hash
                    ->  Seq Scan on a46_t3 t3
