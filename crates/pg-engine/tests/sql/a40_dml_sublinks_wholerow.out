> explain (verbose, costs off) select j, i.f1 from a40_int4 i left join a40_int2 j on i.f1 = j.f1
QUERY PLAN:text
Hash Left Join
  Output: j.*, i.f1
  Hash Cond: (i.f1 = j.f1)
  ->  Seq Scan on public.a40_int4 i
        Output: i.f1
  ->  Hash
        Output: j.*, j.f1
        ->  Seq Scan on public.a40_int2 j
              Output: j.*, j.f1
-- EXPLAIN

> explain (verbose, costs off) select w, i.f1 from a40_wt w join a40_int4 i on w.a = i.f1 join a40_int2 j on j.f1 = i.f1
QUERY PLAN:text
Hash Join
  Output: w.*, i.f1
  Hash Cond: (w.a = j.f1)
  ->  Hash Join
        Output: w.*, w.a, i.f1
        Hash Cond: (w.a = i.f1)
        ->  Seq Scan on public.a40_wt w
              Output: w.*, w.a
        ->  Hash
              Output: i.f1
              ->  Seq Scan on public.a40_int4 i
                    Output: i.f1
  ->  Hash
        Output: j.f1
        ->  Seq Scan on public.a40_int2 j
              Output: j.f1
-- EXPLAIN

> explain (verbose, costs off) select w.a from a40_wt w join a40_int4 i on w.a = i.f1 where w is not null and w::text <> i::text
QUERY PLAN:text
Hash Join
  Output: w.a
  Hash Cond: (w.a = i.f1)
  Join Filter: ((w.*)::text <> (i.*)::text)
  ->  Seq Scan on public.a40_wt w
        Output: w.a, w.*
        Filter: (w.* IS NOT NULL)
  ->  Hash
        Output: i.f1, i.*
        ->  Seq Scan on public.a40_int4 i
              Output: i.f1, i.*
-- EXPLAIN

> set enable_hashjoin = off
