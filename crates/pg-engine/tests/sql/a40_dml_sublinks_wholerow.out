> EXPLAIN (COSTS OFF) UPDATE a40_sbv SET b = 1000 WHERE a < 30
QUERY PLAN:text
Update on a40_ih
  Update on a40_ih a40_ih_1
  Update on a40_ih_c1 a40_ih_2
  Update on a40_ih_c2 a40_ih_3
  ->  Result
        ->  Append
              ->  Seq Scan on a40_ih a40_ih_1
                    Filter: ((a < 30) AND (ANY (a = (hashed SubPlan 2).col1)))
                    SubPlan 2
                      ->  Seq Scan on a40_k k
              ->  Seq Scan on a40_ih_c1 a40_ih_2
                    Filter: ((a < 30) AND (ANY (a = (hashed SubPlan 2).col1)))
              ->  Seq Scan on a40_ih_c2 a40_ih_3
                    Filter: ((a < 30) AND (ANY (a = (hashed SubPlan 2).col1)))
-- EXPLAIN

> UPDATE a40_sbv SET b = 1000 WHERE a < 30
-- UPDATE 10

> EXPLAIN (COSTS OFF) UPDATE a40_pv SET b = 2000 WHERE a > 30
QUERY PLAN:text
Update on a40_ih
  Update on a40_ih a40_ih_1
  Update on a40_ih_c1 a40_ih_2
  Update on a40_ih_c2 a40_ih_3
  ->  Hash Semi Join
        Hash Cond: (a40_ih.a = k.v)
        ->  Append
              ->  Seq Scan on a40_ih a40_ih_1
                    Filter: (a > 30)
              ->  Seq Scan on a40_ih_c1 a40_ih_2
                    Filter: (a > 30)
              ->  Seq Scan on a40_ih_c2 a40_ih_3
                    Filter: (a > 30)
        ->  Hash
              ->  Seq Scan on a40_k k
-- EXPLAIN

