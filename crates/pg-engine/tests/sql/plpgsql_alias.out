> create function gxw_b1(int, out res int, out msg text) language plpgsql as $$
> declare
>   k alias for $1;
>   o alias for res;
>   m alias for msg;
>   cnt alias for o;
> begin
>   select count(*) into cnt from gxw_a where id >= k;
>   get diagnostics m = row_count;
>   m := m || '/' || o;
> end $$
-- CREATE FUNCTION

> select * from gxw_b1(1)
