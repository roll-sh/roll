> create function gxw_b3(id int) returns text language plpgsql as $$
> declare
>   ident alias for id;
>   c cursor for select v from gxw_a where gxw_a.id = ident;
>   r text;
> begin
>   open c;
>   fetch c into r;
>   close c;
>   declare
>     ident text := 'shadow';
>   begin
>     r := r || ident;
>   end;
>   return r || ident;
> end $$
-- CREATE FUNCTION

