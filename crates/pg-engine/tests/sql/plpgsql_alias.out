> create table gxw_a (id int, v text)
-- CREATE TABLE

> insert into gxw_a values (1, 'one'), (2, 'two')
-- INSERT 0 2

> create function gxw_al(int, text) returns text language plpgsql as $$
> declare
>   n alias for $1;
>   t alias for $2;
>   n2 alias for n;
>   r record;
> begin
>   raise notice '% % % %', n, $1, n2, t;
>   n2 := n2 + 1;
>   raise notice 'after % % %', n, $1, n2;
>   select v into r from gxw_a where id = n2 - 1;
>   perform 1 from gxw_a where id = n and v = t;
>   return r.v || ':' || (select count(*) from gxw_a where id <= n2) || ':' || t || $2;
> end $$
-- CREATE FUNCTION

