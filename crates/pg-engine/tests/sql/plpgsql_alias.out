-- SELECT 1

> create function gxw_b2(lim int) returns setof gxw_a language plpgsql as $$
> declare
>   l alias for lim;
>   rec record;
>   rr alias for rec;
> begin
>   for rec in select * from gxw_a where id <= l order by id loop
>     rr.v := rr.v || '!';
>     return next rr;
>   end loop;
>   return query select * from gxw_a where id = l;
>   return query execute 'select * from gxw_a where id = $1' using l;
> end $$
-- CREATE FUNCTION

