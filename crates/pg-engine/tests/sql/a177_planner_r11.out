> CREATE TABLE a177_d (t text, u varchar(10), c text COLLATE "C", n int)
-- CREATE TABLE

> INSERT INTO a177_d SELECT 'x' || (g % 50), 'y' || (g % 7), 'z' || (g % 9), g FROM generate_series(1, 1000) g
-- INSERT 0 1000

> ANALYZE a177_d
-- ANALYZE

> EXPLAIN (COSTS OFF) SELECT DISTINCT t COLLATE "C" FROM a177_d
QUERY PLAN:text
HashAggregate
  Group Key: (t)::text
  ->  Seq Scan on a177_d
-- EXPLAIN

