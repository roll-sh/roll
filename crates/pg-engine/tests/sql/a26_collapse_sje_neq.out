> create table a26_sj (a int unique, b int, c int unique)
-- CREATE TABLE

> insert into a26_sj values (1, null, 2), (null, 2, null), (2, 1, 1)
-- INSERT 0 3

> analyze a26_sj
-- ANALYZE

> create table a26_sk (a int, b int)
-- CREATE TABLE

> create index on a26_sk (a)
-- CREATE INDEX

> set enable_hashjoin = off
-- SET

> set enable_mergejoin = off
-- SET

> set join_collapse_limit = 1
-- SET

> set enable_seqscan = off
-- SET

> explain (costs off) select 1 from
>   (a26_sk k1 join a26_sk k2 on k1.a = k2.a)
>   join (a26_sj j1 join a26_sj j2 on j1.a = j2.a) on j1.b = k1.b
QUERY PLAN:text
Nested Loop
  Join Filter: (k1.b = j2.b)
  ->  Nested Loop
        ->  Index Scan using a26_sk_a_idx on a26_sk k1
        ->  Index Only Scan using a26_sk_a_idx on a26_sk k2
              Index Cond: (a = k1.a)
  ->  Materialize
        ->  Index Scan using a26_sj_a_key on a26_sj j2
              Index Cond: (a IS NOT NULL)
-- EXPLAIN

> explain (costs off) select 1 from
>   (a26_sk k1 join a26_sk k2 on k1.a = k2.a)
>   join (a26_sj j1 join a26_sj j2 on j1.a = j2.a) on j2.b = k1.b
QUERY PLAN:text
Nested Loop
  Join Filter: (k1.b = j2.b)
  ->  Nested Loop
        ->  Index Scan using a26_sk_a_idx on a26_sk k1
        ->  Index Only Scan using a26_sk_a_idx on a26_sk k2
              Index Cond: (a = k1.a)
  ->  Materialize
        ->  Index Scan using a26_sj_a_key on a26_sj j2
              Index Cond: (a IS NOT NULL)
-- EXPLAIN

> reset enable_seqscan
-- RESET

> explain (costs off) select 1 from a26_sk k1, a26_sk k2, a26_sj j1
>   where k1.a = k2.a and j1.b = k1.b
QUERY PLAN:text
Nested Loop
  ->  Nested Loop
        Join Filter: (k1.b = j1.b)
        ->  Seq Scan on a26_sk k1
        ->  Materialize
              ->  Seq Scan on a26_sj j1
  ->  Index Only Scan using a26_sk_a_idx on a26_sk k2
        Index Cond: (a = k1.a)
-- EXPLAIN

> reset join_collapse_limit
-- RESET

