> explain select * from a26_sj n1, a26_sj n2 where n1.a <> n2.a
QUERY PLAN:text
Nested Loop  (cost=0.00..2.20 rows=7 width=24)
  Join Filter: (n1.a <> n2.a)
  ->  Seq Scan on a26_sj n1  (cost=0.00..1.03 rows=3 width=12)
  ->  Materialize  (cost=0.00..1.04 rows=3 width=12)
        ->  Seq Scan on a26_sj n2  (cost=0.00..1.03 rows=3 width=12)
-- EXPLAIN

> explain select * from a26_sj n1 where exists (select 1 from a26_sj n2 where n1.a <> n2.a)
QUERY PLAN:text
Nested Loop Semi Join  (cost=0.00..2.15 rows=2 width=12)
  Join Filter: (n1.a <> n2.a)
  ->  Seq Scan on a26_sj n1  (cost=0.00..1.03 rows=3 width=12)
  ->  Materialize  (cost=0.00..1.04 rows=3 width=4)
        ->  Seq Scan on a26_sj n2  (cost=0.00..1.03 rows=3 width=4)
-- EXPLAIN

> explain select * from a26_sj n1 where not exists (select 1 from a26_sj n2 where n1.a <> n2.a)
QUERY PLAN:text
Nested Loop Anti Join  (cost=0.00..2.15 rows=1 width=12)
  Join Filter: (n1.a <> n2.a)
  ->  Seq Scan on a26_sj n1  (cost=0.00..1.03 rows=3 width=12)
  ->  Materialize  (cost=0.00..1.04 rows=3 width=4)
        ->  Seq Scan on a26_sj n2  (cost=0.00..1.03 rows=3 width=4)
-- EXPLAIN

> explain (costs off)
> select * from (select n2.a from a26_sj n1, a26_sj n2 where n1.a <> n2.a) q0, a26_sl
>   where q0.a = 1
QUERY PLAN:text
Nested Loop
  Join Filter: (n1.a <> n2.a)
  ->  Nested Loop
        ->  Seq Scan on a26_sl
        ->  Seq Scan on a26_sj n2
              Filter: (a = 1)
  ->  Seq Scan on a26_sj n1
-- EXPLAIN

