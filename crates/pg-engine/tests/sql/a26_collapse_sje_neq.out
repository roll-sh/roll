-- INSERT 0 10

> analyze a26_emp
-- ANALYZE

> explain (costs off)
> select count(*) from a26_emp c1, a26_emp c2, a26_emp c3
>   where c3.id = c2.id and c3.id * c2.id = c1.id * c1.id
QUERY PLAN:text
Aggregate
  ->  Seq Scan on a26_emp c3
        Filter: ((id * id) IS NOT NULL)
