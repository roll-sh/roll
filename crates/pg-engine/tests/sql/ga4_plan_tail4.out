> CREATE TABLE ga4_tk (unique1 int, unique2 int, thousand int, tenthous int, filler text)
-- CREATE TABLE

> INSERT INTO ga4_tk SELECT i, (i * 7919) % 10000, i % 1000, i, repeat('x', 100) FROM generate_series(0, 9999) i
-- INSERT 0 10000

> CREATE INDEX ga4_tk_u1 ON ga4_tk (unique1)
-- CREATE INDEX

> CREATE INDEX ga4_tk_thous_tenthous ON ga4_tk (thousand, tenthous)
-- CREATE INDEX

> VACUUM ANALYZE ga4_tk
-- VACUUM

> EXPLAIN (COSTS OFF)
> SELECT COUNT(*) OVER (ORDER BY t1.unique1)
> FROM ga4_tk t1 INNER JOIN ga4_tk t2 ON t1.unique1 = t2.tenthous
> LIMIT 1
QUERY PLAN:text
Limit
  ->  WindowAgg
        Window: w1 AS (ORDER BY t1.unique1)
        ->  Nested Loop
              ->  Index Only Scan using ga4_tk_u1 on ga4_tk t1
              ->  Index Only Scan using ga4_tk_thous_tenthous on ga4_tk t2
                    Index Cond: (tenthous = t1.unique1)
-- EXPLAIN

> EXPLAIN (COSTS OFF)
> SELECT COUNT(*) OVER (ORDER BY t1.unique1 ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)
> FROM ga4_tk t1 INNER JOIN ga4_tk t2 ON t1.unique1 = t2.tenthous
> LIMIT 1
QUERY PLAN:text
Limit
  ->  WindowAgg
        Window: w1 AS (ORDER BY t1.unique1 ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)
        ->  Merge Join
              Merge Cond: (t1.unique1 = t2.tenthous)
              ->  Index Only Scan using ga4_tk_u1 on ga4_tk t1
              ->  Sort
                    Sort Key: t2.tenthous
                    ->  Index Only Scan using ga4_tk_thous_tenthous on ga4_tk t2
-- EXPLAIN

> EXPLAIN (COSTS OFF)
> SELECT COUNT(*) OVER (ORDER BY t1.unique1 ROWS BETWEEN UNBOUNDED PRECEDING AND 10000 FOLLOWING)
> FROM ga4_tk t1 INNER JOIN ga4_tk t2 ON t1.unique1 = t2.tenthous
> LIMIT 1
QUERY PLAN:text
Limit
  ->  WindowAgg
        Window: w1 AS (ORDER BY t1.unique1 ROWS BETWEEN UNBOUNDED PRECEDING AND '10000'::bigint FOLLOWING)
        ->  Merge Join
              Merge Cond: (t1.unique1 = t2.tenthous)
              ->  Index Only Scan using ga4_tk_u1 on ga4_tk t1
              ->  Sort
                    Sort Key: t2.tenthous
                    ->  Index Only Scan using ga4_tk_thous_tenthous on ga4_tk t2
-- EXPLAIN

> EXPLAIN (COSTS OFF)
> SELECT sum(t2.unique2) OVER (PARTITION BY t1.thousand)
> FROM ga4_tk t1 INNER JOIN ga4_tk t2 ON t1.unique1 = t2.unique2
QUERY PLAN:text
WindowAgg
  Window: w1 AS (PARTITION BY t1.thousand)
  ->  Sort
        Sort Key: t1.thousand
        ->  Hash Join
              Hash Cond: (t1.unique1 = t2.unique2)
              ->  Seq Scan on ga4_tk t1
              ->  Hash
                    ->  Seq Scan on ga4_tk t2
-- EXPLAIN

> CREATE TABLE ga4_u1 (a int)
-- CREATE TABLE

> CREATE TABLE ga4_u2 (a int)
-- CREATE TABLE

