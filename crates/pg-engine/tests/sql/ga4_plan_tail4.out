-- CREATE TABLE

> INSERT INTO ga4_u1 SELECT i FROM generate_series(1, 1000) i
-- INSERT 0 1000

> INSERT INTO ga4_u2 SELECT i FROM generate_series(1, 1000) i
-- INSERT 0 1000

> INSERT INTO ga4_u3 SELECT i % 50 FROM generate_series(1, 100) i
-- INSERT 0 100

> CREATE INDEX ON ga4_u1 (a)
-- CREATE INDEX

> CREATE INDEX ON ga4_u2 (a)
-- CREATE INDEX

> ANALYZE ga4_u1
-- ANALYZE

> ANALYZE ga4_u2
-- ANALYZE

> ANALYZE ga4_u3
-- ANALYZE

> EXPLAIN (COSTS OFF)
> SELECT * FROM ga4_u3 t1 JOIN (SELECT * FROM ga4_u1 UNION ALL SELECT * FROM ga4_u2) t2 ON t1.a = t2.a
QUERY PLAN:text
Hash Join
  Hash Cond: (ga4_u1.a = t1.a)
  ->  Append
        ->  Seq Scan on ga4_u1
        ->  Seq Scan on ga4_u2
  ->  Hash
        ->  Seq Scan on ga4_u3 t1
-- EXPLAIN

> SELECT count(*) FROM ga4_u3 t1 JOIN (SELECT * FROM ga4_u1 UNION ALL SELECT * FROM ga4_u2) t2 ON t1.a = t2.a
count:int8
196
-- SELECT 1

> CREATE TABLE ga4_g32 (
>   a int PRIMARY KEY,
>   b int GENERATED ALWAYS AS (a * 2),
>   c int GENERATED ALWAYS AS (10 + 10),
>   d int GENERATED ALWAYS AS (coalesce(a, 100)),
>   e int
> )
-- CREATE TABLE

> INSERT INTO ga4_g32 VALUES (1), (2)
-- INSERT 0 2

> ANALYZE ga4_g32
-- ANALYZE

> EXPLAIN (COSTS OFF)
> SELECT t1.a FROM ga4_g32 t1 LEFT JOIN ga4_g32 t2 ON t1.a = t2.a WHERE coalesce(t2.b, 1) = 2
QUERY PLAN:text
Hash Left Join
  Hash Cond: (t1.a = t2.a)
  Filter: (COALESCE((t2.a * 2), 1) = 2)
  ->  Seq Scan on ga4_g32 t1
  ->  Hash
        ->  Seq Scan on ga4_g32 t2
-- EXPLAIN

> EXPLAIN (COSTS OFF)
> SELECT t1.a FROM ga4_g32 t1 LEFT JOIN ga4_g32 t2 ON t1.a = t2.a WHERE coalesce(t2.b, 1) = 2 OR t1.a IS NULL
QUERY PLAN:text
Hash Left Join
  Hash Cond: (t1.a = t2.a)
  Filter: ((COALESCE((t2.a * 2), 1) = 2) OR (t1.a IS NULL))
  ->  Seq Scan on ga4_g32 t1
  ->  Hash
        ->  Seq Scan on ga4_g32 t2
-- EXPLAIN

> SELECT t1.a FROM ga4_g32 t1 LEFT JOIN ga4_g32 t2 ON t1.a = t2.a WHERE coalesce(t2.b, 1) = 2
a:int4
1
-- SELECT 1

> EXPLAIN (VERBOSE, COSTS OFF) SELECT t2.* FROM ga4_g32 t1 LEFT JOIN ga4_g32 t2 ON false
QUERY PLAN:text
Nested Loop Left Join
  Output: a, (a * 2), (20), (COALESCE(a, 100)), e
  Join Filter: false
  ->  Seq Scan on public.ga4_g32 t1
        Output: t1.a, t1.b, t1.c, t1.d, t1.e
  ->  Result
        Output: a, e, 20, COALESCE(a, 100)
        One-Time Filter: false
-- EXPLAIN

