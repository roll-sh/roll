> CREATE TABLE a167_o (k int)
-- CREATE TABLE

> CREATE TABLE a167_r (rk int)
-- CREATE TABLE

> CREATE TABLE a167_n (nk int, rk int)
-- CREATE TABLE

> INSERT INTO a167_o SELECT g FROM generate_series(1, 6) g
-- INSERT 0 6

> INSERT INTO a167_r VALUES (1), (2), (3)
-- INSERT 0 3

> INSERT INTO a167_n SELECT g, g % 3 + 1 FROM generate_series(1, 9) g
-- INSERT 0 9

> ANALYZE a167_o, a167_r, a167_n
-- ANALYZE

> SET enable_hashjoin = off
-- SET

> SET enable_mergejoin = off
-- SET

> SET enable_material = off
-- SET

> SET enable_memoize = off
-- SET

> EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
> SELECT o.k, (SELECT count(*) FROM a167_r r JOIN a167_n n ON n.rk = r.rk WHERE r.rk < o.k % 3)
> FROM a167_o o WHERE o.k <= 6
QUERY PLAN:text
Seq Scan on a167_o o (actual rows=6.00 loops=1)
  Filter: (k <= 6)
  SubPlan 1
    ->  Aggregate (actual rows=1.00 loops=6)
          ->  Nested Loop (actual rows=1.00 loops=6)
                Join Filter: (r.rk = n.rk)
                Rows Removed by Join Filter: 2
                ->  Seq Scan on a167_r r (actual rows=0.33 loops=6)
                      Filter: (rk < (o.k % 3))
                      Rows Removed by Filter: 3
                ->  Seq Scan on a167_n n (actual rows=9.00 loops=2)
-- EXPLAIN

> EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
> SELECT o.k, (SELECT count(*) FROM a167_r r JOIN a167_n n ON n.rk = r.rk WHERE r.rk < 2 + o.k % 2)
> FROM a167_o o WHERE o.k <= 2
QUERY PLAN:text
Seq Scan on a167_o o (actual rows=2.00 loops=1)
  Filter: (k <= 2)
  Rows Removed by Filter: 4
  SubPlan 1
    ->  Aggregate (actual rows=1.00 loops=2)
          ->  Nested Loop (actual rows=4.50 loops=2)
                Join Filter: (r.rk = n.rk)
                Rows Removed by Join Filter: 9
                ->  Seq Scan on a167_r r (actual rows=1.50 loops=2)
                      Filter: (rk < (2 + (o.k % 2)))
                      Rows Removed by Filter: 2
                ->  Seq Scan on a167_n n (actual rows=9.00 loops=3)
-- EXPLAIN

> RESET enable_hashjoin
-- RESET

> RESET enable_mergejoin
-- RESET

> RESET enable_material
-- RESET

> RESET enable_memoize
-- RESET

> DROP TABLE a167_o, a167_r, a167_n
-- DROP TABLE

