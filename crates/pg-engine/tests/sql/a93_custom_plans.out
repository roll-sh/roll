> CREATE FUNCTION p4(n int) RETURNS int LANGUAGE plpgsql AS $$
> DECLARE r int := 0;
> BEGIN
>   FOR i IN 1..8 LOOP
>     BEGIN
>       SELECT 1 / (n - i) INTO r FROM e;
>     EXCEPTION WHEN division_by_zero THEN RAISE NOTICE 'dz at %', i;
>     END;
>   END LOOP;
>   RETURN r;
> END $$
-- CREATE FUNCTION

