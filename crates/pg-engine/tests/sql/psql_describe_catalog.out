> SELECT 'information_schema._pg_index_position'::regproc
regproc:regproc
information_schema._pg_index_position
-- SELECT 1

> SELECT pg_get_functiondef('information_schema._pg_index_position(oid, smallint)'::regprocedure)
pg_get_functiondef:text
CREATE OR REPLACE FUNCTION information_schema._pg_index_position(oid, smallint)
 RETURNS integer
 LANGUAGE sql
 STABLE STRICT
BEGIN ATOMIC
 SELECT (ss.a).n AS n
    FROM ( SELECT information_schema._pg_expandarray(pg_index.indkey) AS a
            FROM pg_index
           WHERE (pg_index.indexrelid = $1)) ss
   WHERE ((ss.a).x = $2);
END

-- SELECT 1

