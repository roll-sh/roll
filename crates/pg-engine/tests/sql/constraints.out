> CREATE TABLE parent (id int PRIMARY KEY)
-- CREATE TABLE

> CREATE TABLE child (id int PRIMARY KEY, parent_id int REFERENCES parent ON DELETE RESTRICT)
-- CREATE TABLE

> INSERT INTO parent VALUES (1)
-- INSERT 0 1

> INSERT INTO child VALUES (1, 1)
-- INSERT 0 1

> DELETE FROM parent WHERE id = 1
ERROR 23001: update or delete on table "parent" violates RESTRICT setting of foreign key constraint "child_parent_id_fkey" on table "child"
DETAIL: Key (id)=(1) is referenced from table "child".
OBJECTS: schema=public table=child constraint=child_parent_id_fkey

> CREATE TABLE child2 (id int, parent_id int REFERENCES parent DEFERRABLE INITIALLY DEFERRED)
-- CREATE TABLE

> BEGIN
-- BEGIN

> INSERT INTO child2 VALUES (1, 5)
-- INSERT 0 1

> INSERT INTO parent VALUES (5)
-- INSERT 0 1

> COMMIT
-- COMMIT

> BEGIN
-- BEGIN

> INSERT INTO child2 VALUES (2, 6)
-- INSERT 0 1

> COMMIT
ERROR 23503: insert or update on table "child2" violates foreign key constraint "child2_parent_id_fkey"
DETAIL: Key (parent_id)=(6) is not present in table "parent".
OBJECTS: schema=public table=child2 constraint=child2_parent_id_fkey

> SELECT * FROM child2 ORDER BY id
id:int4 | parent_id:int4
1 | 5
