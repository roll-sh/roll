> SELECT conname, contype, pg_get_constraintdef(oid) FROM pg_constraint WHERE conrelid IN ('task'::regclass, 'team'::regclass, 'member'::regclass) ORDER BY conrelid::regclass::text, conname
conname:name | contype:char | pg_get_constraintdef:text
member_org_id_not_null | n | NOT NULL org_id
member_org_id_role_key | u | UNIQUE NULLS NOT DISTINCT (org_id, role)
member_pkey | p | PRIMARY KEY (org_id, user_id)
member_user_id_not_null | n | NOT NULL user_id
task_id_not_null | n | NOT NULL id
task_pkey | p | PRIMARY KEY (id)
task_team_id_fkey | f | FOREIGN KEY (team_id) REFERENCES team(id) ON UPDATE CASCADE ON DELETE SET NULL
task_title_key | u | UNIQUE (title)
task_title_not_null | n | NOT NULL title
title_len | c | CHECK ((length(title) < 3))
team_id_not_null | n | NOT NULL id
team_org_id_fkey | f | FOREIGN KEY (org_id) REFERENCES org(id) ON DELETE CASCADE
team_org_id_not_null | n | NOT NULL org_id
team_pkey | p | PRIMARY KEY (id)
