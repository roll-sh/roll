id:int4 | team_id:int4
1 | 10
2 | NULL
3 | NULL
-- SELECT 3

> DELETE FROM team WHERE id = 10
-- DELETE 1

> SELECT id, team_id FROM task ORDER BY id
id:int4 | team_id:int4
1 | NULL
2 | NULL
3 | NULL
