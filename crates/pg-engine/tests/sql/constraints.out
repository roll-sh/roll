> CREATE TABLE org (id int PRIMARY KEY, name text NOT NULL UNIQUE, slug text, CONSTRAINT slug_ok CHECK (slug ~ '^[a-z]+$'))
-- CREATE TABLE

> INSERT INTO org VALUES (1, 'Acme', 'acme'), (2, 'Beta', NULL)
-- INSERT 0 2

> INSERT INTO org VALUES (1, 'Dup', 'dup')
ERROR 23505: duplicate key value violates unique constraint "org_pkey"
DETAIL: Key (id)=(1) already exists.
OBJECTS: schema=public table=org constraint=org_pkey

> INSERT INTO org VALUES (3, 'Acme', 'x')
ERROR 23505: duplicate key value violates unique constraint "org_name_key"
DETAIL: Key (name)=(Acme) already exists.
OBJECTS: schema=public table=org constraint=org_name_key

> INSERT INTO org VALUES (3, NULL, 'x')
ERROR 23502: null value in column "name" of relation "org" violates not-null constraint
DETAIL: Failing row contains (3, null, x).
OBJECTS: schema=public table=org column=name

> INSERT INTO org VALUES (3, 'Gamma', 'Bad1')
ERROR 23514: new row for relation "org" violates check constraint "slug_ok"
DETAIL: Failing row contains (3, Gamma, Bad1).
OBJECTS: schema=public table=org constraint=slug_ok

> INSERT INTO org (id, name) VALUES (3, 'Gamma') ON CONFLICT (id) DO NOTHING
-- INSERT 0 1

> INSERT INTO org (id, name) VALUES (3, 'Gamma2') ON CONFLICT (id) DO UPDATE SET name = excluded.name RETURNING *
id:int4 | name:text | slug:text
3 | Gamma2 | NULL
-- INSERT 0 1

> INSERT INTO org (id, name) VALUES (4, 'Acme') ON CONFLICT ON CONSTRAINT org_name_key DO UPDATE SET slug = 'acme' RETURNING id, name, slug
id:int4 | name:text | slug:text
1 | Acme | acme
-- INSERT 0 1

> CREATE TABLE member (org_id int, user_id int, role text DEFAULT 'member', PRIMARY KEY (org_id, user_id), UNIQUE NULLS NOT DISTINCT (org_id, role))
-- CREATE TABLE

> INSERT INTO member VALUES (1, 1, 'owner'), (1, 2, NULL)
-- INSERT 0 2

> INSERT INTO member VALUES (1, 3, NULL)
ERROR 23505: duplicate key value violates unique constraint "member_org_id_role_key"
DETAIL: Key (org_id, role)=(1, null) already exists.
OBJECTS: schema=public table=member constraint=member_org_id_role_key

> INSERT INTO member VALUES (1, 1, 'x')
ERROR 23505: duplicate key value violates unique constraint "member_pkey"
DETAIL: Key (org_id, user_id)=(1, 1) already exists.
OBJECTS: schema=public table=member constraint=member_pkey

> CREATE TABLE team (id serial PRIMARY KEY, org_id int NOT NULL REFERENCES org ON DELETE CASCADE, lead_id int, name text)
-- CREATE TABLE

> CREATE TABLE task (id serial PRIMARY KEY, team_id int REFERENCES team (id) ON DELETE SET NULL ON UPDATE CASCADE, title text)
-- CREATE TABLE

> INSERT INTO team (org_id, name) VALUES (1, 'core'), (2, 'ops')
-- INSERT 0 2

> INSERT INTO team (org_id, name) VALUES (99, 'ghost')
ERROR 23503: insert or update on table "team" violates foreign key constraint "team_org_id_fkey"
DETAIL: Key (org_id)=(99) is not present in table "org".
OBJECTS: schema=public table=team constraint=team_org_id_fkey

> INSERT INTO task (team_id, title) VALUES (1, 'a'), (2, 'b'), (NULL, 'c')
-- INSERT 0 3

> DELETE FROM org WHERE id = 2
-- DELETE 1

