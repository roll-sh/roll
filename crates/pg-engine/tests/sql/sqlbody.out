> SELECT pg_get_functiondef(oid) FROM pg_proc WHERE pronamespace = 'sb'::regnamespace ORDER BY proname
pg_get_functiondef:text
CREATE OR REPLACE FUNCTION sb.b1(x integer)
 RETURNS integer
 LANGUAGE sql
BEGIN ATOMIC
 INSERT INTO t (a, b)
   VALUES (b1.x, 'a'::text);
 SELECT count(*) AS count
    FROM t
   WHERE (t.a > b1.x);
END

CREATE OR REPLACE FUNCTION sb.b2(x integer)
 RETURNS bigint
 LANGUAGE sql
BEGIN ATOMIC
 SELECT (x + 1);
END

CREATE OR REPLACE FUNCTION sb.b3(x integer)
 RETURNS SETOF t
 LANGUAGE sql
BEGIN ATOMIC
 SELECT t.a,
     t.b,
     t.c
    FROM t
   WHERE (t.a = b3.x)
   ORDER BY t.b;
END

CREATE OR REPLACE FUNCTION sb.b4(x integer)
 RETURNS integer
 LANGUAGE sql
BEGIN ATOMIC
 UPDATE t SET b = 'q'::text, c = (t.c + b4.x)
   WHERE (t.a = b4.x);
 DELETE FROM u
   WHERE (u.d = b4.x);
 INSERT INTO u (d)  SELECT t.a
            FROM t
           WHERE (t.c > b4.x);
 INSERT INTO t (a) VALUES (b4.x), ((b4.x + 1)) ON CONFLICT(a) DO UPDATE SET c = excluded.c
   WHERE (t.c > 0);
 INSERT INTO t DEFAULT VALUES ON CONFLICT DO NOTHING;
 DELETE FROM t
    USING u
   WHERE (t.a = u.a)
   RETURNING t.a;
END

CREATE OR REPLACE FUNCTION sb.b5(x integer)
 RETURNS integer
 LANGUAGE sql
BEGIN ATOMIC
 UPDATE t SET c = u.d
    FROM u
   WHERE ((t.a = u.a) AND (u.d > b5.x))
   RETURNING t.c;
END

CREATE OR REPLACE FUNCTION sb.b6(x integer)
 RETURNS integer
 LANGUAGE sql
BEGIN ATOMIC
 WITH w AS (
          SELECT t.a
            FROM t
         )
  SELECT count(*) AS count
    FROM w,
     u
   WHERE (w.a = u.a);
END

CREATE OR REPLACE FUNCTION sb.b7(x integer)
 RETURNS integer
 LANGUAGE sql
BEGIN ATOMIC
 INSERT INTO t AS tt (a, c)
   VALUES (b7.x, b7.x) ON CONFLICT ON CONSTRAINT t_pkey DO UPDATE SET c = (tt.c + 1);
 SELECT 1;
END

CREATE OR REPLACE PROCEDURE sb.p1(IN x integer)
 LANGUAGE sql
BEGIN ATOMIC
 INSERT INTO t (a, b)
   VALUES (p1.x, 'b'::text);
END

CREATE OR REPLACE PROCEDURE sb.p2(IN x integer, INOUT y integer)
 LANGUAGE sql
BEGIN ATOMIC
 SELECT (x + y);
END

CREATE OR REPLACE FUNCTION sb.r1(x integer)
 RETURNS integer
 LANGUAGE sql
 IMMUTABLE
RETURN (x + 1)

CREATE OR REPLACE FUNCTION sb.r2(x integer, y integer)
 RETURNS integer
 LANGUAGE sql
RETURN ((SELECT count(*) AS count FROM t WHERE ((t.a > r2.x) AND (t.c < r2.y))))::integer

CREATE OR REPLACE FUNCTION sb.r3(integer)
 RETURNS boolean
 LANGUAGE sql
 STRICT
RETURN (($1 > 0) OR ($1 IS NULL))

CREATE OR REPLACE FUNCTION sb.r4(x text)
 RETURNS text
 LANGUAGE sql
RETURN (upper(x) || 'a'::text)

CREATE OR REPLACE FUNCTION sb.r5(x integer)
 RETURNS integer
 LANGUAGE sql
RETURN (SELECT x AS x)

CREATE OR REPLACE FUNCTION sb.r6(x integer)
 RETURNS integer
 LANGUAGE sql
RETURN CASE WHEN (x > 0) THEN (SELECT max(t.a) AS max FROM t) ELSE 0 END

