> SELECT pg_get_functiondef(oid) FROM pg_proc WHERE pronamespace = 'zb'::regnamespace ORDER BY proname
pg_get_functiondef:text
CREATE OR REPLACE FUNCTION zb.e1(x integer)
 RETURNS bigint
 LANGUAGE sql
BEGIN ATOMIC
 DELETE FROM t
   WHERE ((t.a IN ( SELECT u.a
            FROM u
           WHERE (u.d = e1.x))) AND (EXISTS ( SELECT 1
            FROM t t_1
           WHERE (t_1.c = e1.x))));
 INSERT INTO t (a, b, c)  SELECT t_1.a,
             t_1.b,
             t_1.c
            FROM t t_1
           WHERE (t_1.a = e1.x);
 UPDATE t z SET c = 1
   WHERE (z.a = e1.x);
 SELECT (e1.x + e1.x)
    FROM u;
 WITH g AS (
          DELETE FROM u
           WHERE (u.d = e1.x)
           RETURNING u.a
         )
  SELECT count(*) AS count
    FROM g;
END

CREATE OR REPLACE FUNCTION zb.e2(integer, text)
 RETURNS text
 LANGUAGE sql
RETURN ($2 || ($1)::text)

CREATE OR REPLACE FUNCTION zb.e3(r pair)
 RETURNS integer
 LANGUAGE sql
RETURN ((r).p + (r).q)

CREATE OR REPLACE FUNCTION zb.e4(x integer)
 RETURNS SETOF integer
 LANGUAGE sql
BEGIN ATOMIC
 SELECT t.a
    FROM (t
      JOIN u USING (a))
   WHERE (u.d > e4.x)
   ORDER BY t.a
  LIMIT 3;
END

CREATE OR REPLACE FUNCTION zb.e5(x integer, OUT y integer, OUT z text)
 RETURNS record
 LANGUAGE sql
BEGIN ATOMIC
 SELECT x AS x,
     'a'::text;
END

CREATE OR REPLACE FUNCTION zb.e6()
 RETURNS bigint
 LANGUAGE sql
RETURN ((SELECT sum(t.a) AS sum FROM t) + (SELECT count(*) AS count FROM u))

CREATE OR REPLACE FUNCTION zb.e7(x integer)
 RETURNS integer
 LANGUAGE sql
 STABLE
BEGIN ATOMIC
 SELECT x AS x;
 SELECT (x + 1);
END

CREATE OR REPLACE FUNCTION zb.e8(x integer[])
 RETURNS integer
 LANGUAGE sql
RETURN ((x)[1] + array_length(x, 1))

