pg_get_functiondef:text
CREATE OR REPLACE FUNCTION sb.b4(x integer)
 RETURNS integer
 LANGUAGE sql
BEGIN ATOMIC
 UPDATE t SET b = 'q'::text, cc = (t.cc + b4.x)
   WHERE (t.a = b4.x);
 DELETE FROM u
   WHERE (u.d = b4.x);
 INSERT INTO u (d)  SELECT t.a
            FROM t
           WHERE (t.cc > b4.x);
 INSERT INTO t (a) VALUES (b4.x), ((b4.x + 1)) ON CONFLICT(a) DO UPDATE SET cc = excluded.cc
   WHERE (t.cc > 0);
 INSERT INTO t DEFAULT VALUES ON CONFLICT DO NOTHING;
 DELETE FROM t
    USING u
   WHERE (t.a = u.a)
   RETURNING t.a;
END

