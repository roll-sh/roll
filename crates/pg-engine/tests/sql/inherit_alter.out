> CREATE TABLE p (a int, b text)
-- CREATE TABLE

> CREATE TABLE c (x int) INHERITS (p)
-- CREATE TABLE

> CREATE TABLE gc () INHERITS (c)
-- CREATE TABLE

> INSERT INTO c VALUES (1, 'one', 10)
-- INSERT 0 1

> ALTER TABLE p ADD COLUMN d int DEFAULT 4
-- ALTER TABLE

> SELECT * FROM gc
a:int4 | b:text | x:int4 | d:int4
-- SELECT 0

> SELECT * FROM c
a:int4 | b:text | x:int4 | d:int4
1 | one | 10 | 4
-- SELECT 1

> ALTER TABLE p ADD COLUMN x int
NOTICE 00000: merging definition of column "x" for child "c"
-- ALTER TABLE

> SELECT attname, attinhcount, attislocal FROM pg_attribute WHERE attrelid='c'::regclass AND attnum>0 ORDER BY attnum
attname:name | attinhcount:int2 | attislocal:bool
a | 1 | f
b | 1 | f
x | 1 | t
d | 1 | f
-- SELECT 4

> ALTER TABLE p ADD COLUMN y text
-- ALTER TABLE

> ALTER TABLE c ADD COLUMN z int
-- ALTER TABLE

