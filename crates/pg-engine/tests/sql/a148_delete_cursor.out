> CREATE TABLE a148_cd (id int PRIMARY KEY, a int, t text)
-- CREATE TABLE

> CREATE INDEX a148_cd_a ON a148_cd (a)
-- CREATE INDEX

> INSERT INTO a148_cd SELECT g, g % 50, 'v' || g FROM generate_series(1, 3000) g
-- INSERT 0 3000

> ANALYZE a148_cd
-- ANALYZE

> SET enable_seqscan = off
