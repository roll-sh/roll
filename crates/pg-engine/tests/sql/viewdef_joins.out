> SELECT c.relname, pg_get_viewdef(c.oid, true) FROM pg_class c WHERE c.relkind = 'v' AND c.relname IN ('vq_join_alias', 'vq_right_nested', 'vq_natural') ORDER BY 1
relname:name | pg_get_viewdef:text
vq_natural |  SELECT vq_a.id,
    vq_a.name,
    vq_a.v,
    vq_b.a_id,
    vq_b.w
   FROM vq_a
     JOIN vq_b USING (id);
vq_right_nested |  SELECT a.id
   FROM vq_a a
     LEFT JOIN (vq_b b
     JOIN vq_b c ON c.id = b.id) ON b.a_id = a.id;
