> SELECT c.relname, pg_get_viewdef(c.oid) FROM pg_class c WHERE c.relkind = 'v' AND c.relname LIKE 'vq\_%' ORDER BY 1
relname:name | pg_get_viewdef:text
vq_case_sub |  SELECT
        CASE
            WHEN (EXISTS ( SELECT 1
               FROM vq_b)) THEN 1
            ELSE 0
        END AS flag;
vq_cte_sublink |  WITH c AS (
         SELECT vq_b.a_id
           FROM vq_b
        )
 SELECT id
   FROM vq_a
  WHERE (id IN ( SELECT c.a_id
           FROM c));
vq_cycle |  WITH RECURSIVE t(n) AS (
         SELECT 1 AS "?column?"
        UNION ALL
         SELECT (t_1.n + 1)
           FROM t t_1
          WHERE (t_1.n < 3)
        ) CYCLE n SET is_cycle USING path
 SELECT n
   FROM t;
vq_distinct_order |  SELECT DISTINCT name,
    v
   FROM vq_a
  ORDER BY v DESC;
vq_full_using |  SELECT id,
    vq_a.name
   FROM (vq_a
     FULL JOIN vq_b USING (id));
vq_func_alias |  SELECT x
   FROM unnest(ARRAY[1, 2]) WITH ORDINALITY t(x, n);
vq_grouping |  SELECT a_id,
    GROUPING(a_id) AS "grouping",
    sum(w) AS sum
   FROM vq_b
  GROUP BY ROLLUP(a_id);
vq_groups |  SELECT id,
    sum(v) OVER (ORDER BY id GROUPS BETWEEN 1 PRECEDING AND 1 FOLLOWING) AS sum,
    count(*) FILTER (WHERE (v > (0)::numeric)) OVER () AS count
   FROM vq_a;
vq_implicit_lateral |  SELECT a.id,
    g.g
   FROM vq_a a,
    LATERAL generate_series(1, a.id) g(g);
vq_join_lateral |  SELECT a.id,
    s.n
   FROM (vq_a a
     JOIN LATERAL ( SELECT count(*) AS n
           FROM vq_b b
          WHERE (b.a_id = a.id)) s ON (true));
vq_natural |  SELECT vq_a.id,
    vq_a.name,
    vq_a.v,
    vq_b.a_id,
    vq_b.w
   FROM (vq_a
     JOIN vq_b USING (id));
vq_no_from |  SELECT 1 AS one,
    'x'::text AS two;
vq_order_expr |  SELECT name
   FROM vq_a
  ORDER BY (v * (2)::numeric), id;
vq_partial_alias |  SELECT x,
    name,
    v
   FROM ( SELECT vq_a.id,
            vq_a.name,
            vq_a.v
           FROM vq_a) s(x, name, v);
vq_qualified_fn |  SELECT s
   FROM generate_series(1, 2) s(s);
vq_right_nested |  SELECT a.id
   FROM (vq_a a
     LEFT JOIN (vq_b b
     JOIN vq_b c ON ((c.id = b.id))) ON ((b.a_id = a.id)));
vq_rows_from |  SELECT a,
    b
   FROM ROWS FROM(generate_series(1, 2), generate_series(1, 3)) r(a, b);
vq_srf |  SELECT generate_series(1, 3) AS g,
    unnest(ARRAY[1, 2]) AS u;
vq_star_qual |  SELECT a.id,
    a.name,
    a.v,
    b.w
   FROM vq_a a,
    vq_b b;
vq_two_up |  SELECT id,
    ( SELECT ( SELECT max(c.w) AS max
                   FROM vq_b c
                  WHERE (c.w = a.id)) AS max
           FROM vq_b b
         LIMIT 1) AS x
   FROM vq_a a;
vq_union_from |  SELECT id
   FROM ( SELECT vq_a.id
           FROM vq_a
        UNION
         SELECT vq_b.w
           FROM vq_b) u
  WHERE (id > 1);
vq_using_alias |  SELECT vq_a.id,
    vq_b.w
   FROM (vq_a
     JOIN vq_b USING (id) AS x);
vq_values_in |  SELECT id
   FROM vq_a
  WHERE (id IN ( VALUES (1), (2)));
vq_view_of_view |  SELECT g
   FROM vq_srf
  WHERE (g > 1);
