> CREATE TABLE ft (id int)
-- CREATE TABLE

> INSERT INTO ft VALUES (1)
-- INSERT 0 1

> CREATE VIEW fv1 AS WITH w AS (SELECT id FROM ft GROUP BY id) SELECT id FROM ft
-- CREATE VIEW

> SELECT * FROM fv1 FOR NO KEY UPDATE
id:int4
1
-- SELECT 1

> SELECT * FROM (WITH w AS (SELECT id FROM ft GROUP BY id) SELECT id FROM ft) s FOR UPDATE
id:int4
1
-- SELECT 1

> CREATE TABLE fl (id int)
-- CREATE TABLE

> INSERT INTO fl VALUES (1)
-- INSERT 0 1

> CREATE VIEW va AS SELECT sum(id) AS s FROM fl
-- CREATE VIEW

> SELECT * FROM va FOR UPDATE
ERROR 0A000: FOR UPDATE is not allowed with aggregate functions

> CREATE VIEW vb AS WITH w AS (SELECT id FROM fl) SELECT sum(id) AS s FROM w
-- CREATE VIEW

> SELECT * FROM vb FOR UPDATE
s:int8
1
-- SELECT 1

> CREATE VIEW vc AS WITH w AS (SELECT id FROM fl INTERSECT SELECT id FROM fl) SELECT sum(id) AS s FROM w
-- CREATE VIEW

> SELECT * FROM vc FOR UPDATE
s:int8
1
-- SELECT 1

> CREATE VIEW vd AS WITH w AS (SELECT id FROM fl) SELECT sum(w.id) AS s FROM w JOIN fl USING (id)
-- CREATE VIEW

> SELECT * FROM vd FOR UPDATE
ERROR 0A000: FOR UPDATE is not allowed with aggregate functions

> SELECT * FROM (SELECT sum(id) FROM fl) s FOR UPDATE
ERROR 0A000: FOR UPDATE is not allowed with aggregate functions

