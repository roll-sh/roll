> CREATE TABLE tv (id int, a int, e2 int GENERATED ALWAYS AS (a / (id - 3)) VIRTUAL)
-- CREATE TABLE

> INSERT INTO tv VALUES (3, 4)
-- INSERT 0 1

> CREATE FUNCTION tvf() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RETURN NEW; END $$
-- CREATE FUNCTION

> CREATE TRIGGER tw AFTER UPDATE ON tv FOR EACH ROW WHEN (OLD.* IS DISTINCT FROM NEW.*) EXECUTE FUNCTION tvf()
-- CREATE TRIGGER

> UPDATE tv SET a = 6
ERROR 22012: division by zero

> CREATE TABLE pp (k int, v text) PARTITION BY RANGE (k)
-- CREATE TABLE

> COPY pp TO STDOUT (FORMAT csv, HEADER, FORCE_NOT_NULL (v))
ERROR 42809: cannot copy from partitioned table "pp"
HINT: Try the COPY (SELECT ...) TO variant.

> COPY pp (nosuch) TO STDOUT (FORMAT csv, FORCE_NOT_NULL (v))
ERROR 42703: column "nosuch" of relation "pp" does not exist

> CREATE TABLE ua (id int PRIMARY KEY, a int)
-- CREATE TABLE

> CREATE TABLE ub (k int PRIMARY KEY)
-- CREATE TABLE

> INSERT INTO ua VALUES (1, 1), (2, 2)
-- INSERT 0 2

> INSERT INTO ub VALUES (3)
-- INSERT 0 1

> BEGIN
-- BEGIN

> DECLARE c CURSOR FOR SELECT id FROM ua UNION ALL SELECT k FROM ub
-- DECLARE CURSOR

> FETCH NEXT FROM c
id:int4
1
-- FETCH 1

> UPDATE ua SET a = -a WHERE CURRENT OF c RETURNING id, a
id:int4 | a:int4
1 | -1
-- UPDATE 1

> FETCH 2 FROM c
id:int4
2
3
-- FETCH 2

> UPDATE ua SET a = -a WHERE CURRENT OF c RETURNING id, a
id:int4 | a:int4
-- UPDATE 0

> DELETE FROM ub WHERE CURRENT OF c RETURNING k
k:int4
3
-- DELETE 1

> COMMIT
-- COMMIT

> CREATE TABLE r5 (id int PRIMARY KEY, a int)
-- CREATE TABLE

> INSERT INTO r5 SELECT g, g % 4 FROM generate_series(1, 9) g
-- INSERT 0 9

> ANALYZE r5
-- ANALYZE

> EXPLAIN (COSTS OFF) DECLARE c CURSOR FOR SELECT DISTINCT a FROM r5 ORDER BY a
QUERY PLAN:text
Sort
  Sort Key: a
  ->  HashAggregate
        Group Key: a
        ->  Seq Scan on r5
-- EXPLAIN

> EXPLAIN (COSTS OFF) DECLARE c CURSOR FOR SELECT a, count(*) FROM r5 GROUP BY a ORDER BY a
QUERY PLAN:text
Sort
  Sort Key: a
  ->  HashAggregate
        Group Key: a
        ->  Seq Scan on r5
-- EXPLAIN

> BEGIN
-- BEGIN

> DECLARE c CURSOR FOR SELECT a, count(*) FROM r5 GROUP BY a ORDER BY a
-- DECLARE CURSOR

> SELECT is_scrollable FROM pg_cursors
is_scrollable:bool
t
-- SELECT 1

> FETCH 2 FROM c
a:int4 | count:int8
0 | 2
1 | 3
-- FETCH 2

> FETCH PRIOR FROM c
a:int4 | count:int8
0 | 2
-- FETCH 1

> ROLLBACK
-- ROLLBACK

> CREATE TABLE s1 (id int PRIMARY KEY, n int)
-- CREATE TABLE

> INSERT INTO s1 VALUES (1, 1), (2, 2)
-- INSERT 0 2

> ALTER TABLE s1 ALTER COLUMN n TYPE bigint
-- ALTER TABLE

> SELECT reltuples, relpages FROM pg_class WHERE relname = 's1'
reltuples:float4 | relpages:int4
2 | 1
-- SELECT 1

