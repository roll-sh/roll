> CREATE VIEW gx_v AS SELECT xmlelement(name "a b", xmlattributes(1 as "x y", 'z' as z), 'q') AS e, xmlforest(1 as a, 2 as "b c") AS f, xmlparse(content 'x') AS p, xmlparse(document '<a/>' preserve whitespace) AS p2, xmlpi(name x, 'y') AS pi, xmlroot(xml '<a/>', version '1.0', standalone yes) AS r, xmlroot(xml '<a/>', version no value) AS r2, xmlserialize(content '<a/>' as text) AS s, xmlserialize(document '<a/>' as varchar(10) indent) AS s2, xml '<a/>' IS DOCUMENT AS d, xml '<a/>' IS NOT DOCUMENT AS d2, xmlconcat('<a/>', '<b/>') AS c
-- CREATE VIEW

> SELECT pg_get_viewdef('gx_v')
pg_get_viewdef:text
 SELECT XMLELEMENT(NAME "a b", XMLATTRIBUTES(1 AS "x y", 'z' AS z), 'q') AS e,
    XMLFOREST(1 AS a, 2 AS "b c") AS f,
    XMLPARSE(CONTENT 'x'::text STRIP WHITESPACE) AS p,
    XMLPARSE(DOCUMENT '<a/>'::text PRESERVE WHITESPACE) AS p2,
    XMLPI(NAME x, 'y'::text) AS pi,
    XMLROOT('<a/>'::xml, VERSION '1.0'::text, STANDALONE YES) AS r,
    XMLROOT('<a/>'::xml, VERSION NO VALUE) AS r2,
    XMLSERIALIZE(CONTENT '<a/>'::xml AS text NO INDENT) AS s,
    (XMLSERIALIZE(DOCUMENT '<a/>'::xml AS character varying(10) INDENT))::character varying(10) AS s2,
    '<a/>'::xml IS DOCUMENT AS d,
    (NOT '<a/>'::xml IS DOCUMENT) AS d2,
    XMLCONCAT('<a/>'::xml, '<b/>'::xml) AS c;
-- SELECT 1

> SELECT pg_get_viewdef('gx_v', true)
pg_get_viewdef:text
 SELECT XMLELEMENT(NAME "a b", XMLATTRIBUTES(1 AS "x y", 'z' AS z), 'q') AS e,
    XMLFOREST(1 AS a, 2 AS "b c") AS f,
    XMLPARSE(CONTENT 'x'::text STRIP WHITESPACE) AS p,
    XMLPARSE(DOCUMENT '<a/>'::text PRESERVE WHITESPACE) AS p2,
    XMLPI(NAME x, 'y'::text) AS pi,
    XMLROOT('<a/>'::xml, VERSION '1.0'::text, STANDALONE YES) AS r,
    XMLROOT('<a/>'::xml, VERSION NO VALUE) AS r2,
    XMLSERIALIZE(CONTENT '<a/>'::xml AS text NO INDENT) AS s,
    XMLSERIALIZE(DOCUMENT '<a/>'::xml AS character varying(10) INDENT)::character varying(10) AS s2,
    ('<a/>'::xml) IS DOCUMENT AS d,
    NOT ('<a/>'::xml) IS DOCUMENT AS d2,
    XMLCONCAT('<a/>'::xml, '<b/>'::xml) AS c;
-- SELECT 1

> DROP VIEW gx_v
