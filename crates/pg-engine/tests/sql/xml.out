> create table gx_d(id int, x xml)
-- CREATE TABLE

> insert into gx_d values (1, '<rows><row a="1"><n>one</n><v>1.5</v></row><row a="2"><n>two</n></row></rows>')
-- INSERT 0 1

> create view gx_v as select t.* from gx_d, xmltable(xmlnamespaces('http://a' as a, 'http://b' as "B"), '/rows/row' passing x columns ord for ordinality, a int path '@a' not null, n text default 'zz' path 'n', v numeric(5,2), "q q" varchar(3) path 'n' default 'd') t
-- CREATE VIEW

> select pg_get_viewdef('gx_v')
pg_get_viewdef:text
 SELECT t.ord,
    t.a,
    t.n,
    t.v,
    t."q q"
   FROM gx_d,
    LATERAL XMLTABLE(XMLNAMESPACES ('http://a'::text AS a, 'http://b'::text AS "B"), ('/rows/row'::text) PASSING (gx_d.x) COLUMNS ord FOR ORDINALITY, a integer PATH ('@a'::text) NOT NULL, n text DEFAULT ('zz'::text) PATH ('n'::text), v numeric(5,2), "q q" character varying(3) DEFAULT ('d'::character varying(3)) PATH ('n'::text)) t;
-- SELECT 1

> select pg_get_viewdef('gx_v', true)
pg_get_viewdef:text
 SELECT t.ord,
    t.a,
    t.n,
    t.v,
    t."q q"
   FROM gx_d,
    LATERAL XMLTABLE(XMLNAMESPACES ('http://a'::text AS a, 'http://b'::text AS "B"), ('/rows/row'::text) PASSING (gx_d.x) COLUMNS ord FOR ORDINALITY, a integer PATH ('@a'::text) NOT NULL, n text DEFAULT ('zz'::text) PATH ('n'::text), v numeric(5,2), "q q" character varying(3) DEFAULT ('d'::character varying(3)) PATH ('n'::text)) t;
-- SELECT 1

