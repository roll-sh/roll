> CREATE TABLE ga4_e (a int, b text, p point)
-- CREATE TABLE

> INSERT INTO ga4_e SELECT i, 'v' || i, point(i, i) FROM generate_series(1, 1000) i
-- INSERT 0 1000

> CREATE INDEX ga4_e_ab ON ga4_e ((a + 1), a)
-- CREATE INDEX

> CREATE INDEX ga4_e_b ON ga4_e (b)
-- CREATE INDEX

> CREATE INDEX ga4_e_gist ON ga4_e USING gist (p, circle(p, 1))
-- CREATE INDEX

> VACUUM ANALYZE ga4_e
-- VACUUM

> SET enable_seqscan = off
-- SET

> SET enable_bitmapscan = off
-- SET

> EXPLAIN (COSTS OFF) SELECT a FROM ga4_e WHERE a + 1 > 5 AND a < 7
QUERY PLAN:text
Index Only Scan using ga4_e_ab on ga4_e
  Index Cond: ((((a + 1)) > 5) AND (a < 7))
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF) SELECT a FROM ga4_e WHERE a + 1 = 5
QUERY PLAN:text
Index Only Scan using ga4_e_ab on public.ga4_e
  Output: a
  Index Cond: (((ga4_e.a + 1)) = 5)
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF) SELECT p FROM ga4_e WHERE circle(p, 1) @> circle(point(0, 0), 0.95)
QUERY PLAN:text
Index Only Scan using ga4_e_gist on public.ga4_e
  Output: p
  Index Cond: ((circle(ga4_e.p, '1'::double precision)) @> '<(0,0),0.95>'::circle)
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF) SELECT p FROM ga4_e ORDER BY circle(p, 1) <-> point(0, 0) LIMIT 1
QUERY PLAN:text
Limit
  Output: p, ((circle(p, '1'::double precision) <-> '(0,0)'::point))
  ->  Index Only Scan using ga4_e_gist on public.ga4_e
        Output: p, (circle(p, '1'::double precision) <-> '(0,0)'::point)
        Order By: ((circle(ga4_e.p, '1'::double precision)) <-> '(0,0)'::point)
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF) SELECT a FROM ga4_e ORDER BY p <-> point(0, 0)
QUERY PLAN:text
Index Scan using ga4_e_gist on public.ga4_e
  Output: a, (p <-> '(0,0)'::point)
  Order By: (ga4_e.p <-> '(0,0)'::point)
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF) SELECT a FROM ga4_e ORDER BY b
QUERY PLAN:text
Index Scan using ga4_e_b on public.ga4_e
  Output: a, b
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF) SELECT a FROM ga4_e ORDER BY b LIMIT 2
QUERY PLAN:text
Limit
  Output: a, b
  ->  Index Scan using ga4_e_b on public.ga4_e
        Output: a, b
