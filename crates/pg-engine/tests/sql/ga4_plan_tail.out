> CREATE TABLE ga4_tk (unique1 int, unique2 int, two int, four int, ten int, twenty int, hundred int, thousand int, tenthous int)
-- CREATE TABLE

> INSERT INTO ga4_tk SELECT i, (i * 7919) % 10000, i % 2, i % 4, i % 10, i % 20, i % 100, i % 1000, i
>   FROM generate_series(0, 9999) i
-- INSERT 0 10000

> CREATE INDEX ga4_tk_u1 ON ga4_tk (unique1)
-- CREATE INDEX

> CREATE INDEX ga4_tk_hundred ON ga4_tk (hundred)
-- CREATE INDEX

> VACUUM ANALYZE ga4_tk
-- VACUUM

> EXPLAIN (COSTS OFF)
> SELECT unique1 FROM ga4_tk t0
> WHERE unique1 < 3
>   AND EXISTS (
> 	SELECT 1 FROM ga4_tk t1
> 	INNER JOIN ga4_tk t2 ON t1.unique1 = t2.hundred
> 	WHERE t0.ten = t1.twenty AND t0.two <> t2.four OFFSET 0)
QUERY PLAN:text
Index Scan using ga4_tk_u1 on ga4_tk t0
  Index Cond: (unique1 < 3)
  Filter: EXISTS(SubPlan 1)
  SubPlan 1
    ->  Nested Loop
          ->  Seq Scan on ga4_tk t2
                Filter: (t0.two <> four)
          ->  Memoize
                Cache Key: t2.hundred
                Cache Mode: logical
                ->  Index Scan using ga4_tk_u1 on ga4_tk t1
                      Index Cond: (unique1 = t2.hundred)
                      Filter: (t0.ten = twenty)
-- EXPLAIN

> SELECT unique1 FROM ga4_tk t0
> WHERE unique1 < 3
>   AND EXISTS (
> 	SELECT 1 FROM ga4_tk t1
> 	INNER JOIN ga4_tk t2 ON t1.unique1 = t2.hundred
> 	WHERE t0.ten = t1.twenty AND t0.two <> t2.four OFFSET 0)
unique1:int4
2
-- SELECT 1

> SET enable_hashjoin = off
-- SET

> SET enable_mergejoin = off
-- SET

> EXPLAIN (COSTS OFF)
> SELECT * FROM ga4_tk t1 JOIN ga4_tk t2 ON t1.unique1 = t2.hundred AND t1.ten = t2.four WHERE t2.unique1 < 50
QUERY PLAN:text
Nested Loop
  ->  Index Scan using ga4_tk_u1 on ga4_tk t2
        Index Cond: (unique1 < 50)
  ->  Memoize
        Cache Key: t2.hundred, t2.four
        Cache Mode: logical
        ->  Index Scan using ga4_tk_u1 on ga4_tk t1
              Index Cond: (unique1 = t2.hundred)
              Filter: (ten = t2.four)
-- EXPLAIN

> EXPLAIN (COSTS OFF)
> SELECT * FROM ga4_tk t1 JOIN ga4_tk t2 ON t1.unique1 = t2.hundred AND t1.ten < t2.four WHERE t2.unique1 < 50
QUERY PLAN:text
Nested Loop
  ->  Index Scan using ga4_tk_u1 on ga4_tk t2
        Index Cond: (unique1 < 50)
  ->  Memoize
        Cache Key: t2.four, t2.hundred
        Cache Mode: binary
        ->  Index Scan using ga4_tk_u1 on ga4_tk t1
              Index Cond: (unique1 = t2.hundred)
              Filter: (ten < t2.four)
-- EXPLAIN

> CREATE TABLE ga4_ek (x numeric, t text)
-- CREATE TABLE

> INSERT INTO ga4_ek (x, t) SELECT d1::numeric, d1::text
>   FROM (SELECT round((d / pi())::numeric, 7) AS d1 FROM generate_series(1, 20) AS d) t
-- INSERT 0 20

> INSERT INTO ga4_ek SELECT * FROM ga4_ek
-- INSERT 0 20

> CREATE INDEX ga4_ek_idx_x_t ON ga4_ek (x, t)
-- CREATE INDEX

> VACUUM ANALYZE ga4_ek
-- VACUUM

> SET enable_seqscan = off
-- SET

> EXPLAIN (COSTS OFF)
> SELECT * FROM ga4_ek t1 INNER JOIN ga4_ek t2 ON t1.x = t2.t::numeric AND t1.t::numeric = t2.x
QUERY PLAN:text
Nested Loop
  ->  Index Only Scan using ga4_ek_idx_x_t on ga4_ek t1
  ->  Memoize
        Cache Key: t1.x, (t1.t)::numeric
        Cache Mode: logical
        ->  Index Only Scan using ga4_ek_idx_x_t on ga4_ek t2
              Index Cond: (x = (t1.t)::numeric)
              Filter: (t1.x = (t)::numeric)
-- EXPLAIN

> SELECT count(*) FROM ga4_ek t1 INNER JOIN ga4_ek t2 ON t1.x = t2.t::numeric AND t1.t::numeric = t2.x
count:int8
80
