> EXPLAIN (verbose, costs off) SELECT s FROM (SELECT a, b FROM a29_wt LIMIT 1) s
QUERY PLAN:text
Subquery Scan on s
  Output: s.*
  ->  Limit
        Output: a29_wt.a, a29_wt.b
        ->  Seq Scan on public.a29_wt
              Output: a29_wt.a, a29_wt.b
-- EXPLAIN

> EXPLAIN (verbose, costs off) SELECT s FROM (SELECT a, b FROM a29_wt ORDER BY a OFFSET 0) s
QUERY PLAN:text
Subquery Scan on s
  Output: s.*
  ->  Sort
        Output: a29_wt.a, a29_wt.b
        Sort Key: a29_wt.a
        ->  Seq Scan on public.a29_wt
              Output: a29_wt.a, a29_wt.b
-- EXPLAIN

> EXPLAIN (verbose, costs off) SELECT s FROM (SELECT DISTINCT a FROM a29_wt) s
QUERY PLAN:text
Subquery Scan on s
  Output: s.*
  ->  HashAggregate
        Output: a29_wt.a
        Group Key: a29_wt.a
        ->  Seq Scan on public.a29_wt
              Output: a29_wt.a, a29_wt.b
-- EXPLAIN

> EXPLAIN (verbose, costs off) SELECT s FROM (SELECT a, count(*) FROM a29_wt GROUP BY a) s
QUERY PLAN:text
Subquery Scan on s
  Output: s.*
  ->  HashAggregate
        Output: a29_wt.a, count(*)
        Group Key: a29_wt.a
        ->  Seq Scan on public.a29_wt
              Output: a29_wt.a, a29_wt.b
-- EXPLAIN

