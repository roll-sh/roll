> EXPLAIN (COSTS OFF)
> SELECT t1.a, t2.b, t3.a, t4.b FROM a40_p1 t1 JOIN a40_p2 t2 ON t1.a = t2.b LEFT JOIN (a40_p1 t3 JOIN a40_p2 t4 ON t3.a = t4.b) ON t3.a = t1.a AND t3.b < 3 WHERE t1.b = 0
QUERY PLAN:text
Append
  ->  Nested Loop Left Join
        ->  Hash Join
              Hash Cond: (t2_1.b = t1_1.a)
              ->  Seq Scan on a40_p2_1 t2_1
              ->  Hash
                    ->  Seq Scan on a40_p1_1 t1_1
                          Filter: (b = 0)
        ->  Nested Loop
              ->  Index Scan using a40_i1_1_a on a40_p1_1 t3_1
                    Index Cond: (a = t1_1.a)
                    Filter: (b < 3)
              ->  Index Only Scan using a40_i2_1_b on a40_p2_1 t4_1
                    Index Cond: (b = t3_1.a)
  ->  Nested Loop Left Join
        ->  Hash Join
              Hash Cond: (t2_2.b = t1_2.a)
              ->  Seq Scan on a40_p2_2 t2_2
              ->  Hash
                    ->  Seq Scan on a40_p1_2 t1_2
                          Filter: (b = 0)
        ->  Nested Loop
              ->  Index Scan using a40_i1_2_a on a40_p1_2 t3_2
                    Index Cond: (a = t1_2.a)
                    Filter: (b < 3)
              ->  Index Only Scan using a40_i2_2_b on a40_p2_2 t4_2
                    Index Cond: (b = t3_2.a)
  ->  Nested Loop Left Join
        ->  Hash Join
              Hash Cond: (t2_3.b = t1_3.a)
              ->  Seq Scan on a40_p2_3 t2_3
              ->  Hash
                    ->  Seq Scan on a40_p1_3 t1_3
                          Filter: (b = 0)
        ->  Nested Loop
              ->  Index Scan using a40_i1_3_a on a40_p1_3 t3_3
                    Index Cond: (a = t1_3.a)
                    Filter: (b < 3)
              ->  Index Only Scan using a40_i2_3_b on a40_p2_3 t4_3
                    Index Cond: (b = t3_3.a)
-- EXPLAIN

