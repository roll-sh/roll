-- CREATE INDEX

> CREATE INDEX a40_i2_2_b on a40_p2_2(b)
-- CREATE INDEX

> CREATE INDEX a40_i2_3_b on a40_p2_3(b)
-- CREATE INDEX

> ANALYZE a40_p2
-- ANALYZE

