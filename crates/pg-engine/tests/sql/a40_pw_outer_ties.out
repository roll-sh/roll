> EXPLAIN (COSTS OFF) SELECT t1.b, t1.c, t2.a, t2.c, t3.a, t3.c FROM a40_adv2 t1 LEFT JOIN a40_adv1 t2 ON (t1.b = t2.a) INNER JOIN a40_adv1 t3 ON (t1.b = t3.a) WHERE t1.a = 0 ORDER BY t1.b, t2.a, t3.a
QUERY PLAN:text
Sort
  Sort Key: t1.b, t2.a
  ->  Append
        ->  Nested Loop Left Join
              ->  Nested Loop
                    ->  Seq Scan on a40_adv2_p1 t1_1
                          Filter: (a = 0)
                    ->  Index Scan using a40_adv1_p1_a_idx on a40_adv1_p1 t3_1
                          Index Cond: (a = t1_1.b)
              ->  Index Scan using a40_adv1_p1_a_idx on a40_adv1_p1 t2_1
                    Index Cond: (a = t1_1.b)
        ->  Hash Right Join
              Hash Cond: (t2_2.a = t1_2.b)
              ->  Seq Scan on a40_adv1_p2 t2_2
              ->  Hash
                    ->  Hash Join
                          Hash Cond: (t3_2.a = t1_2.b)
                          ->  Seq Scan on a40_adv1_p2 t3_2
                          ->  Hash
                                ->  Seq Scan on a40_adv2_p2 t1_2
                                      Filter: (a = 0)
        ->  Hash Right Join
              Hash Cond: (t2_3.a = t1_3.b)
              ->  Seq Scan on a40_adv1_p3 t2_3
              ->  Hash
                    ->  Hash Join
                          Hash Cond: (t3_3.a = t1_3.b)
                          ->  Seq Scan on a40_adv1_p3 t3_3
                          ->  Hash
                                ->  Seq Scan on a40_adv2_p3 t1_3
                                      Filter: (a = 0)
-- EXPLAIN

