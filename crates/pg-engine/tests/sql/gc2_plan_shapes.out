> EXPLAIN (COSTS OFF)
> SELECT a.id, b.id FROM gc2_a a JOIN gc2_b b ON a.v = b.v
>   AND a.id = (SELECT min(id) FROM gc2_b c WHERE c.id = b.id)
> WHERE a.id < 10 AND b.id < 10 ORDER BY a.id, b.id
QUERY PLAN:text
Sort
  Sort Key: a.id, b.id
  ->  Hash Join
        Hash Cond: ((b.v = a.v) AND ((SubPlan 2) = a.id))
        ->  Seq Scan on gc2_b b
              Filter: (id < 10)
        ->  Hash
              ->  Seq Scan on gc2_a a
                    Filter: (id < 10)
        SubPlan 2
          ->  Result
                InitPlan 1
                  ->  Limit
                        ->  Seq Scan on gc2_b c
                              Filter: (id = b.id)
-- EXPLAIN

