> SELECT * FROM gc2_i8 WHERE (CASE WHEN q2 IN (SELECT id FROM gc2_a) THEN q2 END) IN (SELECT v FROM gc2_b)
QUERY PLAN:text
Hash Join
  Output: gc2_i8.q1, gc2_i8.q2
  Inner Unique: true
  Hash Cond: (CASE WHEN (ANY (gc2_i8.q2 = (hashed SubPlan 1).col1)) THEN gc2_i8.q2 ELSE NULL::bigint END = gc2_b.v)
  ->  Seq Scan on public.gc2_i8
        Output: gc2_i8.q1, gc2_i8.q2
  ->  Hash
        Output: gc2_b.v
        ->  HashAggregate
              Output: gc2_b.v
              Group Key: gc2_b.v
              ->  Seq Scan on public.gc2_b
                    Output: gc2_b.v
  SubPlan 1
    ->  Seq Scan on public.gc2_a
          Output: gc2_a.id
