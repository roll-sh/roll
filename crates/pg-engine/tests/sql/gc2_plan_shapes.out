>   FROM gc2_a i WHERE i.id = o.id) ss
> WHERE o.v = 0
QUERY PLAN:text
Aggregate
  Output: sum((((ANY (i.v = (hashed SubPlan 1).col1))))::integer)
  ->  Nested Loop
        Output: ((ANY (i.v = (hashed SubPlan 1).col1)))
        ->  Seq Scan on public.gc2_a o
              Output: o.id, o.v
              Filter: (o.v = 0)
        ->  Seq Scan on public.gc2_a i
              Output: (ANY (i.v = (hashed SubPlan 1).col1)), random()
              Filter: (i.id = o.id)
              SubPlan 1
                ->  Seq Scan on public.gc2_b
                      Output: gc2_b.id
                      Filter: (gc2_b.id <= o.v)
