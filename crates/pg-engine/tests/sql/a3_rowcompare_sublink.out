-- SELECT 2

> CREATE VIEW a3_rc_v AS SELECT ROW(1, 2) = (SELECT f1, f2) AS eq, ROW(1, 2) < (SELECT f1, f2) AS lt FROM a3_rc
-- CREATE VIEW

> SELECT pg_get_viewdef('a3_rc_v')
pg_get_viewdef:text
 SELECT ((1, 2) = ( SELECT a3_rc.f1,
            a3_rc.f2)) AS eq,
    ((1, 2) < ( SELECT a3_rc.f1,
            a3_rc.f2)) AS lt
   FROM a3_rc;
-- SELECT 1

> SELECT * FROM a3_rc_v
eq:bool | lt:bool
f | f
f | t
f | t
f | t
f | t
f | t
t | f
