> SELECT pg_size_bytes('1 AB')
ERROR 22023: invalid size: "1 AB"
DETAIL: Invalid size unit: "AB".
HINT: Valid units are "bytes", "B", "kB", "MB", "GB", "TB", and "PB".

> SELECT pg_size_bytes('1 AB A')
ERROR 22023: invalid size: "1 AB A"
DETAIL: Invalid size unit: "AB A".
HINT: Valid units are "bytes", "B", "kB", "MB", "GB", "TB", and "PB".

> SELECT pg_size_bytes('1 AB A    ')
ERROR 22023: invalid size: "1 AB A    "
DETAIL: Invalid size unit: "AB A".
HINT: Valid units are "bytes", "B", "kB", "MB", "GB", "TB", and "PB".

> SELECT pg_size_bytes('9223372036854775807.9')
ERROR 22003: bigint out of range

> SELECT pg_size_bytes('1e100')
ERROR 22003: bigint out of range

> SELECT pg_size_bytes('1e1000000000000000000')
ERROR 22003: value overflows numeric format

> SELECT pg_size_bytes('1 byte')
ERROR 22023: invalid size: "1 byte"
DETAIL: Invalid size unit: "byte".
HINT: Valid units are "bytes", "B", "kB", "MB", "GB", "TB", and "PB".

> SELECT pg_size_bytes('kb')
ERROR 22023: invalid size: "kb"

> SELECT pg_size_bytes('..')
ERROR 22023: invalid size: ".."

> SELECT pg_size_bytes('-.')
ERROR 22023: invalid size: "-."

> SELECT pg_size_bytes('-.kb')
ERROR 22023: invalid size: "-.kb"

> SELECT pg_size_bytes('-. kb')
ERROR 22023: invalid size: "-. kb"

> SELECT pg_size_bytes('.+912')
ERROR 22023: invalid size: ".+912"

> SELECT pg_size_bytes('+912+ kB')
ERROR 22023: invalid size: "+912+ kB"
DETAIL: Invalid size unit: "+ kB".
HINT: Valid units are "bytes", "B", "kB", "MB", "GB", "TB", and "PB".

> SELECT pg_size_bytes('++123 kB')
ERROR 22023: invalid size: "++123 kB"

> r := parse_ident('Schemax.Tabley')
ERROR 42601: syntax error at or near "r" (at 1)

> r := parse_ident('"SchemaX"."TableY"')
ERROR 42601: syntax error at or near "r" (at 1)

> SELECT parse_ident('foo.boo')
parse_ident:text[]
{foo,boo}
-- SELECT 1

> SELECT parse_ident('foo.boo[]')
ERROR 22023: string is not a valid identifier: "foo.boo[]"

> SELECT parse_ident('foo.boo[]', strict => false)
parse_ident:text[]
{foo,boo}
-- SELECT 1

> SELECT parse_ident(' ')
ERROR 22023: string is not a valid identifier: " "

> SELECT parse_ident(' .aaa')
ERROR 22023: string is not a valid identifier: " .aaa"
DETAIL: No valid identifier before ".".

> SELECT parse_ident(' aaa . ')
ERROR 22023: string is not a valid identifier: " aaa . "
DETAIL: No valid identifier after ".".

> SELECT parse_ident('aaa.a%b')
ERROR 22023: string is not a valid identifier: "aaa.a%b"

> SELECT parse_ident(E'X\rXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX')
ERROR 22023: string is not a valid identifier: "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

> SELECT length(a[1]), length(a[2]) from parse_ident('"".yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy') as a
length:int4 | length:int4
414 | 289
-- SELECT 1

> SELECT parse_ident(' first . "  second  " ."   third   ". "  ' || repeat('x',66) || '"')
parse_ident:text[]
{first,"  second  ","   third   ","  xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}
-- SELECT 1

> SELECT parse_ident(' first . "  second  " ."   third   ". "  ' || repeat('x',66) || '"')::name[]
parse_ident:name[]
{first,"  second  ","   third   ","  xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}
-- SELECT 1

> SELECT parse_ident(E'"c".X XXXX\002XXXXXX')
ERROR 22023: string is not a valid identifier: ""c".X XXXXXXXXXX"

> SELECT parse_ident('1020')
ERROR 22023: string is not a valid identifier: "1020"

> SELECT parse_ident('10.20')
ERROR 22023: string is not a valid identifier: "10.20"

> SELECT parse_ident('.')
ERROR 22023: string is not a valid identifier: "."
DETAIL: No valid identifier before ".".

> SELECT parse_ident('.1020')
ERROR 22023: string is not a valid identifier: ".1020"
DETAIL: No valid identifier before ".".

> SELECT parse_ident('xxx.1020')
ERROR 22023: string is not a valid identifier: "xxx.1020"
DETAIL: No valid identifier after ".".

