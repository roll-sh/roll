> ANALYZE a114_g
-- ANALYZE

> SET enable_seqscan = off
-- SET

> CREATE FUNCTION a114_ids(q text) RETURNS text LANGUAGE plpgsql AS $$
> DECLARE r text;
> BEGIN
>   EXECUTE 'SELECT string_agg(id::text, '','' ORDER BY id) FROM a114_g WHERE ' || q INTO r;
>   RETURN coalesce(r, '-');
> END $$
-- CREATE FUNCTION

> EXPLAIN (COSTS OFF) SELECT id FROM a114_g WHERE ia @> '{3}'
QUERY PLAN:text
Bitmap Heap Scan on a114_g
  Recheck Cond: (ia @> '{3}'::integer[])
  ->  Bitmap Index Scan on a114_g_ia
        Index Cond: (ia @> '{3}'::integer[])
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT id FROM a114_g WHERE j ? 'k'
QUERY PLAN:text
Bitmap Heap Scan on a114_g
  Recheck Cond: (j ? 'k'::text)
  ->  Bitmap Index Scan on a114_g_j
        Index Cond: (j ? 'k'::text)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT id FROM a114_g WHERE tv @@ 'even'
QUERY PLAN:text
Bitmap Heap Scan on a114_g
  Recheck Cond: (tv @@ '''even'''::tsquery)
  ->  Bitmap Index Scan on a114_g_tv
        Index Cond: (tv @@ '''even'''::tsquery)
-- EXPLAIN

