  ->  Materialize
        Output: a.f1, (5)
        ->  Hash Join
              Output: a.f1, 5
              Hash Cond: (a.f1 = b.f1)
              ->  Seq Scan on public.a8_pa a
                    Output: a.f1
              ->  Hash
                    Output: b.f1
                    ->  Seq Scan on public.a8_pa b
