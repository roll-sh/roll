ERROR 22023: invalid value for parameter "default_text_search_config": "no_such_config"

> set check_function_bodies = off
-- SET

> create function func_with_bad_set() returns int as $$ select 1 $$ language sql set default_text_search_config = no_such_config
NOTICE 42704: text search configuration "no_such_config" does not exist
-- CREATE FUNCTION

