-- INSERT 0 1

> select lower(a), upper(a), initcap(a), lower(b), lower(n), lower(a collate "default"), a ilike 'àbç', b ilike 'àbç', n ilike 'àbç', a not ilike 'àbç', a !~~* 'àBç', a ~* 'àbç', b ~* 'àbç' from gxc_c
