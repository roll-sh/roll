> create view gxc_v as select lower(a) l, a ilike 'x' i, upper(b) u from gxc_c
-- CREATE VIEW

> select * from gxc_v
l:text | i:bool | u:text
ÀbÇ | f | ÀBÇ
-- SELECT 1

> select pg_get_viewdef('gxc_v')
pg_get_viewdef:text
 SELECT lower(a) AS l,
    (a ~~* 'x'::text) AS i,
    upper(b) AS u
   FROM gxc_c;
-- SELECT 1

> drop view gxc_v
-- DROP VIEW

