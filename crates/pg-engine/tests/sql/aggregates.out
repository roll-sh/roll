b | 2 | 3 | 4 | z
c | 1 | 5 | 5.5 | w
-- SELECT 3

> SELECT g, sum(d), avg(d) FROM s GROUP BY g HAVING sum(d) > 2 ORDER BY g
g:text | sum:numeric | avg:numeric
a | 3.30 | 1.6500000000000000
b | 3.30 | 3.3000000000000000
c | 5.50 | 5.5000000000000000
-- SELECT 3

> SELECT string_agg(t, ',' ORDER BY t), array_agg(n ORDER BY n NULLS FIRST) FROM s
string_agg:text | array_agg:int4[]
w,x,y,z | {NULL,1,2,3,5}
-- SELECT 1

> SELECT count(DISTINCT g), sum(DISTINCT n) FROM s
count:int8 | sum:int8
3 | 11
-- SELECT 1

> SELECT bool_and(n > 0), bool_or(n > 4), every(n < 10) FROM s
bool_and:bool | bool_or:bool | every:bool
t | t | t
-- SELECT 1

