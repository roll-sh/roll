> CREATE TABLE s (g text, n int, f float8, d numeric, t text)
-- CREATE TABLE

> INSERT INTO s VALUES ('a', 1, 1.5, 1.10, 'x'), ('a', 2, 2.5, 2.20, 'y'), ('b', 3, NULL, 3.30, 'z'), ('b', NULL, 4.0, NULL, NULL), ('c', 5, 5.5, 5.50, 'w')
-- INSERT 0 5

> SELECT count(*), count(n), sum(n), avg(n), min(n), max(n) FROM s
count:int8 | count:int8 | sum:int8 | avg:numeric | min:int4 | max:int4
5 | 4 | 11 | 2.7500000000000000 | 1 | 5
-- SELECT 1

> SELECT g, count(*), sum(n), avg(f), max(t) FROM s GROUP BY g ORDER BY g
g:text | count:int8 | sum:int8 | avg:float8 | max:text
