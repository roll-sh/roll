> CREATE VIEW dup_cols AS SELECT 1 AS a, 2 AS a
ERROR 42701: column "a" specified more than once

> CREATE VIEW too_many (a, b, c) AS SELECT 1, 2
ERROR 42601: CREATE VIEW specifies more column names than columns

> CREATE VIEW lit AS SELECT 'x' AS s, 1 AS n
-- CREATE VIEW

> SELECT s, pg_typeof(s) FROM lit
s:text | pg_typeof:regtype
x | text
-- SELECT 1

> CREATE TEMP VIEW tv AS SELECT 1 AS one
-- CREATE VIEW

> SELECT * FROM tv
one:int4
1
-- SELECT 1

> CREATE VIEW recur AS WITH RECURSIVE r(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r WHERE n < 3) SELECT n FROM r
-- CREATE VIEW

> SELECT * FROM recur ORDER BY n
n:int4
1
2
3
-- SELECT 3

