> CREATE TABLE p (a int, b text)
-- CREATE TABLE

> CREATE TABLE c (x int DEFAULT 9) INHERITS (p)
-- CREATE TABLE

> CREATE TABLE c2 (b text, a int) INHERITS (p)
NOTICE 00000: moving and merging column "b" with inherited definition
DETAIL: User-specified column moved to the position of the inherited column.
NOTICE 00000: moving and merging column "a" with inherited definition
DETAIL: User-specified column moved to the position of the inherited column.
-- CREATE TABLE

> INSERT INTO p VALUES (1, 'p1'), (2, 'p2')
-- INSERT 0 2

> INSERT INTO c VALUES (3, 'c3', 30), (4, 'c4', 40)
-- INSERT 0 2

> INSERT INTO c2 VALUES ('c5', 5)
ERROR 22P02: invalid input syntax for type integer: "c5" (at 24)

> SELECT p FROM p ORDER BY a
p:user
(1,p1)
(2,p2)
(3,c3)
(4,c4)
-- SELECT 4

> SELECT p.*, tableoid::regclass FROM p WHERE a % 2 = 1 ORDER BY a
a:int4 | b:text | tableoid:regclass
1 | p1 | p
3 | c3 | c
-- SELECT 2

> SELECT tableoid::regclass, count(*) FROM p GROUP BY 1 ORDER BY 1
tableoid:regclass | count:int8
p | 2
c | 2
-- SELECT 2

> SELECT * FROM p ORDER BY a DESC LIMIT 2
a:int4 | b:text
4 | c4
3 | c3
-- SELECT 2

> SELECT * FROM p x WHERE x.a > 3 ORDER BY 1
a:int4 | b:text
4 | c4
-- SELECT 1

> EXPLAIN (COSTS OFF) SELECT * FROM p x WHERE x.a > 3
QUERY PLAN:text
Append
  ->  Seq Scan on p x_1
        Filter: (a > 3)
  ->  Seq Scan on c x_2
        Filter: (a > 3)
  ->  Seq Scan on c2 x_3
        Filter: (a > 3)
-- EXPLAIN

> EXPLAIN (COSTS OFF) UPDATE p SET b = 'u' WHERE a = 3
QUERY PLAN:text
Update on p
  Update on p p_1
  Update on c p_2
  Update on c2 p_3
  ->  Result
        ->  Append
              ->  Seq Scan on p p_1
                    Filter: (a = 3)
              ->  Seq Scan on c p_2
                    Filter: (a = 3)
              ->  Seq Scan on c2 p_3
                    Filter: (a = 3)
-- EXPLAIN

> EXPLAIN (COSTS OFF) DELETE FROM p WHERE a = 3
QUERY PLAN:text
Delete on p
  Delete on p p_1
  Delete on c p_2
  Delete on c2 p_3
  ->  Append
        ->  Seq Scan on p p_1
              Filter: (a = 3)
        ->  Seq Scan on c p_2
              Filter: (a = 3)
        ->  Seq Scan on c2 p_3
              Filter: (a = 3)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM ONLY p
QUERY PLAN:text
Seq Scan on p
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT count(*) FROM p
QUERY PLAN:text
Aggregate
  ->  Append
        ->  Seq Scan on p p_1
        ->  Seq Scan on c p_2
        ->  Seq Scan on c2 p_3
-- EXPLAIN

> CREATE TABLE log (t text)
-- CREATE TABLE

> CREATE FUNCTION trg() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN INSERT INTO log VALUES (TG_TABLE_NAME || ':' || TG_OP || ':' || TG_LEVEL || ':' || TG_WHEN); RETURN COALESCE(NEW, OLD); END $$
-- CREATE FUNCTION

> CREATE TRIGGER tp BEFORE UPDATE OR DELETE ON p FOR EACH ROW EXECUTE FUNCTION trg()
-- CREATE TRIGGER

> CREATE TRIGGER tps AFTER UPDATE OR DELETE ON p FOR EACH STATEMENT EXECUTE FUNCTION trg()
-- CREATE TRIGGER

> CREATE TRIGGER tc BEFORE UPDATE OR DELETE ON c FOR EACH ROW EXECUTE FUNCTION trg()
-- CREATE TRIGGER

> CREATE TRIGGER tcs AFTER UPDATE OR DELETE ON c FOR EACH STATEMENT EXECUTE FUNCTION trg()
-- CREATE TRIGGER

> UPDATE p SET b = b || '!' WHERE a IN (1, 3)
-- UPDATE 2

> SELECT * FROM log
t:text
c:UPDATE:ROW:BEFORE
p:UPDATE:ROW:BEFORE
p:UPDATE:STATEMENT:AFTER
-- SELECT 3

> DELETE FROM log
-- DELETE 3

> UPDATE c SET b = b || '?' WHERE a = 4
-- UPDATE 1

> SELECT * FROM log
t:text
c:UPDATE:ROW:BEFORE
c:UPDATE:STATEMENT:AFTER
-- SELECT 2

> DELETE FROM log
-- DELETE 2

> DELETE FROM p WHERE a = 2 OR a = 4 RETURNING *
a:int4 | b:text
2 | p2
4 | c4?
-- DELETE 2

> SELECT * FROM log
t:text
c:DELETE:ROW:BEFORE
p:DELETE:ROW:BEFORE
p:DELETE:STATEMENT:AFTER
-- SELECT 3

> DELETE FROM log
-- DELETE 3

> UPDATE p SET a = a * 10 FROM (VALUES (1), (5)) v(k) WHERE p.a = v.k RETURNING p.*, v.k
a:int4 | b:text | k:int4
10 | p1! | 1
-- UPDATE 1

> SELECT * FROM p ORDER BY a
a:int4 | b:text
3 | c3!
10 | p1!
-- SELECT 2

> UPDATE p SET b = 'all'
-- UPDATE 2

> SELECT * FROM p ORDER BY a
a:int4 | b:text
3 | all
10 | all
-- SELECT 2

> BEGIN
-- BEGIN

> DECLARE cur CURSOR FOR SELECT * FROM p ORDER BY a FOR UPDATE
-- DECLARE CURSOR

> SELECT * FROM p FOR UPDATE
a:int4 | b:text
10 | all
3 | all
-- SELECT 2

> COMMIT
-- COMMIT

> MERGE INTO p USING (VALUES (3, 'm')) v(k, s) ON p.a = v.k WHEN MATCHED THEN UPDATE SET b = v.s WHEN NOT MATCHED THEN INSERT VALUES (v.k, v.s)
-- MERGE 1

> SELECT * FROM p ORDER BY a
a:int4 | b:text
3 | m
10 | all
-- SELECT 2

> WITH u AS (UPDATE p SET b = 'cte' WHERE a = 3 RETURNING tableoid::regclass AS t, a) SELECT * FROM u
t:regclass | a:int4
c | 3
-- SELECT 1

> SELECT a, b FROM p TABLESAMPLE BERNOULLI (100) ORDER BY a
a:int4 | b:text
3 | cte
10 | all
-- SELECT 2

> COPY p TO STDOUT
copy:text
10	all
-- COPY 1

> INSERT INTO p SELECT a + 100, b FROM p
-- INSERT 0 2

> SELECT count(*) FROM p
count:int8
4
-- SELECT 1

> SELECT count(*) FROM ONLY p
count:int8
3
-- SELECT 1

> CREATE VIEW pv AS SELECT * FROM p
-- CREATE VIEW

> SELECT count(*) FROM pv
count:int8
4
-- SELECT 1

> UPDATE pv SET b = 'view' WHERE a = 3
-- UPDATE 1

> SELECT tableoid::regclass, * FROM p WHERE a = 3
tableoid:regclass | a:int4 | b:text
c | 3 | view
-- SELECT 1

> CREATE TABLE ck1 (CHECK (a < 10)) INHERITS (p)
-- CREATE TABLE

> CREATE TABLE ck2 (CHECK (a >= 10)) INHERITS (p)
-- CREATE TABLE

> EXPLAIN (COSTS OFF) SELECT * FROM p WHERE a = 50
QUERY PLAN:text
Append
  ->  Seq Scan on p p_1
        Filter: (a = 50)
  ->  Seq Scan on c p_2
        Filter: (a = 50)
  ->  Seq Scan on c2 p_3
        Filter: (a = 50)
  ->  Seq Scan on ck2 p_4
        Filter: (a = 50)
-- EXPLAIN

> SET constraint_exclusion = on
-- SET

> EXPLAIN (COSTS OFF) SELECT * FROM p WHERE a = 50
QUERY PLAN:text
Append
  ->  Seq Scan on p p_1
        Filter: (a = 50)
  ->  Seq Scan on c p_2
        Filter: (a = 50)
  ->  Seq Scan on c2 p_3
        Filter: (a = 50)
  ->  Seq Scan on ck2 p_4
        Filter: (a = 50)
-- EXPLAIN

> EXPLAIN (COSTS OFF) SELECT * FROM ONLY ck1 WHERE a = 50
QUERY PLAN:text
Result
  One-Time Filter: false
-- EXPLAIN

> RESET constraint_exclusion
-- RESET

> EXPLAIN (COSTS OFF) SELECT * FROM ck1 WHERE a = 50
QUERY PLAN:text
Seq Scan on ck1
  Filter: (a = 50)
-- EXPLAIN

