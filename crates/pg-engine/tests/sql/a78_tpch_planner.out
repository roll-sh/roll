> set parallel_setup_cost = 0
-- SET

> set parallel_tuple_cost = 0
-- SET

> set min_parallel_table_scan_size = 0
-- SET

> explain (costs off) select o.ck, count(distinct l.sk) from a78_o o join a78_l l on l.ok = o.k
>   where o.qty < 25 group by o.ck
QUERY PLAN:text
GroupAggregate
  Group Key: o.ck
  ->  Gather Merge
        Workers Planned: 2
        ->  Sort
              Sort Key: o.ck, l.sk
              ->  Parallel Hash Join
                    Hash Cond: (l.ok = o.k)
                    ->  Parallel Seq Scan on a78_l l
                    ->  Parallel Hash
                          ->  Parallel Seq Scan on a78_o o
                                Filter: (qty < '25'::numeric)
-- EXPLAIN

