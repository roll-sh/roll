-- SELECT 5

> explain (costs off) select s.name from a78_s s, a78_n n
>   where s.k in (select l.sk from a78_l l where l.ok in (select k from a78_o where qty < 10)
>                 and l.qty > (select 0.5 * sum(l2.qty) from a78_l l2 where l2.sk = l.sk and l2.ok = l.ok))
>     and s.nk = n.k and n.name = 'N3'
>   order by s.name
QUERY PLAN:text
Sort
  Sort Key: s.name
  ->  Nested Loop Semi Join
        ->  Nested Loop
              Join Filter: (n.k = s.nk)
              ->  Index Scan using a78_s_pkey on a78_s s
              ->  Materialize
                    ->  Seq Scan on a78_n n
                          Filter: (name = 'N3'::text)
        ->  Nested Loop
              ->  Index Scan using a78_l_sk_ok_idx on a78_l l
                    Index Cond: (sk = s.k)
                    Filter: (qty > (SubPlan 1))
                    SubPlan 1
                      ->  Aggregate
                            ->  Index Scan using a78_l_sk_ok_idx on a78_l l2
                                  Index Cond: ((sk = l.sk) AND (ok = l.ok))
              ->  Index Scan using a78_o_pkey on a78_o
                    Index Cond: (k = l.ok)
                    Filter: (qty < '10'::numeric)
-- EXPLAIN

