> explain (costs off)
> select ss.x, spk_b.a from (select (select min(a) from spk_b where spk_b.b = spk_a.b) as x from spk_a where spk_a.a < 8) ss
> join spk_b on spk_b.a = ss.x order by spk_b.a desc, ss.x
