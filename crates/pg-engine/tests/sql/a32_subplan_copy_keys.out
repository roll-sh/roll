> create table spk_a (a int, b int)
-- CREATE TABLE

> create table spk_b (a int, b int)
-- CREATE TABLE

> insert into spk_a select g, g % 5 from generate_series(1, 30) g
-- INSERT 0 30

> insert into spk_b select g, g % 3 from generate_series(1, 30) g
-- INSERT 0 30

> create index on spk_b (a)
-- CREATE INDEX

> analyze spk_a, spk_b
-- ANALYZE

> explain (costs off)
> select ss.x, spk_b.a, spk_b.b from (select (select min(a) from spk_b where spk_b.b = spk_a.b) as x from spk_a where spk_a.a < 8) ss
> join spk_b on spk_b.a = ss.x order by ss.x, spk_b.a
QUERY PLAN:text
Sort
  Sort Key: ((SubPlan 2)), spk_b.a
  ->  Hash Join
        Hash Cond: ((SubPlan 4) = spk_b.a)
        ->  Seq Scan on spk_a
              Filter: (a < 8)
        ->  Hash
              ->  Seq Scan on spk_b
        SubPlan 2
          ->  Result
                InitPlan 1
                  ->  Limit
                        ->  Index Scan using spk_b_a_idx on spk_b spk_b_1
                              Index Cond: (a IS NOT NULL)
                              Filter: (b = spk_a.b)
        SubPlan 4
          ->  Result
                InitPlan 3
                  ->  Limit
                        ->  Index Scan using spk_b_a_idx on spk_b spk_b_2
                              Index Cond: (a IS NOT NULL)
                              Filter: (b = spk_a.b)
-- EXPLAIN

> select ss.x, spk_b.a, spk_b.b from (select (select min(a) from spk_b where spk_b.b = spk_a.b) as x from spk_a where spk_a.a < 8) ss
> join spk_b on spk_b.a = ss.x order by ss.x, spk_b.a
