> explain (costs off)
> select ss.x, ss.a from (select (select min(a) from spk_b where spk_b.b = spk_a.b) as x, a from spk_a) ss
> where ss.x = 2 order by ss.x, ss.a
QUERY PLAN:text
Sort
  Sort Key: ((SubPlan 2)), spk_a.a
  ->  Seq Scan on spk_a
        Filter: ((SubPlan 4) = 2)
        SubPlan 2
          ->  Result
                InitPlan 1
                  ->  Limit
                        ->  Index Scan using spk_b_a_idx on spk_b
                              Index Cond: (a IS NOT NULL)
                              Filter: (b = spk_a.b)
        SubPlan 4
          ->  Result
                InitPlan 3
                  ->  Limit
                        ->  Index Scan using spk_b_a_idx on spk_b spk_b_1
                              Index Cond: (a IS NOT NULL)
                              Filter: (b = spk_a.b)
-- EXPLAIN

> explain (costs off)
> select ss.x, spk_b.a from (select (select min(a) from spk_b where spk_b.b = spk_a.b) as x from spk_a where spk_a.a < 8 offset 0) ss
> join spk_b on spk_b.a = ss.x order by ss.x, spk_b.a
QUERY PLAN:text
Sort
  Sort Key: ((SubPlan 2))
  ->  Hash Join
        Hash Cond: (spk_b.a = ((SubPlan 2)))
        ->  Seq Scan on spk_b
        ->  Hash
              ->  Seq Scan on spk_a
                    Filter: (a < 8)
                    SubPlan 2
                      ->  Result
                            InitPlan 1
                              ->  Limit
                                    ->  Index Scan using spk_b_a_idx on spk_b spk_b_1
                                          Index Cond: (a IS NOT NULL)
                                          Filter: (b = spk_a.b)
-- EXPLAIN

> create function spk_noisy(int) returns int stable language plpgsql as $$
> begin raise notice 'noisy %', $1; return $1; end $$
-- CREATE FUNCTION

> explain (analyze, costs off, timing off, summary off, buffers off)
> select ss.x, ss.x * 2 from (select (select min(a) from spk_b) x from spk_a where a < 3) ss
QUERY PLAN:text
Seq Scan on spk_a (actual rows=2.00 loops=1)
  Filter: (a < 3)
  Rows Removed by Filter: 28
  InitPlan 2
    ->  Result (actual rows=1.00 loops=1)
          InitPlan 1
            ->  Limit (actual rows=1.00 loops=1)
                  ->  Index Only Scan using spk_b_a_idx on spk_b (actual rows=1.00 loops=1)
                        Index Cond: (a IS NOT NULL)
                        Heap Fetches: 1
                        Index Searches: 1
  InitPlan 4
    ->  Result (actual rows=1.00 loops=1)
          InitPlan 3
            ->  Limit (actual rows=1.00 loops=1)
                  ->  Index Only Scan using spk_b_a_idx on spk_b spk_b_1 (actual rows=1.00 loops=1)
                        Index Cond: (a IS NOT NULL)
                        Heap Fetches: 1
                        Index Searches: 1
-- EXPLAIN

