2
3
-- SELECT 3

> WITH RECURSIVE t(j) AS (
>   WITH RECURSIVE s(i) AS (VALUES (1) UNION ALL SELECT i + 1 FROM s WHERE i < 3)
>   SELECT i FROM s
>   UNION ALL
>   SELECT j + 1 FROM t WHERE j < 3)
> SELECT j, count(*) FROM t GROUP BY j ORDER BY j
j:int4 | count:int8
1 | 1
2 | 2
3 | 3
-- SELECT 3

> WITH RECURSIVE x(n) AS (
>   WITH x1 AS (SELECT 1 FROM x) SELECT 0 UNION SELECT * FROM x1)
> SELECT * FROM x
ERROR 42P19: recursive reference to query "x" must not appear within a subquery (at 54)

> WITH RECURSIVE x(n) AS (DELETE FROM gb_g RETURNING (SELECT n FROM x)) SELECT * FROM x
ERROR 42P19: recursive query "x" must not contain data-modifying statements (at 16)

> SELECT * FROM (WITH t AS (UPDATE gb_g SET b = b RETURNING *) SELECT * FROM t) ss
ERROR 0A000: WITH clause containing a data-modifying statement must be at the top level (at 21)

> WITH a(x) AS (SELECT 1 UNION (WITH i AS (SELECT 2) SELECT * FROM a UNION SELECT * FROM i)) SELECT * FROM a
ERROR 42P01: relation "a" does not exist (at 66)
DETAIL: There is a WITH item named "a", but it cannot be referenced from this part of the query.
HINT: Use WITH RECURSIVE, or re-order the WITH items to remove forward references.

> WITH RECURSIVE foo(i) AS (SELECT i FROM (VALUES (1)) t(i) UNION ALL SELECT (i + 1)::numeric(10,0) FROM foo WHERE i < 3)
> SELECT * FROM foo
ERROR 42804: recursive query "foo" column 1 has type integer in non-recursive term but type numeric overall (at 34)
HINT: Cast the output of the non-recursive term to the correct type.

> WITH RECURSIVE foo(i) AS (SELECT i::numeric(3,0) FROM (VALUES (1)) t(i) UNION ALL SELECT (i + 1)::numeric(10,0) FROM foo WHERE i < 3)
> SELECT * FROM foo
ERROR 42804: recursive query "foo" column 1 has type numeric(3,0) in non-recursive term but type numeric overall (at 34)
HINT: Cast the output of the non-recursive term to the correct type.

> WITH RECURSIVE g(f, t) AS (SELECT 1, 2 UNION ALL SELECT 2, 3 UNION ALL SELECT g.t, g.t + 1 FROM g WHERE g.t < 4)
>   SEARCH DEPTH FIRST BY f, t SET seq
> SELECT * FROM g
ERROR 0A000: with a SEARCH or CYCLE clause, the left side of the UNION must be a SELECT

