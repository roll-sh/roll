> CREATE TABLE a20_t1 (a int, b int)
-- CREATE TABLE

> CREATE TABLE a20_t2 (x int, y int)
-- CREATE TABLE

> INSERT INTO a20_t1 SELECT i, i FROM generate_series(1, 100) i
-- INSERT 0 100

> INSERT INTO a20_t2 SELECT i % 10, i FROM generate_series(1, 1000) i
-- INSERT 0 1000

> ANALYZE a20_t1
-- ANALYZE

> ANALYZE a20_t2
-- ANALYZE

> EXPLAIN (VERBOSE, COSTS OFF)
> SELECT * FROM a20_t1 WHERE a IN (SELECT x FROM a20_t2) FOR UPDATE
QUERY PLAN:text
LockRows
  Output: a20_t1.a, a20_t1.b, a20_t1.ctid, a20_t2.ctid
  ->  Hash Join
        Output: a20_t1.a, a20_t1.b, a20_t1.ctid, a20_t2.ctid
        Inner Unique: true
        Hash Cond: (a20_t1.a = a20_t2.x)
        ->  Seq Scan on public.a20_t1
              Output: a20_t1.a, a20_t1.b, a20_t1.ctid
        ->  Hash
              Output: a20_t2.ctid, a20_t2.x
              ->  HashAggregate
                    Output: a20_t2.ctid, a20_t2.x
                    Group Key: a20_t2.x
                    ->  Seq Scan on public.a20_t2
                          Output: a20_t2.ctid, a20_t2.x
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF)
> SELECT * FROM a20_t1 WHERE a IN (SELECT x FROM a20_t2) FOR UPDATE OF a20_t1
QUERY PLAN:text
LockRows
  Output: a20_t1.a, a20_t1.b, a20_t1.ctid, a20_t2.ctid
  ->  Hash Join
        Output: a20_t1.a, a20_t1.b, a20_t1.ctid, a20_t2.ctid
        Inner Unique: true
        Hash Cond: (a20_t1.a = a20_t2.x)
        ->  Seq Scan on public.a20_t1
              Output: a20_t1.a, a20_t1.b, a20_t1.ctid
        ->  Hash
              Output: a20_t2.ctid, a20_t2.x
              ->  HashAggregate
                    Output: a20_t2.ctid, a20_t2.x
                    Group Key: a20_t2.x
                    ->  Seq Scan on public.a20_t2
                          Output: a20_t2.ctid, a20_t2.x
-- EXPLAIN

