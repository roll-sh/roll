                          Output: a20_t1.a, a20_t1.b, a20_t1.ctid
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF)
> SELECT * FROM (SELECT * FROM a20_t1 ORDER BY a DESC LIMIT 1) s FOR UPDATE
QUERY PLAN:text
LockRows
  Output: s.a, s.b, s.*
  ->  Subquery Scan on s
        Output: s.a, s.b, s.*
        ->  Limit
              Output: a20_t1.a, a20_t1.b, a20_t1.ctid
              ->  LockRows
                    Output: a20_t1.a, a20_t1.b, a20_t1.ctid
                    ->  Sort
                          Output: a20_t1.a, a20_t1.b, a20_t1.ctid
                          Sort Key: a20_t1.a DESC
                          ->  Seq Scan on public.a20_t1
                                Output: a20_t1.a, a20_t1.b, a20_t1.ctid
