> create table tt14t (f1 text, f2 text, f3 text, f4 text)
-- CREATE TABLE

> insert into tt14t values('foo', 'bar', 'baz', '42')
-- INSERT 0 1

> alter table tt14t drop column f2
-- ALTER TABLE

> create function tt14f() returns setof tt14t as
> $$
> declare
>     rec1 record;
> begin
>     for rec1 in select * from tt14t
>     loop
>         return next rec1;
>     end loop;
> end;
> $$
> language plpgsql
-- CREATE FUNCTION

> create view tt14v as select t.* from tt14f() t
-- CREATE VIEW

> select pg_get_viewdef('tt14v', true)
pg_get_viewdef:text
 SELECT f1,
    f3,
    f4
   FROM tt14f() t(f1, f3, f4);
-- SELECT 1

> select pg_get_viewdef('tt14v', false)
pg_get_viewdef:text
 SELECT f1,
    f3,
    f4
   FROM tt14f() t(f1, f3, f4);
-- SELECT 1

> begin
-- BEGIN

> delete from pg_depend where
>   objid = (select oid from pg_rewrite
>            where ev_class = 'tt14v'::regclass and rulename = '_RETURN')
>   and refobjsubid = 3
> returning pg_describe_object(classid, objid, objsubid) as obj,
>           pg_describe_object(refclassid, refobjid, refobjsubid) as ref,
>           deptype
obj:text | ref:text | deptype:char
rule _RETURN on view tt14v | column f3 of table tt14t | n
-- DELETE 1

> alter table tt14t drop column f3
-- ALTER TABLE

> select pg_get_viewdef('tt14v', true)
pg_get_viewdef:text
 SELECT f1,
    "?dropped?column?" AS f3,
    f4
   FROM tt14f() t(f1, f4);
-- SELECT 1

> select pg_get_viewdef('tt14v', false)
pg_get_viewdef:text
 SELECT f1,
    "?dropped?column?" AS f3,
    f4
   FROM tt14f() t(f1, f4);
-- SELECT 1

> select f1, f4 from tt14v
f1:text | f4:text
foo | 42
-- SELECT 1

> select * from tt14v
ERROR 42703: attribute 3 of type record has been dropped

> rollback
-- ROLLBACK

> begin
-- BEGIN

> delete from pg_depend where
>   objid = (select oid from pg_rewrite
>            where ev_class = 'tt14v'::regclass and rulename = '_RETURN')
>   and refobjsubid = 4
> returning pg_describe_object(classid, objid, objsubid) as obj,
>           pg_describe_object(refclassid, refobjid, refobjsubid) as ref,
>           deptype
obj:text | ref:text | deptype:char
rule _RETURN on view tt14v | column f4 of table tt14t | n
-- DELETE 1

> alter table tt14t alter column f4 type integer using f4::integer
-- ALTER TABLE

> select pg_get_viewdef('tt14v', true)
pg_get_viewdef:text
 SELECT f1,
    f3,
    f4
   FROM tt14f() t(f1, f3, f4);
-- SELECT 1

> select f1, f3 from tt14v
f1:text | f3:text
foo | baz
-- SELECT 1

> select * from tt14v
ERROR 42804: attribute 4 of type record has wrong type
DETAIL: Table has type integer, but query expects text.

> rollback
-- ROLLBACK

> drop view tt14v
-- DROP VIEW

> create view tt14v as select t.f1, t.f4 from tt14f() t
-- CREATE VIEW

> select pg_get_viewdef('tt14v', true)
pg_get_viewdef:text
 SELECT f1,
    f4
   FROM tt14f() t(f1, f3, f4);
-- SELECT 1

> alter table tt14t drop column f3
-- ALTER TABLE

> select pg_get_viewdef('tt14v', true)
pg_get_viewdef:text
 SELECT f1,
    f4
   FROM tt14f() t(f1, f4);
-- SELECT 1

> select * from tt14v
f1:text | f4:text
foo | 42
-- SELECT 1

> create table vt (a int, b text, c int)
-- CREATE TABLE

> insert into vt values (1, 'one', 10)
-- INSERT 0 1

> create function vf() returns setof vt language sql as $$ select * from vt $$
-- CREATE FUNCTION

> create view vv as select x.a, x.b, x.c from vf() x
-- CREATE VIEW

> begin
-- BEGIN

> delete from pg_depend where objid = (select oid from pg_rewrite where ev_class = 'vv'::regclass and rulename = '_RETURN') and refobjsubid = 2
-- DELETE 1

> alter table vt drop column b
-- ALTER TABLE

> select pg_get_viewdef('vv', true)
pg_get_viewdef:text
 SELECT a,
    "?dropped?column?" AS b,
    c
   FROM vf() x(a, c);
-- SELECT 1

> select pg_get_viewdef('vv')
pg_get_viewdef:text
 SELECT a,
    "?dropped?column?" AS b,
    c
   FROM vf() x(a, c);
-- SELECT 1

> select a, c from vv
a:int4 | c:int4
1 | 10
-- SELECT 1

> select * from vv
ERROR 42703: attribute 2 of type record has been dropped

> rollback
-- ROLLBACK

