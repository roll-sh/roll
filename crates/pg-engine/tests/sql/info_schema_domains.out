> CREATE TABLE isd_t (v varchar(7) CHECK (v IN ('a', 'b')), w varchar CHECK (w IN ('a')), x text CHECK (x IN ('a', 'b')), c char(2) CHECK (c IN ('a', 'b')), y varchar CHECK (y NOT IN ('a', 'b')), z varchar CHECK (z IN ('a', x)), u varchar CHECK (u IN ('a', 'b', x, upper(w))))
-- CREATE TABLE

> SELECT conname, pg_get_constraintdef(oid) FROM pg_constraint WHERE conrelid = 'isd_t'::regclass OR contypid = 'isd_v'::regtype ORDER BY conname
conname:name | pg_get_constraintdef:text
isd_t_c_check | CHECK ((c = ANY (ARRAY['a'::bpchar, 'b'::bpchar])))
isd_t_check | CHECK ((((z)::text = 'a'::text) OR ((z)::text = x)))
isd_t_check1 | CHECK (((((u)::text = ANY ((ARRAY['a'::character varying, 'b'::character varying])::text[])) OR ((u)::text = x)) OR ((u)::text = upper((w)::text))))
isd_t_v_check | CHECK (((v)::text = ANY ((ARRAY['a'::character varying, 'b'::character varying])::text[])))
isd_t_w_check | CHECK (((w)::text = 'a'::text))
isd_t_x_check | CHECK ((x = ANY (ARRAY['a'::text, 'b'::text])))
isd_t_y_check | CHECK (((y)::text <> ALL ((ARRAY['a'::character varying, 'b'::character varying])::text[])))
isd_v_check | CHECK (((VALUE)::text = ANY ((ARRAY['YES'::character varying, 'NO'::character varying])::text[])))
-- SELECT 8

> CREATE VIEW isd_vw AS SELECT v, 'x'::isd_n AS n FROM isd_t WHERE v IN ('a', 'b') AND c NOT IN ('x', 'y')
-- CREATE VIEW

> SELECT pg_get_viewdef('isd_vw')
pg_get_viewdef:text
 SELECT v,
    ('x'::name)::isd_n AS n
   FROM isd_t
  WHERE (((v)::text = ANY ((ARRAY['a'::character varying, 'b'::character varying])::text[])) AND (c <> ALL (ARRAY['x'::bpchar, 'y'::bpchar])));
