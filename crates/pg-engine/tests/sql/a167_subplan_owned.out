> SELECT * FROM a167_o o LEFT JOIN a167_n n ON n.rk=o.k AND n.nk < (SELECT max(rk)*3 FROM a167_r)
QUERY PLAN:text
Nested Loop Left Join (actual rows=11.00 loops=1)
  Join Filter: (n.rk = o.k)
  Rows Removed by Join Filter: 40
  InitPlan 1
    ->  Aggregate (actual rows=1.00 loops=1)
          ->  Seq Scan on a167_r (actual rows=3.00 loops=1)
  ->  Seq Scan on a167_o o (actual rows=6.00 loops=1)
  ->  Seq Scan on a167_n n (actual rows=8.00 loops=6)
        Filter: (nk < (InitPlan 1).col1)
        Rows Removed by Filter: 1
-- EXPLAIN

> EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
> SELECT * FROM a167_o o LEFT JOIN a167_n n ON n.rk=o.k
>  AND n.nk < (SELECT max(r.rk+n.rk) FROM a167_r r)
QUERY PLAN:text
Nested Loop Left Join (actual rows=8.00 loops=1)
  Join Filter: (n.rk = o.k)
  Rows Removed by Join Filter: 25
  ->  Seq Scan on a167_o o (actual rows=6.00 loops=1)
  ->  Seq Scan on a167_n n (actual rows=5.00 loops=6)
        Filter: (nk < (SubPlan 1))
        Rows Removed by Filter: 4
        SubPlan 1
          ->  Aggregate (actual rows=1.00 loops=54)
                ->  Seq Scan on a167_r r (actual rows=3.00 loops=54)
-- EXPLAIN

> EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
> WITH c AS MATERIALIZED (SELECT * FROM a167_n)
