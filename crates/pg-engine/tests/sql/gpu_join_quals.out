> EXPLAIN (VERBOSE, COSTS OFF)
> SELECT (t2.*).q1 FROM gpu_i4 t1 LEFT JOIN gpu_i8 t2 ON t1.f1 = t2.q1
QUERY PLAN:text
Merge Right Join
  Output: t2.q1
  Merge Cond: (t2.q1 = t1.f1)
  ->  Sort
        Output: t2.q1
        Sort Key: t2.q1
        ->  Seq Scan on public.gpu_i8 t2
              Output: t2.q1
  ->  Sort
        Output: t1.f1
        Sort Key: t1.f1
        ->  Seq Scan on public.gpu_i4 t1
              Output: t1.f1
-- EXPLAIN

> SELECT (t2.*).q1, (t2.*).q2 IS NULL FROM gpu_i8 t1 LEFT JOIN gpu_i8 t2 ON t1.q2 = t2.q1 ORDER BY 1, 2
