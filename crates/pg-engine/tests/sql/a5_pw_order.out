> EXPLAIN (COSTS OFF)
> SELECT avg(t1.a), avg(t2.b), t1.c, t2.c FROM a5_plt1 t1 RIGHT JOIN a5_plt2 t2 ON t1.c = t2.c
>   WHERE t1.a % 25 = 0 GROUP BY t1.c, t2.c ORDER BY t1.c, t2.c
QUERY PLAN:text
Sort
  Sort Key: t1.c
  ->  HashAggregate
        Group Key: t1.c
        ->  Append
              ->  Hash Join
                    Hash Cond: (t2_1.c = t1_1.c)
                    ->  Seq Scan on a5_plt2_p1 t2_1
                    ->  Hash
                          ->  Seq Scan on a5_plt1_p1 t1_1
                                Filter: ((a % 25) = 0)
              ->  Hash Join
                    Hash Cond: (t2_2.c = t1_2.c)
                    ->  Seq Scan on a5_plt2_p2 t2_2
                    ->  Hash
                          ->  Seq Scan on a5_plt1_p2 t1_2
                                Filter: ((a % 25) = 0)
              ->  Hash Join
                    Hash Cond: (t2_3.c = t1_3.c)
                    ->  Seq Scan on a5_plt2_p3 t2_3
                    ->  Hash
                          ->  Seq Scan on a5_plt1_p3 t1_3
                                Filter: ((a % 25) = 0)
-- EXPLAIN

