> SET enable_partitionwise_join = on
-- SET

> SET max_parallel_workers_per_gather = 0
-- SET

> CREATE TABLE a5_fract (id bigint, PRIMARY KEY (id)) PARTITION BY RANGE (id)
-- CREATE TABLE

> CREATE TABLE a5_fract0 PARTITION OF a5_fract FOR VALUES FROM ('0') TO ('1000')
-- CREATE TABLE

> CREATE TABLE a5_fract1 PARTITION OF a5_fract FOR VALUES FROM ('1000') TO ('2000')
-- CREATE TABLE

> INSERT INTO a5_fract (id) SELECT generate_series(0, 1999)
-- INSERT 0 2000

> ANALYZE a5_fract
-- ANALYZE

> EXPLAIN (COSTS OFF)
> SELECT x.id, y.id FROM a5_fract x LEFT JOIN a5_fract y USING (id) ORDER BY x.id ASC LIMIT 10
QUERY PLAN:text
Limit
  ->  Merge Append
        Sort Key: x.id
        ->  Merge Left Join
              Merge Cond: (x_1.id = y_1.id)
              ->  Index Only Scan using a5_fract0_pkey on a5_fract0 x_1
              ->  Index Only Scan using a5_fract0_pkey on a5_fract0 y_1
        ->  Merge Left Join
              Merge Cond: (x_2.id = y_2.id)
              ->  Index Only Scan using a5_fract1_pkey on a5_fract1 x_2
              ->  Index Only Scan using a5_fract1_pkey on a5_fract1 y_2
-- EXPLAIN

