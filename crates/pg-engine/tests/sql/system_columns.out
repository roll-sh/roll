> INSERT INTO s VALUES (1, 9, 'a'), (3, 5, 'c') ON CONFLICT (id) DO UPDATE SET n = excluded.n RETURNING id, n, (xmax = 0) AS inserted
id:int4 | n:int4 | inserted:bool
1 | 9 | f
3 | 5 | t
