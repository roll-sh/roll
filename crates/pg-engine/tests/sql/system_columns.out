> SELECT pg_typeof(ctid), pg_typeof(xmin), pg_typeof(cmin), pg_typeof(tableoid) FROM s LIMIT 1
pg_typeof:regtype | pg_typeof:regtype | pg_typeof:regtype | pg_typeof:regtype
tid | xid | cid | oid
