> EXPLAIN (VERBOSE, COSTS OFF) SELECT 1 AS c0, 1 AS c2 FROM t GROUP BY ROLLUP (t.b, 1)
QUERY PLAN:text
MixedAggregate
  Output: (1), (1), b
  Hash Key: t.b, 1
  Hash Key: t.b
  Group Key: ()
  ->  Seq Scan on public.t
        Output: 1, b, 1
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF) SELECT 1 AS c0, count(*) FROM t GROUP BY GROUPING SETS ((t.b), 1) HAVING 1 IS DISTINCT FROM NULL
QUERY PLAN:text
HashAggregate
  Output: (1), count(*), b
  Hash Key: t.b
  Hash Key: 1
  Filter: ((1) IS NOT NULL)
  ->  Seq Scan on public.t
        Output: 1, b, 1
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF) SELECT 1 AS c0, 1 AS c2, sum(1) FROM e GROUP BY GROUPING SETS ((1), ()) ORDER BY 2
QUERY PLAN:text
Sort
  Output: (1), (1), (sum(1))
  Sort Key: (1)
  ->  MixedAggregate
        Output: (1), (1), sum(1)
        Hash Key: 1
        Group Key: ()
        ->  Seq Scan on public.e
              Output: 1, 1
-- EXPLAIN

> EXPLAIN (VERBOSE, COSTS OFF) SELECT 1 AS c0, 'a' AS c2, 'a'::text AS c3 FROM e GROUP BY ROLLUP(1, 2)
QUERY PLAN:text
MixedAggregate
  Output: (1), ('a'::text), ('a'::text)
  Hash Key: 1, 'a'::text
  Hash Key: 1
  Group Key: ()
  ->  Seq Scan on public.e
        Output: 1, 'a'::text, 'a'::text
-- EXPLAIN

