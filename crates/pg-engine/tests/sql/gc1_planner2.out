  Sort Key: t1.a
  ->  Append
        ->  Hash Join
              Hash Cond: (t1_1.a = t2_1.a)
              ->  Seq Scan on gc2_p1_a t1_1
                    Filter: (b < 15)
              ->  Hash
                    ->  Seq Scan on gc2_p2_a t2_1
        ->  Hash Join
              Hash Cond: (t2_2.a = t1_2.a)
              ->  Seq Scan on gc2_p2_b t2_2
              ->  Hash
                    ->  Seq Scan on gc2_p1_b t1_2
                          Filter: (b < 15)
-- EXPLAIN

