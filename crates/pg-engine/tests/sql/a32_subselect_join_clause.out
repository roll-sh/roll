> explain (costs off)
> select ss.x, sjc_b.a from (select (select min(a) from sjc_b where sjc_b.b = sjc_a.b) as x from sjc_a where sjc_a.a < 8) ss
> join sjc_b on sjc_b.a = ss.x
QUERY PLAN:text
Hash Join
  Hash Cond: ((SubPlan 4) = sjc_b.a)
  ->  Seq Scan on sjc_a
        Filter: (a < 8)
  ->  Hash
        ->  Seq Scan on sjc_b
  SubPlan 2
    ->  Result
          InitPlan 1
            ->  Limit
                  ->  Index Scan using sjc_b_a_idx on sjc_b sjc_b_1
                        Index Cond: (a IS NOT NULL)
                        Filter: (b = sjc_a.b)
  SubPlan 4
    ->  Result
          InitPlan 3
            ->  Limit
                  ->  Index Scan using sjc_b_a_idx on sjc_b sjc_b_2
                        Index Cond: (a IS NOT NULL)
                        Filter: (b = sjc_a.b)
-- EXPLAIN

