> SELECT pg_get_viewdef('v'::regclass, true)
pg_get_viewdef:text
 SELECT jb['a'::text] AS a,
    jb['a'::text][1] AS a1,
    jb[m] AS bym,
    arr[1:2] AS sl,
    (jb -> 'x'::text)['y'::text] AS xy
   FROM t;
-- SELECT 1

> SELECT pg_get_viewdef('v'::regclass)
pg_get_viewdef:text
 SELECT jb['a'::text] AS a,
    jb['a'::text][1] AS a1,
    jb[m] AS bym,
    arr[1:2] AS sl,
    ((jb -> 'x'::text))['y'::text] AS xy
   FROM t;
-- SELECT 1

