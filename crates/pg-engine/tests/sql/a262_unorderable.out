> select a from (values ('1'::xid8), ('2')) v(a) order by a desc
a:5069
2
1
-- SELECT 2

> drop table uo
-- DROP TABLE

> create table uw (a int)
-- CREATE TABLE

> insert into uw values (1), (2)
-- INSERT 0 2

> select a, rank() over (order by ctid) from uw
a:int4 | rank:int8
1 | 1
2 | 2
-- SELECT 2

> select count(*) over w from uw window w as (order by ctid)
