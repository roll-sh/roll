QUERY PLAN:text
Limit
  ->  Append
        ->  Nested Loop
              ->  Seq Scan on a5_pht_p1 p1_1
              ->  Memoize
                    Cache Key: p1_1.c
                    Cache Mode: logical
                    ->  Index Scan using a5_pht_p1_c_idx on a5_pht_p1 p2_1
                          Index Cond: (c = p1_1.c)
        ->  Nested Loop
              ->  Seq Scan on a5_pht_p2 p1_2
              ->  Memoize
                    Cache Key: p1_2.c
                    Cache Mode: logical
                    ->  Index Scan using a5_pht_p2_c_idx on a5_pht_p2 p2_2
                          Index Cond: (c = p1_2.c)
        ->  Nested Loop
              ->  Seq Scan on a5_pht_p3 p1_3
              ->  Memoize
                    Cache Key: p1_3.c
                    Cache Mode: logical
                    ->  Index Scan using a5_pht_p3_c_idx on a5_pht_p3 p2_3
                          Index Cond: (c = p1_3.c)
-- EXPLAIN

