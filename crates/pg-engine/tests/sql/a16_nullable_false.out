>   left join (select 1 as val) as ss1 on true
>   left join lateral (select ss1.val as val_filtered where false) as ss2 on true
QUERY PLAN:text
Nested Loop Left Join
  Output: 0, (1), ((1))
  Join Filter: false
  ->  Result
        Output: 1
  ->  Result
        Output: (1)
        One-Time Filter: false
