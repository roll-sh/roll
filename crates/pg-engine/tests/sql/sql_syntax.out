> create view sx_mv as select n = v as a, n = c as b, v = c as c, n = any('{x}') as d, c = any('{x}') as e, case when true then v else c end as f from sx_m
-- CREATE VIEW

> select pg_get_viewdef('sx_mv'::regclass)
pg_get_viewdef:text
 SELECT (n = (v)::text) AS a,
    (n = (c)::text) AS b,
    ((v)::bpchar = c) AS c,
    (n = ANY ('{x}'::name[])) AS d,
    (c = ANY ('{x}'::bpchar[])) AS e,
        CASE
            WHEN true THEN (v)::bpchar
            ELSE c
        END AS f
   FROM sx_m;
