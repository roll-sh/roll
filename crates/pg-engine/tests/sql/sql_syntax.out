> create view sx_cv as select t collate "C" as a, t || 'x' collate "C" as b, collation for (t) as c, (t collate "C")::varchar as d, upper(t collate "POSIX") as e, (t collate "C")::int as f from sx_c order by t collate "C"
-- CREATE VIEW

> select pg_get_viewdef('sx_cv')
pg_get_viewdef:text
 SELECT (t COLLATE "C") AS a,
    (t || ('x'::text COLLATE "C")) AS b,
    COLLATION FOR (t) AS c,
    ((t)::character varying COLLATE "C") AS d,
    upper((t COLLATE "POSIX")) AS e,
    (t)::integer AS f
   FROM sx_c
  ORDER BY (t COLLATE "C");
-- SELECT 1

