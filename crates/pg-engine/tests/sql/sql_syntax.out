> create table sx_s (t text, v varchar(5), ts timestamptz, tz timestamp, d date, i interval, tm time, b bytea, bt bit(8), n numeric)
-- CREATE TABLE

> create view sx_sv as select position(v in t) as c1, position('a' in t) as c2, substring(t from 2) as c3, substring(t from 2 for 3) as c4, substring(t for 3) as c5, substring(t similar 'a#"b#"c' escape '#') as c6, overlay(t placing 'x' from 2) as c7, overlay(t placing 'x' from 2 for 1) as c8, trim(t) as c9, trim(both 'x' from t) as c10, trim(leading 'x' from t) as c11, trim(trailing from t) as c12, extract(year from ts) as c13, extract(epoch from i) as c14, extract(day from d) as c15, ts at time zone 'UTC' as c16, tz at time zone 'UTC' as c17, ts at local as c18, (ts, i) overlaps (ts, ts) as c19, t is normalized as c20, t is nfkc normalized as c21, normalize(t) as c22, normalize(t, nfd) as c23, collation for (t) as c24, current_date as c25, current_timestamp(2) as c26, localtime as c27, current_user as c28, session_user as c29, system_user as c30, current_catalog as c31, current_schema as c32, current_role as c33, user as c34, position(b in b) as c35, substring(b from 2) as c36, overlay(b placing b from 2) as c37, trim(both b from b) as c38, position(bt in bt) as c39, substring(bt from 2 for 3) as c40, overlay(bt placing bt from 2) as c41, "position"(t, v) as c42, substring(t, 2) as c43, btrim(t) as c44, date_part('year', ts) as c45, timezone('UTC', ts) as c46, t similar to 'a%' as c47, t not similar to 'a' escape '#' as c48, extract(hour from tm) as c49, ts at time zone i as c50 from sx_s
-- CREATE VIEW

> select pg_get_viewdef('sx_sv'::regclass)
pg_get_viewdef:text
 SELECT POSITION((v) IN (t)) AS c1,
    POSITION(('a'::text) IN (t)) AS c2,
    SUBSTRING(t FROM 2) AS c3,
    SUBSTRING(t FROM 2 FOR 3) AS c4,
    SUBSTRING(t FROM 1 FOR 3) AS c5,
    SUBSTRING(t SIMILAR 'a#"b#"c'::text ESCAPE '#'::text) AS c6,
    OVERLAY(t PLACING 'x'::text FROM 2) AS c7,
    OVERLAY(t PLACING 'x'::text FROM 2 FOR 1) AS c8,
    TRIM(BOTH FROM t) AS c9,
    TRIM(BOTH 'x'::text FROM t) AS c10,
    TRIM(LEADING 'x'::text FROM t) AS c11,
    TRIM(TRAILING FROM t) AS c12,
    EXTRACT(year FROM ts) AS c13,
    EXTRACT(epoch FROM i) AS c14,
    EXTRACT(day FROM d) AS c15,
    (ts AT TIME ZONE 'UTC'::text) AS c16,
    (tz AT TIME ZONE 'UTC'::text) AS c17,
    (ts AT LOCAL) AS c18,
    ((ts, i) OVERLAPS (ts, ts)) AS c19,
    (t IS NORMALIZED) AS c20,
    (t IS NFKC NORMALIZED) AS c21,
    NORMALIZE(t) AS c22,
    NORMALIZE(t, NFD) AS c23,
    COLLATION FOR (t) AS c24,
    CURRENT_DATE AS c25,
    CURRENT_TIMESTAMP(2) AS c26,
    LOCALTIME AS c27,
    CURRENT_USER AS c28,
    SESSION_USER AS c29,
    SYSTEM_USER AS c30,
    CURRENT_CATALOG AS c31,
    CURRENT_SCHEMA AS c32,
    CURRENT_ROLE AS c33,
    USER AS c34,
    POSITION((b) IN (b)) AS c35,
    SUBSTRING(b FROM 2) AS c36,
    OVERLAY(b PLACING b FROM 2) AS c37,
    TRIM(BOTH b FROM b) AS c38,
    POSITION((bt) IN (bt)) AS c39,
    SUBSTRING(bt FROM 2 FOR 3) AS c40,
    OVERLAY(bt PLACING bt FROM 2) AS c41,
    "position"(t, (v)::text) AS c42,
    "substring"(t, 2) AS c43,
    btrim(t) AS c44,
    date_part('year'::text, ts) AS c45,
    timezone('UTC'::text, ts) AS c46,
    (t ~ similar_to_escape('a%'::text)) AS c47,
    (t !~ similar_to_escape('a'::text, '#'::text)) AS c48,
    EXTRACT(hour FROM tm) AS c49,
    (ts AT TIME ZONE i) AS c50
   FROM sx_s;
-- SELECT 1

