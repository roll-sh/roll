> create table sx_n (n name, t text, v varchar(5), w varchar(7), c char(3), i int, b bigint)
-- CREATE TABLE

> create view sx_nv as select n = t as a1, t = n as a2, n < t as a3, n <> 'x'::text as a4, n = 'x' as a5, v = any('{a}') as a6, t = any('{a,b}') as a7, i = any('{1,2}') as a8, greatest(v, 'x') as a9, greatest(v, w) as a10, coalesce(v, w) as a11, case when true then v else w end as a12, least(v, v) as a13, coalesce(v, 'abc') as a14, n || 'x' as a15, n like 'a%' as a16, t like n as a17, n ~ 'a' as a18, i = any(array[1,b]) as a19, v in ('a', 'b') as a20, n in ('a', 'b') as a21, c = 'a' as a22, c || 'x' as a23, nullif(v, 'x') as a24 from sx_n
-- CREATE VIEW

> select pg_get_viewdef('sx_nv'::regclass)
pg_get_viewdef:text
 SELECT (n = t) AS a1,
    (t = n) AS a2,
    (n < t) AS a3,
    (n <> 'x'::text) AS a4,
    (n = 'x'::name) AS a5,
    ((v)::text = ANY ('{a}'::text[])) AS a6,
    (t = ANY ('{a,b}'::text[])) AS a7,
    (i = ANY ('{1,2}'::integer[])) AS a8,
    GREATEST(v, 'x'::character varying) AS a9,
    GREATEST(v, w) AS a10,
    COALESCE(v, w) AS a11,
        CASE
            WHEN true THEN v
            ELSE w
        END AS a12,
    LEAST(v, v) AS a13,
    COALESCE(v, 'abc'::character varying) AS a14,
    ((n)::text || 'x'::text) AS a15,
    (n ~~ 'a%'::text) AS a16,
    (t ~~ (n)::text) AS a17,
    (n ~ 'a'::text) AS a18,
    (i = ANY (ARRAY[(1)::bigint, b])) AS a19,
    ((v)::text = ANY ((ARRAY['a'::character varying, 'b'::character varying])::text[])) AS a20,
    (n = ANY (ARRAY['a'::name, 'b'::name])) AS a21,
    (c = 'a'::bpchar) AS a22,
    ((c)::text || 'x'::text) AS a23,
    NULLIF((v)::text, 'x'::text) AS a24
   FROM sx_n;
-- SELECT 1

