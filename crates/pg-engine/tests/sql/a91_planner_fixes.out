> 		   ('cabbage', 'brassica'), ('kohlrabi', 'brassica'),
> 		   ('rutabaga', 'brassica'), ('turnip', 'brassica')
-- INSERT 0 8

> CREATE INDEX ON a91_veg (id)
-- CREATE INDEX

> ANALYZE a91_veg
-- ANALYZE

> SET enable_hashjoin = false
-- SET

> SET enable_material = false
-- SET

> SET enable_mergejoin = false
-- SET

> SET enable_seqscan = false
-- SET

> EXPLAIN (COSTS OFF) SELECT * FROM a91_veg v1, a91_veg v2 WHERE v1.id = v2.id
QUERY PLAN:text
Nested Loop
  ->  Append
        ->  Index Scan using a91_brassica_id_idx on a91_brassica v1_1
        ->  Index Scan using a91_daucus_id_idx on a91_daucus v1_2
  ->  Append
        ->  Index Scan using a91_brassica_id_idx on a91_brassica v2_1
              Index Cond: (id = v1.id)
        ->  Index Scan using a91_daucus_id_idx on a91_daucus v2_2
              Index Cond: (id = v1.id)
-- EXPLAIN

