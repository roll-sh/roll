10 | 5
-- SELECT 15

> EXPLAIN (COSTS OFF)
> SELECT l.id, s.id0
> FROM a91_l AS l
> LEFT JOIN LATERAL (
>     SELECT l2.id, l0.id AS id0
>     FROM a91_l AS l0
>     LEFT JOIN (
>         SELECT l1.id, l1.req, l1.l2name FROM a91_l AS l1 WHERE l1.req IS NOT NULL
>     ) AS l2 ON l0.id = CASE WHEN l2.req IS NOT NULL THEN l2.id END
>     WHERE l2.req IS NOT NULL AND (l2.req = l.id * 2 OR length(l2.l2name)::int = l2.id)
> ) AS s ON TRUE
> ORDER BY 1, 2
QUERY PLAN:text
Incremental Sort
  Sort Key: l.id, l0.id
  Presorted Key: l.id
  ->  Nested Loop Left Join
        Join Filter: ((l1.req = (l.id * 2)) OR (length(l1.l2name) = l1.id))
        ->  Index Only Scan using a91_l_pkey on a91_l l
        ->  Materialize
              ->  Hash Join
                    Hash Cond: (CASE WHEN (l1.req IS NOT NULL) THEN l1.id ELSE NULL::integer END = l0.id)
                    ->  Seq Scan on a91_l l1
                          Filter: ((req IS NOT NULL) AND (req IS NOT NULL))
                    ->  Hash
                          ->  Seq Scan on a91_l l0
-- EXPLAIN

> DROP TABLE a91_l
-- DROP TABLE

> CREATE TABLE a91_veg (id serial, name text, genus text) PARTITION BY LIST (genus)
-- CREATE TABLE

> CREATE TABLE a91_daucus PARTITION OF a91_veg FOR VALUES IN ('daucus')
-- CREATE TABLE

> CREATE TABLE a91_brassica PARTITION OF a91_veg FOR VALUES IN ('brassica')
-- CREATE TABLE

> INSERT INTO a91_veg (name, genus)
> 	VALUES ('carrot', 'daucus'), ('bok choy', 'brassica'),
