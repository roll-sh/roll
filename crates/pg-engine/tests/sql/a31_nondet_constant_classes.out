QUERY PLAN:text
Nested Loop
  ->  Nested Loop
        ->  Seq Scan on n1
              Filter: (x = 'b2'::text COLLATE ci)
        ->  Materialize
              ->  Seq Scan on n3
                    Filter: ((x)::text = 'b2'::text COLLATE ci)
  ->  Materialize
        ->  Seq Scan on n2
              Filter: (x = 'b2'::text COLLATE ci)
-- EXPLAIN

