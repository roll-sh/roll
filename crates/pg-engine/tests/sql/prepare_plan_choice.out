> create table sk2 (a int primary key, c text)
-- CREATE TABLE

> insert into sk2 select g, 'c' || g from generate_series(1, 1000) g
-- INSERT 0 1000

> analyze sk2
-- ANALYZE

> prepare j(int) as select sk.b, sk2.c from sk join sk2 on sk2.a = sk.a where sk.a = $1
-- PREPARE

> execute j(995)
b:text | c:text
v995 | c995
-- SELECT 1

