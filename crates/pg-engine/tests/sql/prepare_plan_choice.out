> create table sk (a int, b text)
-- CREATE TABLE

> insert into sk select case when g <= 990 then 1 else g end, 'v' || g from generate_series(1, 1000) g
-- INSERT 0 1000

> create index sk_a on sk (a)
-- CREATE INDEX

> analyze sk
-- ANALYZE

> prepare q(int) as select b from sk where a = $1
-- PREPARE

> execute q(995)
b:text
v995
-- SELECT 1

> execute q(996)
b:text
v996
-- SELECT 1

> execute q(997)
b:text
v997
-- SELECT 1

> execute q(998)
b:text
v998
-- SELECT 1

> execute q(999)
b:text
v999
-- SELECT 1

> explain execute q(1000)
QUERY PLAN:text
Index Scan using sk_a on sk  (cost=0.15..9.74 rows=91 width=4)
  Index Cond: (a = $1)
-- EXPLAIN

> execute q(1000)
b:text
v1000
-- SELECT 1

