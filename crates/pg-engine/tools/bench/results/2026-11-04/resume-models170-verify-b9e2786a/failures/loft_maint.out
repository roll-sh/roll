> set default_toast_compression = 'pglz'
-- SET

> create table cmd (f1 text compression pglz)
-- CREATE TABLE

> insert into cmd values (repeat('1234567890', 1000))
-- INSERT 0 1

> create table cmd1 (f1 text compression lz4)
-- CREATE TABLE

> insert into cmd1 values (repeat('1234567890', 1004))
-- INSERT 0 1

> create table cmm (f1 text compression pglz)
-- CREATE TABLE

> insert into cmm select * from cmd
-- INSERT 0 1

> insert into cmm select * from cmd1
-- INSERT 0 1

> select pg_column_compression(f1) from cmm
pg_column_compression:text
lz4
pglz
-- SELECT 2

> alter table cmd alter column f1 set compression lz4
-- ALTER TABLE

> insert into cmd values (repeat('123456789', 4004))
-- INSERT 0 1

> select pg_column_compression(f1) from cmd
pg_column_compression:text
lz4
pglz
-- SELECT 2

> create materialized view cmv(x) as select * from cmd1
-- SELECT 1

> select pg_column_compression(x) from cmv
pg_column_compression:text
lz4
-- SELECT 1

> create table cmm2 (f1 text compression pglz)
-- CREATE TABLE

> insert into cmm2 values (repeat('1234567890', 1004))
-- INSERT 0 1

> select pg_column_compression(f1) from cmm2
pg_column_compression:text
pglz
-- SELECT 1

> update cmm2 set f1 = cmd1.f1 from cmd1
-- UPDATE 1

> select pg_column_compression(f1) from cmm2
pg_column_compression:text
lz4
-- SELECT 1

> create table cmm3 (f1 text compression lz4)
-- CREATE TABLE

