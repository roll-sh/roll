UPDATE tbl SET c1 = 100 WHERE c1 = 2;
-- @@@ 116
UPDATE tbl SET c1 = 1 WHERE c1 = 3;
-- @@@ 117
-- should fail
UPDATE tbl SET c2 = 2 WHERE c1 = 1;
