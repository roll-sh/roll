-- @@@ 50
-- Test with non-strict equality function.
-- We need to create our own type for this.
begin;
-- @@@ 51
create type myint;
-- @@@ 52
create function myintin(cstring) returns myint strict immutable language
  internal as 'int4in';
NOTICE:  return type myint is only a shell
-- @@@ 53
create function myintout(myint) returns cstring strict immutable language
  internal as 'int4out';
NOTICE:  argument type myint is only a shell
LINE 1: create function myintout(myint) returns cstring strict immut...
                                 ^
-- @@@ 54
create function myinthash(myint) returns integer strict immutable language
  internal as 'hashint4';
NOTICE:  argument type myint is only a shell
LINE 1: create function myinthash(myint) returns integer strict immu...
                                  ^
-- @@@ 55
create type myint (input = myintin, output = myintout, like = int4);
-- @@@ 56
create cast (int4 as myint) without function;
-- @@@ 57
create cast (myint as int4) without function;
-- @@@ 58
create function myinteq(myint, myint) returns bool as $$
begin
  if $1 is null and $2 is null then
    return true;
  else
    return $1::int = $2::int;
  end if;
end;
$$ language plpgsql immutable;
-- @@@ 59
create function myintne(myint, myint) returns bool as $$
begin
  return not myinteq($1, $2);
end;
$$ language plpgsql immutable;
-- @@@ 60
create operator = (
  leftarg    = myint,
  rightarg   = myint,
  commutator = =,
  negator    = <>,
  procedure  = myinteq,
  restrict   = eqsel,
  join       = eqjoinsel,
  merges
);
-- @@@ 61
create operator <> (
  leftarg    = myint,
  rightarg   = myint,
  commutator = <>,
  negator    = =,
  procedure  = myintne,
  restrict   = eqsel,
  join       = eqjoinsel,
  merges
);
-- @@@ 62
create operator class myint_ops
default for type myint using hash as
  operator    1   =  (myint, myint),
  function    1   myinthash(myint);
-- @@@ 63
create table inttest (a myint);
-- @@@ 64
insert into inttest values (null), (0::myint), (1::myint);
-- @@@ 65
-- Test EEOP_HASHED_SCALARARRAYOP against EEOP_SCALARARRAYOP.  Ensure the
-- result of non-hashed vs hashed is the same.
select
  a,
  a in (1::myint,2::myint,3::myint,4::myint,5::myint,6::myint,7::myint,8::myint) as not_hashed,
  a in (1::myint,2::myint,3::myint,4::myint,5::myint,6::myint,7::myint,8::myint,9::myint) as hashed
from inttest;
 a | not_hashed | hashed 
---+------------+--------
   |            | 
 0 | f          | f
 1 | t          | t
(3 rows)

