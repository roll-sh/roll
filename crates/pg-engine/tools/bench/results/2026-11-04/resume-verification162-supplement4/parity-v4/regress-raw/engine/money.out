--
-- MONEY
--
-- Note that we assume lc_monetary has been set to C.
--
CREATE TABLE money_data (m money);
-- @@@ 0
INSERT INTO money_data VALUES ('123');
-- @@@ 1
SELECT * FROM money_data;
    m    
---------
 $123.00
(1 row)

-- @@@ 2
SELECT m + '123' FROM money_data;
 ?column? 
----------
  $246.00
(1 row)

-- @@@ 3
SELECT m + '123.45' FROM money_data;
 ?column? 
----------
  $246.45
(1 row)

-- @@@ 4
SELECT m - '123.45' FROM money_data;
 ?column? 
----------
