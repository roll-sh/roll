             (0.5::numeric),
             (1.5::numeric),
             (2.5::numeric)) t(x);
  x   | int8_value 
------+------------
 -2.5 |         -3
 -1.5 |         -2
 -0.5 |         -1
  0.0 |          0
  0.5 |          1
  1.5 |          2
  2.5 |          3
(7 rows)

