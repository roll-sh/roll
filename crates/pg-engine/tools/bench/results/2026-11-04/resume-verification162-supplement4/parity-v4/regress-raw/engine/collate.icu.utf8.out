WHERE t1.x = t2.x COLLATE case_insensitive
ORDER BY 1, 2;
  x  |  x  
-----+-----
 abc | abc
 abc | ABC
 ABC | abc
 ABC | ABC
 def | def
 ghi | ghi
(6 rows)

