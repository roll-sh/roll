-- @@@ 131
-- Check that LIKE isn't confused when new table masks the old, either
BEGIN;
-- @@@ 132
CREATE SCHEMA ctl_schema;
-- @@@ 133
SET LOCAL search_path = ctl_schema, public;
-- @@@ 134
