SELECT explain_mask_costs($$
SELECT * FROM generate_series('-infinity'::NUMERIC, 'infinity'::NUMERIC, 1.0) g(s);$$,
false, true, false, true);
                        explain_mask_costs                         
-------------------------------------------------------------------
 Function Scan on generate_series g  (cost=N..N rows=1000 width=N)
(1 row)

