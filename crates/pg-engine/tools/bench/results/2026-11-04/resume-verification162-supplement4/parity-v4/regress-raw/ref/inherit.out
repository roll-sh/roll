ALTER TABLE errtst_child_fastdef ADD COLUMN data int NOT NULL DEFAULT 0;
-- @@@ 880
ALTER TABLE errtst_child_fastdef ADD CONSTRAINT errtest_child_fastdef_data_check CHECK (data < 10);
