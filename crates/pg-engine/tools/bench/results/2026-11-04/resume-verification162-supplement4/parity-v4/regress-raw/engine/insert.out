ERROR:  new row for relation "part4" violates partition constraint
DETAIL:  Failing row contains (a, 10).
-- @@@ 107
-- ok
insert into part4 values ('b', 10);
-- @@@ 108
-- fail (partition key a has a NOT NULL constraint)
