-- @@@ 4
--
-- Check mentioning same column more than once
--
EXPLAIN (VERBOSE, COSTS OFF)
SELECT count(*) FROM
  (SELECT DISTINCT two, four, two FROM tenk1) ss;
                       QUERY PLAN                       
--------------------------------------------------------
 Aggregate
   Output: count(*)
   ->  HashAggregate
         Output: tenk1.two, tenk1.four, tenk1.two
         Group Key: tenk1.two, tenk1.four
         ->  Seq Scan on public.tenk1
               Output: tenk1.two, tenk1.four, tenk1.two
(7 rows)

-- @@@ 5
SELECT count(*) FROM
  (SELECT DISTINCT two, four, two FROM tenk1) ss;
 count 
-------
     4
(1 row)

-- @@@ 6
--
-- Compare results between plans using sorting and plans using hash
-- aggregation. Force spilling in both cases by setting work_mem low.
--
SET work_mem='64kB';
-- @@@ 7
-- Produce results with sorting.
SET enable_hashagg=FALSE;
-- @@@ 8
SET jit_above_cost=0;
-- @@@ 9
EXPLAIN (costs off)
SELECT DISTINCT g%1000 FROM generate_series(0,9999) g;
                   QUERY PLAN                   
------------------------------------------------
 Unique
   ->  Sort
         Sort Key: ((g % 1000))
         ->  Function Scan on generate_series g
(4 rows)

-- @@@ 10
CREATE TABLE distinct_group_1 AS
SELECT DISTINCT g%1000 FROM generate_series(0,9999) g;
-- @@@ 11
SET jit_above_cost TO DEFAULT;
-- @@@ 12
CREATE TABLE distinct_group_2 AS
SELECT DISTINCT (g%1000)::text FROM generate_series(0,9999) g;
-- @@@ 13
SET enable_seqscan = 0;
-- @@@ 14
-- Check to see we get an incremental sort plan
EXPLAIN (costs off)
SELECT DISTINCT hundred, two FROM tenk1;
                     QUERY PLAN                      
-----------------------------------------------------
 Unique
   ->  Incremental Sort
         Sort Key: hundred, two
         Presorted Key: hundred
         ->  Index Scan using tenk1_hundred on tenk1
(5 rows)

-- @@@ 15
RESET enable_seqscan;
-- @@@ 16
SET enable_hashagg=TRUE;
-- @@@ 17
-- Produce results with hash aggregation.
SET enable_sort=FALSE;
-- @@@ 18
SET jit_above_cost=0;
-- @@@ 19
EXPLAIN (costs off)
SELECT DISTINCT g%1000 FROM generate_series(0,9999) g;
                QUERY PLAN                
------------------------------------------
 HashAggregate
   Group Key: (g % 1000)
   ->  Function Scan on generate_series g
(3 rows)

-- @@@ 20
CREATE TABLE distinct_hash_1 AS
SELECT DISTINCT g%1000 FROM generate_series(0,9999) g;
-- @@@ 21
SET jit_above_cost TO DEFAULT;
-- @@@ 22
CREATE TABLE distinct_hash_2 AS
SELECT DISTINCT (g%1000)::text FROM generate_series(0,9999) g;
-- @@@ 23
SET enable_sort=TRUE;
-- @@@ 24
SET work_mem TO DEFAULT;
-- @@@ 25
-- Compare results
(SELECT * FROM distinct_hash_1 EXCEPT SELECT * FROM distinct_group_1)
  UNION ALL
(SELECT * FROM distinct_group_1 EXCEPT SELECT * FROM distinct_hash_1);
 ?column? 
----------
(0 rows)

-- @@@ 26
(SELECT * FROM distinct_hash_1 EXCEPT SELECT * FROM distinct_group_1)
  UNION ALL
(SELECT * FROM distinct_group_1 EXCEPT SELECT * FROM distinct_hash_1);
 ?column? 
----------
(0 rows)

-- @@@ 27
DROP TABLE distinct_hash_1;
-- @@@ 28
DROP TABLE distinct_hash_2;
-- @@@ 29
DROP TABLE distinct_group_1;
-- @@@ 30
DROP TABLE distinct_group_2;
-- @@@ 31
-- Test parallel DISTINCT
SET parallel_tuple_cost=0;
-- @@@ 32
SET parallel_setup_cost=0;
-- @@@ 33
SET min_parallel_table_scan_size=0;
-- @@@ 34
SET max_parallel_workers_per_gather=2;
-- @@@ 35
-- Ensure we get a parallel plan
EXPLAIN (costs off)
SELECT DISTINCT four FROM tenk1;
                     QUERY PLAN                     
----------------------------------------------------
 Unique
   ->  Gather Merge
         Workers Planned: 2
         ->  Sort
               Sort Key: four
               ->  HashAggregate
                     Group Key: four
                     ->  Parallel Seq Scan on tenk1
(8 rows)

-- @@@ 36
-- Ensure the parallel plan produces the correct results
SELECT DISTINCT four FROM tenk1;
 four 
------
    0
    1
    2
    3
(4 rows)

-- @@@ 37
CREATE OR REPLACE FUNCTION distinct_func(a INT) RETURNS INT AS $$
  BEGIN
    RETURN a;
  END;
$$ LANGUAGE plpgsql PARALLEL UNSAFE;
-- @@@ 38
-- Ensure we don't do parallel distinct with a parallel unsafe function
EXPLAIN (COSTS OFF)
SELECT DISTINCT distinct_func(1) FROM tenk1;
                        QUERY PLAN                        
----------------------------------------------------------
 Unique
   ->  Sort
         Sort Key: (distinct_func(1))
         ->  Index Only Scan using tenk1_hundred on tenk1
(4 rows)

-- @@@ 39
-- make the function parallel safe
CREATE OR REPLACE FUNCTION distinct_func(a INT) RETURNS INT AS $$
  BEGIN
    RETURN a;
  END;
$$ LANGUAGE plpgsql PARALLEL SAFE;
-- @@@ 40
-- Ensure we do parallel distinct now that the function is parallel safe
EXPLAIN (COSTS OFF)
SELECT DISTINCT distinct_func(1) FROM tenk1;
                     QUERY PLAN                     
----------------------------------------------------
 Unique
   ->  Gather Merge
         Workers Planned: 2
         ->  Unique
               ->  Sort
                     Sort Key: (distinct_func(1))
                     ->  Parallel Seq Scan on tenk1
(7 rows)

-- @@@ 41
RESET max_parallel_workers_per_gather;
-- @@@ 42
RESET min_parallel_table_scan_size;
-- @@@ 43
RESET parallel_setup_cost;
-- @@@ 44
RESET parallel_tuple_cost;
-- @@@ 45
--
-- Test the planner's ability to use a LIMIT 1 instead of a Unique node when
-- all of the distinct_pathkeys have been marked as redundant
--
-- Ensure we get a plan with a Limit 1
EXPLAIN (COSTS OFF)
SELECT DISTINCT four FROM tenk1 WHERE four = 0;
         QUERY PLAN         
----------------------------
 Limit
   ->  Seq Scan on tenk1
         Filter: (four = 0)
(3 rows)

-- @@@ 46
-- Ensure the above gives us the correct result
SELECT DISTINCT four FROM tenk1 WHERE four = 0;
 four 
------
    0
(1 row)

-- @@@ 47
-- Ensure we get a plan with a Limit 1
EXPLAIN (COSTS OFF)
SELECT DISTINCT four FROM tenk1 WHERE four = 0 AND two <> 0;
                 QUERY PLAN                  
---------------------------------------------
 Limit
   ->  Seq Scan on tenk1
         Filter: ((two <> 0) AND (four = 0))
(3 rows)

-- @@@ 48
-- Ensure no rows are returned
SELECT DISTINCT four FROM tenk1 WHERE four = 0 AND two <> 0;
 four 
------
(0 rows)

-- @@@ 49
-- Ensure we get a plan with a Limit 1 when the SELECT list contains constants
EXPLAIN (COSTS OFF)
SELECT DISTINCT four,1,2,3 FROM tenk1 WHERE four = 0;
         QUERY PLAN         
----------------------------
 Limit
   ->  Seq Scan on tenk1
         Filter: (four = 0)
(3 rows)

-- @@@ 50
-- Ensure we only get 1 row
SELECT DISTINCT four,1,2,3 FROM tenk1 WHERE four = 0;
 four | ?column? | ?column? | ?column? 
------+----------+----------+----------
    0 |        1 |        2 |        3
(1 row)

-- @@@ 51
SET parallel_setup_cost=0;
-- @@@ 52
SET min_parallel_table_scan_size=0;
-- @@@ 53
SET max_parallel_workers_per_gather=2;
-- @@@ 54
-- Ensure we get a plan with a Limit 1 in both partial distinct and final
-- distinct
EXPLAIN (COSTS OFF)
SELECT DISTINCT four FROM tenk1 WHERE four = 10;
                  QUERY PLAN                  
----------------------------------------------
 Limit
   ->  Gather
         Workers Planned: 2
         ->  Limit
               ->  Parallel Seq Scan on tenk1
                     Filter: (four = 10)
(6 rows)

-- @@@ 55
RESET max_parallel_workers_per_gather;
-- @@@ 56
RESET min_parallel_table_scan_size;
-- @@@ 57
RESET parallel_setup_cost;
-- @@@ 58
--
-- Also, some tests of IS DISTINCT FROM, which doesn't quite deserve its
-- very own regression file.
--
CREATE TEMP TABLE disttable (f1 integer);
-- @@@ 59
INSERT INTO DISTTABLE VALUES(1);
-- @@@ 60
INSERT INTO DISTTABLE VALUES(2);
-- @@@ 61
INSERT INTO DISTTABLE VALUES(3);
-- @@@ 62
INSERT INTO DISTTABLE VALUES(NULL);
-- @@@ 63
-- basic cases
SELECT f1, f1 IS DISTINCT FROM 2 as "not 2" FROM disttable;
 f1 | not 2 
----+-------
  1 | t
  2 | f
  3 | t
    | t
(4 rows)

-- @@@ 64
SELECT f1, f1 IS DISTINCT FROM NULL as "not null" FROM disttable;
 f1 | not null 
----+----------
  1 | t
  2 | t
  3 | t
    | f
(4 rows)

-- @@@ 65
SELECT f1, f1 IS DISTINCT FROM f1 as "false" FROM disttable;
 f1 | false 
----+-------
  1 | f
  2 | f
  3 | f
    | f
(4 rows)

-- @@@ 66
SELECT f1, f1 IS DISTINCT FROM f1+1 as "not null" FROM disttable;
 f1 | not null 
----+----------
  1 | t
  2 | t
  3 | t
    | f
(4 rows)

