SELECT ten FROM onek t WHERE unique1 IN (VALUES (0), ((2 IN
  (SELECT (3)))::integer)
);
                     QUERY PLAN                     
----------------------------------------------------
 Nested Loop
   ->  Unique
         ->  Sort
               Sort Key: "*VALUES*".column1
               ->  Values Scan on "*VALUES*"
                     SubPlan 1
                       ->  Result
   ->  Index Scan using onek_unique1 on onek t
         Index Cond: (unique1 = "*VALUES*".column1)
(9 rows)

