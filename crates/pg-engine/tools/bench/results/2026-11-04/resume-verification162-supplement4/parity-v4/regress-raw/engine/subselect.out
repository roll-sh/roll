               ->  Hash
                     Output: t3.q1
                     ->  Seq Scan on public.int8_tbl t3
                           Output: t3.q1
         ->  Hash
               Output: t1.q1
               ->  Seq Scan on public.int8_tbl t1
                     Output: t1.q1
