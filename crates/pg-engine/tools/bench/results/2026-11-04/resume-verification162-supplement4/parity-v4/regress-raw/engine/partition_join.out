               ->  Seq Scan on prt1_l_p2_p2 t1_3
               ->  Hash
                     ->  Seq Scan on prt2_l_p2_p2 t2_3
                           Filter: (a = b)
         ->  Hash Join
               Hash Cond: ((t1_5.a = t2_5.a) AND ((t1_5.c)::text = (t2_5.c)::text))
               ->  Append
                     ->  Seq Scan on prt1_l_p3_p1 t1_5
                     ->  Seq Scan on prt1_l_p3_p2 t1_6
               ->  Hash
                     ->  Append
                           ->  Seq Scan on prt2_l_p3_p1 t2_5
                                 Filter: (a = b)
