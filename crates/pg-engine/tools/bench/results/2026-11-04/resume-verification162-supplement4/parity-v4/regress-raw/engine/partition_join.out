CREATE INDEX iprt1_e_p1_ab2 on prt1_e_p1(((a+b)/2));
-- @@@ 62
CREATE INDEX iprt1_e_p2_ab2 on prt1_e_p2(((a+b)/2));
-- @@@ 63
