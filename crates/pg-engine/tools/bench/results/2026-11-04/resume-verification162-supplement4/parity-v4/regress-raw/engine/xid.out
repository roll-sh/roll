-- xid and xid8
-- values in range, in octal, decimal, hex
select '010'::xid,
       '42'::xid,
       '0xffffffff'::xid,
       '-1'::xid,
	   '010'::xid8,
	   '42'::xid8,
	   '0xffffffffffffffff'::xid8,
	   '-1'::xid8;
 xid | xid |    xid     |    xid     | xid8 | xid8 |         xid8         |         xid8         
-----+-----+------------+------------+------+------+----------------------+----------------------
   8 |  42 | 4294967295 | 4294967295 |    8 |   42 | 18446744073709551615 | 18446744073709551615
(1 row)

