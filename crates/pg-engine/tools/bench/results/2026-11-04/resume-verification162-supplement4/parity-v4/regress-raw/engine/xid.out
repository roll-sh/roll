select min(x), max(x) from xid8_t1;
 min |         max          
-----+----------------------
   0 | 18446744073709551615
(1 row)

-- @@@ 28
-- xid8 has btree and hash opclasses
create index on xid8_t1 using btree(x);
-- @@@ 29
create index on xid8_t1 using hash(x);
-- @@@ 30
drop table xid8_t1;
