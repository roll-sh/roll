(1 row)

-- @@@ 191
-- global option - more than one match
SELECT regexp_matches('foobarbequebazilbarfbonk', $re$(b[^b]+)(b[^b]+)$re$, 'g');
 regexp_matches 
----------------
 {bar,beque}
 {bazil,barf}
(2 rows)

-- @@@ 192
-- empty capture group (matched empty string)
SELECT regexp_matches('foobarbequebaz', $re$(bar)(.*)(beque)$re$);
