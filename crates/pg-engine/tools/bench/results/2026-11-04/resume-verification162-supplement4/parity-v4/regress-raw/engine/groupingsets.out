from int8_tbl i1
cross join lateral (select (select i1.q1) as x) ss
group by ss.x;
                 QUERY PLAN                 
--------------------------------------------
 GroupAggregate
   Output: (SubPlan 2), ((SubPlan 3))
   Group Key: ((SubPlan 3))
   ->  Sort
         Output: ((SubPlan 3)), i1.q1
         Sort Key: ((SubPlan 3))
         ->  Seq Scan on public.int8_tbl i1
               Output: (SubPlan 3), i1.q1
               SubPlan 3
                 ->  Result
                       Output: i1.q1
   SubPlan 2
     ->  Result
           Output: GROUPING((SubPlan 1))
(14 rows)

