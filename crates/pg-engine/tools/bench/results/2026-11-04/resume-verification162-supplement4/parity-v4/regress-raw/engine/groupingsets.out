 Sort
   Sort Key: (GROUPING(unhashable_col, unsortable_col)), (sum(v))
   ->  MixedAggregate
         Hash Key: v, unsortable_col
         Group Key: v, unhashable_col
         ->  Sort
               Sort Key: v, unhashable_col
               ->  Seq Scan on gstest4
(8 rows)

