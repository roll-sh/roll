-- Tests for range data types.
--
-- test input parser
-- (type textrange was already made in test_setup.sql)
--
-- negative tests; should fail
select ''::textrange;
ERROR:  malformed range literal: ""
LINE 1: select ''::textrange;
               ^
DETAIL:  Missing left parenthesis or bracket.
-- @@@ 0
select '-[a,z)'::textrange;
ERROR:  malformed range literal: "-[a,z)"
LINE 1: select '-[a,z)'::textrange;
               ^
DETAIL:  Missing left parenthesis or bracket.
-- @@@ 1
select '[a,z) - '::textrange;
ERROR:  malformed range literal: "[a,z) - "
LINE 1: select '[a,z) - '::textrange;
               ^
DETAIL:  Junk after right parenthesis or bracket.
-- @@@ 2
select '(",a)'::textrange;
ERROR:  malformed range literal: "(",a)"
LINE 1: select '(",a)'::textrange;
               ^
DETAIL:  Unexpected end of input.
-- @@@ 3
select '(,,a)'::textrange;
ERROR:  malformed range literal: "(,,a)"
LINE 1: select '(,,a)'::textrange;
               ^
DETAIL:  Too many commas.
-- @@@ 4
select '(),a)'::textrange;
ERROR:  malformed range literal: "(),a)"
LINE 1: select '(),a)'::textrange;
               ^
DETAIL:  Missing comma after lower bound.
-- @@@ 5
select '(a,))'::textrange;
ERROR:  malformed range literal: "(a,))"
LINE 1: select '(a,))'::textrange;
               ^
DETAIL:  Junk after right parenthesis or bracket.
-- @@@ 6
select '(],a)'::textrange;
ERROR:  malformed range literal: "(],a)"
LINE 1: select '(],a)'::textrange;
               ^
DETAIL:  Missing comma after lower bound.
-- @@@ 7
select '(a,])'::textrange;
ERROR:  malformed range literal: "(a,])"
LINE 1: select '(a,])'::textrange;
               ^
DETAIL:  Junk after right parenthesis or bracket.
-- @@@ 8
select '[z,a]'::textrange;
ERROR:  range lower bound must be less than or equal to range upper bound
LINE 1: select '[z,a]'::textrange;
               ^
-- @@@ 9
-- should succeed
select '  empty  '::textrange;
 textrange 
-----------
 empty
(1 row)

-- @@@ 10
select ' ( empty, empty )  '::textrange;
      textrange       
----------------------
 (" empty"," empty ")
(1 row)

-- @@@ 11
select ' ( " a " " a ", " z " " z " )  '::textrange;
        textrange         
--------------------------
 ("  a   a ","  z   z  ")
(1 row)

-- @@@ 12
select '(a,)'::textrange;
 textrange 
-----------
 (a,)
(1 row)

-- @@@ 13
select '[,z]'::textrange;
 textrange 
-----------
 (,z]
(1 row)

-- @@@ 14
select '[a,]'::textrange;
 textrange 
-----------
 [a,)
(1 row)

-- @@@ 15
select '(,)'::textrange;
 textrange 
-----------
 (,)
(1 row)

-- @@@ 16
select '[ , ]'::textrange;
 textrange 
-----------
 [" "," "]
(1 row)

-- @@@ 17
select '["",""]'::textrange;
 textrange 
-----------
 ["",""]
(1 row)

-- @@@ 18
select '[",",","]'::textrange;
 textrange 
-----------
 [",",","]
(1 row)

-- @@@ 19
select '["\\","\\"]'::textrange;
  textrange  
-------------
 ["\\","\\"]
(1 row)

-- @@@ 20
select '(\\,a)'::textrange;
 textrange 
-----------
 ("\\",a)
(1 row)

-- @@@ 21
select '((,z)'::textrange;
 textrange 
-----------
 ("(",z)
(1 row)

-- @@@ 22
select '([,z)'::textrange;
 textrange 
-----------
 ("[",z)
(1 row)

-- @@@ 23
select '(!,()'::textrange;
 textrange 
-----------
 (!,"(")
(1 row)

-- @@@ 24
select '(!,[)'::textrange;
 textrange 
-----------
 (!,"[")
(1 row)

-- @@@ 25
select '[a,a]'::textrange;
 textrange 
-----------
 [a,a]
(1 row)

-- @@@ 26
-- these are allowed but normalize to empty:
select '[a,a)'::textrange;
 textrange 
-----------
 empty
(1 row)

-- @@@ 27
select '(a,a]'::textrange;
 textrange 
-----------
 empty
(1 row)

-- @@@ 28
select '(a,a)'::textrange;
 textrange 
-----------
 empty
(1 row)

