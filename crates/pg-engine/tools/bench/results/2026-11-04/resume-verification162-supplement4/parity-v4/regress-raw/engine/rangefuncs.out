DROP FUNCTION dup(anyelement);
-- @@@ 252
-- equivalent behavior, though different name exposed for input arg
CREATE OR REPLACE FUNCTION dup (inout f2 anyelement, out f3 anyarray)
AS 'select $1, array[$1,$1]' LANGUAGE sql;
-- @@@ 253
SELECT dup(22);
      dup       
----------------
 (22,"{22,22}")
(1 row)

