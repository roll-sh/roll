-- @@@ 277
--
-- some tests on SQL functions with RETURNING
--
create temp table tt(f1 serial, data text);
-- @@@ 278
create function insert_tt(text) returns int as
$$ insert into tt(data) values($1) returning f1 $$
language sql;
-- @@@ 279
select insert_tt('foo');
 insert_tt 
-----------
         1
(1 row)

-- @@@ 280
select insert_tt('bar');
 insert_tt 
-----------
         2
(1 row)

-- @@@ 281
select * from tt;
 f1 | data 
----+------
  1 | foo
  2 | bar
(2 rows)

-- @@@ 282
-- insert will execute to completion even if function needs just 1 row
create or replace function insert_tt(text) returns int as
$$ insert into tt(data) values($1),($1||$1) returning f1 $$
language sql;
-- @@@ 283
select insert_tt('fool');
 insert_tt 
-----------
         3
(1 row)

-- @@@ 284
select * from tt;
 f1 |   data   
----+----------
  1 | foo
  2 | bar
  3 | fool
  4 | foolfool
(4 rows)

-- @@@ 285
-- setof does what's expected
create or replace function insert_tt2(text,text) returns setof int as
$$ insert into tt(data) values($1),($2) returning f1 $$
language sql;
-- @@@ 286
select insert_tt2('foolish','barrish');
 insert_tt2 
------------
          5
          6
(2 rows)

-- @@@ 287
select * from insert_tt2('baz','quux');
 insert_tt2 
------------
          7
          8
(2 rows)

-- @@@ 288
select * from tt;
 f1 |   data   
----+----------
  1 | foo
  2 | bar
  3 | fool
  4 | foolfool
  5 | foolish
  6 | barrish
  7 | baz
  8 | quux
(8 rows)

-- @@@ 289
-- limit doesn't prevent execution to completion
select insert_tt2('foolish','barrish') limit 1;
 insert_tt2 
------------
          9
(1 row)

-- @@@ 290
select * from tt;
 f1 |   data   
----+----------
  1 | foo
  2 | bar
  3 | fool
  4 | foolfool
  5 | foolish
  6 | barrish
  7 | baz
  8 | quux
  9 | foolish
 10 | barrish
(10 rows)

-- @@@ 291
-- triggers will fire, too
create function noticetrigger() returns trigger as $$
begin
  raise notice 'noticetrigger % %', new.f1, new.data;
  return null;
end $$ language plpgsql;
-- @@@ 292
create trigger tnoticetrigger after insert on tt for each row
execute procedure noticetrigger();
-- @@@ 293
select insert_tt2('foolme','barme') limit 1;
NOTICE:  noticetrigger 11 foolme
NOTICE:  noticetrigger 12 barme
 insert_tt2 
------------
         11
(1 row)

-- @@@ 294
select * from tt;
 f1 |   data   
----+----------
  1 | foo
  2 | bar
  3 | fool
  4 | foolfool
  5 | foolish
  6 | barrish
  7 | baz
  8 | quux
  9 | foolish
 10 | barrish
 11 | foolme
 12 | barme
(12 rows)

-- @@@ 295
-- and rules work
create temp table tt_log(f1 int, data text);
-- @@@ 296
create rule insert_tt_rule as on insert to tt do also
  insert into tt_log values(new.*);
-- @@@ 297
select insert_tt2('foollog','barlog') limit 1;
NOTICE:  noticetrigger 13 foollog
NOTICE:  noticetrigger 14 barlog
 insert_tt2 
------------
         13
(1 row)

-- @@@ 298
select * from tt;
 f1 |   data   
----+----------
  1 | foo
  2 | bar
  3 | fool
  4 | foolfool
  5 | foolish
  6 | barrish
  7 | baz
  8 | quux
  9 | foolish
 10 | barrish
 11 | foolme
 12 | barme
 13 | foollog
 14 | barlog
(14 rows)

-- @@@ 299
-- note that nextval() gets executed a second time in the rule expansion,
-- which is expected.
select * from tt_log;
 f1 |  data   
----+---------
 15 | foollog
 16 | barlog
(2 rows)

-- @@@ 300
-- test case for a whole-row-variable bug
create function rngfunc1(n integer, out a text, out b text)
  returns setof record
  language sql
  as $$ select 'foo ' || i, 'bar ' || i from generate_series(1,$1) i $$;
-- @@@ 301
set work_mem='64kB';
-- @@@ 302
select t.a, t, t.a from rngfunc1(10000) t limit 1;
   a   |         t         |   a   
-------+-------------------+-------
 foo 1 | ("foo 1","bar 1") | foo 1
(1 row)

-- @@@ 303
reset work_mem;
-- @@@ 304
select t.a, t, t.a from rngfunc1(10000) t limit 1;
   a   |         t         |   a   
-------+-------------------+-------
 foo 1 | ("foo 1","bar 1") | foo 1
(1 row)

