-------------------------------------------------
 ( 'foot':B & 'ball':B & 'klubber':B ) <-> 'sky'
(1 row)

-- @@@ 99
SELECT phraseto_tsquery('hunspell_tst', 'footballyklubber sky');
             phraseto_tsquery              
-------------------------------------------
