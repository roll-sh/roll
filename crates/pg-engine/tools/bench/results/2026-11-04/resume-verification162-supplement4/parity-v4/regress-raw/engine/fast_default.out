-- @@@ 146
ALTER TABLE t ADD COLUMN x int NOT NULL DEFAULT 4;
-- @@@ 147
ALTER TABLE t ADD COLUMN y int NOT NULL DEFAULT 5;
-- @@@ 148
CREATE TRIGGER a BEFORE UPDATE ON t FOR EACH ROW EXECUTE PROCEDURE test_trigger();
-- @@@ 149
SELECT * FROM t;
 id | a | b | c | x | y 
----+---+---+---+---+---
  1 | 1 | 2 | 3 | 4 | 5
(1 row)

