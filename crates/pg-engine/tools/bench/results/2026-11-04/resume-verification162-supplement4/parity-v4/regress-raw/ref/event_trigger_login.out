(1 row)

-- @@@ 8
-- Check dathasloginevt in system catalog
SELECT dathasloginevt FROM pg_database WHERE datname= :'DBNAME';
 dathasloginevt 
----------------
 t
(1 row)

-- @@@ 9
-- Cleanup
DROP TABLE user_logins;
-- @@@ 10
DROP EVENT TRIGGER on_login_trigger;
-- @@@ 11
DROP FUNCTION on_login_proc();
-- @@@ 12
\c
