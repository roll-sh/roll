--
-- CHAR
--
-- Per SQL standard, CHAR means character(1), that is a varlena type
-- with a constraint restricting it to one character (not byte)
SELECT char 'c' = char 'c' AS true;
 true 
------
 t
(1 row)

-- @@@ 0
--
-- Build a table for testing
-- (This temporarily hides the table created in test_setup.sql)
--
CREATE TEMP TABLE CHAR_TBL(f1 char);
-- @@@ 1
INSERT INTO CHAR_TBL (f1) VALUES ('a');
-- @@@ 2
INSERT INTO CHAR_TBL (f1) VALUES ('A');
-- @@@ 3
-- any of the following three input formats are acceptable
INSERT INTO CHAR_TBL (f1) VALUES ('1');
-- @@@ 4
INSERT INTO CHAR_TBL (f1) VALUES (2);
-- @@@ 5
INSERT INTO CHAR_TBL (f1) VALUES ('3');
-- @@@ 6
-- zero-length char
INSERT INTO CHAR_TBL (f1) VALUES ('');
-- @@@ 7
-- try char's of greater than 1 length
INSERT INTO CHAR_TBL (f1) VALUES ('cd');
ERROR:  value too long for type character(1)
-- @@@ 8
INSERT INTO CHAR_TBL (f1) VALUES ('c     ');
-- @@@ 9
SELECT * FROM CHAR_TBL;
 f1 
----
 a
 A
 1
 2
 3
  
 c
(7 rows)

-- @@@ 10
SELECT c.*
   FROM CHAR_TBL c
   WHERE c.f1 <> 'a';
 f1 
----
 A
 1
 2
 3
  
 c
(6 rows)

-- @@@ 11
SELECT c.*
   FROM CHAR_TBL c
   WHERE c.f1 = 'a';
 f1 
----
 a
(1 row)

-- @@@ 12
SELECT c.*
   FROM CHAR_TBL c
   WHERE c.f1 < 'a';
 f1 
----
 A
 1
 2
 3
  
(5 rows)

-- @@@ 13
SELECT c.*
   FROM CHAR_TBL c
   WHERE c.f1 <= 'a';
 f1 
----
 a
 A
 1
 2
 3
  
(6 rows)

-- @@@ 14
SELECT c.*
   FROM CHAR_TBL c
   WHERE c.f1 > 'a';
 f1 
----
 c
(1 row)

-- @@@ 15
SELECT c.*
   FROM CHAR_TBL c
   WHERE c.f1 >= 'a';
 f1 
----
 a
 c
(2 rows)

-- @@@ 16
DROP TABLE CHAR_TBL;
-- @@@ 17
--
-- Now test longer arrays of char
--
-- This char_tbl was already created and filled in test_setup.sql.
-- Here we just try to insert bad values.
--
INSERT INTO CHAR_TBL (f1) VALUES ('abcde');
ERROR:  value too long for type character(4)
-- @@@ 18
SELECT * FROM CHAR_TBL;
  f1  
------
 a   
 ab  
 abcd
 abcd
(4 rows)

-- @@@ 19
-- Also try it with non-error-throwing API
SELECT pg_input_is_valid('abcd  ', 'char(4)');
 pg_input_is_valid 
-------------------
 t
(1 row)

-- @@@ 20
SELECT pg_input_is_valid('abcde', 'char(4)');
 pg_input_is_valid 
-------------------
 f
(1 row)

-- @@@ 21
SELECT * FROM pg_input_error_info('abcde', 'char(4)');
               message                | detail | hint | sql_error_code 
--------------------------------------+--------+------+----------------
 value too long for type character(4) |        |      | 22001
(1 row)

-- @@@ 22
--
-- Also test "char", which is an ad-hoc one-byte type.  It can only
-- really store ASCII characters, but we allow high-bit-set characters
-- to be accessed via bytea-like escapes.
--
SELECT 'a'::"char";
 char 
------
 a
(1 row)

-- @@@ 23
SELECT '\101'::"char";
 char 
------
 A
(1 row)

-- @@@ 24
SELECT '\377'::"char";
 char 
------
 \377
(1 row)

-- @@@ 25
SELECT 'a'::"char"::text;
 text 
------
 a
(1 row)

-- @@@ 26
SELECT '\377'::"char"::text;
 text 
------
 \377
(1 row)

-- @@@ 27
SELECT '\000'::"char"::text;
 text 
------
 
(1 row)

-- @@@ 28
SELECT 'a'::text::"char";
 char 
------
 a
(1 row)

-- @@@ 29
SELECT '\377'::text::"char";
 char 
------
 \377
(1 row)

-- @@@ 30
SELECT ''::text::"char";
 char 
------
 
(1 row)

