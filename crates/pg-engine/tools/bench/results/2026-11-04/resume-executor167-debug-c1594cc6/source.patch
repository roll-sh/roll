+fn key_equal_apart(e: &crate::sql::expr::Expr, proj: Option<&[crate::sql::expr::Expr]>) -> bool {
+    let mut x = e;
+    while let crate::sql::expr::Expr::Relabel(y, _) = x {
+        x = y;
+    }
+    if let (crate::sql::expr::Expr::Col(i, _), Some(p)) = (x, proj)
+        && let Some(y) = p.get(*i)
+    {
+        return key_equal_apart(y, None);
+    }
