@@ -300,3 +300,46 @@ fn hash_join_spilling_bounds_the_build_heap() {
     assert!(spilled < 16 << 20, "spilled build used {spilled} bytes");
     assert!(memory > spilled * 2, "spilling did not bound the build: {spilled} vs {memory}");
 }
