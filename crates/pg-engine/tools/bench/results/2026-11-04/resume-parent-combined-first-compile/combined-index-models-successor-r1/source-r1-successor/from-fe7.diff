+INSERT INTO a163_rs (id, t) VALUES (40, a163_long(300));
+UPDATE a163_rs SET t = a163_long(85, 1) WHERE id = 1;
+UPDATE a163_rs SET id = 10 WHERE id = 2;
+SELECT id, length(t) FROM a163_rs ORDER BY id;
