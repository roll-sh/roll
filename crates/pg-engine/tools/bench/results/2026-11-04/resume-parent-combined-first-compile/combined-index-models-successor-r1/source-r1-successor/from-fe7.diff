         assert_eq!(rows(&mut s, "SELECT n_distinct FROM pg_stats WHERE tablename = 'sa' AND attname = 'a'"), ["[Float4(10.0)]"]);
     });
 }
+
+/// INCLUDE size checks on the measured serial callback, with its actual unmodelled
+/// heap state asserted. Error sizes are the PG18.6 a163_review_sizes fixture's.
+#[test]
+fn measured_serial_include_size() {
+    let dir = tempfile::tempdir().unwrap();
+    let eng = open(dir.path());
+    with_max_versions(500, || {
+        let mut s = eng.connect(1, "postgres", "postgres", "t").unwrap();
+        s.query("SET max_parallel_maintenance_workers=0").unwrap();
+        s.query("CREATE FUNCTION mi_text(n int) RETURNS text LANGUAGE sql IMMUTABLE AS $$ SELECT left(string_agg(md5(g::text), ''), n) FROM generate_series(1, (n+31)/32) g $$").unwrap();
+        for (len, expected) in [(2800, "index row size 2816 exceeds btree version 4 maximum 2704"), (8300, "index row requires 8320 bytes, maximum size is 8191")] {
+            s.query("CREATE TABLE mi (k int, payload text)").unwrap();
+            s.query(&format!("INSERT INTO mi SELECT g, CASE WHEN g=6000 THEN mi_text({len}) ELSE 'small' END FROM generate_series(1,6000) g")).unwrap();
+            // The bulk insert already leaves this heap unmodelled. VACUUM of the
+            // 8300-byte raw row hits a separately recorded HeapPacker overflow before
+            // CREATE INDEX; it is not needed to enter the measured build callback.
+            let result = s.query("SELECT oid FROM pg_class WHERE relname='mi'").unwrap();
+            let pg_engine::types::Value::Oid(oid) = result[0].rows[0][0] else { panic!("table oid") };
+            assert!(pg_engine::exec::sizing::is_estimated(oid, &s.state.db));
+            assert!(pg_engine::exec::sizing::heap_writes(oid, &s.state.db).is_none());
+            let e = s.query("CREATE INDEX mi_i ON mi(k) INCLUDE(payload)").unwrap_err();
+            assert_eq!(e.code, "54000");
+            assert!(e.message.starts_with(expected), "{e:?}");
+            eprintln!("measured serial INCLUDE: estimated=true heap_model=false workers=0: {}", e.message);
+            s.query("DROP TABLE mi").unwrap();
+        }
+    });
+}
diff --git a/crates/pg-engine/tests/isolation/specs/roll-bitmap-recheck.spec b/crates/pg-engine/tests/isolation/specs/roll-bitmap-recheck.spec
new file mode 100644
index 00000000..bd782888
--- /dev/null
+++ b/crates/pg-engine/tests/isolation/specs/roll-bitmap-recheck.spec
@@ -0,0 +1,41 @@
+# Actual PG18.6 interleavings: bitmap candidates must be rechecked after a lock finds a
+# changed row version, including BitmapOr and non-index filter columns.
+setup
+{
+  CREATE TABLE rb (id int, v int, w int);
+  INSERT INTO rb SELECT i, i % 100, i % 200 FROM generate_series(1,1000) i;
+  CREATE INDEX rb_v ON rb(v);
+  CREATE INDEX rb_w ON rb(w);
+  ANALYZE rb;
+}
+teardown { DROP TABLE rb; }
+
+session s1
+step begin { BEGIN; }
+step change { UPDATE rb SET v=99, w=99 WHERE id=1; }
+step qualifying { UPDATE rb SET v=101, w=1 WHERE id=1; }
+step filteronly { UPDATE rb SET id=2 WHERE id=1; }
+step commit { COMMIT; }
+
+session s2
+setup { SET enable_seqscan=off; SET enable_indexscan=off; }
+step planlock { EXPLAIN (COSTS OFF) SELECT id FROM rb WHERE v=1 AND id<5 FOR UPDATE; }
+step planor { EXPLAIN (COSTS OFF) SELECT id FROM rb WHERE (v=1 OR w=1) AND id<5 FOR UPDATE; }
+step planupdate { EXPLAIN (COSTS OFF) UPDATE rb SET id=id+1000 WHERE v=1 AND id<5 RETURNING id; }
+step lock { SELECT id FROM rb WHERE v=1 AND id<5 FOR UPDATE; }
+step lockor { SELECT id FROM rb WHERE (v=1 OR w=1) AND id<5 FOR UPDATE; }
+step update { UPDATE rb SET id=id+1000 WHERE v=1 AND id<5 RETURNING id; }
+step plainor { SELECT id FROM rb WHERE (v=1 OR w=1) AND id<5 ORDER BY id,v,w; }
+step filterlock { SELECT id FROM rb WHERE v=1 AND id<5 FOR UPDATE; }
+step final { SELECT id,v,w FROM rb WHERE id IN (1,2,1001,1002) ORDER BY id,v,w; }
+
+permutation planlock begin change lock commit final
+permutation planor plainor begin change lockor commit plainor final
+permutation planupdate begin change update commit final
+
+# Still qualifies through the other OR arm after an indexed-column update.
+permutation planor begin qualifying lockor commit final
+# Index key is unchanged; the row returned must contain the new filter-only value.
+permutation planlock begin filteronly filterlock commit final
+# A qualifying UPDATE must act on the new version, not drop the candidate.
+permutation planupdate begin filteronly update commit final
diff --git a/crates/pg-engine/tests/models_kept.rs b/crates/pg-engine/tests/models_kept.rs
index 004900a6..898e9527 100644
--- a/crates/pg-engine/tests/models_kept.rs
+++ b/crates/pg-engine/tests/models_kept.rs
@@ -236,3 +236,36 @@ fn kept_models_not_used_when_stale() {
     s.query("TRUNCATE km2; INSERT INTO km2 VALUES (1, 'a')").unwrap();
     assert_eq!(rows(&mut s, "SELECT ctid FROM km2"), ["[Tid(0, 1)]"]);
 }
+
+/// A kept table whose pages were all visible is planned from its record's sizes while its
+/// models are still being laid out (`kept::sizes`): the plans, costs and sizes its first
+/// statements see are those of its models once laid out, and of before the restart.
+#[test]
+fn kept_sizes_plan_as_the_models_do() {
+    let dir = tempfile::tempdir().unwrap();
+    let checks = [
+        "EXPLAIN SELECT pad FROM ks WHERE id = 12345",
+        "EXPLAIN SELECT * FROM ks WHERE a = 7",
+        "SELECT pg_relation_size('ks'), pg_relation_size('ks_pkey'), pg_relation_size('ks_a')",
+        "SELECT pad FROM ks WHERE id = 12345",
+    ];
+    let before: Vec<Vec<String>> = {
+        let eng = open(dir.path());
+        let mut s = eng.connect(1, "postgres", "postgres", "t").unwrap();
+        exec(&mut s, "CREATE TABLE ks (id int PRIMARY KEY, a int, pad text); CREATE INDEX ks_a ON ks (a);
+            INSERT INTO ks SELECT g, g % 101, repeat('p', 60) FROM generate_series(1, 150000) g;
+            DELETE FROM ks WHERE id % 10 = 0; VACUUM ks");
+        let out = checks.iter().map(|q| rows(&mut s, q)).collect();
+        drop(s);
+        eng.shutdown();
+        out
+    };
+    let eng = open(dir.path());
+    let mut s = eng.connect(1, "postgres", "postgres", "t").unwrap();
+    let first: Vec<Vec<String>> = checks.iter().map(|q| rows(&mut s, q)).collect();
+    // (A ctid lays the models out, if the background builder hasn't yet.)
+    rows(&mut s, "SELECT ctid FROM ks WHERE id = 1");
+    let laid: Vec<Vec<String>> = checks.iter().map(|q| rows(&mut s, q)).collect();
+    assert_eq!(first, before);
+    assert_eq!(laid, before);
+}
