model account {
  id                           BigInt                   @id @default(autoincrement())
  email                        String                   @unique @db.Citext
  name                         String                   @default("anon") @db.VarChar(80)
  mood                         mood                     @default(ok)
  score                        Decimal?                 @db.Decimal(10, 2)
  ratio                        Float?
  small                        Int?                     @default(1) @db.SmallInt
  flag                         Boolean                  @default(false)
  born                         DateTime?                @db.Date
  wake                         DateTime?                @db.Time(3)
  created                      DateTime                 @default(now()) @db.Timestamptz(6)
  updated                      DateTime?
  tags                         String[]                 @default([])
  nums                         Int[]
  meta                         Json?                    @default("{\"a\": 1}")
  raw                          Json?                    @db.Json
  blob                         Bytes?
  uid                          String                   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ip                           String?                  @db.Inet
  bits                         String?                  @db.Bit(4)
  vbits                        String?                  @db.VarBit(8)
  ch                           String?                  @db.Char(3)
  x                            String?                  @db.Xml
  money_col                    Decimal?                 @db.Money
  iv                           Unsupported("interval")?
  ticket                       Int                      @default(autoincrement())
  gen                          Int?                     @default(dbgenerated("(small * 2)"))
  ident                        Int                      @default(autoincrement())
  post_post_author_idToaccount post[]                   @relation("post_author_idToaccount")
  post_post_editor_idToaccount post[]                   @relation("post_editor_idToaccount")

  @@unique([name, born], map: "account_name_born")
  @@index([uid], map: "account_hash", type: Hash)
  @@index([meta(ops: JsonbPathOps)], map: "account_meta_gin", type: Gin)
  @@index([name(sort: Desc)])
  @@index([born], map: "account_partial", where: raw("flag"))
}
