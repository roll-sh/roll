-- DESCRIBE of every kind of object, and its errors.
DROP KEYSPACE IF EXISTS cli_g_desc;
CREATE KEYSPACE cli_g_desc WITH replication = {'class': 'NetworkTopologyStrategy', 'replication_factor': 1};
CREATE TYPE cli_g_desc.pt (x int, y text);
CREATE TYPE cli_g_desc.addr (street text, "Zip" int, p frozen<pt>);
CREATE TABLE cli_g_desc.t (k int PRIMARY KEY, a ascii, ad frozen<addr>, m map<text, int>, "Quoted" text);
CREATE TABLE cli_g_desc.wide (p int, c1 text, c2 int, s int static, v text, PRIMARY KEY ((p, c1), c2)) WITH CLUSTERING ORDER BY (c2 DESC) AND comment = 'it''s wide' AND default_time_to_live = 60;
CREATE INDEX t_a ON cli_g_desc.t (a);
CREATE TABLE cli_g_desc."Mixed" (k int, c int, PRIMARY KEY (k, c));
DESC KEYSPACE cli_g_desc;
DESC TABLE cli_g_desc.t;
DESC TABLE cli_g_desc.wide;
DESC TABLE cli_g_desc."Mixed";
DESC TYPE cli_g_desc.addr;
DESC INDEX cli_g_desc.t_a;
DESC cli_g_desc.t;
DESC cli_g_desc;
DESC KEYSPACE nope;
DESC TABLE cli_g_desc.nope;
DESC TYPE cli_g_desc.nope;
DESC INDEX cli_g_desc.nope;
DESC MATERIALIZED VIEW cli_g_desc.nope;
DESC FUNCTION cli_g_desc.nope;
DESC AGGREGATE cli_g_desc.nope;
DESC cli_g_desc.nope;
DESC nope;
DESC TYPE nope;
DESC TABLE nope;
DESC KEYSPACE;
USE cli_g_desc;
DESC TABLES;
DESC TYPES;
DESC FUNCTIONS;
DESC AGGREGATES;
DESC KEYSPACE;
DESC TABLE wide;
DESC TYPE pt;
DESC t;
DESC nope;
DESC TYPE nope;
DROP KEYSPACE cli_g_desc;
