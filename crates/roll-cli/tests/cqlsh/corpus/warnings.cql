-- Server warnings, JSON, roles without auth, and statements cqlsh passes through.
DROP KEYSPACE IF EXISTS cli_g_warn;
CREATE KEYSPACE cli_g_warn WITH replication = {'class': 'NetworkTopologyStrategy', 'replication_factor': 1};
USE cli_g_warn;
CREATE TABLE t (k int, c int, v text, PRIMARY KEY (k, c));
INSERT INTO t (k, c, v) VALUES (1, 1, 'a');
INSERT INTO t (k, c, v) VALUES (2, 1, 'b');
SELECT count(*) FROM t;
SELECT max(c) FROM t;
BEGIN BATCH INSERT INTO t (k, c, v) VALUES (3, 1, ''); INSERT INTO t (k, c, v) VALUES (4, 1, 'y'); APPLY BATCH;
SELECT JSON k, c, v FROM t WHERE k = 1;
SELECT toJson(v), fromJson('"q"') FROM t WHERE k = 2;
INSERT INTO t JSON '{"k": 5, "c": 1, "v": "it''s json"}';
SELECT * FROM t WHERE k = 5;
LIST ROLES;
LIST ALL PERMISSIONS;
CREATE ROLE nobody;
SELECT key FROM system.local;
SELECT * FROM t WHERE k = 1 AND c = 1 USING TIMEOUT 5s;
UPDATE t USING TTL 100 SET v = 'ttl' WHERE k = 1 AND c = 2;
SELECT k, c, v FROM t WHERE k = 1;
DELETE FROM t WHERE k = 1;
SELECT * FROM t WHERE k = 1;
DROP KEYSPACE cli_g_warn;
