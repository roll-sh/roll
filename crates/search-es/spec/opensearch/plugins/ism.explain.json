            "index": {
              "type": "list",
              "description": "index"
            }
          }
        },
        {
          "path": "/_plugins/_ism/explain",
          "methods": [
            "GET",
            "POST"
          ]
        },
        {
          "path": "/_opendistro/_ism/explain",
