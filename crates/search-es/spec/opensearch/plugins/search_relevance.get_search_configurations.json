{
  "search_relevance.get_search_configurations": {
    "documentation": {
      "url": "https://docs.opensearch.org/latest/search-plugins/search-relevance/",
      "description": "Lists the search configurations, or gets one."
    },
    "stability": "experimental",
    "url": {
      "paths": [
        {
          "path": "/_plugins/_search_relevance/search_configurations",
          "methods": [
            "GET"
          ]
        },
        {
          "path": "/_plugins/_search_relevance/search_configurations/{search_configuration_id}",
          "methods": [
            "GET"
          ],
          "parts": {
            "search_configuration_id": {
              "type": "string",
              "description": "The search configuration's id."
            }
          }
        }
      ]
    }
  }
}
