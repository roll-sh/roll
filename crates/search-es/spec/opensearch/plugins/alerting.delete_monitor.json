{
  "alerting.delete_monitor": {
    "documentation": {
      "url": "https://docs.opensearch.org/latest/observing-your-data/alerting/api/",
      "description": "Deletes a monitor."
    },
    "stability": "stable",
    "url": {
      "paths": [
        {
          "path": "/_plugins/_alerting/monitors/{monitor_id}",
          "methods": [
            "DELETE"
          ],
          "parts": {
            "monitor_id": {
              "type": "string",
              "description": "The monitor's id."
            }
          }
        },
        {
          "path": "/_opendistro/_alerting/monitors/{monitor_id}",
          "methods": [
            "DELETE"
          ],
          "parts": {
            "monitor_id": {
              "type": "string",
              "description": "The monitor's id."
            }
          }
        }
      ]
    },
    "params": {
      "refresh": {
        "type": "enum",
        "options": [
          "true",
          "false",
          "wait_for"
        ],
        "description": "Refresh the config index after the write."
      }
    }
  }
}
