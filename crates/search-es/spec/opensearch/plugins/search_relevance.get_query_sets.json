{
  "search_relevance.get_query_sets": {
    "documentation": {
      "url": "https://docs.opensearch.org/latest/search-plugins/search-relevance/",
      "description": "Lists the query sets, or gets one."
    },
    "stability": "experimental",
    "url": {
      "paths": [
        {
          "path": "/_plugins/_search_relevance/query_sets",
          "methods": [
            "GET"
          ]
        },
        {
          "path": "/_plugins/_search_relevance/query_sets/{query_set_id}",
          "methods": [
            "GET"
          ],
          "parts": {
            "query_set_id": {
              "type": "string",
              "description": "The query set's id."
            }
          }
        }
      ]
    }
  }
}
