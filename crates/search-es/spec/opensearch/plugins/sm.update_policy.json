{
  "sm.update_policy": {
    "documentation": {
      "url": "https://docs.opensearch.org/latest/tuning-your-cluster/availability-and-recovery/snapshots/sm-api/",
      "description": "Updates a snapshot management policy."
    },
    "stability": "stable",
    "url": {
      "paths": [
        {
          "path": "/_plugins/_sm/policies/{policy_name}",
          "methods": [
            "PUT"
          ],
          "parts": {
            "policy_name": {
              "type": "string",
              "description": "The name of the snapshot management policy."
            }
          }
        }
      ]
    },
    "params": {
      "if_seq_no": {
        "type": "number",
        "description": "Only update the policy if it has this sequence number."
      },
      "if_primary_term": {
        "type": "number",
        "description": "Only update the policy if it has this primary term."
      }
    },
    "body": {
      "description": "The policy",
      "required": true
    }
  }
}
