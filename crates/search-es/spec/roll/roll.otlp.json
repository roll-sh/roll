{
  "roll.otlp.logs": {
    "documentation": {
      "url": "https://roll.sh/docs/search/guides/logs",
      "description": "OpenTelemetry logs over OTLP/HTTP (protobuf or JSON), written as OTel-native documents into logs-<dataset>.otel-<namespace> data streams"
    },
    "stability": "experimental",
    "visibility": "public",
    "headers": { "accept": ["application/json", "application/x-protobuf"], "content_type": ["application/json", "application/x-protobuf"] },
    "url": {
      "paths": [
        { "path": "/_otlp/v1/logs", "methods": ["POST"] }
      ]
    },
    "body": { "description": "An OTLP ExportLogsServiceRequest", "required": true },
    "params": {}
  }
}
