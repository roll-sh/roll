{
  "description" : "ES|QL ENRICH geo_match with shape inputs (containment, crossings, holes) and the match-field type check",
  "steps" : [
    {
      "req" : "PUT /xpack-geosrc?filter_path=errors,acknowledged,error",
      "body" : {
        "mappings" : {
          "properties" : {
            "g" : {
              "type" : "geo_shape"
            },
            "name" : {
              "type" : "keyword"
            }
          }
        }
      },
      "status" : 200,
      "response" : {
        "acknowledged" : true
      }
    },
    {
      "req" : "POST /xpack-geosrc/_bulk?refresh=true&filter_path=errors,error",
      "raw" : "{\"index\":{}}\n{\"g\":\"POLYGON ((-50 -50, 50 -50, 50 50, -50 50, -50 -50))\",\"name\":\"big\"}\n{\"index\":{}}\n{\"g\":\"LINESTRING (100 1, 100 -10)\",\"name\":\"cross\"}\n{\"index\":{}}\n{\"g\":\"POLYGON ((10 10, 20 10, 20 20, 10 20, 10 10), (12 12, 18 12, 18 18, 12 18, 12 12))\",\"name\":\"ring\"}\n{\"index\":{}}\n{\"g\":\"POINT (150 5)\",\"name\":\"pt\"}\n",
      "status" : 200,
      "response" : {
        "errors" : false
      }
    },
    {
      "req" : "PUT /_enrich/policy/xpack-pol?filter_path=errors,acknowledged,error",
      "body" : {
        "geo_match" : {
          "indices" : "xpack-geosrc",
          "match_field" : "g",
          "enrich_fields" : [
            "name"
          ]
        }
      },
      "status" : 200,
      "response" : {
        "acknowledged" : true
      }
    },
    {
      "req" : "POST /_enrich/policy/xpack-pol/_execute?filter_path=errors,acknowledged,error",
