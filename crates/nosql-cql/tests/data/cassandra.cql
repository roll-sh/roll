SELECT a + b, a - b, a * b, a / b, a % b, -a FROM t
SELECT (a + b) * c FROM t
SELECT (int) a, (text) 'x' FROM t
SELECT l[1..2], l[..3], l[2..], m['a'..'c'] FROM t
SELECT [a, b], {a, b}, {a: b}, (a, b), {} FROM t
SELECT maxwritetime(v), MAXWRITETIME(m['a']) FROM t
SELECT CAST(a + 1 AS bigint) FROM t
SELECT * FROM t WHERE k = 1 + 2 * 3
SELECT * FROM t WHERE k = - 1 AND c = CAST(1 AS int) AND d = -(int)1
SELECT * FROM t WHERE expr(idx, 'query')
SELECT * FROM t WHERE "" = 1
SELECT * FROM t ORDER BY v ANN OF [1.0, 2.0] LIMIT 5
SELECT k FROM t GROUP BY token(k)
SELECT k FROM t GROUP BY floor(c, 1h)
UPDATE t SET c += 1, d -= 2 WHERE k = 1
UPDATE t SET v = 1 WHERE k = 1 IF s CONTAINS 1
UPDATE t SET v = 1 WHERE k = 1 IF m CONTAINS KEY 'a'
INSERT INTO t ("") VALUES (1)
CREATE TABLE t (k int PRIMARY KEY, v int MASKED WITH mask_inner(1, null))
CREATE TABLE t (k int PRIMARY KEY, v text MASKED WITH DEFAULT)
CREATE TABLE t (k int PRIMARY KEY, v vector<float, 3>)
CREATE TABLE t (k int PRIMARY KEY, v 'org.apache.cassandra.db.marshal.UTF8Type')
ALTER TABLE IF EXISTS t ADD IF NOT EXISTS v int MASKED WITH mask_null()
ALTER TABLE t ALTER v MASKED WITH DEFAULT
ALTER TABLE t ALTER IF EXISTS v MASKED WITH system.mask_replace('x')
ALTER TABLE t ALTER v DROP MASKED
ALTER TABLE t DROP IF EXISTS v
ALTER TABLE t RENAME IF EXISTS a TO b
ALTER TABLE t DROP COMPACT STORAGE
ALTER KEYSPACE IF EXISTS ks WITH durable_writes = true
ALTER TYPE IF EXISTS ty ADD IF NOT EXISTS c int
ALTER TYPE ty RENAME IF EXISTS a TO b
ALTER MATERIALIZED VIEW IF EXISTS mv WITH comment = 'y'
CREATE CUSTOM INDEX ON t (v) USING 'StorageAttachedIndex'
CREATE INDEX ON t (v) USING 'sai' WITH OPTIONS = {'case_sensitive': 'false'}
CREATE TRIGGER trig ON t USING 'org.example.Trigger'
CREATE TRIGGER IF NOT EXISTS trig ON ks.t USING 'X'
DROP TRIGGER trig ON t
DROP TRIGGER IF EXISTS trig ON ks.t
GRANT UNMASK ON TABLE ks.t TO r
GRANT SELECT_MASKED ON KEYSPACE ks TO r
GRANT SELECT, MODIFY ON KEYSPACE ks TO r
GRANT SELECT PERMISSION, MODIFY PERMISSION ON KEYSPACE ks TO r
GRANT ALL ON ALL TABLES IN KEYSPACE ks TO r
GRANT SELECT ON ALL MBEANS TO r
GRANT SELECT ON MBEAN 'org.apache.cassandra.db:type=Tables' TO r
GRANT SELECT ON MBEANS 'org.apache.cassandra.db:type=*' TO r
CREATE ROLE r WITH HASHED PASSWORD = '$2a$10$x' AND LOGIN = true
CREATE ROLE r WITH ACCESS TO ALL DATACENTERS
CREATE ROLE r WITH ACCESS TO DATACENTERS {'dc1', 'dc2'} AND ACCESS FROM CIDRS {'region1'}
ALTER ROLE IF EXISTS r WITH ACCESS FROM ALL CIDRS
ALTER USER IF EXISTS u SUPERUSER
CREATE USER u WITH HASHED PASSWORD 'h'
ADD IDENTITY 'id' TO ROLE 'r'
ADD IDENTITY IF NOT EXISTS 'id' TO ROLE r
DROP IDENTITY 'id'
DROP IDENTITY IF EXISTS 'id'
SELECT key, ttl, count, writetime, json, distinct, cast, keys, type, values, map, list, filtering FROM t
CREATE ROLE r WITH OPTIONS = {'a': 'b'} AND ACCESS FROM CIDRS {'c1', 'c2'} AND ACCESS TO ALL DATACENTERS
ALTER ROLE r WITH ACCESS TO DATACENTERS {'dc'}
GRANT ALL ON ALL TABLES IN KEYSPACE ks TO r
REVOKE UNMASK ON TABLE ks.t FROM r
LIST SELECT PERMISSION ON ALL KEYSPACES
SELECT * FROM t WHERE k = 1 AND c IN (1, -2) ORDER BY c ANN OF [1, 2]
SELECT CAST(writetime(v) AS text), (bigint) 1, [1, 2][0], {'a': 1}['a'], (1, 2) FROM t
SELECT a % 2, a / 2, -(a * 2) FROM t
UPDATE t SET l = l - [1], s += {1}, m -= {'a'} WHERE k = 1 IF m['a'] != 1 AND l CONTAINS 1
DELETE FROM t WHERE k = 1 AND (c1, c2) >= (1, 2) AND (c1, c2) < (3, 4)
CREATE TABLE t (k int, c int, v vector<float, 2>, PRIMARY KEY (k, c)) WITH CLUSTERING ORDER BY (c ASC) AND default_time_to_live = 10
CREATE CUSTOM INDEX ON t (v) USING 'StorageAttachedIndex' WITH OPTIONS = {'similarity_function': 'COSINE'}
DESCRIBE TYPES WITH INTERNALS
DESC FUNCTIONS
DESC AGGREGATES
DESCRIBE ONLY KEYSPACE
