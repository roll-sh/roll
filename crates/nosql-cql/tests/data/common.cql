UPDATE t SET m['a'] = 1, l[0] = 2 WHERE k = 1
UPDATE t SET u.f = 1 WHERE k = 1
UPDATE t SET v = 1 WHERE k = 1 IF EXISTS
UPDATE t SET v = 1 WHERE k = 1 IF v = 2 AND w != 3
