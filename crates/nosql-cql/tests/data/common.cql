INSERT INTO t (k, v) VALUES (1, 'a')
INSERT INTO ks.t (k, c, v) VALUES (?, :c, [1, 2]) IF NOT EXISTS
INSERT INTO t (k, v) VALUES (1, 2) USING TTL 10
INSERT INTO t (k, v) VALUES (1, 2) USING TIMESTAMP 123 AND TTL ?
INSERT INTO t (k, v) VALUES (1, 2) IF NOT EXISTS USING TTL 1
INSERT INTO t (k, m) VALUES (1, {'a': 1, 'b': 2})
INSERT INTO t (k, u) VALUES (1, {f: 1, g: 'x'})
INSERT INTO t (k, tp) VALUES (1, (1, 'a', null))
INSERT INTO t JSON '{"k": 1}'
INSERT INTO t JSON ? DEFAULT NULL
INSERT INTO t JSON :j DEFAULT UNSET IF NOT EXISTS USING TTL 3
UPDATE t SET v = 1 WHERE k = 1
UPDATE ks.t USING TTL 10 AND TIMESTAMP 2 SET v = 1, w = 'x' WHERE k = 1 AND c = 2
UPDATE t SET c = c + 1 WHERE k = 1
UPDATE t SET c = c - 1 WHERE k = 1
UPDATE t SET c = c -1 WHERE k = 1
UPDATE t SET l = l + [1], s = s - {2} WHERE k = 1
