-- Writes and reads.
CREATE KEYSPACE {ks} WITH replication = {'class': 'NetworkTopologyStrategy', 'replication_factor': 1};
CREATE TABLE {ks}.t (k int, c int, v text, n bigint, PRIMARY KEY (k, c));
INSERT INTO {ks}.t (k, c, v, n) VALUES (1, 1, 'a', 10);
INSERT INTO {ks}.t (k, c, v, n) VALUES (1, 2, 'b', 20);
INSERT INTO {ks}.t (k, c, v) VALUES (2, 1, 'c');
UPDATE {ks}.t SET v = 'B' WHERE k = 1 AND c = 2;
UPDATE {ks}.t SET n = 30 WHERE k = 3 AND c = 3;
SELECT * FROM {ks}.t WHERE k = 1;
SELECT v, n FROM {ks}.t WHERE k = 1 AND c = 2;
SELECT k, c FROM {ks}.t WHERE k = 1 AND c > 1;
SELECT k, c FROM {ks}.t WHERE k = 1 ORDER BY c DESC;
SELECT * FROM {ks}.t WHERE k IN (1, 2);
!unordered SELECT * FROM {ks}.t;
SELECT count(*) FROM {ks}.t WHERE k = 1;
SELECT * FROM {ks}.t WHERE k = 1 LIMIT 1;
DELETE v FROM {ks}.t WHERE k = 1 AND c = 1;
SELECT * FROM {ks}.t WHERE k = 1 AND c = 1;
DELETE FROM {ks}.t WHERE k = 1 AND c = 1;
SELECT * FROM {ks}.t WHERE k = 1;
DELETE FROM {ks}.t WHERE k = 2;
SELECT * FROM {ks}.t WHERE k = 2;
SELECT * FROM {ks}.t WHERE v = 'a';
SELECT * FROM {ks}.t WHERE c = 1;
SELECT nope FROM {ks}.t;
INSERT INTO {ks}.t (k, v) VALUES (1, 'x');
INSERT INTO {ks}.t (k, c, v) VALUES (1, 1, 2);
SELECT * FROM {ks}.nope;
DROP KEYSPACE {ks};
